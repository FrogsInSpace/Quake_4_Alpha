 minDistance 80
 maxDistance 900
 volumeDb 0

 sound/vo/M03_AirAssault/marks_goodbadworse.wav
}


sound vo_marks_goodfirst
{
 description "<Markswell:> Good news first, despite our losses, our mission to the Trianthinide facility was a success.  The facility was successfully destroyed and the data that we collected has perked the interests of SMC top brass.  "

 minDistance 80
 maxDistance 900
 volumeDb 0

 sound/vo/M03_AirAssault/marks_goodfirst.wav
}


