sound vo_marks_worsenews
{
 description "<Markswell:> Worse news, we just got word from the Hannibal, all four operation advantage EMP convoys were wiped out.  Most of the ground forces are captured or dead, and it would seem that the Strogg have replaced their leader with a new Makron."

 minDistance 80
 maxDistance 900
 volumeDb 0

 sound/vo/M03_AirAssault/marks_worsenews.wav
}


