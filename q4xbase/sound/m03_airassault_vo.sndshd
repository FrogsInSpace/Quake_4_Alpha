{
 description "<Tak:> Strauss was in one of those convoys- without him, this data is worthless!"

 minDistance 80
 maxDistance 900
 volumeDb 0

 sound/vo/M03_AirAssault/tak_straussconv.wav
}


sound vo_marks_empeffortf
{
 description "<Markswell:> That’s right, after the EMP effort failed, sci-tech turned to the data we collected and discovered fragments pointing to how the Strogg brought a new Makron online so quickly. Unfortunately the rest of the data is heavily encrypted; and since it was our find, we’ve been tasked with locating the only marine that can unlock the rest of this critical data."

 minDistance 80
 maxDistance 900
 volumeDb 0

 sound/vo/M03_AirAssault/marks_empeffortf.wav
}


