sound vo_tak_sciconftac
{
 description "<Tak:> Sci-tech confirmed what I suspected.  The data contains tactical information about the Strogg that nobody has seen before.  Most of it is encrypted.  They're trying to get in touch with Rhino Squad’s tech, Strauss.  He's one of 3 techs in the entire SMC that can decrypt Strogg data like this, and the only one that’s currently dirtside."

 minDistance 80
 maxDistance 900
 volumeDb 0

 sound/vo/M03_AirAssault/tak_sciconftac.wav
}


