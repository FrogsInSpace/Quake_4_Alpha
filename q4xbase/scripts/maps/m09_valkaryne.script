void valk01_moves()
{	
	$mvr_valk01.time( 6 );
	$mvr_valk01.accelTime( 0.5 );
	$mvr_valk01.decelTime( 0.5 );
	
	if ( intValk01_moving == 1 )
	{		
		$mvr_valk01.startSpline( $spline_valk01 );
		intValk01_moving = intValk01_moving + 1;		
		sys.waitFor( $mvr_valk01 );		
	}
	else if ( intValk01_moving == 2 )
	{	
		$mvr_valk01.startSpline( $spline_valk02 );
		intValk01_moving = intValk01_moving + 1;
		sys.waitFor( $mvr_valk01 );
	}
	else if ( intValk01_moving == 3 )
	{		
		$mvr_valk01.startSpline( $spline_valk03 );
		intValk01_moving = intValk01_moving + 1;
		sys.waitFor( $mvr_valk01 );		
	}
	else if ( intValk01_moving == 4 )
	{
		$valkaryne01.becomePassive( 1 );
		$mvr_valk01.startSpline( $spline_valk04 );
		sys.waitFor( $mvr_valk01 );
	}
	else
	{
		//sys.println( "COUNTER NOT WORKING" );
		sys.wait( 1 );
	}
}

void valk01_attacks_player()
{
	sys.println( "Valk ATTACKING PLAYER" );
	entValkaryne = $valkaryne01;
	entValkaryne.docked();
	$valkaryne01.becomePassive( 0 );
	$valkaryne01.faceEntity( $player1 );
}

