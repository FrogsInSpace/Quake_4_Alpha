//This is called by a trigger_once when the player is at the bottom of the first shaft
void playerBottomShaftOne()
{
	thread endRepairBotOne();
	thread endRepairBotTwo();
	//thread spawnTacBlastElite01();

	//Move the Valk into the tube
	$mover_icecube.bind( $mover_icecube_trackthing );
	$mover_icecube_trackthing.time( 5 );
	$mover_icecube_trackthing.accelTime( 1 );
	$mover_icecube_trackthing.decelTime( 1 );
	$mover_icecube_trackthing.moveTo( $cube_null_2 );
	sys.waitFor( $mover_icecube_trackthing );

	sys.trigger( $tubedoor1_north );

	$mover_icecube.bind( $mover_icecube_trackthing );
	$mover_icecube_trackthing.time( 5 );
	$mover_icecube_trackthing.accelTime( 1 );
	$mover_icecube_trackthing.decelTime( 1 );
	$mover_icecube_trackthing.moveTo( $cube_null_3 );
	sys.waitFor( $mover_icecube_trackthing );

	sys.trigger( $tubedoor1_north );
	
	sys.trigger( $SAVEME_BITCH );
}

