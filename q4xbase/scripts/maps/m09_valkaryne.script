void setupMachines()
{
	$mover_icecube_trackthing_3.time( 5 );
	$mover_icecube_trackthing_3.accelTime( 1 );
	$mover_icecube_trackthing_3.decelTime( 1 );
	$mover_icecube_trackthing_3.moveTo( $cube_null_6 );
	sys.waitFor( $mover_icecube_trackthing_3 );

	$mover_tube2_mach_2.time( 5 );
	$mover_tube2_mach_2.accelTime( 0.5 );
	$mover_tube2_mach_2.decelTime( 0.5 );
	$mover_tube2_mach_2.rotateOnce( '0 10 0' );
	sys.waitFor( $mover_tube2_mach_2 );
}

// Repair Bots
void repairBotOne()
{
	float t;

	aiScriptedMoveWait( $repbot_1, $repbot_repspot_1, 8, 0 );
	aiScriptedFaceWait( $repbot_1, $repspot_1_target, 0 );
	$repbot_1.bind( $repbot_repspot_1 );
	sys.wait( 1 );

	for(t=0;t++;t<5) {
		aiScriptedActionWait( $repbot_1, $repspot_1_target, 0 );
		sys.wait( 8 );
	}
}

void repairBotTwo()
{
	float t;

	aiScriptedMoveWait( $repbot_2, $repbot_repspot_2, 8, 0 );
	aiScriptedFaceWait( $repbot_2, $repspot_2_target, 0 );
	$repbot_2.bind( $repbot_repspot_2 );
	sys.wait( 1 );

	for(t=0;t++;t<5) {
		aiScriptedActionWait( $repbot_2, $repspot_2_target, 0 );
		sys.wait( 8 );
	}
}

void moveIceCubeDown()
{
	thread navajasPlantsBomb();
	
	sys.wait( 3 );
	// ** VO **	
	sys.trigger( $valk_speaker_1 );	//"<valkaryne:> .Reborn."
	sys.wait( 3 );
	
	// DIALOG OMITED
	//radioChatterPlay( $radiochatter, "vo_10_1_2" );	//"<markswell:> <Over Radio> Dekard!  What's going on?  We're getting heavy(static) EM interference and (static) Losing you."

	$mover_icecube.bind( $mover_icecubearm_1 );
	$mover_icecubearm_1.bind( $mover_icecubearmbase_1 );
	$mover_icecubearm_2.bind( $mover_icecubearmbase_2 );

	$mover_icecubearmbase_1.time( 60 );
	$mover_icecubearmbase_1.decelTime( 1 );
	$mover_icecubearmbase_1.move( -2, 1064 ); // 1144
	$mover_icecubearmbase_2.time( 60 );
	$mover_icecubearmbase_2.decelTime( 1 );
	$mover_icecubearmbase_2.move( -2, 1064 ); // 1144
	sys.waitFor( $mover_icecubearmbase_1 );

	sys.wait( 1 );

	$mover_icecubearm_1_teeth.time( 1 );
	$mover_icecubearm_1_teeth.move( SOUTH, 24 );
	sys.waitFor( $mover_icecubearm_1_teeth );

	$mover_icecubearm_2_teeth.time( 1 );
	$mover_icecubearm_2_teeth.move( WEST, 24 );
	sys.waitFor( $mover_icecubearm_2_teeth );

	sys.wait( 1 );

	$mover_icecube.unbind();

	$mover_icecubearm_1.time( 6 );
	$mover_icecubearm_1.accelTime( 1 );
	$mover_icecubearm_1.decelTime( 1 );
	$mover_icecubearm_2.time( 6 );
	$mover_icecubearm_2.accelTime( 1 );
	$mover_icecubearm_2.decelTime( 1 );
	$mover_icecubearmbase_1.move( -1, 1062 ); // 1142
	$mover_icecubearmbase_2.move( -1, 1062 ); // 1142
	$mover_icecubearm_1.rotateOnce( '0 0 60' );
	$mover_icecubearm_2.rotateOnce( '-60 0 0' );
	sys.waitFor( $mover_icecubearm_1 );

	$mover_icecube.bind( $mover_icecube_trackthing );
	$mover_icecube_trackthing.time( 5 );
	$mover_icecube_trackthing.accelTime( 1 );
	$mover_icecube_trackthing.decelTime( 1 );
	$mover_icecube_trackthing.moveTo( $cube_null_1 );
	sys.waitFor( $mover_icecube_trackthing );
}

void navajasPlantsBomb()
{
	thread moveFog01_spot01();
	thread navaSpeaks01();
	
	// navajas jumps in daring fashion, what a hero
	// sys.wait( 3 );
	aiScriptedAnimWait( $navajas, "cine_mcc_rail_vault", 10, 1 );

	// play place bomb anim
	aiScriptedFaceWait( $navajas, $lookAtMeDickhead, 1 );
	aiScriptedAnimLoop( $navajas, "cine_medic_treating", 10 );
	$navajas.bind( $mover_icecube );
	$egg_clip.remove();
	sys.wait( 3 );
	sys.trigger( $bomb01 );
	$light_bomb01.On();
	
	thread navaSpeaks04c();
}

