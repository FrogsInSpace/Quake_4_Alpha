void navajasDies()
{
	// Navajas jumps off the Makron egg
	thread navaSpeaks07();
	aiScriptedAnimWait( $navajas02, "idle", 10, 1 );
	$navajas02.remove();
	sys.trigger( $navajas03 );	
	$navajas03.becomePassive( 1 );
		
	// Valkaryne preys on navajas
	sys.trigger( $valkaryne02 );
	$valkaryne02.becomePassive( 1 );
