//-------------------
// End Game Cinematic
//-------------------

void youAreTehWinnar()
{
	sys.trigger( $music_on_dropship );
	
	aiScriptedAnimLoop( $char_dropship, "relaxed_idle", 10 );
	
	PLAYER_ON_DROPSHIP = true;
	
	$player1.bind( $mover_dropship );
	$player1.disableWeapon();
	$mover_dropship.time( 5 );
	$mover_dropship.accelTime( 1 );
	$mover_dropship.moveTo( $dropship_null_2 );
	sys.waitFor( $mover_dropship );
	$mover_dropship.moveTo( $dropship_null_3 );
	sys.waitFor( $mover_dropship );
	
	// remove sounds for cinematic
	$valkroom_rumble.remove();
	$escape_1.remove();
	$escape_amb1.remove();
	$speaker_20.remove();
	$speaker_14.remove();	
	$end_amb3.remove();
	$speaker_17.remove();
	$end_amb4.remove();
	$ent_amb6.remove();
	$ent_amb7.remove();
	$speaker_10.remove();
	
	
	// cut to outside room 
	sys.trigger( $cine_shot01 );	
	
	// make ship fly
	$mover_cine_dropship.enableSplineAngles();
	playAnimWait( $cine_dropship, ANIMCHANNEL_ALL, "idle_all_closed" );
	$mover_cine_dropship.time( 10 );
	$mover_cine_dropship.accelTime( 2 );
	$mover_cine_dropship.decelTime( 0.5 );
	$mover_cine_dropship.startSpline( $spline_dropship );	
	
	// wait a sec or two
	sys.wait( 3.5 );
	
	// trigger explosions
	sys.trigger( $cine_explo01 ); // effects/explosions/surface/hangar_exp.fx
	sys.wait( 0.7 );
	sys.trigger( $cine_explo02 ); // effects/explosions/surface/tram_pipe_exp.fx
	
	sys.wait( 3 );
	
	// rock the camera
	//$cine_shot01.bind( $mvr_cine_shot01 );
	
	//scriptEvent	void 	bob( float speed, float phase, vector distance );
	//$mvr_cine_shot01.bob( 20, 1, '10 10 10' );
	
	//scriptEvent	void 	sway( float speed, float phase, vector angles );
	//$mvr_cine_shot01.sway( 10, 1, '0 10 0' );
	sys.wait( 3 );
	
	$cine_shot01.unbind();
		
	sys.trigger( $cine_shot01 );
	$player1.unbind();
	
	// teleport player to the next cinematic scene which has a trigger_once that executes the "end_cine02" thread below
	$player1.setWorldOrigin( $cine02.getOrigin() );	
}

void animDropShipFlyByLanding()
{
	$outro_dropship.playAnim(ANIMCHANNEL_ALL, "outro_dropship");
	sys.wait(25);
	sys.trigger($light_1846); //turn off red spinner	
}

void end_cine02()
{
	//sys.println( "ENDING IN SPACE" );
	
	// unhide space props
	sys.trigger( $stroggos );
	sys.trigger( $destroyer );
	sys.trigger( $outro_dropship );
	
	// make dropship fly away from stroggos
	thread animDropShipFlyByLanding();
	
	$cine02_shot00.bind( $mvr_cine02_shot00 );
	// start camera shot00 in space
	sys.trigger( $cine02_shot00 );	
		
	sys.wait( 2 );
	
	$mvr_cine02_shot00.accelTime( 1 );
	$mvr_cine02_shot00.decelTime( 1 );
	$mvr_cine02_shot00.time( 4 );
	
	$mvr_cine02_shot00.rotateOnce( '0 -45 0' );
	
	sys.wait( 4 );
	
	sys.trigger( $stroggos_explo01 ); //effects/explosions/surface/item_exp.fx
	sys.wait( 0.7 );
	sys.trigger( $stroggos_explo02 ); //effects/explosions/surface/medium2.fx
	sys.wait( 0.2 );
	sys.trigger( $stroggos_explo03 ); //effects/explosions/surface/tram_ext.fx
		
	sys.wait( 2 );
		
	// RHINO SQUAD???
	sys.trigger( $npc_fatigues01 );
	sys.trigger( $npc_fatigues02 );
	sys.trigger( $npc_fatigues03 );
	sys.trigger( $npc_fatigues04 );	
	sys.trigger( $markswell );	

	// Bay doors open up for dropship	
	sys.trigger( $door_uppper_top_2 );
	
	//sys.println( "ENDING IN PATTON BAY" );
		
	// start camera shot01 in patton bay
	sys.trigger( $cine02_shot01 );
	
	sys.wait( 12 );
	
	sys.trigger( $npc_dekard );
	
	$npc_dekard.setAnimRate( 1.2 );
	$npc_dekard.setMoveSpeed( AIMOVESPEED_WALK );
	aiScriptedMoveWait( $npc_dekard, $dekard_spot01, 8, 0 );
	aiScriptedMoveWait( $npc_dekard, $dekard_spot02, 8, 0 );
	
	sys.trigger( $marine01_congrats );
	sys.wait( 0.3 );
	sys.trigger( $marine02_congrats );
	sys.wait( 1 );
	sys.trigger( $marine03_congrats );
	sys.wait( 0.5 );
	sys.trigger( $markswell_congrats );
	sys.wait( 2 );
	sys.trigger( $markswell_speaks01 );
	sys.wait( 6 );
	sys.trigger( $markswell_speaks02 );
	sys.wait( 6 );
	sys.trigger( $markswell_speaks03 );
	sys.wait( 4 );
	sys.trigger( $marine01_cheer );
	sys.wait( 0.5 );
	sys.trigger( $marine02_cheer );
	sys.wait( 4 );
	sys.trigger( $marine03_cheer );
	
	
	// show makron/valkaryne emerging	
	// thread valk_awakens();
	
	sys.trigger( $music_not_over );
	
	sys.wait ( 2 );
	
	// show spline going down shaft really fast, show makron
	thread theEnd();
}

