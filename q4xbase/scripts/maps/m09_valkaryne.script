void theEnd()
{
	//sys.println( "GAME OVER!! BLOWJOBS FOR EVERYONE!" );
	sys.fadeOut( '0 0 0', 3);
	sys.wait( 3 );
	sys.trigger( $TEHEND );
}

//------
//  Main
//------

void main()
{
	sys.trigger( $music_intro );
	
	$func_door_161.lock( 1 );
	
	sys.trigger( $target_give01 ); // gives player all weapons, ammo, and weaponmods
	
	$hh_tank01.bind( $hh_tank01_glass );
	$hh_tank02.bind( $hh_tank02_glass );
	
	thread setupMachines();
	thread init_steamers();

	//Setup booleans
	ESCAPE_ELEVATOR_CLEAR = false;
	PLAYER_ON_EXIT_ELEVATOR = false;
	EXIT_DOOR_ONE_CLOSED = false;
	EXIT_DOOR_TWO_CLOSED = false;
	EXIT_DOOR_THREE_CLOSED = false;

	sys.trigger( $navajas );
	$navajas.becomePassive( 1 );
	sys.trigger( $valkaryne01 );	
	$valkaryne01.becomePassive( 1 );
	//aiScriptedAnimLoop( $valkaryne01, "idle", 10 );
	//sys.trigger( $monster_gunner_1 );
	//sys.trigger( $monster_gunner_2 );
	sys.trigger( $repbot_1 );
	sys.trigger( $repbot_2 );

	thread coldInHere();
	thread repairBotOne();
	thread repairBotTwo();

	sys.wait( 2 );
	m10_giveObjective( 1 );

	thread moveIceCubeDown();
	
	PLAYER_ON_DROPSHIP = false;
	GAME_OVER = false;
}

} // end namespace