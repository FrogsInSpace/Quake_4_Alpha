void markswellIsMrObvious()
{
	sys.println( "MARKSWELL: <Over Radio> Dekard!  Dekard!  Good work, the EM interference just shut down.  We got a lock on you and. (Static). Oh shit, we're picking up all kinds of readings.  Looks like that bitch is gonna blow.  We've got a drop-ship en route.  Get to the top of the facility, and shut the blast doors.  Go, Marine." );
	radioChatterPlay( $radiochatter, "vo_marks_dekemclear" );
	sys.wait( 5 );
	radioChatterPlay( $radiochatter, "vo_marks_dekhugeenrgy" );
	sys.wait( 8 );
	radioChatterPlay( $radiochatter, "vo_marks_dek3min" );	
}

