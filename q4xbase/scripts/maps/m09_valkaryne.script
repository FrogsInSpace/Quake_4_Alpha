//------------------
//  Valkaryne Finale
//------------------
void valkIntro()
{
	sys.trigger( $music_valk_intro );
	
	VALK_ALIVE = true;

	sys.trigger( $valkcamera );
		
	animMakronRolling();
	sys.wait( 2 );
	
	sys.trigger( $valk_speaker_27 );
	
	$makShield01.remove();
	$makShield02.remove();
	
	$mak_shield_1.show();
	$mak_shield.show();
	$baby_mak.show();
	$baby_mak_light01.On();
	$mak_sphere.show();

	$func_door_119.lock( 1 );
	$func_door_120.lock( 1 );
	$func_static_54386.setShaderParm( 7, 0 );
	sys.trigger( $valkcamera );

	sys.wait( 2 );
	$valk.becomeAggressive();
	thread initValk();
	
	while( 1 )
	{
		sys.trigger( $firstHex_2 );
		sys.wait( sys.random( 5 ) );
		sys.trigger( $secondHex_2 );
		sys.wait( sys.random( 10 ) );		
		sys.trigger( $thirdHex_2 );
		sys.wait( sys.random( 20 ) );
	}
}

void animMakronRolling()
{	
	// makron ball rolls into position
	$makShield01.accelTime( 0 );
	$makShield01.decelTime( 1 );
	$makShield01.time( 6 );
	
	$makShield01.rotate( '-180 0 0' );
	
	$makShield01.disableSplineAngles();
	$makShield01.startSpline( $spline_makShield );
	sys.waitFor( $makShield01 );
	$mvr_makShields.rotate( '0 0 0' );	
}

void initValk()
{	
	sys.trigger( $target_bossMakronEgg );	

	VALK_DOCKED = true;
	
	thread makronMovers();
	thread makron_shield_battle();
	
	sys.trigger( $SAVEME_BITCH );
	
	thread moveFog03_spot01();
}

void moveFog03_spot01()
{	
	// trigger to turn on steam
	sys.trigger( $steam01_freeze05 );
	sys.trigger( $steam02_freeze05 );
	sys.trigger( $steam03_freeze05 );
	sys.trigger( $steam04_freeze05 );
	sys.trigger( $steam05_freeze05 );
	
	// move the fog layer down
	$fog03_hurt.bind( $mvr_fog03 );
	$fog_freeze03.bind( $mvr_fog03 );
	$mvr_fog03.time( 180 ); // 3 minutes to battle zee bossa de bella, muy mal!!! It's 5am, do you know where your level designer is?
	$mvr_fog03.accelTime( 1 );
	$mvr_fog03.decelTime( 1 );
	
	$mvr_fog03.moveTo( $fog03_spot01 );
	sys.waitFor( $mvr_fog03 );
	
	// trigger to turn off steam
	sys.trigger( $steam01_freeze05 );
	sys.trigger( $steam02_freeze05 );
	sys.trigger( $steam03_freeze05 );
	sys.trigger( $steam04_freeze05 );
	sys.trigger( $steam05_freeze05 );
}

