void spawn_hh_tank01()
{
	//sys.trigger( $hh_tank01 );
	$hh_tank01.becomePassive( 0 );
	$hh_tank01.unbind();
	$hh_tank01_glass.remove();
	sys.trigger( $fx_hh_tank_emerge01 );
	
	sys.wait( 3 );
	
	thread stalac01_fall();
	// thread valk01_moves();
}

void moveFog01_spot01()
{	
	// trigger to turn on steam
	sys.trigger( $steam01_freeze01 );
	sys.trigger( $steam02_freeze01 );
	sys.trigger( $steam03_freeze01 );
	sys.trigger( $steam04_freeze01 );
	sys.trigger( $steam05_freeze01 );
	sys.trigger( $steam06_freeze01 );
	
	// move the fog layer down
	$fog01_hurt.bind( $mvr_fog01 );
	$fog_freeze01.bind( $mvr_fog01 );
	$mvr_fog01.time( 120 );
	$mvr_fog01.accelTime( 1 );
	$mvr_fog01.decelTime( 1 );
	
	$mvr_fog01.moveTo( $fog01_spot01 );
	sys.waitFor( $mvr_fog01 );
	
	// trigger to turn off steam
	sys.trigger( $steam01_freeze01 );
	sys.trigger( $steam02_freeze01 );
	sys.trigger( $steam03_freeze01 );
	sys.trigger( $steam04_freeze01 );
	sys.trigger( $steam05_freeze01 );
	sys.trigger( $steam06_freeze01 );
}

void moveFog01_spot02()
{
	// trigger to turn on steam
	sys.trigger( $steam01_freeze02 );
	sys.trigger( $steam02_freeze02 );
	sys.trigger( $steam03_freeze02 );
	sys.trigger( $steam04_freeze02 );
		
	// move the fog layer down	
	$mvr_fog01.moveTo( $fog01_spot02 );
	sys.waitFor( $mvr_fog01 );
	
	// trigger to turn off steam
	sys.trigger( $steam01_freeze02 );
	sys.trigger( $steam02_freeze02 );
	sys.trigger( $steam03_freeze02 );
	sys.trigger( $steam04_freeze02 );	
}

void stalac01_fall()
{	
	// action
	$stalac01.time( 2 );
	$stalac01.accelTime( 1 );
	$stalac01.decelTime( 0 );
	$stalac01.moveTo( $stalac01_spot01 );
	
	sys.wait( 0.5 );
	
	$stalac01.time( 0.5 );
	$stalac01.moveTo( $stalac01_spot01 );
	sys.waitFor( $stalac01 );
	sys.trigger( $fx_stalac01 );
	
	// clean up
	$fx_stalac01.unbind();
	//$stalac01_hurt.unbind();
	$stalac01.remove();
	//$stalac01_hurt.remove();
}

