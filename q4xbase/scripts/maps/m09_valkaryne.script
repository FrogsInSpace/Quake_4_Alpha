void start_machines()
{	
	thread machine_1_on();
	sys.wait( 0.4 );
	thread machine_2_on();
	sys.wait( 0.3 );
	thread machine_3_on();
	sys.wait( 0.6 );
	thread machine_4_on();
	thread streamerScrolling02();
	
	while( 1 )
	{
		sys.trigger( $firstHex_1 );
		sys.wait( sys.random( 5 ) );
		sys.trigger( $secondHex_1 );
		sys.wait( sys.random( 10 ) );		
		sys.trigger( $thirdHex_1 );
		sys.wait( sys.random( 20 ) );
	}
}

