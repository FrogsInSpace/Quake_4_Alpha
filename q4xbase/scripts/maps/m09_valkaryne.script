void escapeSeqExplosions()
{
	//Series of timed explosion FX and trigger hurts up the exit tunnel

	//Give the elevator time to get to its stopping point
	if( PLAYER_ON_EXIT_ELEVATOR ) {
		sys.wait( 40 );
	}

	//Activate FX and trigger hurt
	sys.trigger( $esc_bot_bigfx_1 );
	sys.trigger( $esc_bot_hurt_1 );
	//Kill the large light for that section of tunnel
	$esc_light_1.Off();
	//Start the secondary smoke
	sys.trigger( $esc_bot_bigfx_1b );

	sys.wait( 8 );
	sys.trigger( $esc_bot_bigfx_2 );
	sys.trigger( $esc_bot_hurt_2 );
	$esc_light_2.Off();
	sys.trigger( $esc_bot_bigfx_2b );

	sys.wait( 8 );
	sys.trigger( $esc_bot_bigfx_3 );
	sys.trigger( $esc_bot_hurt_3 );
	$esc_light_3.Off();
	sys.trigger( $esc_bot_bigfx_3b );

	sys.wait( 8 );
	sys.trigger( $esc_bot_bigfx_4 );
	sys.trigger( $esc_bot_hurt_4 );
	$esc_light_4.Off();
	sys.trigger( $esc_bot_bigfx_4b );

	sys.wait( 8 );
	sys.trigger( $esc_bot_bigfx_5 );
	sys.trigger( $esc_bot_hurt_5 );
	$esc_light_5.Off();
	sys.trigger( $esc_bot_bigfx_5b );
	//Remove the secondary smoke as its very, very far below
	sys.trigger( $esc_bot_bigfx_1b );

	sys.wait( 8 );
	sys.trigger( $esc_bot_bigfx_6 );
	sys.trigger( $esc_bot_hurt_6 );
	sys.trigger( $esc_bot_bigfx_6b );
	//Remove the secondary smoke as its very, very far below
	sys.trigger( $esc_bot_bigfx_2b );

	sys.wait( 8 );
	sys.trigger( $esc_bot_bigfx_7 );
	sys.trigger( $esc_bot_hurt_7 );
	sys.trigger( $esc_bot_bigfx_7b );
	//Remove the secondary smoke as its very, very far below
	sys.trigger( $esc_bot_bigfx_3b );
}

//If the player doesn't get on and start the elevator, start the explosions and kill him
void esc_playerEnteredShaft()
{
	sys.wait( 15 );
	if( !PLAYER_ON_EXIT_ELEVATOR ) {
		thread escapeSeqExplosions();
	}
}

