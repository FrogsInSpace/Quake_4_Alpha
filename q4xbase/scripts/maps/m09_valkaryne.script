//--------------------
// nexus streamer room - after the 2nd large cave room
//--------------------

void streamerScrolling() // from Raven
{	
	//sys.println( "streamer started" );
	
	// fancy stuff to make sure that the shader effects don't get out of sync with the effects emitters

	float streamerPosition = 0;
	float oldTime = sys.getTime();
	float nowTime = sys.getTime();
	float startTime = sys.getTime();
	float deltaTime;
	float streamerState = 0;
	float streamerSpeed = -0.125;
	
	while(1){
		
		nowTime = sys.getTime();
		deltaTime = nowTime - oldTime;
		oldTime = nowTime;
	
		streamerPosition += streamerSpeed * deltaTime;
		$coreStreamers.setShaderParm( 4, streamerPosition );

		if ((nowTime - startTime) >= 8.0) {
			//sys.print("reset");
			startTime = nowTime;
			streamerState = 0;
		} else if ((nowTime - startTime) >= 1.7 && streamerState == 2) {
			//sys.print("third one");
			sys.trigger($thirdHex);
			streamerState = 3;
		} else if ((nowTime - startTime) >= 1.4 && streamerState == 1) {
			//sys.print("second one");
			sys.trigger($secondHex);
			streamerState = 2;
		} else if ((nowTime - startTime) >= 0.35 && streamerState == 0) {
			//sys.print("first one");
			sys.trigger($firstHex);
			streamerState = 1;
		}
		
		sys.waitFrame();
	
	}

}

void wobbler01_skewed()
{
	$orig_wobbler01.time( 1 );
	
	while( 1 )
	{
		$orig_wobbler01.rotateOnce( '0 10 5' );
		sys.waitFor( $orig_wobbler01 );
		$orig_wobbler01.rotateOnce( '0 -10 -5' );
		sys.waitFor( $orig_wobbler01 );
	}
}

void wobblers()
{
	// sys.println( "wobble gobble" );
	$wobbler01.time( 2 );
	$wobbler01.rotate( '90 0 0' );
	
	thread wobbler01_skewed();
	//thread wobbler02_skewed();
}

void steamersLoop()
{
	while( 1 ) {
		$steamer_1_light.On();
		sys.wait( 0.1 );
		$steamer_1_lightb.On();

		$steamer_1_light.fadeInLight( 4 );

		sys.trigger( $steamer_1_liquid_speaker );

		$steamer_1_fluid.time( 6 );
		$steamer_1_fluid.move( UP, 390 );
		sys.waitFor( $steamer_1_fluid );

		$steamer_1_part_1.time( 2 );
		$steamer_1_part_1.move( DOWN, 84 );
		sys.waitFor( $steamer_1_part_1 );

		$steamer_1_part_2.time( 2 );
		$steamer_1_part_2.move( DOWN, 60 );
		sys.waitFor( $steamer_1_part_2 );

		$steamer_1_light.fadeOutLight( 5 );
		$steamer_1_lightb.fadeInLight( 5 );
		sys.wait( 5 );

		$steamer_1_part_1.time( 2 );
		$steamer_1_part_1.move( UP, 84 );
		sys.waitFor( $steamer_1_part_1 );

		$steamer_1_part_2.time( 2 );
		$steamer_1_part_2.move( UP, 60 );
		sys.waitFor( $steamer_1_part_2 );

		$steamer_1_lightb.fadeOutLight( 6 );

		$steamer_1_fluid.time( 6 );
		$steamer_1_fluid.move( DOWN, 390 );
		sys.waitFor( $steamer_1_fluid );

		sys.trigger( $steamer_1_liquid_speaker );

		$steamer_1_light.Off();
		sys.wait( 0.1 );
		$steamer_1_lightb.Off();

		sys.wait( 2 );

		$steamer_2_light.On();
		sys.wait( 0.1 );
		$steamer_2_lightb.On();

		$steamer_2_light.fadeInLight( 4 );

		sys.trigger( $steamer_2_liquid_speaker );

		$steamer_2_fluid.time( 6 );
		$steamer_2_fluid.move( UP, 390 );
		sys.waitFor( $steamer_2_fluid );

		$steamer_2_part_1.time( 2 );
		$steamer_2_part_1.move( DOWN, 84 );
		sys.waitFor( $steamer_2_part_1 );

		$steamer_2_part_2.time( 2 );
		$steamer_2_part_2.move( DOWN, 60 );
		sys.waitFor( $steamer_1_part_2 );

		$steamer_2_light.fadeOutLight( 5 );
		$steamer_2_lightb.fadeInLight( 5 );
		sys.wait( 5 );

		$steamer_2_part_1.time( 2 );
		$steamer_2_part_1.move( UP, 84 );
		sys.waitFor( $steamer_2_part_1 );

		$steamer_2_part_2.time( 2 );
		$steamer_2_part_2.move( UP, 60 );
		sys.waitFor( $steamer_2_part_2 );

		$steamer_2_lightb.fadeOutLight( 6 );

		$steamer_2_fluid.time( 6 );
		$steamer_2_fluid.move( DOWN, 390 );
		sys.waitFor( $steamer_2_fluid );

		sys.trigger( $steamer_2_liquid_speaker );

		$steamer_2_light.Off();
		sys.wait( 0.1 );
		$steamer_2_lightb.Off();

		sys.wait( 2 );
	}	
}

void init_steamers()
{
	$steamer_1_light.bind( $steamer_1_fluid );
	$steamer_2_light.bind( $steamer_2_fluid );
	$steamer_1_lightb.bind( $steamer_1_fluid );
	$steamer_2_lightb.bind( $steamer_2_fluid );

	$steamer_1_light.fadeOutLight( 1 );
	$steamer_1_lightb.fadeOutLight( 1 );
	$steamer_2_light.fadeOutLight( 1 );
	$steamer_2_lightb.fadeOutLight( 1 );

	sys.wait( 0.1 );

	$steamer_1_fluid.time( 0.1 );
	$steamer_1_fluid.move( DOWN, 390 );
	sys.waitFor( $steamer_1_fluid );

	sys.wait( 0.1 );

	$steamer_1_part_1.time( 2 );
	$steamer_1_part_1.move( UP, 84 );
	sys.waitFor( $steamer_1_part_1 );

	sys.wait( 0.1 );

	$steamer_1_part_2.time( 2 );
	$steamer_1_part_2.move( UP, 60 );
	sys.waitFor( $steamer_1_part_2 );

	sys.wait( 0.1 );

	$steamer_2_fluid.time( 0.1 );
	$steamer_2_fluid.move( DOWN, 390 );
	sys.waitFor( $steamer_2_fluid );

	sys.wait( 0.1 );

	$steamer_2_part_1.time( 2 );
	$steamer_2_part_1.move( UP, 84 );
	sys.waitFor( $steamer_2_part_1 );

	sys.wait( 0.1 );

	$steamer_2_part_2.time( 2 );
	$steamer_2_part_2.move( UP, 60 );
	sys.waitFor( $steamer_2_part_2 );

	sys.wait( 0.1 );

	thread steamersLoop();
}

