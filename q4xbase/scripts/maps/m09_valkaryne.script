void esc_elevatorFall()
{
	ESCAPE_ELEVATOR_CLEAR = true;

	sys.trigger( $esc_speaker_1 );
	sys.wait( 0.35 );
	sys.trigger( $esc_speaker_2 );
	sys.wait( 1 );
	sys.trigger( $esc_fake_elev_speaker );

	thread esc_elevatorHit();

	$exit_fake_elevator.show();
	$exit_elevator_panel_fake.show();
	sys.wait( 0.1 );
	$exit_elevator.remove();
	
	// rotate down 5 degrees
	$exit_fake_elevator.time( 0.2 );
	$exit_fake_elevator.accelTime( 0.1 );
	$exit_fake_elevator.decelTime( 0.1 );
	$exit_fake_elevator.rotateOnce( '0 0 -5' );
	sys.waitFor( $exit_fake_elevator );
	
	sys.wait( 0.5 );
	
	// fall 64 units
	$exit_fake_elevator.time( 0.5 );
	$exit_fake_elevator.accelTime( 0 );
	$exit_fake_elevator.decelTime( 0 );
	$exit_fake_elevator.move( DOWN, 64 );
	// sparks on
	sys.trigger( $fake_ele_sparks_1 );
	sys.trigger( $fake_ele_sparks_2 );
	sys.trigger( $fake_ele_sparks_3 );
	sys.trigger( $fake_ele_sparks_4 );
	sys.waitFor( $exit_fake_elevator );
	// sparks off
	sys.trigger( $fake_ele_sparks_1 );
	sys.trigger( $fake_ele_sparks_2 );
	sys.trigger( $fake_ele_sparks_3 );
	sys.trigger( $fake_ele_sparks_4 );
	sys.waitFor( $exit_fake_elevator );
	
	sys.wait( 0.7 );
	
	// climb up 32 units
	$exit_fake_elevator.time( 0.2 );
	$exit_fake_elevator.accelTime( 0 );
	$exit_fake_elevator.decelTime( 0 );
	$exit_fake_elevator.move( UP, 32 );
	sys.waitFor( $exit_fake_elevator );
	
	sys.wait( 1.5  );
	
	// fall a fuck of a distance
	$exit_fake_elevator.time( 8 );
	$exit_fake_elevator.accelTime( 3 );
	$exit_fake_elevator.move( DOWN, 5872 );
	sys.trigger( $fake_ele_sparks_1 );
	sys.trigger( $fake_ele_sparks_2 );
	sys.trigger( $fake_ele_sparks_3 );
	sys.trigger( $fake_ele_sparks_4 );
	sys.waitFor( $exit_fake_elevator );

	$fake_ele_sparks_1.remove();
	$fake_ele_sparks_2.remove();
	$fake_ele_sparks_3.remove();
	$fake_ele_sparks_4.remove();
}

//the elevator is at the top, wait a bit and if the player hasn't grappled off of it, drop the sucker
void esc_elevatorUp()
{
	radioChatterPlay( $radiochatter, "vo_marks_dekyougot" );
	
	sys.wait( 10 );
	if( !ESCAPE_ELEVATOR_CLEAR ) {
		sys.trigger( $esc_speaker_2 );
		sys.wait( 1 );
		sys.trigger( $esc_speaker_1 );
	}

	sys.wait( 5 );

	if( !ESCAPE_ELEVATOR_CLEAR ) {
		thread esc_elevatorFall();
	}
}

void moveDropship()
{
	sys.trigger( $char_dropship);
	aiScriptedAnimLoop( $char_dropship, "ad_bidwell_wave", 10 );
	sys.trigger( $dropship );
	playAnimWait( $dropship, ANIMCHANNEL_ALL, "intro_idle" );
	$mover_dropship.time( 3 );
	$mover_dropship.decelTime( 1 );
	$mover_dropship.moveTo( $dropship_null );
	$mover_dropship.rotateOnce( '0 -180 0' );
	sys.waitFor( $mover_dropship );

	$mover_dropship.time( 3 );
	$mover_dropship.accelTime( 1 );
	$mover_dropship.decelTime( 1 );
	$mover_dropship.moveTo( $dropship_null_1 );
	$mover_dropship.rotateOnce( '0 -180 0' );
	sys.wait( 2 );
	
	$busted_beam01.remove();
	sys.trigger( $busted_beam_explo01 );
	$busted_beam02.remove();
	sys.trigger( $busted_beam_explo02 );
	
	sys.waitFor( $mover_dropship );
	
	radioChatterPlay( $radiochatter, "vo_marks_wecanhldps" );
	
	//thread bobbing_dropship();
	thread rolling_dropship();
	thread turning_dropship();
}

void bobbing_dropship()
{	
	//scriptEvent	void 	bob( float speed, float phase, vector distance );	
	
	$mover_dropship.accelTime( 0.3 );
	$mover_dropship.decelTime( 0.3 );
	$mover_dropship.time( 1.5 );
	
	$mover_dropship.bob( 8, 0, '0 0 2' );
}

void rolling_dropship()
{
	//scriptEvent	void 	sway( float speed, float phase, vector angles );
	
	$mover_dropship.accelTime( 0.3 );
	$mover_dropship.decelTime( 0.3 );
	$mover_dropship.time( 1.5 );
	
	$mover_dropship.sway( 8, 4, '10 0 0' );
}

void turning_dropship()
{	
	//scriptEvent	void 	sway( float speed, float phase, vector angles );
	
	$mover_dropship.accelTime( 0.3 );
	$mover_dropship.decelTime( 0.3 );
	$mover_dropship.time( 1.5 );

	$mover_dropship.sway( 4, 1, '0 5 0' );
}

//Large iris doors at end of level
void operate_exit_4door()
{
	radioChatterPlay( $radiochatter, "vo_marks_30sec" );
	
	thread dropshipAbortsExtraction(); // waits 20 seconds
		
	// sys.println( "HURRY! The doors are closing!" );
	
	//close door | time was 25
	$mover_4door_5.time( 45 );
	$mover_4door_6.time( 45 );
	$mover_4door_7.time( 45 );
	$mover_4door_8.time( 45 );
	$mover_4door_5.accelTime( 0.5 );
	$mover_4door_6.accelTime( 0.5 );
	$mover_4door_7.accelTime( 0.5 );
	$mover_4door_8.accelTime( 0.5 );
	$mover_4door_5.decelTime( 0.5 );
	$mover_4door_6.decelTime( 0.5 );
	$mover_4door_7.decelTime( 0.5 );
	$mover_4door_8.decelTime( 0.5 );
	$mover_4door_5.rotateOnce( '0 45 0' );
	$mover_4door_6.rotateOnce( '0 45 0' );
	$mover_4door_7.rotateOnce( '0 45 0' );
	$mover_4door_8.rotateOnce( '0 45 0' );
	
	sys.wait( 2 );
	sys.trigger( $SAVEME_BITCH );
	sys.waitFor( $mover_4door_5 );
}

void dropshipAbortsExtraction()
{	
	// sys.println( "dropshipAbortsExtraction thread waiting 20sec" );
	sys.wait( 20 );
	
	if( !PLAYER_ON_DROPSHIP )
	{
		thread pilotSpeaks();
		// sys.println( "DROPSHIP: We can't wait anymore, the doors are about to shut on us, we gotta jet, NOW!" );
		$mover_dropship.time( 5 );
		$mover_dropship.accelTime( 1 );
		$mover_dropship.moveTo( $dropship_null_2 );
		sys.waitFor( $mover_dropship );
		$mover_dropship.moveTo( $dropship_null_3 );
		sys.waitFor( $mover_dropship );
		
		//sys.println( "YOU BOOB! You were too slow!" );
		sys.wait( 1 );
		sys.fadeOut( '0 0 0', 5);
	}
}

