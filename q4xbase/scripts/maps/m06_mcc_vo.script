void VO_tak_valkact( entity ent )
{
 //Tak: The Valkaryne acts as a data conduit for a newly awakened Makron.  She filters all the data from the Nexus into a new Makron, making sure the Strogg leadership doesn't skip a beat.  This is even more concerning- since she can filter Nexus information directly, it's possible she doesn't need the Nexus like the other Strogg do.  She can function without it!  
 aiSpeakWait( ent, "lipsync_vo_tak_valkact" );
}


