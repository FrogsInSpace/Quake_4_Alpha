

void VO_harp_falcsqcom( entity ent )
{
 //Harper/Davenport: Falcon squad, I'm here to compliment you on your efforts today, your team has pulled off the impossible by getting Strauss back in one piece, and the Strogg data you collected has become essential to the entire war effort, Strauss...  
 aiSpeakWait( ent, "lipsync_vo_harp_falcsqcom" );
}


void VO_strauss_workingondata( entity ent )
{
 //Strauss: I've been working on the data decryption since my rescue, it took me the better part of a day, but I’ve finished the decryption algorithms.  
 aiSpeakWait( ent, "lipsync_vo_strauss_workingondata" );
}


void VO_strauss_somuchdat( entity ent )
{
 //Strauss: There is so much data, it could take weeks to fully decode, but, as you can see here, we have every available CPU dedicated to the task.  
