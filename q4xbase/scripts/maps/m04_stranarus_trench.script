		sys.wait( 3 );
		
		aiSpeakWait( $tak, "lipsync_tak_goodholdwlk" );					// %%%%%%%%%% VO %%%%%%%%%%
		sys.wait( 3 );
		
		aiScriptedMoveWait 	( $tak, $m04_maint_tunnel_unit1_tak_node_seq_4, 16, 1);
