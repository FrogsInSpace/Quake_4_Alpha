		thread foldWings();
		$dummyfreezeGun.remove();
		sys.trigger			( $m04_building_unit1_seq_3_give_freeze_gun );
		aiScriptedAnimWait 	( $tak, "player_gift_end", 16, 1 );
		$tak.showSurface	("models/weapons/mp_guns/w_mg_lo");
		$tak.flashlight(1);
		
		//sys.trigger( $m04_building_unit1_seq_3_door );
		sys.music( "m1_objective" );
		thread tak_seq_3();
		thread navajas_seq_3();
		sys.trigger( $m04_building_unit1_seq_3_set_door_shader );
		sys.trigger( $m04_building_unit1_seq_3_door_lock );
		
		sys.trigger( $m04_building_unit1_seq_3_door );
		sys.trigger( $m04_building_unit1_seq_3_strog_ambusher_1 );
		$tak.becomeAggressive();
		$navajas.becomeAggressive();
	}
