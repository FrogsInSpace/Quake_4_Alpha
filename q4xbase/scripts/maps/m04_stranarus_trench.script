		sys.trigger( $m04_maint_tunnel_unit1_navajas_node_seq_4_show_charge );
		sys.wait( 10 );
		
		radioChatterPlay( $uni_radiochatter, "vo_nava_firstchrg" );		// %%%%%%%%%% VO %%%%%%%%%%
		//aiSpeakWait( $navajas, "lipsync_nava_firstchrg" );					// %%%%%%%%%% VO %%%%%%%%%%
