void m04_maint_tunnel_unit1_seq_1()
	{	
		sys.trigger( $uni_auto_save_trigger );
		sys.trigger( $m04_maint_tunnel_unit1_uni_vehicle_walker_tak );
		$m04_maint_tunnel_unit1_uni_vehicle_walker_player.lock(1);
		aiScriptedAnimLoop 	( $m04_maint_tunnel_unit1_uni_vehicle_walker_tak, "idle_offline", 32 );
		thread m04_maint_tunnel_unit1_tak_seq_1();
		thread m04_maint_tunnel_unit1_navajas_seq_1();
		sys.wait( 3 );
		
		aiSpeakWait( $tak, "lipsync_tak_thertheyr" );					// %%%%%%%%%% VO %%%%%%%%%%
		sys.trigger( $tunnel1Hatch_26 );
		sys.trigger( $m04_maint_tunnel_unit1_seq_1_strog_hatch_spawner );
		sys.wait( 4 );
		
		sys.music( "m1_objective" );
	}
