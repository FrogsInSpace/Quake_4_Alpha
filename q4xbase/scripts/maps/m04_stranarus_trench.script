		$m04_maint_tunnel_unit1_uni_vehicle_walker_player.unbind();
		$m04_maint_tunnel_unit1_uni_vehicle_walker_player.guiEvent( "event_anim_sysonline" );
		
		sys.trigger( $OBJ_two_complete );
