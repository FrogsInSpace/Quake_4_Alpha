		sys.trigger( $guy_3 );
		sys.wait( 4 );
		
		sys.trigger( $guy_4 );
		sys.wait( 4 );
		
		sys.trigger( $markswell );
		sys.wait( 4 );
		
		sys.trigger( $OBJ_four );
		
		radioChatterPlay( $uni_radiochatter, "vo_mark_tre_getout" );		// %%%%%%%%%% VO %%%%%%%%%%
		$m04_maint_tunnel_unit1_uni_vehicle_walker_player.lock(0);
	}
	
