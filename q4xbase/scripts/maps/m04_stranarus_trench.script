void m04_trench_unit2_seq_2_unlock_player()
	{	
		sys.trigger( $OBJ_three_complete );
		
		radioChatterPlayWait( $uni_radiochatter, "vo_tak_turrdown" );		// %%%%%%%%%% VO %%%%%%%%%%
		sys.wait( 4 );
		radioChatterPlayWait( $uni_radiochatter, "vo_marks_rogertht2" );		// %%%%%%%%%% VO %%%%%%%%%%
		thread m04_trench_unit2_tak_seq_2();
		thread m04_trench_unit2_navajas_seq_2();
