	$wing_rt_south_3.bind($origin_piston_rt_3);
	$wing_rt_north_7.bind($origin_piston_rt_7);	
	$wing_rt_south_7.bind($origin_piston_rt_7);	

	$origin_piston_rt_3.rotateOnce( '0 0 -720' );
	$origin_piston_rt_7.rotateOnce( '0 0 -720' );	
}

