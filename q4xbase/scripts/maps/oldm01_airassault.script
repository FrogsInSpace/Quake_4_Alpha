//Development only!  GUI in forward turret that adds 1000 health to the dropship.
void devGiveDropshipHealth()
{
	float n;
	float p;

	p = $drop_ship.getHealth();
	n = ( p + 1000 );
	$drop_ship.setHealth( n );
}

