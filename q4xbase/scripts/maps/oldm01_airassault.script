//Called by startMap(), toggles on and off the MCC's nose guns a few times for effect
void mccSpecial()
{
	//on
	sys.trigger( $mcc1_specialattack );
	sys.trigger( $mcc2_specialattack );

	sys.wait( 8 );

	//off
	sys.trigger( $mcc1_specialattack );
	sys.trigger( $mcc2_specialattack );

	sys.wait( 8 );

	//on
	sys.trigger( $mcc1_specialattack );
	sys.trigger( $mcc2_specialattack );

	sys.wait( 8 );

	//off
	sys.trigger( $mcc1_specialattack );
	sys.trigger( $mcc2_specialattack );

	sys.wait( 8 );

	//on
	sys.trigger( $mcc1_specialattack );
	sys.trigger( $mcc2_specialattack );

	sys.wait( 8 );

	//off
	sys.trigger( $mcc1_specialattack );
	sys.trigger( $mcc2_specialattack );
}

