	//--------------------------------------------------------------------------
	// Locks all doors that get unlocked at a later time
	//--------------------------------------------------------------------------
	void setupLockedDoors()
	{
		// speeder hangar
		$door_speeder.lock( 1 );

		// mess hall
		$func_door_166.lock( 1 );
		$func_door_167.lock( 1 );
		
		// control room
		$func_door_130.lock( 1 );
		$func_door_131.lock( 1 );
	}
	
	
	//--------------------------------------------------------------------------
	// The guys that are sitting react to the explosion
	//--------------------------------------------------------------------------
	void sittingReaction( entity ent, float variant )
	{
		string temp;
		string anim;
		temp = ent.getKey( "anim" );
		
		if ( variant == 1 )
		{
			anim = "mcc_console_reaction1";
		}
		else
		{
			anim = "mcc_console_reaction2";
		}
		
		aiScriptedAnimWait( ent, anim, 4, 0 );
		aiScriptedAnimLoop( ent, temp, 4 );
	}
	
		
	//--------------------------------------------------------------------------
	// Player meets with Whedon and Markswell in Sci-Tech
	//--------------------------------------------------------------------------
	void attackMusic()
	{
		sys.trigger( $musicAction );
		$musicAction.fadeSound( SND_CHANNEL_ANY, 0, 5 );
		$musicSubtle.fadeSound( SND_CHANNEL_ANY, -80, 2 );
		sys.wait( 2 );
		$musicSubtle.remove();
	}
	
	void sciTechMeeting()
	{
		// objective complete
		sys.trigger( $item_objectivecomplete_1 );
		
		sys.println("m06b::sciTechMeeting()");
		
		// SEQUENCE GOES HERE
		if ( !CUT_THE_CRAP )
		{
			$tak.lookAt( $player1 );
			aiSpeakWait( $tak, "lipsync_tak_dekwepouringover" );
			$tak.lookAt( $orig_mon_3 );
			aiSpeakWait( $tak, "lipsync_tak_numrefvalk" );
			$tak.lookAt( $player1 );
			aiSpeakWait( $tak, "lipsync_tak_wemins" );
			radioChatterPlay( $mcc2_briefingPA, "" );
			thread setupEmergencyLights();
			$tak.lookAt( $orig_mon_3 );
			sys.wait( 3 );
			aiSpeakWait( $tak, "lipsync_tak_whathellgo" );
			$tak.setTalkState( TALK_OK );
		}
		
		sys.wait( 1 );
		
		sys.trigger( $fxShake );
		sys.trigger( $largeExplosion ); // attacked
		thread attackMusic(); // here?
		thread sittingReaction( $poisson, 1 );
		thread sittingReaction( $dakin, 2 );
		thread sittingReaction( $heckler, 1 );
		radioChatterPlayWait( $func_radiochatter_0, "vo_mcc_allperidef" );
		
		sys.trigger( $target_objectivebeacon_2 ); // turret area
		sys.trigger( $item_objective_2 ); // get to PDGs
		
		thread setupRouteToTurret(); // DESTROY THE REST OF THE MCC		
		thread radioBattle();
		thread backgroundSounds(); // background battle sounds
		
		$scitech_door.lock( 0 );

		sys.wait( 1 );
		radioChatterPlayWait( $func_radiochatter_0, "vo_marks_dekgettodef" );

		if ( !SKIP_SAVEGAMES )
		{
			sys.trigger( $func_savegame_1 );
		}
	}

	void scitechAncillary()
	{
		$FLANAGAN.setTalkState( TALK_WAIT );
		$KETCHERSIDE.setTalkState( TALK_WAIT );
		$FLANAGAN.lookAt( $func_static_54976 );
		$KETCHERSIDE.lookAt( $func_static_54976 );
		aiSpeakWait( $FLANAGAN, "lipsync_flan_data1" );
		$KETCHERSIDE.lookAt( $FLANAGAN );
		aiSpeakWait( $KETCHERSIDE, "lipsync_ketch_data2" );
		$FLANAGAN.lookAt( $KETCHERSIDE );
		aiSpeakWait( $FLANAGAN, "lipsync_flan_data3" );
		$KETCHERSIDE.lookAt( $func_static_54976 );
		$FLANAGAN.lookAt( $func_static_54976 );
		aiSpeakWait( $KETCHERSIDE, "lipsync_ketch_data4" );
		$FLANAGAN.lookAt( $null_entity );
		$KETCHERSIDE.lookAt( $null_entity );
		$FLANAGAN.setTalkState( TALK_OK );
		$KETCHERSIDE.setTalkState( TALK_OK );
	}
	
	
	//--------------------------------------------------------------------------
	// randomly play explosions
