	// ...entering the speeder hangar
	//--------------------------------------------------------------------------
	void morganWork()
	{
		$morgan.setMoveSpeed( AIMOVESPEED_WALK );
		aiScriptedFaceWait( $morgan, $markswell, 0 );
		aiScriptedAnimWait( $morgan, "at_attention_start", 4, 0 );
		aiScriptedAnimWait( $morgan, "at_attention_end", 4, 0 );
		aiScriptedMoveWait( $morgan, $morgan_goto, 4, 0 );
		aiScriptedFaceWait( $morgan, $func_static_55181, 0 );
		aiScriptedAnimLoop( $morgan, "console_w_weapon_loop", 8 );
	}
	
	void dekardMoves()
	{
		$dekard.setMoveSpeed( AIMOVESPEED_WALK );
		aiScriptedMoveWait( $dekard, $tar_dekard_spot_outro, 4, 0 );
		aiScriptedFace( $dekard, $markswell, 0 );
	}
	
	void enterSpeederHangar()
	{
		$vehicle_speederbike_1.lock( 1 );
		$tak_outro.disableHeal();
		aiScriptedAnimLoop( $naymushin, "cover_left_idle", 4 );
		
		sys.setCamera( $func_cameraview_1 );
		$player1.setOrigin( $tar_dekard_spot_outro_HACK.getOrigin() );
		sys.trigger( $dekard );
		thread dekardMoves();
						
		thread morganWork();
		sys.wait( 1 );
		$door_speeder.close();
		
		$markswell.lookAt( $dekard );
		$tak_outro.lookAt( $dekard );
		aiSpeakWait( $markswell, "lipsync_marks_dekgoodnex" );
		aiSpeakWait( $tak_outro, "lipsync_tak_wefindec" );
		sys.setCamera( $func_cameraview_tak );
		aiSpeakWait( $tak_outro, "lipsync_tak_valkact" );
		aiSpeakWait( $tak_outro, "lipsync_tak_datapoint" );
		sys.setCamera( $func_cameraview_markswell );
		aiSpeakWait( $markswell, "lipsync_marks_wetrycomm" );
		sys.setCamera( $func_cameraview_tak );
		aiSpeakWait( $tak_outro, "lipsync_tak_unfortstrgg" );
		sys.setCamera( $func_cameraview_markswell );
		aiSpeakWait( $markswell, "lipsync_marks_dektimeshort" );
		sys.setCamera( $func_cameraview_group );
		aiSpeakWait( $markswell, "lipsync_marks_youonlyfew" );
		aiSpeakWait( $markswell, "lipsync_marks_moveout5" );
		
		$dekard.remove();
		sys.firstPerson();
		$door_speeder.lock( 1 );
		$player1.setOrigin( $tar_dekard_spot_outro.getOrigin() );
		$player1.setViewAngles( '0 90 0' );
		
		$tak_outro.setTalkState( TALK_OK );
		$navajas_outro.setTalkState( TALK_OK );
		$darnell_outro.setTalkState( TALK_OK );
		$markswell.setTalkState( TALK_OK );
		$naymushin.setTalkState( TALK_OK );
		$morgan.setTalkState( TALK_OK );
		
		sys.trigger( $speaker_speederann_2 );
		
		$tak_outro.enableHeal();
		
		sys.trigger( $blueLightSpecial );
		sys.trigger( $exitareaalert );
		$vehicle_speederbike_1.lock( 0 );
	}
	
	
	//--------------------------------------------------------------------------
	// Player gets in the speederbike, sets off events that end the level
	//--------------------------------------------------------------------------	
	void getInSpeeder()
	{
		//Completed objective #5
		sys.trigger( $item_objectivecomplete_3 );
		$vehicle_speederbike_1.lock( 1 );
		
		thread speederHangarLiftDown(); // going down
	}


	//-----------------------------------------------------------------------
	// When the player gets on the bikes, lower the hangar doors
	//-----------------------------------------------------------------------
	void awayMusic()
	{
		sys.trigger( $musicTheme );
		$musicTheme.fadeSound( SND_CHANNEL_ANY, 0, 5 );
		$musicAction.fadeSound( SND_CHANNEL_ANY, -80, 2 );
		sys.wait( 2 );
		$musicAction.remove();
	}
	
	void speederHangarLiftDown()
	{
		thread awayMusic();
		
		$speeder_hangar_floor.time( 15 );
		$speeder_hangar_floor.accelTime( 3 );
	
		// door used just to close off a vis portal
		sys.trigger( $speeder_hangar_floor_door );
		sys.wait( 3 );
			
		// eventually get some dialog telling the player to stand still
		$speeder_hangar_floor.move( DOWN, 394 );
		sys.wait( 12 );
		sys.fadeOut( '0 0 0', 2);
		sys.wait( 2 );
		
		$player1.setHealth( 100 ); // give the player what he needs
		$player1.refillAmmo();
		
		sys.trigger( $target_leveltrigger_1 );
	}
	
	
	//-----------------------------------------------------------------------
	// Raise the platform that the speeder bikes are on
	//-----------------------------------------------------------------------
	void speederHangarLiftUp()
	{
		$speeder_hangar_floor.time( 15 );
		$speeder_hangar_floor.decelTime( .5 );
	
		sys.trigger( $speeder_hangar_floor_door );
		$speeder_hangar_floor_door.hide();
		$speeder_hangar_floor.move( UP, 394 );
		sys.waitFor( $speeder_hangar_floor );
		$speeder_hangar_floor_door.show();
	
		// door used just to close off a vis portal
		sys.trigger( $speeder_hangar_floor_door );
	}


	//--------------------------------------------------------------------------
	// Sci-Tech monitor setup
	//--------------------------------------------------------------------------
	void scitechMonsDown()
	{	
		$monitor_base.time( 5 );
		$monitor_base.accelTime( .5 );
		$monitor_base.decelTime( .5 );
		
		$monitor_base.moveTo( $mon_base_DN );
		sys.waitFor( $monitor_base );
		$horz_mon_1.rotateUpTo( 2, 30 );
		$orig_mon_3.rotateDownTo( 0, 330 );	
	}
	

