	{
		spawnedFighterDriver = d;
	}
	
	
	//--------------------------------------------------------------------------
	// triggering the fighter spawners and making them do their thing
	//--------------------------------------------------------------------------
	void manageFighter( string spline )
	{
		entity currVehicle;
		entity currDriver;
		
		entity currVehicleSpawner = sys.getEntity( "func_spawner_vehicle_" + spline );
		entity currVehicleDriverSpawner = sys.getEntity( "func_spawner_driver_" + spline );
		entity currSpline = sys.getEntity( "func_mover_fighter_spline_" + spline );
		entity currMover = sys.getEntity( "func_mover_fighter_" + spline );
		entity currMoverPitch = sys.getEntity( "func_mover_pitch_" + spline );
		entity currSpeaker = sys.getEntity( "strogg_fighter_speaker_" + spline );
		entity currMoverOrigin = sys.getEntity( "tar_start_mover_" + spline );
		
		float t;
		float whilechecker = 1;
		
		do
		{
			//sys.println( "Fighter plane on spline " + spline + " spawned" );
			sys.trigger( currVehicleSpawner );
			sys.waitFrame();
			currVehicle = spawnedFighter;	
			currVehicle.bind( currMoverPitch );
			sys.waitFrame();

			sys.trigger( currVehicleDriverSpawner );
			sys.waitFrame();
			currDriver = spawnedFighterDriver;
			currDriver.enterVehicle( currVehicle );
			currDriver.fireWeapon( 0, 5 );
		
			currMover.speed( 2000 );
			currMover.startSpline( currSpline );
			
			// INSERT TIMING FOR SETTING OFF THE SPEAKER AND BANKING HERE
			sys.wait( 2.75 );
			if ( isValidEntity( currVehicle ) )
			{
				sys.trigger( currSpeaker );
			}
			// DONE FANCY-SCHMANCY TIMING
			
			sys.waitFor( currMover );
			currMover.stopSpline();
			currMover.setOrigin( currMoverOrigin.getOrigin() );
			if ( isValidEntity( currVehicle ) )	{
				currVehicle.remove();
			}

			t = randomRoundFloat( 1, 5 ) + 5;
			sys.wait( t );
		} 
		while( spawnTurret1Fighters );
	}
	
	
	//--------------------------------------------------------------------------
	// vehicle fighters on splines at the first turret position
	//--------------------------------------------------------------------------
	void fighterGroup1()
	{
		float t;
		thread manageFighter("2");
		
		t = randomRoundFloat( 1, 5 ) + 3;
		sys.wait(t);
		thread manageFighter("3");
		
		t = randomRoundFloat( 1, 5 ) + 3;
		sys.wait(t);
		thread manageFighter("4");
		
		t = randomRoundFloat( 1, 5 ) + 3;
		sys.wait(t);
		thread manageFighter("5");
		
		t = randomRoundFloat( 1, 5 ) + 3;
		sys.wait(t);
		thread manageFighter("6");
	}
		

	//--------------------------------------------------------------------------
	// Sends off the flatbed trucks and walkers for the convoy sequence
	//--------------------------------------------------------------------------
	void convoyAway()
	{
		$truck1.show();
		$truck2.show();
		$truck3.show();
		
		sys.trigger( $walkerTether1 );
		sys.trigger( $walkerTether2 );
		
		$truck1.setAngles ('0 0 0');
		setNewTimes( $truck1Mover , 25 , 3 , 0 );
		$truck1Mover.startSpline( $truck1Spline );
				
		$truck2.setAngles ('0 0 0');
		setNewTimes( $truck2Mover , 26 , 3 , 0 );
		$truck2Mover.startSpline( $truck2Spline );
		
		$truck3.setAngles ('0 0 0');
		setNewTimes( $truck3Mover , 27 , 3 , 0 );
		$truck3Mover.startSpline( $truck3Spline );
		
		sys.wait( 18 );
		
		sys.trigger( $func_bigdoor_11 );
		sys.wait( 8 );
		sys.trigger( $func_bigdoor_11 );
	}
	
	void skyboxDroppods()
	{
		$skyboxDroppod_1.time( 60 );
		$skyboxDroppod_2.time( 60 );
		$skyboxDroppod_3.time( 60 );
		$skyboxDroppod_4.time( 60 );
		$skyboxDroppod_5.time( 60 );
		$skyboxDroppod_6.time( 60 );
		$skyboxDroppod_7.time( 60 );
		$skyboxDroppod_8.time( 60 );
		$skyboxDroppod_9.time( 60 );
		$skyboxDroppod_10.time( 60 );
				
		$skyboxDroppod_1.moveTo( $tar_skyboxDroppod_1 );
		$skyboxDroppod_2.moveTo( $tar_skyboxDroppod_2 );
		$skyboxDroppod_3.moveTo( $tar_skyboxDroppod_3 );
		$skyboxDroppod_4.moveTo( $tar_skyboxDroppod_4 );
		$skyboxDroppod_5.moveTo( $tar_skyboxDroppod_5 );
		$skyboxDroppod_6.moveTo( $tar_skyboxDroppod_6 );
		$skyboxDroppod_7.moveTo( $tar_skyboxDroppod_7 );
		$skyboxDroppod_8.moveTo( $tar_skyboxDroppod_8 );
		$skyboxDroppod_9.moveTo( $tar_skyboxDroppod_9 );
		$skyboxDroppod_10.moveTo( $tar_skyboxDroppod_10 );
		
		sys.wait( 10 );
		thread startTurretSpawners(); // OFF
		
		sys.wait( 10 );
		thread startTurretSpawners(); // ON
	}
	
	
	//--------------------------------------------------------------------------
	// looping function that keeps the turret at the position, 
	// when this falls out the turret sequence is over
	//--------------------------------------------------------------------------
	void turret_obj01()
	{	
		//thread turretBattleRadioChatter();
		
		radioChatterPlayWait( $func_radiochatter_whedon, "vo_marine1_thisperdef" ); // inc harvesters
		sys.wait(2);
						
		sys.println( "ROUND 1: wave of flyers" );
		sys.println( "NOT YET IMPLEMENTED" );
		sys.wait( 2 );
		
		radioChatterPlayWait( $func_radiochatter_whedon, "vo_marine1_harvinb" );
		
		sys.println( "ROUND 2: HOLY SHIT HARVESTER OVER HILL + DESTRUCTION OF MCC GUN" );
		sys.trigger( $monster_q4x_harvester_combat_2 );
		aiScriptedAnim( $monster_q4x_harvester_combat_2, "mcc_mountain_climb", 4, 0 );
		
		sys.wait( 3 );
		
		radioChatterPlayWait( $func_radiochatter_whedon, "vo_marine1_nexdroppod" );
		thread skyboxDroppods();
		
		while ( !TURRET_DEAD )
		{
			sys.waitFrame();
		}
		
		while ( isLivingEntity($monster_q4x_harvester_combat_5) )
		{
			sys.waitFrame();
		}
	
		radioChatterPlayWait( $func_radiochatter_whedon, "vo_marine1_nexasspod" );
		radioChatterPlayWait( $func_radiochatter_whedon, "vo_marks_attfalcspeed" ); // okay done meet us at the speeder hangar
				
			sys.wait( 5 );
			// "Aerial pods deployed."
			//sys.trigger( $radioBattle_11 );

		sys.println( "ROUND 4: flyers and bombers attack, ground forces getting ready to move out" );
		sys.wait(6);
		radioChatterPlayWait( $func_radiochatter_whedon, "vo_marine1_morestrgg" ); // additional signals
		sys.wait(3);
			
			// "Mechanized, Transport, and Infantry Units mobilized."
			//sys.trigger( $radioBattle_12 );
			sys.wait(5);
			
		radioChatterPlayWait( $func_radiochatter_whedon, "vo_marine1_grnsred" );				
			// "Ground forces deployed."
			//sys.trigger( $radioBattle_13 );
			sys.wait(5);

		thread convoyAway();	
			
		radioChatterPlayWait( $func_radiochatter_whedon, "vo_marine1_holdshharv" ); // contact bearing....
			
		sys.trigger( $monster_q4x_harvester_combat_4 ); // OH GOD THE HORROR
		
		while ( isLivingEntity( $monster_q4x_harvester_combat_4 ) ) 
		{
			//sys.println("waiting for harvester 2 to die");
			sys.wait( 1 );	
		}
		radioChatterPlayWait( $func_radiochatter_whedon, "vo_marine1_nexgaway" );
		
		sys.println( "TURRET SEQUENCE OVER" );
		sys.wait(2);
	}
	
	void harvesterKillsTurret()
	{
		TURRET_DEAD = 1;
		$monster_q4x_mcc_turret_1.kill();
		$monster_q4x_harvester_combat_2.remove();
		sys.trigger( $monster_q4x_harvester_combat_5 );	
	}
	
	
