	//--------------------------------------------------------------------------
	// Setting up the route for the player after the turret objective to get to the
	// speeder hangar
	//--------------------------------------------------------------------------
	void setupRouteToHangar()
	{
		$corey_light_3517.setShader( "lights/square_flicker" );
		$corey_light_3524.setShader( "lights/square_flicker" );
		
		if ( !SKIP_SAVEGAMES )
		{
			sys.trigger( $func_savegame_1 );
		}
		
		$func_door_130.lock( 0 );
		$func_door_131.lock( 0 );

		thread giveWeapon();
		thread monitorTeleHealth();
		thread blockHallway();

		$func_door_126.lock( 1 ); // initial door (damaged by dropdown thingie)
		$func_door_127.lock( 1 );

		$func_door_154.lock( 1 ); // engine room
		$func_door_153.lock( 1 );
		
		$func_door_166.lock( 0 ); // mess hall
		$func_door_167.lock( 0 );
		
		$door_speeder.lock( 0 );
		$scitech_door.lock( 1 );
				
		sys.trigger( $trig_explosion_1 );
		sys.trigger( $trig_explosion_2 );
		sys.trigger( $trig_explosion_3 );
		sys.trigger( $trig_hall_teleporter );
		
		sys.trigger( $trig_start_controlroom );
		sys.trigger( $trig_start_controlroom_1 );
		
		$crblocker1.remove();
		$crblocker2.remove();
		/*
		//$crblocker2.forcePosture( AIPOSTURE_STAND );
		aiScriptedAnimWait( $crblocker2, "crouch_to_stand_scripted", 4, 1 );
		//sys.trigger( $ai_tether_none_1 );
		*/
		
		sys.wait( 5 );
		sys.trigger( $target_objectivebeacon_3 ); // speeder hangar
		sys.trigger( $item_objective_3 );
	}
	
	
	//--------------------------------------------------------------------------
	// Random stuff for smoke and mirrors in the control room
	//--------------------------------------------------------------------------
	void controlRoomKnockBackHelper( entity knockbackee )
	{
		vector vKnockback;
		vector vGrunt = $target_null_7.getWorldOrigin();
		vector vPlayer = knockbackee.getWorldOrigin();
		
		vKnockback = VectorSubtract( vPlayer, vGrunt);
		vKnockback = sys.vecNormalize( vKnockback);
	
		//high numbers? Yes but they work very well.
		vKnockback *= 150000;
		vKnockback_z = 4000;

		knockbackee.applyImpulse( knockbackee, knockbackee.getWorldOrigin(), vKnockback);
	}
	
	void controlRoomKnockBack()
	{
		sys.trigger( $target_launchprojectile_1 );
		thread controlRoomKnockBackHelper( $player1 );
		/*
		$crblocker2.becomeRagdoll();
		thread controlRoomKnockBackHelper( $crblocker2 );
		sys.waitFrame();
		$crblocker2.becomeNonSolid();
		$crblocker2.setTalkState( TALK_NEVER );
		$crblocker2.disableBlinking();
		$crblocker2.becomePassive( 1 );
		//$crblocker2.kill();
		*/
	}
	
		
	//--------------------------------------------------------------------------
	// Player steps in control room, Strogg teleporter crashes into it
	//--------------------------------------------------------------------------
	void controlRoomCrash()
	{
		sys.println("m06b::controlRoomCrash()");
		sys.wait( 1 );
		
		sys.trigger( $controlRoomShakefx );
		sys.trigger( $controlRoomLargeExplosion );
		sys.trigger( $func_fx_controlRoomCrash );
		thread controlRoomKnockBack();
		sys.trigger( $target_light_fadeout_command );
		//sys.wait( 1 );
		
		// HIDE/SHOW EVERYTHING HERE
		$controlroom_pipes_before.hide();
		$controlroom_ceiling_before.hide();
		$controlroom_randombar.hide();
		
		$controlroom_pipes_after.show();
		$controlroom_ceiling_after.show();
		
		$strogg_teleporter_base_controlroom.show();
		$controlroom_teleporter_base.show();
		$teleporter_controllroom_arm_north.show();
		$teleporter_controllroom_arm_south.show();
		$teleporter_controllroom_arm_east.show();
		$controlroom_teleporter_arm_west.show();
		$comm_tele_ball.show();
		$comm_tele_socket.show();
		sys.trigger( $func_fx_comm_tele );
		thread monitorCommTeleHealth();

 		$corey_light_2604.Off();
 		$corey_light_2614.Off();
 		$corey_light_2616.Off();
 		$corey_light_2647.Off();
 		$corey_light_3595.Off();
 		$corey_light_3596.Off();
 		$corey_light_3601.Off();
 		//$corey_light_3594.setShader("lights/square_blast");
 		//$corey_light_2600.setShader("lights/round_flicker2"); //what broken?

		sys.trigger( $target_light_fadein_command );
		$controlRoomTeleporterLight.fadeInLight(1.5);
		
		sys.trigger( $controlroom_steam_1 );
		sys.trigger( $controlroom_steam_2 );
		sys.trigger( $controlroom_steam_3 );
		sys.trigger( $controlroom_steam_4 );
		sys.trigger( $controlroom_steam_5 );
		sys.trigger( $controlroom_steam_6 );
		
		sys.trigger( $controlroom_pipesteam_1 );
		sys.trigger( $controlroom_pipesteam_2 );
		
		sys.trigger( $func_fx_controlroom_sparks_1 );
		sys.trigger( $func_fx_controlroom_sparks_2 );
		sys.trigger( $func_fx_controlroom_sparks_3 );
		
		sys.trigger( $func_fx_controlroom_fire_1 );
		
		sys.wait(3);
		
		// TELEPORTER ENABLED
		sys.trigger( $func_spawner_command_dropin );
	}
	
	
