	void blockedHallwayDude()
	{
		$marineBlocker1.setTalkState( TALK_OK );
		$marineBlocker2.setTalkState( TALK_OK );
		
		thread dudesDialog();
		sys.println("m06b::blockedHallwayDude()");
		aiScriptedTetherMoveWait( $marineBlocker2, $ai_tether_radius_2 );
		aiScriptedFaceWait( $marineblocker2, $downHallway, 1 );
		$marineBlocker2.forcePosture( AIPOSTURE_CROUCH );
		$marineBlocker2.becomeAggressive();
	}
	
	
	//--------------------------------------------------------------------------
	// Round and round she goes... (HALLWAY VERSION)
	//--------------------------------------------------------------------------
	void spinHallTeleBall()
	{
		while( !hallTeleporterDestroyed ) {
			//spin the balls
			$rear_tele_ball_1.time( 1 );
			$rear_tele_ball_1.rotateOnce( '0 180 0' );
			sys.waitFor( $rear_tele_ball_1 );
			sys.waitFrame();
		}
	}
	
	
	//--------------------------------------------------------------------------
	// Allows the destruction of the teleporter ball thing and the turning off
	// of the teleporter (HALLWAY VERSION)
	//--------------------------------------------------------------------------
	void monitorHallTeleHealth()
	{
		float r;
		hallTeleporterDestroyed = false;
		
		thread spinHallTeleBall();
		
		while ( !hallTeleporterDestroyed )
		{
			r = $rear_tele_ball_1.getHealth();
			
			if ( r <= 1 )
			{
				$rear_tele_broken_1.show();
				$rear_tele_ball_1.remove();
				sys.trigger( $rear_tele_broken_fx_1 );
				sys.trigger( $rear_tele_break_fx_1 );
				sys.trigger( $func_fx_809 ); 
				sys.wait( 0.2 );
				sys.trigger( $func_fx_809 );
				sys.wait( 0.1 );
				sys.trigger( $func_fx_809 );
				$light_8546.remove();
				hallTeleporterDestroyed = true;
				$func_spawner_enemy_light_4.remove();
			}
			
			sys.wait(0.1);
		}
	}
	
	
	//--------------------------------------------------------------------------
	// Round and round she goes... (COMMAND VERSION)
