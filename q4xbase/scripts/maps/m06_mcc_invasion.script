	//--------------------------------------------------------------------------
	//==========================================================================
	// Q4 from Raven below - MCC Setup practices and stuff
	//==========================================================================
	//--------------------------------------------------------------------------
	
	//--------------------------------------------------------------------------
	// loop for the target_setinfluence and speaker
	// There are 2 speakers because the sounds overlap. If the speaker would be triggered again before finishing, it's shut off.
	//--------------------------------------------------------------------------
	void attackInfluence(entity inf, entity snd, entity snd_1)
	{
		while(1)
		{
			sys.trigger( snd );
			sys.wait(1);
			sys.trigger( inf );
			sys.wait(1);
	
			sys.trigger( snd_1 );
			sys.wait(1);
			sys.trigger( inf );
			sys.wait(1);
		}
	}
	
		
	//--------------------------------------------------------------------------
	// Setting up anims for idle chars
	//--------------------------------------------------------------------------
	void spawnScitechDudes()
	{
		$poisson.setTalkState( TALK_OK );
		$heckler.setTalkState( TALK_OK );
		$dakin.setTalkState( TALK_OK );
	}
	
	void spawnRs1()
	{
		aiScriptedAnimLoop( $RED_SHIRT_1, "working_on_knee", 4 );
		sys.wait( 2 );
		aiSpeakWait( $RED_SHIRT_1, "lipsync_must_dooropen" );
		sys.wait( 4 );
		aiSpeakWait( $RED_SHIRT_1, "lipsync_must_onemore" );
		sys.wait( 4 );
		aiSpeakWait( $RED_SHIRT_1, "lipsync_must_gotit" );
		thread openPremesshallDoor();
	}
		
	
	//--------------------------------------------------------------------------
	// copy->paste mcc_2 radio battle
	//--------------------------------------------------------------------------
	void radioBattle()
	{
		// "Heavy Damage"
		sys.trigger($radioWarnings_1);
		sys.wait(5);
	
			// "3 o'clock"
			radioChatterPlayWait ($radioTurret1_1, "");
			// "I'm on 'em."
			radioChatterPlayWait ($radioTurret1_2, "");
	
			// "keep coming"
			radioChatterPlayWait ($radioRandoms_1, "");
	
		// "86%"
		sys.trigger($radioWarnings_2);
		sys.wait(5);
			
			// "comin' in too low"
			radioChatterPlayWait ($radioTurret2_1, "");
			// "target visually."
			radioChatterPlayWait ($radioTurret2_2, "");
	
		// "72%"
		sys.trigger($radioWarnings_3);
		sys.wait(7);
	
			// "take that"
			radioChatterPlayWait ($radioRandoms_2, "");
			sys.wait(1);
			
			// "turret's been hit"
			radioChatterPlayWait ($radioTurret3_1, "");
	
		// "63%"
		sys.trigger($radioWarnings_4);
		sys.wait(5);
	
			// "harvesters, left flank"
			radioChatterPlayWait ($radioWalker1_1, "");
			// "taking engineering"
			radioChatterPlayWait ($radioRandoms_3, "");
	
		// "48%"
		sys.trigger($radioWarnings_5);
		sys.wait(6);
		
			// "get banks out of there"
			radioChatterPlayWait ($radioWalker2_1, "");
	
			// "air support right now"
			radioChatterPlayWait ($radioWalker3_1, "");
			// "can't stop them"
			radioChatterPlayWait ($radioRandoms_4, "");
	
		// "Decks 2 and 3"
		sys.trigger($radioWarnings_6);
		sys.wait(7);
	
			// "coord 43, 82"
			radioChatterPlayWait ($radioField1_1, "");
			// "roger that"
			radioChatterPlayWait ($radioField1_2, "");
			sys.wait(1);
	
		// "29%"
		sys.trigger($radioWarnings_7);
		sys.wait(6);
	
			// "air support?"
			radioChatterPlayWait ($radioField2_1, "");
			// "eta 3 min."
			radioChatterPlayWait ($radioField2_2, "");
			// "last that long"
			radioChatterPlayWait ($radioField2_3, "");
	
		// "13%"
		sys.trigger($radioWarnings_8);
		sys.wait(6);
	
			// "another transport"
			radioChatterPlayWait ($radioField3_1, "");
			// "too damn many"
			radioChatterPlayWait ($radioRandoms_5, "");
	}

				
	//--------------------------------------------------------------------------
	// random stuff going on during the turret sequence
	//--------------------------------------------------------------------------
	void turretBattleRadioChatter()
	{
		sys.wait(4);

		// "hull breach"
		//sys.trigger( $radioBattle_1 );
		sys.wait(6);
		
			// "they're dropping teleporters!"
			radioChatterPlayWait( $func_radiochatter_0, "vo_7_13_11" );
			sys.wait(1);

			
		// "medical attention required" 
		//sys.trigger( $radioBattle_3 );
		sys.wait(8);
		
			// "got contact, 3 incoming squadrons bearing..."
			radioChatterPlayWait( $func_radiochatter_0, "vo_7_13_18" );
			sys.wait(4);
		
			// "going for the reactor" 
			radioChatterPlayWait( $func_radiochatter_0, "vo_7_13_2" );
			sys.wait(9);
			
			// "panther squad requesting support on deck 12"
			radioChatterPlayWait( $func_radiochatter_0, "vo_7_13_6" );

			// "that's a negative panther, they've locked down..."
			radioChatterPlayWait( $func_radiochatter_0, "vo_7_13_12" );
			sys.wait(8);
		
			// "nexus's assault's almost prepped"
			radioChatterPlayWait( $func_radiochatter_0, "vo_7_13_5" );

		
		// "strogg lifeforms detected"
		//sys.trigger( $radioBattle_2 );
		sys.wait(7);
					
			// "got contact, watch the engine room"
			radioChatterPlayWait( $func_radiochatter_0, "vo_7_13_1" );
			sys.wait(8);
			
			// "3 men down on deck 5, requesting medical"
			radioChatterPlayWait( $func_radiochatter_0, "vo_7_13_9" );
			sys.wait(3);		
			
			// "coming from port, hold them off"
			radioChatterPlayWait( $func_radiochatter_0, "vo_7_13_3" );
			sys.wait(5);
	}
	
	
	//--------------------------------------------------------------------------
	// In the beginning...
	//--------------------------------------------------------------------------
	void main()
	{
		// remove the players weapon 
		$player1.disableWeapon();
		
		// wait to be enabled
		$turret.disableWeapon();
		
		/////////////////////
		// Q4X addition /////
		/////////////////////		
				
		// Hangar lift going up into the hangar (speeders)
		thread speederHangarLiftUp();
		
		$vehicle_speederbike_2.disableMovement();
		$vehicle_speederbike_2.bind( $speeder_hangar_floor );
		$vehicle_speederbike_2.lock( 1 );
		
		$vehicle_speederbike_1.disableMovement();
		$vehicle_speederbike_1.bind( $speeder_hangar_floor );
		$vehicle_speederbike_1.disableWeapon();

		thread scitechMonsDown();
		thread spawnScitechDudes();
		
		thread setupLockedDoors();
				
		sys.fadeIn( '0 0 0', 2 );
		
		sys.trigger( $musicSubtle );
		$musicSubtle.fadeSound( SND_CHANNEL_ANY, -80, .1 );
		sys.wait( .1 );
		$musicSubtle.fadeSound( SND_CHANNEL_ANY, -6, 2 );
	}
	
	
