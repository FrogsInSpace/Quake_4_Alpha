	//--------------------------------------------------------------------------
	// Player getting to the turret, and the sequence
	//--------------------------------------------------------------------------
	void shipDamaged()
	{
		sys.trigger( $item_objectivefailed_2 );	
		
		$player1.enterVehicle( $turret );  //test
	}
	
	void monitorShipHealth()
	{
		float h = 20000;

		$mcc_2.setHealth( 20000 );
		
		while( 1 ) 
		{
			h = $mcc_2.getHealth();
			if( h <= 0 ) 
			{
				$turret.setGuiParm( "mcchealth", 0 );
				thread shipDamaged();
				return;
			}
			$turret.setGuiParm( "mcchealth", sys.floor( h/10 ) );
			sys.waitFrame();
		}
	}
	
	void turretOnline()
	{
		aiScriptedAnim( $turret, "intro", 4, 0 );
		sys.wait(2);
		$turret.enableWeapon();
	}
	
	void startTurretSpawners()
	{
		sys.wait(3);
		sys.trigger( $flyingTurretSpawner_1 );
		sys.wait(5);
		sys.trigger( $flyingTurretSpawner_3 );
		sys.wait(4);
		sys.trigger( $flyingTurretSpawner_2 );
	}
	
	void exitTurretSequence()
	{
		sys.trigger( $item_objectivecomplete_2 ); //Completed objective #2
		sys.fadeOut( '0 0 0', 1);
		sys.wait( 1 );
				
		thread setupRouteToHangar();

		$turret.lock( 0 );
		$player1.exitVehicle( 0 );
		sys.waitFrame();
		sys.trigger( $player_post_turret ); // info_player_teleport
		//$player1.setViewAngles ( '0 180 0' );
		//$player1.setOrigin( $target_player_post_turret.getOrigin() );
				
		sys.fadeIn( '0 0 0', 1);
	}
	
	void turretSequence()
	{
		sys.println("m06b::turretSequence()");
		
		if ( !SKIP_SAVEGAMES )
		{
			sys.trigger( $func_savegame_1 );
		}

		sys.trigger( $target_objectivebeacon_2 ); // turret area beacon off
		//sys.killthread("m06b::radioBattle");
		$player1.exitVehicle( 1 ); // exiting dummyTurret
		sys.waitFrame();

		if ( SKIP_TURRET_SEQUENCE ) 
		{
			sys.println("TURRET SEQUENCE BEING SKIPPED FOR THE TIME BEING OKAY");
			//Completed objective #2
			thread setupRouteToHangar();
			return;
		}
		
		sys.fadeOut( '0 0 0', 1);
		sys.wait(1);
		
		thread skyboxFighters();
		thread fighterGroup1();
		thread monitorShipHealth();
		
		$player1.enterVehicle( $turret );
		$dummyTurret.lock( 1 ); 
		//$turret.lock( 1 ); // uncomment for release
		sys.fadeIn( '0 0 0', 1);
		
		thread turretOnline();
		
		// markswell gives the rundown
		thread startTurretSpawners();
		
		// looping script that waits for player to complete obj01
		turret_obj01();
		
		// stop spawning plz
		spawnTurret1Fighters = 0;
		$flyingTurretSpawner_1.remove();
		$flyingTurretSpawner_2.remove();
		$flyingTurretSpawner_3.remove();
		
		thread exitTurretSequence(); // okay we're done
	}

	
