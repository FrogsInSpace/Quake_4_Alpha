}


void VO_marks_nowbadnews( entity ent )
{
 //Markswell: Now the bad news, we aren’t heading back to the MCC.  We’ve changed course to join up with a multiple unit task force to infiltrate the Strogg medlabs, prisons, and bio processing centers.    
 aiSpeakWait( ent, "lipsync_vo_marks_nowbadnews" );
}


