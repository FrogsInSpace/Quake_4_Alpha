}


void VO_nava_yeahwellwe( entity ent )
{
 //Navajas: Yeah, well, we accomplished the mission.  Speaking of which- Tak- what’s the verdict on that data we collected?  
 aiSpeakWait( ent, "lipsync_vo_nava_yeahwellwe" );
}


void VO_tak_sciconftac( entity ent )
{
 //Tak: Sci-tech confirmed what I suspected.  The data contains tactical information about the Strogg that nobody has seen before.  Most of it is encrypted.  They're trying to get in touch with Rhino Squad’s tech, Strauss.  He's one of 3 techs in the entire SMC that can decrypt Strogg data like this, and the only one that’s currently dirtside.  
 aiSpeakWait( ent, "lipsync_vo_tak_sciconftac" );
}


void VO_marks_goodbadworse( entity ent )
{
 //Markswell: Good news, bad news, and worse news gentlemen.    
 aiSpeakWait( ent, "lipsync_vo_marks_goodbadworse" );
}


void VO_marks_goodfirst( entity ent )
{
 //Markswell: Good news first, despite our losses, our mission to the Trianthinide facility was a success.  The facility was successfully destroyed and the data that we collected has perked the interests of SMC top brass.    
 aiSpeakWait( ent, "lipsync_vo_marks_goodfirst" );
}


void VO_darn_goodhobtakdek( entity ent )
{
 //Darnell: Good job Tak and Dekard!  
 aiSpeakWait( ent, "lipsync_vo_darn_goodhobtakdek" );
}


void VO_marks_worsenews( entity ent )
{
 //Markswell: Worse news, we just got word from the Hannibal, all four operation advantage EMP convoys were wiped out.  Most of the ground forces are captured or dead, and it would seem that the Strogg have replaced their leader with a new Makron.  
 aiSpeakWait( ent, "lipsync_vo_marks_worsenews" );
}


void VO_nava_what2( entity ent )
{
 //Navajas: What?!  
 aiSpeakWait( ent, "lipsync_vo_nava_what2" );
}


void VO_darn_whathellwar( entity ent )
{
