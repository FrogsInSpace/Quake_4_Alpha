}


void VO_mitch_holyshit( entity ent )
{
 //Mitchell: Holy shit?!   We committed more than half our ground forces to those objectives.  
 aiSpeakWait( ent, "lipsync_vo_mitch_holyshit" );
}


void VO_tak_straussconv( entity ent )
{
 //Tak: Strauss was in one of those convoys- without him, this data is worthless!  
 aiSpeakWait( ent, "lipsync_vo_tak_straussconv" );
}


void VO_marks_empeffortf( entity ent )
{
 //Markswell: That’s right, after the EMP effort failed, sci-tech turned to the data we collected and discovered fragments pointing to how the Strogg brought a new Makron online so quickly. Unfortunately the rest of the data is heavily encrypted; and since it was our find, we’ve been tasked with locating the only marine that can unlock the rest of this critical data.  
 aiSpeakWait( ent, "lipsync_vo_marks_empeffortf" );
}


void VO_tak_straussalive( entity ent )
{
