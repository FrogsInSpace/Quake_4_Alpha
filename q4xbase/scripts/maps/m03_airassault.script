///////////////////////////////////////////////////////////////
//  Skybox Functions                                         //
///////////////////////////////////////////////////////////////
void loopSkyboxTerrain()
{
	float a = 0;

	while( 1 ) {
		$terrain_1.time( 30 );
		$terrain_1.move( 180, 512 );
		$terrain_2.time( 30 );
		$terrain_2.move( 180, 512 );
		sys.waitFor( $terrain_1 );
		sys.waitFor( $terrain_2 );

		if( a == 1 ) {
			$skybox_bld_1.hide();
		}
		if( a == 2 ) {
			$skybox_bld_2.hide();
		}
		if( a == 3 ) {
			$skybox_bld_3.hide();
		}
		if( a == 4 ) {
			$skybox_bld_4.hide();
		}

		$terrain_1.hide();
		$terrain_1.time( 0.01 );
		$terrain_1.move( 360, 1024 );
		sys.waitFor( $terrain_1 );
		$terrain_1.show();

		a = randomRoundFloat(1, 10);
		if( a == 1 ) {
			$skybox_bld_1.show();
		}
		if( a == 2 ) {
			$skybox_bld_2.show();
		}
		if( a == 3 ) {
			$skybox_bld_3.show();
		}
		if( a == 4 ) {
			$skybox_bld_4.show();
		}

		$terrain_1.time( 30 );
		$terrain_1.move( 180, 512 );
		$terrain_2.time( 30 );
		$terrain_2.move( 180, 512 );
		sys.waitFor( $terrain_1 );
		sys.waitFor( $terrain_2 );
	
		$terrain_2.hide();
		$terrain_2.time( 0.01 );
		$terrain_2.move( 360, 1024 );
		sys.waitFor( $terrain_2 );
		$terrain_2.show();

		sys.waitFrame();
	}
}



///////////////////////////////////////////////////////////////
//  Turret Functions                                         //
///////////////////////////////////////////////////////////////
void hideInterior()
{
	if( DRIVER ) {
		return;
	}

	if( INTOPGUN ) {
		$ship_top_facade.show();
	}
	if( INBOTTOMGUN ) {
		$ship_bottom_facade.show();
	}

	if( !EVENT_FIRE_CARGO ) {
		$mitchell.hide();
		$wounded.hide();
	}

	$navajas.hide();
	$tak.hide();
	$ship_interior.hide();
	$ramp.hide();
	$cargodoor.hide();
	$rightdoor.hide();
	$leftdoor.hide();
	$box1.hide();
	$box2.hide();
	$box3.hide();
	$box4.hide();
	if( !CARGO_DUMPED ) {
		$cargo_crate_1.hide();
		$cargo_crate_2.hide();
	}
	$ammocrate.hide();
	$gui_arm_1.hide();
	$gui_arm_2.hide();
	$gui_arm_3.hide();
	$chair_light_static_flares.hide();
	$chair_light_wires.hide();
	$chair_light_statics_off.hide();
	$seat_light_1.Off();
	$seat_light_2.Off();
	$seat_light_3.Off();
	$seat_light_4.Off();
	$seat_light_5.Off();
	$ds_redlight_static_1.hide();
	$ds_redlight_rot_1.hide();
	$ds_redlight_1.Off();
	$ds_redlight_static_2.hide();
	$ds_redlight_rot_2.hide();
	$ds_redlight_2.Off();
	$takgui_1.hide();
	$takgui_2.hide();
	$forward_light.Off();
	$navajas_chair.hide();
	$tak_chair.hide();
	$empty_chair_1.hide();
	$tak_chair_side.hide();
	$empty_chair_3.hide();
	$empty_chair_4.hide();
	$dekard_chair.hide();
	$navajas_chair_side.hide();
	$mitchell_chair.hide();
	$darnell_chair.hide();
	$reargui.hide();
	$forwardgui.hide();
	$forwardgui_amb.hide();
	$engine_thrust_fx_1.hide();
	$engine_thrust_fx_2.hide();
	$ladder.hide();
	$ammostuff.hide();
	$nava_gui_1.hide();
	$nava_gui_2.hide();
	$nava_gui_arm_1.hide();
	$nava_gui_arm_2.hide();
	$nava_gui_arm_3.hide();
	$nava_gui_arm_4.hide();
}

void showInterior()
{
	if( DRIVER ) {
		return;
	}

	$ship_bottom_facade.hide();
	$ship_top_facade.hide();
	$ship_interior.show();
	$ramp.show();
	$cargodoor.show();
	$rightdoor.show();
	$leftdoor.show();
	if( !EVENT_FIRE_CARGO ) {
		$mitchell.show();
		$wounded.show();
	}

	$navajas.show();
	$tak.show();
	$box1.show();
	$box2.show();
	$box3.show();
	$box4.show();
	if( !CARGO_DUMPED ) {
		$cargo_crate_1.show();
		$cargo_crate_2.show();
	}
	$ammocrate.show();
	$gui_arm_1.show();
	$gui_arm_2.show();
	$gui_arm_3.show();;
	$chair_light_static_flares.show();
	$chair_light_wires.show();
	$chair_light_statics_off.show();
	$seat_light_1.On();
	$seat_light_2.On();
	$seat_light_3.On();
	$seat_light_4.On();
	$seat_light_5.On();
	$ds_redlight_static_1.show();
	$ds_redlight_rot_1.show();
	if( !INTROCIN ) {
		$ds_redlight_1.On();
		$ds_redlight_2.On();
	}
	$ds_redlight_static_2.show();
	$ds_redlight_rot_2.show();
	$takgui_1.show();
	$takgui_2.show();
	$forward_light.On();
	$navajas_chair.show();
	$tak_chair.show();
	$empty_chair_1.show();
	$tak_chair_side.show();
	$empty_chair_3.show();
	$empty_chair_4.show();
	$dekard_chair.show();
	$navajas_chair_side.show();
	$mitchell_chair.show();
	$darnell_chair.show();
	$reargui.show();
	$forwardgui.show();
	$forwardgui_amb.show();
	$engine_thrust_fx_1.show();
	$engine_thrust_fx_2.show();
	$ladder.show();
	$ammostuff.show();
	$nava_gui_1.show();
	$nava_gui_2.show();
	$nava_gui_arm_1.show();
	$nava_gui_arm_2.show();
	$nava_gui_arm_3.show();
	$nava_gui_arm_4.show();
}

void shipMovement( entity gun )
{
	float a;

	while( 1 ) {

		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}
		$dropship_mover.time( 1.5 );
		$dropship_mover.accelTime( 0.75 );
		$dropship_mover.decelTime( 0.75 );
		$dropship_mover.rotateOnce( '0 0 5' );
		sys.waitFor( $dropship_mover );
		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}
		$dropship_mover.time( 1.5 );
		$dropship_mover.accelTime( 0.75 );
		$dropship_mover.decelTime( 0.75 );
		$dropship_mover.rotateOnce( '0 0 -10' );
		sys.waitFor( $dropship_mover );
		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}
		$dropship_mover.time( 1.5 );
		$dropship_mover.accelTime( 0.75 );
		$dropship_mover.decelTime( 0.75 );
		$dropship_mover.rotateOnce( '0 0 10' );
		sys.waitFor( $dropship_mover );
		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}
		$dropship_mover.time( 1.5 );
		$dropship_mover.accelTime( 0.75 );
		$dropship_mover.decelTime( 0.75 );
		$dropship_mover.rotateOnce( '0 0 -5' );
		sys.waitFor( $dropship_mover );
		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}
		$dropship_mover.time( 1.5 );
		$dropship_mover.accelTime( 0.75 );
		$dropship_mover.decelTime( 0.75 );
		$dropship_mover.rotateOnce( '0 0 -5' );
		sys.waitFor( $dropship_mover );
		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}
		$dropship_mover.time( 1.5 );
		$dropship_mover.accelTime( 0.75 );
		$dropship_mover.decelTime( 0.75 );
		$dropship_mover.rotateOnce( '0 0 10' );
		sys.waitFor( $dropship_mover );
		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}
		$dropship_mover.time( 1.5 );
		$dropship_mover.accelTime( 0.75 );
		$dropship_mover.decelTime( 0.75 );
		$dropship_mover.rotateOnce( '0 0 -10' );
		sys.waitFor( $dropship_mover );
		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}
		$dropship_mover.time( 1.5 );
		$dropship_mover.accelTime( 0.75 );
		$dropship_mover.decelTime( 0.75 );
		$dropship_mover.rotateOnce( '0 0 5' );
		sys.waitFor( $dropship_mover );
		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}

		a = randomRoundFloat( 1, 8 );
		if( a == 1 && !PLAYER_EVENT_IN_PROGRESS && !NO_EVASIVES ) {				//Hard right tilt
			gun.lock( 1 );
			radioChatterPlay( $radiochatter_pilot, "vo_vansen_evasiv2" );		// %%%%%%%%%% VO %%%%%%%%%%
			$dropship_mover.time( 1 );
			$dropship_mover.accelTime( 0.3 );
			$dropship_mover.decelTime( 0.6 );
			$dropship_mover.rotateOnce( '0 0 45' );
			sys.waitFor( $dropship_mover );
			$dropship_mover.time( 1 );
			$dropship_mover.accelTime( 0.5 );
			$dropship_mover.decelTime( 0.5 );
			$dropship_mover.rotateOnce( '0 0 -55' );
			sys.waitFor( $dropship_mover );
			$dropship_mover.time( 1 );
			$dropship_mover.accelTime( 0.5 );
			$dropship_mover.decelTime( 0.5 );
			$dropship_mover.rotateOnce( '0 0 10' );
			sys.waitFor( $dropship_mover );
			gun.lock( 0 );
		}		

		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}

		if( a == 2 && !PLAYER_EVENT_IN_PROGRESS && !NO_EVASIVES ) {				//Hard left tilt
			gun.lock( 1 );
			radioChatterPlay( $radiochatter_pilot, "vo_vansen_evasiveman" );		// %%%%%%%%%% VO %%%%%%%%%%
			$dropship_mover.time( 1 );
			$dropship_mover.accelTime( 0.3 );
			$dropship_mover.decelTime( 0.6 );
			$dropship_mover.rotateOnce( '0 0 -45' );
			sys.waitFor( $dropship_mover );
			$dropship_mover.time( 1 );
			$dropship_mover.accelTime( 0.5 );
			$dropship_mover.decelTime( 0.5 );
			$dropship_mover.rotateOnce( '0 0 55' );
			sys.waitFor( $dropship_mover );
			$dropship_mover.time( 1 );
			$dropship_mover.accelTime( 0.5 );
			$dropship_mover.decelTime( 0.5 );
			$dropship_mover.rotateOnce( '0 0 -10' );
			sys.waitFor( $dropship_mover );
			gun.lock( 0 );
		}

		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}

		if( a == 3 && !PLAYER_EVENT_IN_PROGRESS && !NO_EVASIVES ) {				//Long, slow tilt right
			gun.lock( 1 );
			$dropship_mover.time( 3 );
			$dropship_mover.accelTime( 1 );
			$dropship_mover.decelTime( 1.5 );
			$dropship_mover.rotateOnce( '0 0 25' );
			sys.waitFor( $dropship_mover );
			$dropship_mover.time( 3 );
			$dropship_mover.accelTime( 1 );
			$dropship_mover.decelTime( 1.5 );
			$dropship_mover.rotateOnce( '0 0 -25' );
			sys.waitFor( $dropship_mover );
			gun.lock( 0 );
		}

		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}

		if( a == 4 && !PLAYER_EVENT_IN_PROGRESS && !NO_EVASIVES ) {				//Long, slow tilt left
			gun.lock( 1 );
			$dropship_mover.time( 3 );
			$dropship_mover.accelTime( 1 );
			$dropship_mover.decelTime( 1.5 );
			$dropship_mover.rotateOnce( '0 0 -25' );
			sys.waitFor( $dropship_mover );
			$dropship_mover.time( 3 );
			$dropship_mover.accelTime( 1 );
			$dropship_mover.decelTime( 1.5 );
			$dropship_mover.rotateOnce( '0 0 25' );
			sys.waitFor( $dropship_mover );
			gun.lock( 0 );
		}

		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}

		if( a == 5 && !PLAYER_EVENT_IN_PROGRESS && !NO_EVASIVES ) {				//Pitch nose down
			gun.lock( 1 );
			radioChatterPlay( $radiochatter_pilot, "vo_vansen_evasive3" );		// %%%%%%%%%% VO %%%%%%%%%%
			$dropship_mover.time( 2 );
			$dropship_mover.accelTime( 0.5 );
			$dropship_mover.decelTime( 1.4 );
			$dropship_mover.rotateOnce( '25 0 0' );
			sys.waitFor( $dropship_mover );
			$dropship_mover.time( 2 );
			$dropship_mover.accelTime( 0.5 );
			$dropship_mover.decelTime( 1.4 );
			$dropship_mover.rotateOnce( '-25 0 0' );
			sys.waitFor( $dropship_mover );
			gun.lock( 0 );
		}

		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}

		if( a == 6 && !PLAYER_EVENT_IN_PROGRESS && !NO_EVASIVES ) {				//Pitch nose up
			gun.lock( 1 );
			radioChatterPlay( $radiochatter_pilot, "vo_vansen_hangon" );		// %%%%%%%%%% VO %%%%%%%%%%
			$dropship_mover.time( 2 );
			$dropship_mover.accelTime( 0.5 );
			$dropship_mover.decelTime( 1.4 );
			$dropship_mover.rotateOnce( '-25 0 0' );
			sys.waitFor( $dropship_mover );
			$dropship_mover.time( 2 );
			$dropship_mover.accelTime( 0.5 );
			$dropship_mover.decelTime( 1.4 );
			$dropship_mover.rotateOnce( '25 0 0' );
			sys.waitFor( $dropship_mover );
			gun.lock( 0 );
		}

		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}

		if( a == 7 && !PLAYER_EVENT_IN_PROGRESS && !NO_EVASIVES ) {				//Pitch nose down & tilt left
			gun.lock( 1 );
			$dropship_mover.time( 2 );
			$dropship_mover.accelTime( 0.5 );
			$dropship_mover.decelTime( 1.4 );
			$dropship_mover.rotateOnce( '25 0 -15' );
			sys.waitFor( $dropship_mover );
			$dropship_mover.time( 2 );
			$dropship_mover.accelTime( 0.5 );
			$dropship_mover.decelTime( 1.4 );
			$dropship_mover.rotateOnce( '-25 0 15' );
			sys.waitFor( $dropship_mover );
			gun.lock( 0 );
		}

		if( !INBOTTOMGUN && !INTOPGUN ) {
			break;
		}

		if( a == 8 && !PLAYER_EVENT_IN_PROGRESS && !NO_EVASIVES ) {				//Pitch nose up & tilt right
			gun.lock( 1 );
			$dropship_mover.time( 2 );
			$dropship_mover.accelTime( 0.5 );
			$dropship_mover.decelTime( 1.4 );
			$dropship_mover.rotateOnce( '-25 0 15' );
			sys.waitFor( $dropship_mover );
			$dropship_mover.time( 2 );
			$dropship_mover.accelTime( 0.5 );
			$dropship_mover.decelTime( 1.4 );
			$dropship_mover.rotateOnce( '25 0 -15' );
			sys.waitFor( $dropship_mover );
			gun.lock( 0 );
		}

		sys.waitFrame();		
	} 
}

void topGunEntered()
{
	if( DRIVER ) {
		return;
	}
	INTOPGUN = true;

	sys.setcvar( "g_fov", "80" );

	sys.trigger( $comm_chatter );

	$dropship_mover.setAngles( '0 0 0' );

	thread hideInterior();
	$topgun.lock( 1 );
	$topgun.disableWeapon();
	sys.waitFrame();
	aiScriptedAnim( $topgun, "intro", 4, 0 );
	sys.wait( 2 );
	$topgun.enableWeapon();
	sys.waitFrame();
	$topgun.lock( 0 );
	thread shipMovement( $topgun );
}

void topGunExited()
{
	INTOPGUN = false;
	thread showInterior();
	sys.setcvar( "g_fov", "90" );
	sys.waitFrame();
	$topgun.lock( 1 );

	sys.trigger( $comm_chatter );

	aiScriptedAnimLoop( $topgun, "idle", 0 );
	sys.wait( 1 );
	$topgun.lock( 0 );
}

void bottomGunEntered()
{
	if( DRIVER ) {
		return;
	}
	INBOTTOMGUN = true;

	$ship_bottom_fill_light.On();
	sys.setcvar( "g_fov", "80" );

	$dropship_mover.setAngles( '0 0 0' );

	sys.trigger( $comm_chatter );

	thread hideInterior();
	$bottomgun.lock( 1 );
	$bottomgun.disableWeapon();
	sys.waitFrame();
	aiScriptedAnim( $bottomgun, "intro", 4, 0 );
	sys.wait( 2 );
	$bottomgun.enableWeapon();
	sys.waitFrame();
	$bottomgun.lock( 0 );
	thread shipMovement( $bottomgun );
}

void bottomGunExited()
{
	INBOTTOMGUN = false;
	thread showInterior();
	$ship_bottom_fill_light.Off();
	sys.setcvar( "g_fov", "90" );
	sys.waitFrame();
	$bottomgun.lock( 1 );

	sys.trigger( $comm_chatter );

	aiScriptedAnimLoop( $bottomgun, "idle", 0 );
	sys.wait( 1 );
	$bottomgun.lock( 0 );
}

///////////////////////////////////////////////////////////////
//  Ramp Functions                                           //
///////////////////////////////////////////////////////////////
void moveRampDown()
{
	RAMPACTIVE = true;
	sys.trigger( $ramp_open_speaker );
	sys.trigger( $wind1 );
	$ramp.time( 5 );
	$ramp.accelTime( 1 );
	$ramp.decelTime( 2 );
	$ramp.rotateOnce( '-40 0 0' );
	sys.waitFor( $ramp );
	RAMPUP = false;
	sys.wait( 0.5 );
	RAMPACTIVE = false;
}

void moveRampUp()
{
	RAMPACTIVE = true;
	sys.trigger( $ramp_close_speaker );
	$ramp.time( 5 );
	$ramp.accelTime( 1 );
	$ramp.decelTime( 2 );
	$ramp.rotateOnce( '40 0 0' );
	sys.waitFor( $ramp );
	RAMPUP = true;
	sys.trigger( $wind1 );

	sys.wait( 0.5 );
	RAMPACTIVE = false;
}

void toggleRamp()
{
	if( RAMPACTIVE ) {
		return;
	}

	if( RAMPUP ) {
		moveRampDown();
	}

	else {
		moveRampUp();
	}
}

///////////////////////////////////////////////////////////////
//  Friendly Ships Functions                                 //
