void wave3Fighter()
{
	WAVE3FIGHTER_ALIVE = true;
	sys.trigger( $wave3fighter_spawn );
	sys.waitFrame();
	$wave3fighter.setKey( "fx_death", "effects/monsters/flyer_space/q4x_explode_atmos.fx" );
	$wave3fighter_mover.time( 10 );
	$wave3fighter_mover.decelTime( 2 );
	$wave3fighter_mover.startSpline( $wave3fighter_spline );
	sys.waitFor( $wave3fighter_mover );

	while( WAVE3FIGHTER_ALIVE ) {
		if( WAVE3FIGHTER_ALIVE ) {
			sys.wait( 6 );
		}
		if( WAVE3FIGHTER_ALIVE ) {
			if( !PLAYER_EVENT_IN_PROGRESS ) {
				radioChatterPlayWait( $radiochatter, "vo_marks_dekfightt" );		// %%%%%%%%%% VO %%%%%%%%%%
