	if( isValidEntity( $friendly_dropship_2 ) ) {
		sys.trigger( $ds_2_launcher_1 );
		sys.trigger( $ds_2_launcher_2 );
	}

	if( isValidEntity( $friendly_dropship_3 ) ) {
		sys.trigger( $ds_3_launcher_1 );
		sys.trigger( $ds_3_launcher_2 );
	}
}

