{
	$friendly_dropship_3_mover.disableSplineAngles();

	while( 1 ) {
		$friendly_dropship_3_mover.time( 4 );
		$friendly_dropship_3_mover.startSpline( $friendly_dropship_3_spline );
		sys.waitFor( $friendly_dropship_3_mover );
		sys.waitFrame();
		if( FRIENDLY_3_KILL ) {
			break;
		}
	}

	FRIENDLY_3_READYTODIE = true;
}

void initFriendlies()
{
	$friendly_dropship_1.playCycle( ANIMCHANNEL_ALL, "idle_all_closed" );
	$friendly_dropship_2.playCycle( ANIMCHANNEL_ALL, "idle_all_closed" );
	$friendly_dropship_3.playCycle( ANIMCHANNEL_ALL, "idle_all_closed" );
	thread loopFriendlyDropshipOne();
	thread loopFriendlyDropshipTwo();
	thread loopFriendlyDropshipThree();
}

void killFriendlyDropship1()
{
	if( FRIENDLY_1_KILL ) {
		return;
	}
	FRIENDLY_1_KILL = true;

	while( !FRIENDLY_1_READYTODIE ) {
		sys.wait( 0.1 );
	}

	if( !PLAYER_EVENT_IN_PROGRESS ) {
		radioChatterPlayWait( $radiochatter, "vo_marks_eagle15hit" );		// %%%%%%%%%% VO %%%%%%%%%%
	}

	$ds_1_launcher_1.remove();
	$ds_1_launcher_2.remove();

	if( !PLAYER_EVENT_IN_PROGRESS ) {
		radioChatterPlay( $radiochatter, "vo_eagle15_wehitgodown" );		// %%%%%%%%%% VO %%%%%%%%%%
	}

	$friendly_dropship_1_mover.stopSpline();
	$friendly_dropship_1_death_mover.disableSplineAngles();
	$friendly_dropship_1_mover.bind( $friendly_dropship_1_death_mover );
	$friendly_dropship_1_death_mover.time( 8 );
	$friendly_dropship_1_death_mover.accelTime( 1 );
	$friendly_dropship_1_death_mover.decelTime( 0 );
	$friendly_dropship_1_death_mover.startSpline( $friendly_dropship_1_death_spline );
	$friendly_dropship_1_mover.rotate( '0 0 180' );
	sys.wait( 6.75 );

	if( !PLAYER_EVENT_IN_PROGRESS ) {
		//radioChatterPlay( $radiochatter, "vo_eagle15_shouting" );		// %%%%%%%%%% VO %%%%%%%%%%
		radioChatterPlay( $radiochatter, "vo_w_scream" );		// %%%%%%%%%% VO %%%%%%%%%%
	}

	sys.waitFor( $friendly_dropship_1_death_mover );

	sys.trigger( $friendly_dropship_1_deathfx_1 );
	sys.wait( 0.1 );
	sys.trigger( $friendly_dropship_1_deathfx_2 );

	sys.trigger( $friendly_dropship_1_enginefx_1 );
	$friendly_dropship_1_clip.remove();
	$friendly_dropship_1.remove();
	$friendly_dropship_1_mover.remove();
	$friendly_dropship_1_death_mover.remove();

	if( !PLAYER_EVENT_IN_PROGRESS ) {
		radioChatterPlay( $radiochatter, "vo_marks_eagle15dest" );		// %%%%%%%%%% VO %%%%%%%%%%
	}
}

void killFriendlyDropship2()
{
	if( FRIENDLY_2_KILL ) {
		return;
	}
	FRIENDLY_2_KILL = true;

	while( !FRIENDLY_2_READYTODIE ) {
		sys.wait( 0.1 );
	}

	if( !PLAYER_EVENT_IN_PROGRESS ) {
		radioChatterPlayWait( $radiochatter, "vo_raven8_shitfire" );		// %%%%%%%%%% VO %%%%%%%%%%
	}

	$ds_2_launcher_1.remove();
	$ds_2_launcher_2.remove();

	$friendly_dropship_2_mover.stopSpline();
	$friendly_dropship_2_death_mover.disableSplineAngles();
	$friendly_dropship_2_death_mover.removeInitialSplineAngles();
	$friendly_dropship_2_mover.bind( $friendly_dropship_2_death_mover );
	$friendly_dropship_2_death_mover.time( 8 );
	$friendly_dropship_2_death_mover.accelTime( 1 );
	$friendly_dropship_2_death_mover.decelTime( 0 );
	$friendly_dropship_2_death_mover.startSpline( $friendly_dropship_2_death_spline );
	$friendly_dropship_2_mover.rotate( '0 0 -90' );
	sys.wait( 1 );

	if( !PLAYER_EVENT_IN_PROGRESS ) {
		radioChatterPlay( $radiochatter, "vo_markswell_raven8com" );		// %%%%%%%%%% VO %%%%%%%%%%
	}

	sys.wait( 2 );

	if( !PLAYER_EVENT_IN_PROGRESS ) {
		radioChatterPlay( $radiochatter, "vo_raven8_die" );		// %%%%%%%%%% VO %%%%%%%%%%
	}

	sys.wait( 3 );

	if( !PLAYER_EVENT_IN_PROGRESS ) {
		radioChatterPlay( $radiochatter, "vo_makrs_exploraven8" );		// %%%%%%%%%% VO %%%%%%%%%%
	}

	sys.waitFor( $friendly_dropship_2_death_mover );

	sys.trigger( $friendly_dropship_2_deathfx_1 );
	sys.wait( 0.1 );
	sys.trigger( $friendly_dropship_2_deathfx_2 );

	sys.trigger( $friendly_dropship_2_smokefx );
	$friendly_dropship_2_enginefx_1.remove();
	$friendly_dropship_2_enginefx_2.remove();
	$friendly_dropship_2_clip.remove();
	$friendly_dropship_2.remove();
	$friendly_dropship_2_mover.remove();
	$friendly_dropship_2_death_mover.remove();
}

void killFriendlyDropship3()
{
	if( FRIENDLY_3_KILL ) {
		return;
	}
	FRIENDLY_3_KILL = true;

	while( !FRIENDLY_3_READYTODIE ) {
		sys.wait( 0.1 );
	}

	$ds_3_launcher_1.remove();
	$ds_3_launcher_2.remove();

	//Kamikaze
	$kamikaze.removeInitialSplineAngles();
	$kamikaze.disableSplineAngles();
