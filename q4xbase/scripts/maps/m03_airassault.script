///////////////////////////////////////////////////////////////
//  GUI console                                              //
///////////////////////////////////////////////////////////////
void playerGUILights()
{
	if( LIGHTS_ON ) {
		$white_ship_light.Off();
		$chair_light_static_flares.setColor( 0, 0, 0 );
		$seat_light_1.Off();
		$seat_light_2.Off();
		$seat_light_3.Off();
		$seat_light_4.Off();
		$seat_light_5.Off();
		$ds_redlight_1.Off();
		$ds_redlight_2.Off();
		$ds_redlight_rot_flare_1.hide();
		$ds_redlight_rot_flare_2.hide();
		$player_console_light.Off();
		$player_console_static.setColor( 0, 0, 0 );
		$tak_console_light.Off();
		$tak_console_static.setColor( 0, 0, 0 );
		LIGHTS_ON = false;
	}
	else {
		if( REDALERT ) {
			$chair_light_static_flares.setColor( 0.5, 0.03, 0 );	//red
		}
		else {
			$chair_light_static_flares.setColor( 0.6, 1, 0.9 );	//bluegreen
		}
		$seat_light_1.On();
		$seat_light_2.On();
		$seat_light_3.On();
		$seat_light_4.On();
		$seat_light_5.On();
		$white_ship_light.On();
		$ds_redlight_1.On();
		$ds_redlight_2.On();
		$ds_redlight_rot_flare_1.show();
		$ds_redlight_rot_flare_2.show();
		$player_console_light.On();
		$player_console_static.setColor( 1, 0.73, 0.34 );
		$tak_console_light.On();
		$tak_console_static.setColor( 1, 0.73, 0.34 );
		LIGHTS_ON = true;
	}
}

///////////////////////////////////////////////////////////////
//  GUI on arm by ramp                                       //
///////////////////////////////////////////////////////////////

void gui_arm_screen_rotate()
{
	$gui_arm_screen_mover.time( 1.5 );
	$gui_arm_screen_mover.rotateOnce( '0 180 0' );
	sys.waitFor( $reargui );
}

void gui_arm_screen_rotate_reverse()
{
	$gui_arm_screen_mover.time( 1.5 );
	$gui_arm_screen_mover.rotateOnce( '0 -180 0' );
	sys.waitFor( $reargui );
}

void gui_arm_extend()
{
	thread gui_arm_screen_rotate();
	sys.trigger( $reargui_speaker );
	$gui_arm_1.time( 1 );
	$gui_arm_1.accelTime( 0.1 );
	$gui_arm_1.decelTime( 0.1 );
	$gui_arm_2.time( 1 );
	$gui_arm_2.accelTime( 0.1 );
	$gui_arm_2.decelTime( 0.1 );
	$gui_arm_1.rotateOnce( '0 90 0' );
	$gui_arm_2.rotateOnce( '0 0 -180' );
	sys.waitFor( $gui_arm_1 );
	sys.waitFor( $gui_arm_2 );

	$gui_arm_2.time( 0.5 );
	$gui_arm_2.accelTime( 0.1 );
	$gui_arm_2.decelTime( 0.1 );
	$gui_arm_2.rotateOnce( '0 0 25' );
	sys.waitFor( $gui_arm_2 );

	$reargui.setGuiParm( "noninteractive", 0 );
}

void gui_arm_retract()
{
	$reargui.setGuiParm( "noninteractive", 1 );

	thread gui_arm_screen_rotate_reverse();
	sys.trigger( $reargui_speaker );
	$gui_arm_2.time( 0.5 );
	$gui_arm_2.accelTime( 0.1 );
	$gui_arm_2.decelTime( 0.1 );
	$gui_arm_2.rotateOnce( '0 0 -25' );
	sys.waitFor( $gui_arm_2 );

	$gui_arm_1.time( 1 );
	$gui_arm_1.accelTime( 0.1 );
	$gui_arm_1.decelTime( 0.1 );
	$gui_arm_2.time( 1 );
	$gui_arm_2.accelTime( 0.1 );
	$gui_arm_2.decelTime( 0.1 );
	$gui_arm_1.rotateOnce( '0 -90 0' );
	$gui_arm_2.rotateOnce( '0 0 180' );
	sys.waitFor( $gui_arm_1 );
	sys.waitFor( $gui_arm_2 );
}

///////////////////////////////////////////////////////////////
//  Player Fell out                                          //
///////////////////////////////////////////////////////////////
void playerFalling()
{
	$player1.disableWeapon();
	sys.fadeOut( '1 0 0', 1 );
	sys.wait( 1.5 );
	$player1.bind( $drop_ship );
	sys.trigger( $item_objectivefailed_1 );
}

///////////////////////////////////////////////////////////////
//  Dropship health monitoring                               //
///////////////////////////////////////////////////////////////
void shipImpactEffectLight()
{
	if( WAVE == 1 || WAVE == 2 ) {
		sys.trigger( $amb_shake_low );
	}
	if( WAVE == 3 || WAVE == 4 ) {
		sys.trigger( $amb_shake_med );
	}
	if( WAVE == 5 ) {
		sys.trigger( $amb_shake_high );
	}

	sys.waitFrame();
	sys.trigger( $ship_hit_shake );
	sys.wait( 1 );

	if( WAVE == 1 || WAVE == 2 ) {
		sys.trigger( $amb_shake_low );
	}
	if( WAVE == 3 || WAVE == 4 ) {
		sys.trigger( $amb_shake_med );
	}
	if( WAVE == 5 ) {
		sys.trigger( $amb_shake_high );
	}
}

void shipImpactEffectHeavy()
{
	if( WAVE == 1 || WAVE == 2 ) {
		sys.trigger( $amb_shake_low );
	}
	if( WAVE == 3 || WAVE == 4 ) {
		sys.trigger( $amb_shake_med );
	}
	if( WAVE == 5 ) {
		sys.trigger( $amb_shake_high );
	}

	sys.waitFrame();
	sys.trigger( $ship_hit_shake_heavy );
	sys.wait( 0.5 );
	aiScriptedAnim( $bottomgun, "impact_heavy", 4, 0 );
	aiScriptedAnim( $topgun, "impact_heavy", 4, 0 );

	sys.wait( 1 );

	if( WAVE == 1 || WAVE == 2 ) {
		sys.trigger( $amb_shake_low );
	}
	if( WAVE == 3 || WAVE == 4 ) {
		sys.trigger( $amb_shake_med );
	}
	if( WAVE == 5 ) {
		sys.trigger( $amb_shake_high );
	}
}

void dropshipDead()
{
	sys.trigger( $item_objectivefailed_1 );
}

void dropshiphealthcheck()
{
	float h = DROPSHIP_HEALTH;	//current health
	float p = DROPSHIP_HEALTH;	//previous health
	float d;			//difference

	$drop_ship.setHealth( DROPSHIP_HEALTH );
 
	while( 1 ) {

		h = $drop_ship.getHealth();

		d = ( p - h );

		if( d >= 1 && d <= 30) {
			thread shipImpactEffectLight();
		}

		if( d >= 75 ) {
			thread shipImpactEffectHeavy();
		}

		p = h;		

		if( (h + DSHEALTHADD) <= 0 ) {
			//$topgun.setGuiParm( "shealth", 0 );
			//$bottomgun.setGuiParm( "shealth", 0 );
			thread dropshipDead();
			break;
		}

		if( h <= GLOBAL_DS_HEALTH_SEVENTYFIVE && !WARN_SEVENTYFIVE_PERCENT ) {
			WARN_SEVENTYFIVE_PERCENT = true;
			if( !PLAYER_EVENT_IN_PROGRESS ) {
				radioChatterPlay( $radiochatter, "vo_minordamtoseconday" );	//%%%%%%%% VO %%%%%%%%%%
			}
		}

		if( h <= GLOBAL_DS_HEALTH_FIFTY && !WARN_FIFTY_PERCENT ) {
			WARN_FIFTY_PERCENT = true;
			if( !PLAYER_EVENT_IN_PROGRESS ) {
				radioChatterPlayWait( $radiochatter, "vo_tak_powersysst" );	//%%%%%%%% VO %%%%%%%%%%
				radioChatterPlay( $radiochatter, "vo_tak_wehavemajdam" );	//%%%%%%%% VO %%%%%%%%%%
			}
		}

		if( h <= GLOBAL_DS_HEALTH_TWENTYFIVE && !WARN_TWENTYFIVE_PERCENT ) {
			WARN_TWENTYFIVE_PERCENT = true;
			if( !PLAYER_EVENT_IN_PROGRESS ) {
				radioChatterPlay( $radiochatter, "vo_tak_damagelevcrty" );	//%%%%%%%% VO %%%%%%%%%%
			}
		}

		//Update the GUI status
		if( h <= GLOBAL_DS_HEALTH_80 && !GUI_80 ) {
			sys.sendNamedEvent( GUI_VEHICLEHUD, "ship_health_01_on" );
			sys.sendNamedEvent( GUI_PLAYERHUD, "ship_health_01_on" );
			GUI_80 = true ;
		}
		if( h <= GLOBAL_DS_HEALTH_60 && !GUI_60 ) {
			sys.sendNamedEvent( GUI_VEHICLEHUD, "ship_health_02_on" );
			sys.sendNamedEvent( GUI_PLAYERHUD, "ship_health_02_on" );
			GUI_60 = true ;
		}
		if( h <= GLOBAL_DS_HEALTH_40 && !GUI_40 ) {
			sys.sendNamedEvent( GUI_VEHICLEHUD, "ship_health_03_on" );
			sys.sendNamedEvent( GUI_PLAYERHUD, "ship_health_03_on" );
			GUI_40 = true ;
		}
		if( h <= GLOBAL_DS_HEALTH_20 && !GUI_20 ) {
			sys.sendNamedEvent( GUI_VEHICLEHUD, "ship_health_04_on" );
			sys.sendNamedEvent( GUI_PLAYERHUD, "ship_health_04_on" );
			GUI_20 = true ;
		}
		if( h <= GLOBAL_DS_HEALTH_10 && !GUI_10 ) {
			sys.sendNamedEvent( GUI_VEHICLEHUD, "ship_health_05_on" );
			sys.sendNamedEvent( GUI_PLAYERHUD, "ship_health_05_on" );
			GUI_10 = true ;
		}

		//$topgun.setGuiParm( "shealth", h );
		//$bottomgun.setGuiParm( "shealth", h );

		sys.wait( 0.1 );
	}
}

///////////////////////////////////////////////////////////////
//  Spawning ships on splines                                //
///////////////////////////////////////////////////////////////
void stroggKilledFeedback( entity self, entity killer )
{
	float i;

	STROGG_WAVE_SHIP_COUNTER--;

	//sys.println( self.getName() + " " + killer.getName() );


	//Wave 1
	if( killer == $player1 && WAVE == 1 ) {
		self.setKey( "fx_death", "effects/monsters/flyer_space/q4x_explode_atmos.fx" );
		WAVE1_PLAYERKILLS++;
		TOTAL_PLAYER_KILLS++;
	}

	//Wave 2
	if( killer == $player1 && WAVE == 2 ) {
		self.setKey( "fx_death", "effects/monsters/flyer_space/q4x_explode_atmos.fx" );
		WAVE2_PLAYERKILLS++;
		TOTAL_PLAYER_KILLS++;
	}

	//Wave 3
	if( killer == $player1 && WAVE == 3 ) {
		self.setKey( "fx_death", "effects/monsters/flyer_space/q4x_explode_atmos.fx" );
		WAVE3_PLAYERKILLS++;
		TOTAL_PLAYER_KILLS++;
	}

	//Wave 4
	if( killer == $player1 && WAVE == 4 ) {
		self.setKey( "fx_death", "effects/monsters/flyer_space/q4x_explode_atmos.fx" );
		WAVE4_PLAYERKILLS++;
		TOTAL_PLAYER_KILLS++;
	}

	//Wave 5
	if( killer == $player1 && WAVE == 5 ) {
		self.setKey( "fx_death", "effects/monsters/flyer_space/q4x_explode_atmos.fx" );
		WAVE5_PLAYERKILLS++;
		TOTAL_PLAYER_KILLS++;
	}

	if( killer == $topgun_driver || killer == $bottomgun_driver ) {
		self.setKey( "fx_death", "effects/monsters/flyer_space/q4x_explode_atmos.fx" );
	}

	//Darnell feedback
	i = randomRoundFloat(1, 50);
	if( i == 2 && !PLAYER_EVENT_IN_PROGRESS ) {
		radioChatterPlay( $radiochatter_pilot, "vo_darn_watchtarg" );		// %%%%%%%%%% VO %%%%%%%%%%		
	}
	if( i == 3 && !PLAYER_EVENT_IN_PROGRESS ) {
		radioChatterPlay( $radiochatter_pilot, "vo_darn_flydown" );		// %%%%%%%%%% VO %%%%%%%%%%		
	}
	if( i == 4 && !PLAYER_EVENT_IN_PROGRESS ) {
		radioChatterPlay( $radiochatter_pilot, "vo_darn_threemore" );		// %%%%%%%%%% VO %%%%%%%%%%		
	}
}

