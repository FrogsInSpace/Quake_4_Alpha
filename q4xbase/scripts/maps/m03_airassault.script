void causeCargoFire()
{
	sys.trigger( $fire_on_1 );
	sys.trigger( $fire_on_2 );
	sys.trigger( $func_fire_volume_1 );
	sys.trigger( $func_fire_volume_2 );
	$cargo_smolder_1.show();
	$cargo_smolder_2.show();

	EVENT_FIRE_CARGO = true;
}

void cargoFireInit()
{
	STARTED_CARGO_FIRE_SEQ = true;
	PLAYER_EVENT_IN_PROGRESS = true;

	$mitchell.hide();
	$wounded.hide();
	$mitchell_helping.show();
	$wounded_ground.show();
	$mitchell_helping.hideSurface("models/weapons/mp_guns/w_mg_lo"); 
	$wounded_ground.hideSurface("models/weapons/mp_guns/w_mg_lo");

	$mitchell_helping.setTalkState( TALK_BUSY );
	$wounded_ground.setTalkState( TALK_BUSY );

	aiScriptedAnimLoop( $mitchell_helping, "medic_treating1", 0 );
	aiScriptedAnimLoop( $wounded_ground, "ad_wounded_on_knee_loop", 0 );

	$mitchell_chair.playAnim( ANIMCHANNEL_ALL, "sitting_to_idle" );
	$empty_chair_4.playAnim( ANIMCHANNEL_ALL, "sitting_to_idle" );
	
	thread causeCargoFire();
	sys.sendNamedEvent( GUI_VEHICLEHUD, "ship_target_02_on" );

	radioChatterPlayWait( $radiochatter, "vo_tak_nastyfire" );		// %%%%%%%%%% VO %%%%%%%%%%
	sys.wait( 1 );
	radioChatterPlayWait( $radiochatter, "vo_tak_firespread" );		// %%%%%%%%%% VO %%%%%%%%%%
	sys.wait( 2 );
	radioChatterPlayWait( $radiochatter, "vo_tak_holyshit2" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_mitch_trianthrupt" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_mitch_damnrazor" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_marks_takhitsupp" );	// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_tak_suppdead" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlay( $radiochatter, "vo_marks_taktact" );		// %%%%%%%%%% VO %%%%%%%%%%

	sys.trigger( $cargo_smoke_hurt );

	EVENT_FIRE_CARGO = true;
	thread timeCargoFire();
	sys.trigger( $item_objective_3 );

	while( INBOTTOMGUN ) {
		sys.wait( 0.5 );
	}

	sys.sendNamedEvent( GUI_PLAYERHUD, "ship_target_02_on" );
	$player1.enableWeapon();
}

//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//AMMO JAM
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++

void monitorAmmoJam()
{
	while( !AMMO_JAM_FIXED ) {
		sys.wait( 0.5 );
	}

	$topgun.enableWeapon();
	$topgun.enableMovement();
}

void ammoNavajasInstruct()
{
	radioChatterPlayWait( $radiochatter, "vo_nava_okdekon3" );		// %%%%%%%%%% VO %%%%%%%%%%
	sys.wait( 0.1 );
	NAVAJAS_READY_AMMO = true;
}

void ammoUnjam()
{
	thread gui_arm_retract();

	AMMO_JAM_FIXED = true;
	EVENT_AMMO = false;
	$topgun.guiEvent( "JammedTextOff" );
	$reargui.startSoundShader( "space_cannon_jamcleared", SND_CHANNEL_ANY );
	DSHEALTHADD+=2000;

	radioChatterPlayWait( $radiochatter, "vo_nava_lookinggood" );		// %%%%%%%%%% VO %%%%%%%%%%

	sys.trigger( $item_objectivecomplete_4 );

	sys.sendNamedEvent( GUI_PLAYERHUD, "ship_target_01_off" );

	//sys.music( "m03_medium1" );								// ====######## MUSIC #########====
	sys.trigger( $musicevent );
	sys.trigger( $musicmedium1 );

	sys.wait( 4 );
	radioChatterPlayWait( $radiochatter, "vo_nava_jamisfree" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_darn_firingweback" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_marks_dekmovetopt" );		// %%%%%%%%%% VO %%%%%%%%%%

	while( !INTOPGUN ) {
		if( !INTOPGUN ) {
			sys.wait( 7 );
		}
		if( !INTOPGUN ) {
			radioChatterPlayWait( $radiochatter, "vo_marks_movedek2" );		// %%%%%%%%%% VO %%%%%%%%%%
		}
	}

	PLAYER_EVENT_IN_PROGRESS = false;
	sys.wait( 0.1 );
	sys.sendNamedEvent( GUI_VEHICLEHUD, "ship_target_01_off" );
}

void ammoJamInit()
{
	STARTED_AMMO_JAM_SEQ = true;
	EVENT_AMMO = true;

	PLAYER_EVENT_IN_PROGRESS = true;

	$topgun.disableWeapon();
	$topgun.disableMovement();
	$topgun.guiEvent( "JammedTextOn" );
	$topgun.startSoundShader( "space_cannon_jam", SND_CHANNEL_ANY );
	sys.wait( 1.5 );
	$topgun.startSoundShader( "vo_computer_munitjam", SND_CHANNEL_ANY );	// %%%%%%%%%% VO %%%%%%%%%%
	sys.wait( 2 );
	radioChatterPlayWait( $radiochatter, "vo_darn_shitgunsdead" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_nava_feedjam" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_marks_dekhelpnavfe" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlay( $radiochatter, "vo_darn_sittduck" );		// %%%%%%%%%% VO %%%%%%%%%%

	sys.sendNamedEvent( GUI_VEHICLEHUD, "ship_target_01_on" );

	sys.trigger( $item_objective_4 );

	while( INTOPGUN ) {
		if( INTOPGUN ) {
			sys.wait( 3 );
		}
		if( INTOPGUN ) {
			radioChatterPlay( $radiochatter, "vo_marks_getfeednow" );		// %%%%%%%%%% VO %%%%%%%%%%
		}
	}

	sys.sendNamedEvent( GUI_PLAYERHUD, "ship_target_01_on" );

	radioChatterPlayWait( $radiochatter_pilot, "vo_vansen_whatquick" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlay( $radiochatter, "vo_nava_detammofeed" );		// %%%%%%%%%% VO %%%%%%%%%%
	thread gui_arm_extend();
	thread ammoNavajasInstruct();
	thread monitorAmmoJam();
	NAVAJAS_READY_AMMO = false;
}

void ammoGuiUse()
{
	if( !EVENT_AMMO ) {
		return;
	}

	if( !NAVAJAS_READY_AMMO ) {
		$reargui.startSoundShader( "space_cannon_jam", SND_CHANNEL_ANY );
		radioChatterPlayWait( $radiochatter, "vo_nava_dammwaitsig" );		// %%%%%%%%%% VO %%%%%%%%%%
		sys.wait( 0.2 );
		thread ammoNavajasInstruct();
	}
	if( NAVAJAS_READY_AMMO ) {
		thread ammoUnjam();
	}
}

//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//ENGINE FIRE
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++
void timeEngineFire()
{
	sys.wait( 5 );
	sys.trigger( $enginesmoke_fx_1 );
	sys.wait( 7 );
	sys.trigger( $enginesmoke_fx_2 );
	sys.wait( 40 );

	if( ENGINE_FIRE_OUT ) {
		return;
	}

	sys.trigger( $item_objectivefailed_1 );
}

void engineFireOut()
{
	if( !EVENT_ENGINE ) {
		return;
	}

	if( ENGINE_STEP_1 ) {
		ENGINE_STEP_1 = false;
		ENGINE_STEP_2 = true;

		sys.trigger( $enginefire_fx_1 );
		sys.trigger( $enginefire_fx_2 );
		sys.trigger( $enginefire_fx_3 );
		$enginesmoke_fx_1.remove();
		$enginesmoke_fx_2.remove();

		$engine_thrust_fx_1.hide();

		$forwardgui.guiEvent( "enginestep1" );
		sys.waitFrame();
		$forwardgui.setGuiParm( "noninteractive", 1 );
		radioChatterPlayWait( $radiochatter, "vo_vansen_okport" );		// %%%%%%%%%% VO %%%%%%%%%%
		sys.wait( 2 );
		radioChatterPlayWait( $radiochatter, "vo_vansen_reactclr" );		// %%%%%%%%%% VO %%%%%%%%%%
		$forwardgui.guiEvent( "enginestep2" );
		radioChatterPlay( $radiochatter, "vo_vansen_pressengag" );		// %%%%%%%%%% VO %%%%%%%%%%
		$forwardgui.setGuiParm( "noninteractive", 0 );

		while( EVENT_ENGINE ) {
			if( EVENT_ENGINE ) {
				sys.wait( 5 );
			}
			if( EVENT_ENGINE ) {
				radioChatterPlayWait( $radiochatter, "vo_marks_dekprsseng" );		// %%%%%%%%%% VO %%%%%%%%%%
			}
			if( EVENT_ENGINE ) {
				sys.wait( 3 );
			}
			if( EVENT_ENGINE ) {
				radioChatterPlayWait( $radiochatter, "vo_marks_deknow" );		// %%%%%%%%%% VO %%%%%%%%%%
			}
		}
	}

	if( ENGINE_STEP_2 ) {
		EVENT_ENGINE = false;
		ENGINE_FIRE_OUT = true;

		sys.sendNamedEvent( GUI_PLAYERHUD, "ship_target_04_off" );

		$forwardgui.startSoundShader( "dropship_gaineng", SND_CHANNEL_ANY );
		sys.wait( 1 );
		$engine_thrust_fx_1.show();
		sys.waitFrame();
		$forwardgui.guiEvent( "enginenormal" );
		sys.waitFrame();
		radioChatterPlayWait( $radiochatter, "vo_vansen_portenginback" );		// %%%%%%%%%% VO %%%%%%%%%%
		sys.waitFrame();
		radioChatterPlayWait( $radiochatter, "vo_marks_grtworkdek" );		// %%%%%%%%%% VO %%%%%%%%%%
		DSHEALTHADD+=1000;
		sys.trigger( $item_objectivecomplete_5 );
		//sys.music( "m03_fast1" );								// ====######## MUSIC #########====
		sys.trigger( $musicevent );
		sys.trigger( $musicfast1 );

		while( !INTOPGUN ) {
			if( !INTOPGUN ) {
				sys.wait( 7 );
			}
			if( !INTOPGUN ) {
				radioChatterPlayWait( $radiochatter, "vo_marks_dekmovetopt" );		// %%%%%%%%%% VO %%%%%%%%%%
			}
		}

		PLAYER_EVENT_IN_PROGRESS = false;
		sys.wait( 0.1 );
		sys.sendNamedEvent( GUI_VEHICLEHUD, "ship_target_04_off" );
	}
}

void engineFireInit()
{
	STARTED_ENGINE_FIRE_SEQ = true;
	EVENT_ENGINE = true;
	PLAYER_EVENT_IN_PROGRESS = true;

	sys.trigger( $enginefire_fx_1 );
	sys.trigger( $enginefire_fx_2 );
	sys.trigger( $enginefire_fx_3 );

	sys.sendNamedEvent( GUI_VEHICLEHUD, "ship_target_04_on" );

	$topgun.startSoundShader( "dropship_loseeng", SND_CHANNEL_ANY );
	sys.wait( 1 );
	radioChatterPlayWait( $radiochatter, "vo_vansen_shitportract" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_marks_dekgettosec" );		// %%%%%%%%%% VO %%%%%%%%%%
	sys.trigger( $item_objective_5 );
	radioChatterPlayWait( $radiochatter, "vo_vansen_portfail" );		// %%%%%%%%%% VO %%%%%%%%%%

	thread timeEngineFire();

	while( INTOPGUN ) {
		if( INTOPGUN ) {
			sys.wait( 7 );
		}
		if( INTOPGUN ) {
			radioChatterPlayWait( $radiochatter, "vo_marks_dekgetengin" );		// %%%%%%%%%% VO %%%%%%%%%%
		}
	}

	sys.sendNamedEvent( GUI_PLAYERHUD, "ship_target_04_on" );
}

