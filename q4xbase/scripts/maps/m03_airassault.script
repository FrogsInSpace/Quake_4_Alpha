	sys.trigger( $kamikaze_smoke_fx );
	$kamikaze.time( 4 );
	$kamikaze.accelTime( 1 );
	$kamikaze.rotateOnce( '1024 0 0' );
	$kamikaze.startSpline( $kamikaze_spline );
	sys.waitFor( $kamikaze );
	$kamikaze_smoke_fx.remove();	
	$kamikaze.remove();	

	sys.trigger( $friendly_dropship_3_deathfx_1 );
	sys.wait( 0.1 );
	sys.trigger( $friendly_dropship_3_deathfx_2 );

	$friendly_dropship_3_clip.remove();
	$friendly_dropship_3.remove();
	$friendly_dropship_3_mover.remove();

	if( !PLAYER_EVENT_IN_PROGRESS ) {
		radioChatterPlay( $radiochatter, "vo_marks_23isgone" );		// %%%%%%%%%% VO %%%%%%%%%%
	}
}

///////////////////////////////////////////////////////////////
//  Player Special Actions                                   //
///////////////////////////////////////////////////////////////

//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//REAR FIRE
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++
void spreadRearFire()
{
	sys.wait( 5 );

	for(t=2;t<=7;t++) {
		n = sys.getEntity( "rearfire_fx_" + t );
		sys.wait( 3.5 );
		sys.trigger( n );

		if( t == 4 ) {
			radioChatterPlayWait( $radiochatter, "vo_nava_firegrow" );		// %%%%%%%%%% VO %%%%%%%%%%
		}

		if( t == 6 ) {
			radioChatterPlayWait( $radiochatter, "vo_marks_dekfirectrln" );		// %%%%%%%%%% VO %%%%%%%%%%
		}

		if( FIRE_SUPRESSED ) {
			return;
		}
	}

	sys.trigger( $navajas_fire_launcher );
}

void fireSurpressionRear()
{
	if( !EVENT_FIRE_REAR ) {
		return;
	}

	for(f=1;f<=6;f++) {
		e = sys.getEntity( "rear_supression_fx_" + f );
		sys.trigger( e );
	}

	FIRE_SUPRESSED = true;
	$forwardgui.startSoundShader( "fire_suppress_sys", SND_CHANNEL_ANY );
	radioChatterPlay( $radiochatter, "vo_marks_goodbackbell" );		// %%%%%%%%%% VO %%%%%%%%%%

	DSHEALTHADD+=5000;

	sys.wait( 2 );

	for(f=1;f<=7;f++) {
		e = sys.getEntity( "rearfire_fx_" + f );
		e.remove();
	}

	sys.wait( 2 );

	for(f=1;f<=6;f++) {
		e = sys.getEntity( "rear_supression_fx_" + f );
		e.remove();
	}

	sys.sendNamedEvent( GUI_PLAYERHUD, "ship_target_04_off" );

	sys.trigger( $item_objectivecomplete_2 );

	//sys.music( "m03_slow1" );								// ====######## MUSIC #########====
	sys.trigger( $musicevent );
	sys.trigger( $musicslow1 );

	radioChatterPlayWait( $radiochatter, "vo_mitch_navayouneedmed" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_nava_firedidnt" );		// %%%%%%%%%% VO %%%%%%%%%%

	while( !INBOTTOMGUN ) {
		sys.wait( 0.5 );
	}

	PLAYER_EVENT_IN_PROGRESS = false;
	sys.wait( 0.1 );
	sys.sendNamedEvent( GUI_VEHICLEHUD, "ship_target_04_off" );
}

void spinNavajasAroundforFire()
{
	aiScriptedFaceWait( $navajas, $navajas_turnaround, 0 );
	$navajas_chair.playCycle( ANIMCHANNEL_ALL, "fire" );
	aiScriptedAnimLoop( $navajas, "aa_back_chair_fire", 0 );
}

void causeRearFire()
{
	thread spinNavajasAroundforFire();

	while ( !FIRE_SUPRESSED ) {
		sys.wait( 1 );
	}

	$navajas_chair.playCycle( ANIMCHANNEL_ALL, "sitting_idle" );
	aiScriptedAnimLoop( $navajas, "aa_back_chair_idle2", 0 );

	EVENT_FIRE_REAR = false;
}

void rearFireInit()
{
	STARTED_REAR_FIRE_SEQ = true;
	EVENT_FIRE_REAR = true;
	PLAYER_EVENT_IN_PROGRESS = true;

	sys.trigger( $rearfire_fx_1 );
	sys.sendNamedEvent( GUI_VEHICLEHUD, "ship_target_04_on" );

	radioChatterPlayWait( $radiochatter, "vo_nava_firemunit" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_vansen_cookinghyd" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_darn_illkeepcov" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlay( $radiochatter, "vo_marks_dekgetofire" );		// %%%%%%%%%% VO %%%%%%%%%%

	thread causeRearFire();
	thread spreadRearFire();
	sys.trigger( $item_objective_2 );

	while( INBOTTOMGUN ) {
		sys.wait( 0.5 );
	}

	sys.sendNamedEvent( GUI_PLAYERHUD, "ship_target_04_on" );
}

//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//CARGO DUMP
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++
void closeCargo()
{
	$cargodoor.time( 3 );
	$cargodoor.accelTime( 1 );
	$cargodoor.decelTime( 1 );
	$cargodoor.rotateOnce( '-55 0 0' );
	sys.waitFor( $cargodoor );
}

void timeCargoFire()
{
	float d;

	for(d=40;d>=0;d--) {
		sys.wait( 1 );
		if( CARGO_DUMPED ) {
			return;
		}
	}
	//Time is up, blow up the cargo, mission failed
	sys.trigger( $cargo_explode_inside_fx );
	sys.wait( 1 );
	sys.trigger( $item_objectivefailed_1 );
}

void dumpCargoOut()
{
	if( !EVENT_FIRE_CARGO ) {
		return;
	}

	EVENT_FIRE_CARGO = false;

	DSHEALTHADD+=3000;

	$topgun.lock( 0 );
	$bottomgun.lock( 1 );

	CARGO_DUMPED = true;

	thread moveRampDown();

	$cargodoor.time( 3 );
	$cargodoor.accelTime( 1 );
	$cargodoor.decelTime( 1 );
	$cargodoor.rotateOnce( '55 0 0' );
	sys.waitFor( $cargodoor );

	$cargo_crate_1.unbind();
	$cargo_crate_2.unbind();
	sys.wait( 0.1 );

	$cargo_crate_2.applyImpulse( $cargo_crate_2, $cargo_crate_2.getWorldOrigin(), '-16500 0 0' );
	sys.wait( 0.2 );
	$cargo_crate_1.applyImpulse( $cargo_crate_1, $cargo_crate_1.getWorldOrigin(), '-16500 0 0' );	//22500
	sys.wait( 1 );

	$cargo_smoke_hurt.remove();
	sys.trigger( $interior_smoke_fx_1 );
	sys.trigger( $interior_smoke_fx_2 );
	sys.trigger( $interior_smoke_fx_3 );
	sys.trigger( $interior_smoke_fx_4 );
	sys.trigger( $interior_smoke_fx_5 );
	sys.trigger( $interior_smoke_fx_6 );

	radioChatterPlay( $radiochatter, "vo_tak_cargoaway" );		// %%%%%%%%%% VO %%%%%%%%%%

	thread closeCargo();

	sys.wait( 2.2 );

	sys.trigger( $cargoexp_fx_1 );
	$cargo_crate_1.remove();
	$cargo_smolder_1.remove();
	sys.wait( 0.3 );
	sys.trigger( $cargoexp_fx_2 );
	$cargo_crate_2.remove();
	$cargo_smolder_2.remove();
	sys.trigger( $amb_shake_low );
	sys.waitFrame();
	sys.trigger( $ship_hit_shake_super );
	sys.wait( 2 );
	sys.trigger( $amb_shake_low );

	thread moveRampUp();

	DRIVER = true;
	sys.waitFrame();
	$topgun_driver.exitVehicle( 1 );
	sys.waitFrame();
	$topgun_driver.remove();
	sys.waitFrame();
	aiScriptedAnim( $topgun, "idle", 4, 1 );
	sys.waitFrame();
	$bottomgun_driver.enterVehicle( $bottomgun );
	sys.waitFrame();
	DRIVER = false;

	radioChatterPlayWait( $radiochatter_pilot, "vo_vansen_whathelltht" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_tak_thatwastoo" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_marks_dekgettotop" );		// %%%%%%%%%% VO %%%%%%%%%%

	sys.trigger( $item_objectivecomplete_3 );
	sys.sendNamedEvent( GUI_PLAYERHUD, "ship_target_02_off" );

	//sys.music( "m03_medium1" );								// ====######## MUSIC #########====
	sys.trigger( $musicevent );
	sys.trigger( $musicmedium1 );

	while( !INTOPGUN ) {
		if( !INTOPGUN ) {
			sys.wait( 7 );
		}
		if( !INTOPGUN ) {
			radioChatterPlayWait( $radiochatter, "vo_marks_dektopturr" );		// %%%%%%%%%% VO %%%%%%%%%%
		}
		if( !INTOPGUN ) {
			sys.wait( 7 );
		}
		if( !INTOPGUN ) {
			radioChatterPlayWait( $radiochatter, "vo_marks_movedektopturr" );		// %%%%%%%%%% VO %%%%%%%%%%
		}
	}

	$mitchell_helping.remove();
	$wounded_ground.remove();

	$mitchell_chair.playAnim( ANIMCHANNEL_ALL, "idle_to_sitting" );
