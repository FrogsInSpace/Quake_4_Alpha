		if( WAVE3FIGHTER_ALIVE ) {
			if( !PLAYER_EVENT_IN_PROGRESS ) {
				radioChatterPlayWait( $radiochatter, "vo_marks_takeoutt6" );		// %%%%%%%%%% VO %%%%%%%%%%
