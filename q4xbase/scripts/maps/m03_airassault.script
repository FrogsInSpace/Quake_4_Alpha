	WAVE4BOMBER_ALIVE = false;
}

void wave5bomberdead()
{
	WAVE5BOMBER_ALIVE = false;
}


///////////////////////////////////////////////////////////////
//  Draw player kills on turret hud                          //
///////////////////////////////////////////////////////////////
void updatePlayerKills()
{
	while( 1 ) {
		$topgun.setGuiParm( "pkills", TOTAL_PLAYER_KILLS );
		$bottomgun.setGuiParm( "pkills", TOTAL_PLAYER_KILLS );
		sys.wait( 1 );
	}
}

///////////////////////////////////////////////////////////////
//  Cinematics                                               //
///////////////////////////////////////////////////////////////
void shakeIntroCam()
{
	while( INTROCIN ) {
		$intro_cam_shaker.time( 0.01 );
		$intro_cam_shaker.move( -1, 0.04 );
		sys.waitFor( $intro_cam_shaker );
		$intro_cam_shaker.time( 0.01 );
		$intro_cam_shaker.move( -2, 0.07 );
		sys.waitFor( $intro_cam_shaker );
		$intro_cam_shaker.time( 0.01 );
		$intro_cam_shaker.move( -1, 0.07 );
		sys.waitFor( $intro_cam_shaker );
		$intro_cam_shaker.time( 0.01 );
		$intro_cam_shaker.move( -2, 0.04 );
		sys.waitFor( $intro_cam_shaker );
		sys.waitFrame();
	}
}

void moveEndCameraFirst()
{
	$end_camera_mover.time( 12 );
	$end_camera_mover.accelTime( 4 );
	$end_camera_mover.decelTime( 4 );
	$end_camera_mover.moveTo( $end_camera_null_1 );
	sys.waitFor( $end_camera_mover );
}

void moveEndCameraSecond()
{
	$end_camera_mover.time( 15 );
	$end_camera_mover.accelTime( 2 );
	$end_camera_mover.decelTime( 4 );
	$end_camera_mover.moveTo( $end_camera_null_2 );
	$end_camera_mover.rotateOnce( '0 -80 0' );
	sys.waitFor( $end_camera_mover );
}

void introCinEndMoveNavajas()
{
	sys.wait( 2 );

	$navajas_chair_side.playAnim( ANIMCHANNEL_ALL, "sitting_to_idle" );
	aiScriptedAnimWait( $navajas, "aa_chair_exit", 12, 0 );
	aiScriptedMoveWait( $navajas, $navajas_null_1, 8, 0 );
	aiScriptedMoveWait( $navajas, $navajas_goback, 16, 0 );
	aiScriptedMoveWait( $navajas, $navajas_backchair_null, 2, 0 );
	aiScriptedFaceWait( $navajas, $navajas_sit_face2, 0 );
	$navajas_chair.playAnim( ANIMCHANNEL_ALL, "idle_to_sitting" );
	aiScriptedAnimWait( $navajas, "aa_back_chair_enter", 12, 0 );
	sys.wait( 0.25 );
	$navajas_chair.playCycle( ANIMCHANNEL_ALL, "sitting_idle" );
	aiScriptedAnimLoop( $navajas, "aa_back_chair_idle1", 0 );

}

void introCinEndMoveMarkswell()
{
	aiScriptedMoveWait( $markswell, $markswell_null_3, 8, 0 );
	aiScriptedMoveWait( $markswell, $markswell_null_2, 8, 0 );
	aiScriptedMoveWait( $markswell, $markswell_null_1, 8, 0 );
	$markswell.remove();
}

void introCinEndMoveTak()
{
	$tak_chair.playAnim( ANIMCHANNEL_ALL, "standing_to_idle" );
	aiScriptedAnimWait( $tak, "aa_tak_turnaround_end", 12, 0 );
	sys.wait( 0.1 );
	$tak_chair.playCycle( ANIMCHANNEL_ALL, "idle" );
	aiScriptedAnimLoop( $tak, "aa_tak_idle_loop", 0 );
	$tak.lookAt( $player_console_static );
}

void introCinStandTak()
{
	$tak_chair.playAnim( ANIMCHANNEL_ALL, "idle_to_standing" );
	aiScriptedAnimWait( $tak, "aa_tak_turnaround_intro", 12, 0 );
	sys.wait( 0.1 );
	$tak_chair.playCycle( ANIMCHANNEL_ALL, "standing_idle" );
	aiScriptedAnimLoop( $tak, "aa_tak_turnaround_loop", 0 );
	$tak.lookAt( $markswell );
}

void introCinEndMoveDarnell()
{
	$darnell_chair.playAnim( ANIMCHANNEL_ALL, "sitting_to_idle" );
	aiScriptedAnimWait( $darnell, "aa_chair_exit", 12, 0 );
	aiScriptedMoveWait( $darnell, $darnell_null_1, 8, 0 );
	aiScriptedMoveWait( $darnell, $darnell_null_2, 8, 0 );
	$darnell.hide();
}

//-------------------------------------------------------------

void moveNavajasBacktoChair()
{
	$navajas.show();
	sys.waitFrame();
	$navajas_chair.playAnim( ANIMCHANNEL_ALL, "sitting_to_idle" );
	aiScriptedAnimWait( $navajas, "aa_back_chair_exit", 12, 0 );
	sys.wait( 0.1 );
	$navajas_chair.playCycle( ANIMCHANNEL_ALL, "idle" );
	aiScriptedMoveWait( $navajas, $navajas_goback, 16, 0 );
	aiScriptedMoveWait( $navajas, $navajas_sit, 4, 0 );
	aiScriptedFaceWait( $navajas, $navajas_sit_face, 0 );
	aiScriptedAnim( $navajas, "aa_chair_enter", 12, 0 );
	$navajas_chair_side.playAnim( ANIMCHANNEL_ALL, "idle_to_sitting" );
}

void moveDarnellBacktoChair()
{
	$darnell.show();
	sys.waitFrame();
	aiScriptedMoveWait( $darnell, $darnell_sit, 4, 0 );
	aiScriptedFaceWait( $darnell, $darnell_sit_face, 0 );
	aiScriptedAnim( $darnell, "aa_chair_enter", 12, 0 );
	$darnell_chair.playAnim( ANIMCHANNEL_ALL, "idle_to_sitting" );
}

void moveTakBacktoChair()
{
	$tak.show();
	sys.waitFrame();
	$tak_chair.playAnim( ANIMCHANNEL_ALL, "idle_to_standing" );
	aiScriptedAnimWait( $tak, "aa_tak_turnaround_intro", 12, 0 );
	sys.wait( 0.1 );
	aiScriptedMoveWait( $tak, $tak_sit, 4, 0 );
	aiScriptedFaceWait( $tak, $tak_sit_face, 0 );
	aiScriptedAnim( $tak, "aa_chair_enter", 12, 0 );
	$tak_chair_side.playAnim( ANIMCHANNEL_ALL, "idle_to_sitting" );
	$tak.lookAt( $tak_sitting_lookat_target );
}

void endofbattle_vo()
{
	radioChatterPlayWait( $radiochatter, "vo_vansen_lz150" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_marks_everybdyback" );		// %%%%%%%%%% VO %%%%%%%%%%

	sys.sendNamedEvent( GUI_VEHICLEHUD, "ship_target_03_on" );

	radioChatterPlayWait( $radiochatter, "vo_vansen_gocgunf1lz" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_goc_rogfalc1altlz" );		// %%%%%%%%%% VO %%%%%%%%%%
}

void introCinGunship()
{
	while( INTROCIN ) {
		$intro_gunship_mover.time( 1.5 );
		$intro_gunship_mover.accelTime( 0.75 );
		$intro_gunship_mover.decelTime( 0.75 );
		$intro_gunship_mover.move( -2, 48 );
		$intro_gunship_mover.rotateOnce( '0 0 5' );
		sys.waitFor( $intro_gunship_mover );
		$intro_gunship_mover.time( 1.5 );
		$intro_gunship_mover.accelTime( 0.75 );
		$intro_gunship_mover.decelTime( 0.75 );
		$intro_gunship_mover.move( -1, 48 );
		$intro_gunship_mover.rotateOnce( '0 0 -10' );
		sys.waitFor( $intro_gunship_mover );
		$intro_gunship_mover.time( 1.5 );
		$intro_gunship_mover.accelTime( 0.75 );
		$intro_gunship_mover.decelTime( 0.75 );
		$intro_gunship_mover.move( -1, 48 );
		$intro_gunship_mover.rotateOnce( '0 0 10' );
		sys.waitFor( $intro_gunship_mover );
		$intro_gunship_mover.time( 1.5 );
		$intro_gunship_mover.accelTime( 0.75 );
		$intro_gunship_mover.decelTime( 0.75 );
		$intro_gunship_mover.move( -2, 48 );
		$intro_gunship_mover.rotateOnce( '0 0 -5' );
		sys.waitFor( $intro_gunship_mover );
		sys.waitFrame();
	}
}

