			if( !PLAYER_EVENT_IN_PROGRESS ) {
				radioChatterPlay( $radiochatter, "vo_vansen_cantshkd" );		// %%%%%%%%%% VO %%%%%%%%%%
			}
		}

		if( SPLINE_4_COMPLETED ) {
			sys.trigger( $fighter_spawn_4 );		//SW corner low
			thread gunVehicleDriverFire( $bottomgun_driver );
		}

		sys.wait( 1 );

		if( SPLINE_19_COMPLETED )
			sys.trigger( $fighter_spawn_90_1 );		//Starboard high

		sys.wait( 1 );

		if( SPLINE_20_COMPLETED )
			sys.trigger( $fighter_spawn_90_2 );		//Starboard high

		sys.wait( 1 );

		if( !WAVE5_CALLOUT_3 && INTOPGUN && !PLAYER_EVENT_IN_PROGRESS ) {
			WAVE5_CALLOUT_3 = true;
			radioChatterPlay( $radiochatter, "vo_tak_dest2oclock" );		// %%%%%%%%%% VO %%%%%%%%%%
		}

		if( SPLINE_13_COMPLETED )
			sys.trigger( $bomber_spawn_1 );		//NE corner low - Bomber

		sys.wait( 1 );

		if( SPLINE_7_COMPLETED )
			sys.trigger( $fighter_spawn_7 );		//NW corner high

		sys.wait( 3 );

		if( SPLINE_16_COMPLETED )
			sys.trigger( $bomber_spawn_4 );		//NW corner low - Bomber

		sys.wait( 1 );

		if( SPLINE_10_COMPLETED )
			sys.trigger( $fighter_spawn_10 );		//SE corner high

		sys.wait( 1 );

		if( !WAVE5_CALLOUT_1 && INTOPGUN && !PLAYER_EVENT_IN_PROGRESS ) {
			radioChatterPlay( $radiochatter, "vo_tak_theyeveryw" );		// %%%%%%%%%% VO %%%%%%%%%%
			WAVE5_CALLOUT_1 = true;
		}

		if( SPLINE_8_COMPLETED )
			sys.trigger( $fighter_spawn_8 );		//NW corner high

		sys.wait( 1 );

		if( SPLINE_14_COMPLETED )
			sys.trigger( $bomber_spawn_2 );		//NE corner low - Bomber

		sys.wait( 1 );

		if( SPLINE_21_COMPLETED )
			sys.trigger( $fighter_spawn_180_1 );		//Aft high

		sys.wait( 1 );

		if( !WAVE5_CALLOUT_2 && WAVE5_CALLOUT_1 && WAVE5_PLAYERKILLS >= 3 && SPLINE_22_COMPLETED && INTOPGUN && !PLAYER_EVENT_IN_PROGRESS ) {
			radioChatterPlay( $radiochatter, "vo_tak_multtargallq" );		// %%%%%%%%%% VO %%%%%%%%%%
			WAVE5_CALLOUT_2 = true;
		}

		if( SPLINE_22_COMPLETED )
			sys.trigger( $fighter_spawn_180_2 );		//Aft high

		sys.wait( 3 );

		if( SPLINE_11_COMPLETED )
			sys.trigger( $fighter_spawn_11 );		//SE corner high

		sys.wait( 1 );

		if( SPLINE_9_COMPLETED )
			sys.trigger( $fighter_spawn_9 );		//NW corner high

		sys.wait( 1 );

		if( SPLINE_15_COMPLETED )
			sys.trigger( $bomber_spawn_3 );		//NW corner low - Bomber

		sys.wait( 1 );

		if( SPLINE_12_COMPLETED )
			sys.trigger( $fighter_spawn_12 );		//SE corner high

		sys.wait( 1 );
	}

	NO_EVASIVES = true;

	if( WAVE5BOMBER_ALIVE ) {
		$wave5bomber.kill();
	}

	thread moveDarnellBacktoChair();

	//sys.music( "m03_exit_cinematic" );						// ====######## MUSIC #########====
	$musicfast1.fadeSound( SND_CHANNEL_ANY, -80, 1 );
	$musicfast1.remove();
	sys.trigger( $musicexit );

	//Wait until all ships have been killed before proceeding
	while( STROGG_WAVE_SHIP_COUNTER > 0 ) {
		sys.wait( 1 );
	}
	
	//____________________________________________________________

	DRIVER_STOP_FIRING = true;
	PLAYER_EVENT_IN_PROGRESS = true;

	sys.wait( 5 );

	sys.trigger( $playerchairtrigger );

	sys.trigger( $item_objectivecomplete_1 );

	radioChatterPlayWait( $radiochatter, "vo_vansen_weapprchlz" );		// %%%%%%%%%% VO %%%%%%%%%%
	radioChatterPlayWait( $radiochatter, "vo_marks_everyprep" );		// %%%%%%%%%% VO %%%%%%%%%%

	thread endofbattle_vo();

	REDALERT = false;

	sys.trigger( $ds_redlight_rot_1 );
	$ds_redlight_rot_flare_1.hide();
	$ds_redlight_1.Off();
	sys.trigger( $ds_redlight_rot_2 );
	$ds_redlight_rot_flare_2.hide();
	$ds_redlight_2.Off();

	$chair_light_static_flares.setColor( 0.6, 1, 0.9 );
	$seat_light_1.setColor( 0.6, 1, 0.9 );
	$seat_light_2.setColor( 0.6, 1, 0.9 );
	$seat_light_3.setColor( 0.6, 1, 0.9 );
	$seat_light_4.setColor( 0.6, 1, 0.9 );
	$seat_light_5.setColor( 0.6, 1, 0.9 );

	$white_ship_light.On();

	thread moveNavajasBacktoChair();
	thread moveTakBacktoChair();

	while( INTOPGUN ) {
		sys.wait( 0.1 );
	}

	sys.sendNamedEvent( GUI_PLAYERHUD, "ship_target_03_on" );

	sys.wait( 5 );

	while( !PLAYER_BACK_AT_CHAIR ) {
		sys.wait( 0.1 );
	}

	$player1.bind( $drop_ship );

	sys.fadeOut( '0 0 0', 1 );
	sys.wait( 1 );


	//-------------------------------------- end cinematic ------------------------------------
	thread flapBanners();

	$sky_camera_mover.time( 0.1 );
	$sky_camera_mover.moveTo( $sky_2_null );
	sys.waitFor( $sky_camera_mover );

	sys.trigger( $end_camera );

	thread moveEndCameraFirst();

	$end_dropship.show();
	$end_dropship.time( 12 );
	$end_dropship.decelTime( 4 );
	$end_dropship.startSpline( $end_dropship_spline );
	sys.wait( 1 );

	sys.fadeIn( '0 0 0', 1 );

	sys.waitFor( $end_dropship );

	sys.wait( 2 );

	$markswell_end.show();
	aiScriptedMoveWait( $markswell_end, $markswell_end_null_1, 16, 0 );
	aiScriptedFaceWait( $markswell_end, $end_dropship, 0 );

	sys.trigger( $end_camera_cu );
	sys.wait( 0.5 );
	$musicexit.fadeSound( SND_CHANNEL_ANY, -20, 0.5 );			// ====######## MUSIC #########====
	aiSpeak( $markswell_end, "lipsync_marks_everybdyout" );		// %%%%%%%%%% VO %%%%%%%%%%

	$navajas_end.show();
	aiScriptedMove( $navajas_end, $navajas_end_null_1, 16, 0 );
	sys.wait( 1.25 );

	$mitchell_end.show();
	aiScriptedMove( $mitchell_end, $mitchell_end_null_1, 16, 0 );
	sys.wait( 1.25 );

	sys.trigger( $end_camera );
	sys.wait( 0.2 );
	radioChatterPlay( $radiochatter, "vo_vansen_delivpack" );		// %%%%%%%%%% VO %%%%%%%%%%

	sys.wait( 1 );

	$navajas_end.lookAt( $markswell_end );
	aiScriptedFace( $navajas_end, $markswell_end, 0 );
	$mitchell_end.lookAt( $markswell_end );
	aiScriptedFace( $mitchell_end, $markswell_end, 0 );

	$tak_end.show();
	aiScriptedMove( $tak_end, $tak_end_null_1, 16, 0 );
	sys.wait( 1 );

	$darnell_end.show();
	aiScriptedMove( $darnell_end, $darnell_end_null_1, 16, 0 );
	sys.wait( 1 );

	$dekard_end.show();
	aiScriptedMoveWait( $dekard_end, $deckard_end_null_1, 16, 0 );

	$tak_end.lookAt( $markswell_end );
	aiScriptedFace( $tak_end, $markswell_end, 0 );
	$darnell_end.lookAt( $markswell_end );
	aiScriptedFace( $darnell_end, $markswell_end, 0 );
	$dekard_end.lookAt( $markswell_end );
	aiScriptedFace( $dekard_end, $markswell_end, 0 );

	sys.wait( 1 );
	sys.trigger( $end_camera_cu );
	sys.wait( 0.5 );
	$markswell_end.lookAt( $dekard_end );
	aiScriptedFace( $markswell_end, $dekard_end, 0 );
	aiSpeak( $markswell_end, "lipsync_marks_infiltopsid" );		// %%%%%%%%%% VO %%%%%%%%%%
	sys.wait( 8 );
	$markswell_end.lookAt( $navajas_end );
	aiScriptedFace( $markswell_end, $navajas_end, 0 );
	sys.wait( 6 );
	aiSpeakWait( $markswell_end, "lipsync_marks_moveout3" );		// %%%%%%%%%% VO %%%%%%%%%%
	sys.wait( 0.2 );
	$musicexit.fadeSound( SND_CHANNEL_ANY, 20, 0.5 );			// ====######## MUSIC #########====

	sys.trigger( $end_camera );

	sys.wait( 1 );

	$tak_end.lookAt( $end_doors );
	$darnell_end.lookAt( $end_doors );
	$dekard_end.lookAt( $end_doors );

	aiScriptedMove( $navajas_end, $navajas_end_null_2, 16, 0 );
	sys.wait( 0.85 );
	aiScriptedMove( $markswell_end, $markswell_end_null_2, 16, 0 );
	sys.wait( 0.85 );
	aiScriptedMove( $mitchell_end, $mitchell_end_null_2, 16, 0 );

	thread moveEndCameraSecond();

	aiScriptedMove( $darnell_end, $darnell_end_null_2, 16, 0 );
	sys.wait( 0.85 );
	aiScriptedMove( $dekard_end, $deckard_end_null_2, 16, 0 );
	sys.wait( 0.85 );
	aiScriptedMoveWait( $tak_end, $tak_end_null_2a, 16, 0 );
	aiScriptedFaceWait( $tak_end, $exitdoorgui, 0 );
	$tak_end.lookAt( $exitdoorgui );
	aiScriptedAnimWait( $tak_end, "tram1_console_stand_start", 12, 0 );
	aiScriptedAnimWait( $tak_end, "tram1_console_stand_loop", 0, 0 );
	aiScriptedAnimWait( $tak_end, "tram1_console_stand_end", 0, 0 );
	sys.wait( 0.5 );
	sys.trigger( $end_doors );
	aiScriptedMoveWait( $tak_end, $tak_end_null_2b, 16, 0 );
	sys.wait( 1 );

	aiScriptedMove( $darnell_end, $darnell_end_null_3, 16, 0 );
	sys.wait( 0.5 );
	aiScriptedMove( $tak_end, $tak_end_null_3, 16, 0 );
	sys.wait( 0.75 );
	aiScriptedMoveWait( $dekard_end, $deckard_end_null_3, 16, 0 );
	sys.fadeOut( '0 0 0', 2 );
	sys.trigger( $end_doors );
	sys.wait( 2 );
	sys.trigger( $end_camera );
	sys.wait( 0.1 );
	sys.sendNamedEvent( GUI_PLAYERHUD, "aa_showShipStatusOff" );
	$player1.enableWeapon();
	sys.waitFrame();
	sys.trigger( $endlevel );
}

//end namespace
}



