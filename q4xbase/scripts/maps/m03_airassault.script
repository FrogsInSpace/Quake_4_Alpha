///////////////////////////////////////////////////////////////
//  Main                                                     //
///////////////////////////////////////////////////////////////
void main()
{
	float a;

	sys.fadeOut( '0 0 0', 0 );

	a = thread initStuff();
	sys.waitForThread( a );

	//sys.music( "m03_intro_cinematic" );								// ====######## MUSIC #########====
	sys.trigger( $musicintro );

	//These are in the .map for AAS generation only
	$remove_me_bomber.remove();
	$remove_me_flyer.remove();

	$player1.disableTarget();

//	$topgun.lock( 0 );
//	$bottomgun.lock( 0 );

	DRIVER = true;
	$topgun_driver.enterVehicle( $topgun );
	sys.waitFrame();
	DRIVER = false;

	thread loopSkyboxTerrain();
	thread initFriendlies();
	thread dropshiphealthcheck();

	sys.trigger( $amb_shake_low );

	//---------------------------- cinematic --------------------------------------------------
	//------ exterior -------
	$intro1_cam_1_mover.time( 0.01 );
	$intro1_cam_1_mover.accelTime( 0 );
	$intro1_cam_1_mover.decelTime( 0 );
	$intro1_cam_1_mover.rotateOnce( '-45 0 0' );
	sys.waitFor( $intro1_cam_1_mover );

	INTROCIN = true;
	thread hideInterior();
	thread introCinGunship();
	sys.wait( 0.1 );
	sys.trigger( $intro1_cam_1 );
	sys.fadeIn( '0 0 0', 1 );

	$intro1_cam_1_mover.time( 10 );
	$intro1_cam_1_mover.accelTime( 2 );
	$intro1_cam_1_mover.decelTime( 0 );
	$intro1_cam_1_mover.moveTo( $intro1_cam_1_target_2 );
	$intro1_cam_1_mover.rotateOnce( '45 -5 0' );
	sys.waitFor( $intro1_cam_1_mover );

	$intro1_cam_1_mover.time( 3 );
	$intro1_cam_1_mover.accelTime( 0 );
	$intro1_cam_1_mover.decelTime( 2.5 );
	$intro1_cam_1_mover.moveTo( $intro1_cam_1_target_1 );
	$intro1_cam_1_mover.rotateOnce( '0 -40 0' );
	sys.waitFor( $intro1_cam_1_mover );

	sys.wait( 2 );

	sys.fadeOut( '0 0 0', 0.25 );
	sys.wait( 0.3 );
	thread showInterior();
	sys.trigger( $intro_engine_thrust_fx_1 );
	sys.trigger( $intro_engine_thrust_fx_2 );
	$intro_gunship_top.remove();
	$intro_gunship_bottom.remove();
	$markswell.hide();

	//------ interior -------
	//camera 1, wide shot from rear
	//camera 2, Navajas
	//camera 3, Mitchell
	//camera 4, Darnell
	//camera 5, Tak
	//camera 5b, Tak standing close-up
	//camera 6, Dekard

	thread shakeIntroCam();

	sys.trigger( $intro_cam_1 );
	sys.fadeIn( '0 0 0', 0.1 );
	$intro_cam_1_mover.time( 4 );
	$intro_cam_1_mover.accelTime( 0.5 );
	$intro_cam_1_mover.decelTime( 0.5 );
	$intro_cam_1_mover.rotateOnce( '0 -45 0' );
	sys.waitFor( $intro_cam_1_mover );

	sys.wait( 2 );

	sys.trigger( $intro_cam_2 );
	$navajas.lookAt( $wounded );

	$musicintro.fadeSound( SND_CHANNEL_ANY, -4, 1 );				// ====######## MUSIC #########====

	aiSpeakWait( $navajas, "lipsync_nava_howhedo" );

	sys.wait( 0.2 );
	sys.trigger( $intro_cam_3 );
	$mitchell.lookAt( $wounded );
	aiSpeakWait( $mitchell, "lipsync_mitch_aswell" );
	$mitchell.lookAt( $navajas );
	aiSpeakWait( $mitchell, "lipsync_mitch_gladfalc" );

	sys.wait( 0.2 );
	sys.trigger( $intro_cam_2 );
	$navajas.lookAt( $mitchell );
	$mitchell.lookAt( $darnell );
	aiSpeakWait( $navajas, "lipsync_nava_considwedid" );

	sys.wait( 0.2 );
	sys.trigger( $intro_cam_4 );
	$darnell.lookAt( $navajas );
	aiSpeakWait( $darnell, "lipsync_darn_townsatk" );

	sys.wait( 0.2 );
	sys.trigger( $intro_cam_2 );
	$navajas.lookAt( $darnell );
	aiSpeak( $navajas, "lipsync_nava_yeahwellwe" );
	sys.wait( 2 );
	$navajas.lookAt( $tak );
	sys.wait( 3.75 );

	aiScriptedMove( $markswell, $markswell_null_1, 8, 0 );

	sys.wait( 0.2 );
	sys.trigger( $intro_cam_5 );
	$tak.lookAt( $tak_backwards_look );
	aiSpeakWait( $tak, "lipsync_tak_sciconftac" );

	$markswell.show();

	$dekard.lookAt( $markswell );
	$darnell.lookAt( $markswell );
	$navajas.lookAt( $markswell );
	$mitchell.lookAt( $markswell );

	sys.wait( 0.2 );
	sys.trigger( $intro_cam_1 );

	$intro_cam_1_mover.time( 3 );
	$intro_cam_1_mover.accelTime( 1.5 );
	$intro_cam_1_mover.decelTime( 1.5 );
	$intro_cam_1_mover.moveTo( $cam1_markswell_cu );

	thread introCinStandTak();
	aiScriptedMoveWait( $markswell, $markswell_null_4, 8, 0 );
	sys.waitFor( $intro_cam_1_mover );

	aiScriptedAnimLoop( $markswell, "weaponless_idle2_loop", 16 );

	sys.waitFrame();
	$markswell.lookAt( $darnell );
	aiSpeakWait( $markswell, "lipsync_marks_goodbadworse" );
	$markswell.lookAt( $dekard );
	aiSpeakWait( $markswell, "lipsync_marks_goodfirst" );

	sys.wait( 0.2 );
	sys.trigger( $intro_cam_4 );
	aiSpeakWait( $darnell, "lipsync_darn_goodhobtakdek" );

	$dekard.lookAt( $darnell );
	sys.wait( 0.1 );
	sys.trigger( $intro_cam_6 );

	sys.wait( 1.5 );
	sys.trigger( $intro_cam_1 );
	$intro_cam_1_mover.time( 15 );
	$intro_cam_1_mover.accelTime( 7 );
	$intro_cam_1_mover.decelTime( 7 );
	$intro_cam_1_mover.move( EAST, 16 );
	$intro_cam_1_mover.rotateOnce( '0 -9 0' );

	$markswell.lookAt( $darnell );
	aiSpeakWait( $markswell, "lipsync_marks_worsenews" );

	sys.wait( 0.2 );
	sys.trigger( $intro_cam_3 );
	aiSpeak( $navajas, "lipsync_nava_what2" );
	sys.wait( 0.1 );
	aiSpeak( $mitchell, "lipsync_mitch_holyshit" );
	sys.wait( 0.15 );
	aiSpeakWait( $darnell, "lipsync_darn_whathellwar" );

	sys.trigger( $intro_cam_1 );
	$markswell.lookAt( $tak );
	aiSpeakWait( $tak, "lipsync_tak_straussconv" );
	aiSpeakWait( $markswell, "lipsync_marks_empeffortf" );

	sys.trigger( $intro_cam_5b );
	aiSpeakWait( $tak, "lipsync_tak_straussalive" );

	sys.trigger( $intro_cam_1 );
	$markswell.lookAt( $dekard );
	aiSpeakWait( $markswell, "lipsync_marks_yeshannib" );
	$markswell.lookAt( $darnell );
	aiSpeakWait( $markswell, "lipsync_marks_nowbadnews" );
	$markswell.lookAt( $dekard );
	aiSpeakWait( $markswell, "lipsync_marks_theirgoal" );

	sys.wait( 0.2 );
	sys.trigger( $intro_cam_4 );
	aiSpeak( $darnell, "lipsync_darnell_wetwomen" );
	aiSpeakWait( $navajas, "lipsync_nava_anothershit" );

	sys.wait( 0.2 );
	sys.trigger( $intro_cam_1 );
	radioChatterPlayWait( $radiochatter, "vo_vansen_ltwing3" );
	$markswell.lookAt( $darnell );
	aiSpeakWait( $markswell, "lipsync_marks_iknowshort" );
	radioChatterPlayWait( $radiochatter, "vo_vansen_wegotincom1" );

	$musicintro.fadeSound( SND_CHANNEL_ANY, 4, 1 );				// ====######## MUSIC #########====

	sys.waitFor( $intro_cam_1_mover );

	REDALERT = true;

	$white_ship_light.Off();
	$markswell_intro_fill_light.On();
	$chair_light_static_flares.setColor( 0.5, 0.03, 0 );
	$seat_light_1.setColor( 0.5, 0.03, 0 );
	$seat_light_2.setColor( 0.5, 0.03, 0 );
	$seat_light_3.setColor( 0.5, 0.03, 0 );
	$seat_light_4.setColor( 0.5, 0.03, 0 );
	$seat_light_5.setColor( 0.5, 0.03, 0 );

	sys.trigger( $ds_redlight_rot_1 );
	$ds_redlight_rot_flare_1.show();
	$ds_redlight_1.On();
	sys.wait( 0.5 );
	sys.trigger( $ds_redlight_rot_2 );
	$ds_redlight_rot_flare_2.show();
	$ds_redlight_2.On();

	aiSpeakWait( $markswell, "lipsync_marks_everystation" );			// %%%%%%%%%% VO %%%%%%%%%%

	aiScriptedAnimLoop( $navajas, "aa_chair_alert_reaction3", 0 );
	sys.wait( 0.1 );
	aiScriptedAnimLoop( $mitchell, "aa_chair_alert_reaction2", 0 );
	sys.wait( 0.1 );
	aiScriptedAnimLoop( $dekard, "aa_chair_alert_reaction4", 0 );
	sys.wait( 0.1 );
	aiScriptedAnimLoop( $darnell, "aa_chair_alert_reaction1", 0 );

	thread introCinEndMoveNavajas();
	thread introCinEndMoveMarkswell();
