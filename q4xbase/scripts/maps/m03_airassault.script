///////////////////////////////////////////////////////////////
//  Vehicle Drivers                                          //
///////////////////////////////////////////////////////////////
void gunVehicleDriverFire( entity gunner )
{
	float a;
	float b;
	float c;

	if( DRIVER_FIRING ) {
		return;
	}

	DRIVER_FIRING = true;

	a = starget.getHealth();
	a += randomRoundFloat(350, 500);
	starget.setHealth( a );

	while( a > 0 ) {
		sys.wait( 2 );
		gunner.lookAt( starget );
		sys.wait( 0.5 );

		c = randomRoundFloat(1, 10);
		if( c <= 9 ) {
			gunner.fireWeapon( 0, 0.75 );
		}
		else {
			gunner.fireWeapon( 1, 0.75 );
		}

		sys.wait( 2 );
		a = starget.getHealth();
		if( DRIVER_STOP_FIRING ) {
			break;
		}
	}

	DRIVER_FIRING = false;
}


///////////////////////////////////////////////////////////////
//  Flak                                                     //
///////////////////////////////////////////////////////////////
void flakFire()
{
	sys.trigger( $flak_1 );
	sys.wait( sys.random(2) );
	sys.trigger( $flak_2 );
	thread shipImpactEffectLight();
	sys.wait( sys.random(2) );
	sys.trigger( $flak_3 );
	sys.wait( sys.random(2) );
	sys.trigger( $flak_4 );
	thread shipImpactEffectLight();
	sys.wait( sys.random(2) );
	sys.trigger( $flak_5 );
	sys.wait( sys.random(2) );
	sys.trigger( $flak_6 );
	sys.wait( sys.random(2) );
	sys.trigger( $flak_7 );
	sys.wait( sys.random(2) );
	sys.trigger( $flak_direct );
	thread shipImpactEffectHeavy();
	sys.trigger( $flak_8 );
	sys.wait( sys.random(2) );
	sys.trigger( $flak_9 );
	sys.wait( sys.random(2) );
	sys.trigger( $flak_10 );
	thread shipImpactEffectLight();
	sys.wait( sys.random(2) );
	sys.trigger( $flak_11 );
	sys.wait( sys.random(2) );
	sys.trigger( $flak_12 );
	thread shipImpactEffectLight();
	sys.wait( sys.random(2) );
	sys.trigger( $flak_1 );
	sys.wait( sys.random(2) );
	sys.trigger( $flak_2 );
	thread shipImpactEffectLight();
	sys.wait( sys.random(2) );
	sys.trigger( $flak_3 );
	sys.wait( sys.random(2) );
	sys.trigger( $flak_direct );
	thread shipImpactEffectHeavy();
	sys.trigger( $flak_4 );
}

void flakFireLight()
{
	sys.trigger( $flak_1 );
	sys.wait( sys.random(3) );
	sys.trigger( $flak_4 );
	sys.wait( sys.random(6) );
	sys.trigger( $flak_10 );
	sys.wait( sys.random(3) );
	sys.trigger( $flak_3 );
}

