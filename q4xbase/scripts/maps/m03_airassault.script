		SPLINE_23_COMPLETED = completed;
	if(shipId == SHIP_24)
		SPLINE_24_COMPLETED = completed;
}

void moveShipAlongSpline( entity shipEntity, entity moverEntity, entity splinePath, float shipId, float flytime )
{
	string tempShip;

	tempShip = shipEntity.getName();

	splinePathCompleted( shipId, false );

	shipEntity.setScript( "death", "stroggKilledFeedback" );

	STROGG_WAVE_SHIP_COUNTER++;

	shipEntity.bind( moverEntity );
	sys.waitFrame();

	moverEntity.time( flytime );
	moverEntity.accelTime( (flytime*0.25) );
	moverEntity.startSpline( splinePath );
	sys.waitFor( moverEntity );

	shipEntity = sys.getEntity( tempShip );

	if( isValidEntity( shipEntity ) ) {
		shipEntity.kill();
	}
	sys.wait( 0.1 );

	moverEntity.stopSpline();
	sys.waitFrame();
	moverEntity.removeBinds();
	sys.waitFrame();
	thread splinePathCompleted( shipId, true );
}

//Fighters__________________________________________________________________
void fighter_spawn_1_shipSpawned( entity spawnedstrogg1 )
{
	if( SPLINE_1_COMPLETED ) {
		thread moveShipAlongSpline( spawnedstrogg1, $fighter_spawn_1_mover, $fighter_spline_1, SHIP_1, 13 );
		sys.trigger( $flyby_high_1 );
		sys.sendNamedEvent( GUI_VEHICLEHUD, "warning_NE" );
		sys.sendNamedEvent( GUI_PLAYERHUD, "warning_NE" );
	}
}
void fighter_spawn_2_shipSpawned( entity spawnedstrogg2 )
{
	if( SPLINE_2_COMPLETED ) {
		thread moveShipAlongSpline( spawnedstrogg2, $fighter_spawn_2_mover, $fighter_spline_2, SHIP_2, 15 );
		sys.trigger( $flyby_high_2 );
		sys.sendNamedEvent( GUI_VEHICLEHUD, "warning_NE" );
		sys.sendNamedEvent( GUI_PLAYERHUD, "warning_NE" );
	}
}
void fighter_spawn_3_shipSpawned( entity spawnedstrogg3 )
