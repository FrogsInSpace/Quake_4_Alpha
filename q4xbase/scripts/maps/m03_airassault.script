void loopFriendlyDropshipOne()
{
	$friendly_dropship_1_mover.disableSplineAngles();

	while( 1 ) {
		$friendly_dropship_1_mover.time( 4 );
		$friendly_dropship_1_mover.startSpline( $friendly_dropship_1_spline );
		sys.waitFor( $friendly_dropship_1_mover );
		sys.waitFrame();
		if( FRIENDLY_1_KILL ) {
			break;
		}
	}

	FRIENDLY_1_READYTODIE = true;
}

void loopFriendlyDropshipTwo()
{
	$friendly_dropship_2_mover.disableSplineAngles();

	while( 1 ) {
		$friendly_dropship_2_mover.time( 4 );
		$friendly_dropship_2_mover.startSpline( $friendly_dropship_2_spline );
		sys.waitFor( $friendly_dropship_2_mover );
		sys.waitFrame();
		if( FRIENDLY_2_KILL ) {
			break;
		}
	}

	FRIENDLY_2_READYTODIE = true;
}

