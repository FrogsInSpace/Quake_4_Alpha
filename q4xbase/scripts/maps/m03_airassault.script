///////////////////////////////////////////////////////////////
//  Biggun shots                                             //
///////////////////////////////////////////////////////////////
void biggunShotsFire()
{
	sys.trigger( $biggunshot_1 );
	$biggunshot_mover_1.time( 10 );
	$biggunshot_mover_1.accelTime( 5 );
	$biggunshot_mover_1.moveTo( $biggunshot_target_1 );
	sys.wait( 1.5 );

	if( !PLAYER_EVENT_IN_PROGRESS ) {
		radioChatterPlay( $radiochatter, "vo_tak_incomingairdef" );		// %%%%%%%%%% VO %%%%%%%%%%
	}

	sys.trigger( $biggunshot_speaker_1 );
	sys.waitFor( $biggunshot_mover_1 );
	sys.trigger( $biggunshot_1 );

	sys.wait( 15 );

	sys.trigger( $biggunshot_2 );
	$biggunshot_mover_2.time( 10 );
	$biggunshot_mover_2.accelTime( 5 );
	$biggunshot_mover_2.moveTo( $biggunshot_target_2 );
	sys.wait( 1.5 );
	sys.trigger( $biggunshot_speaker_2 );
	sys.waitFor( $biggunshot_mover_2 );
	sys.trigger( $biggunshot_2 );
}

