///////////////////////////////////////////////////////////////
                                                             //
///////////////////////////////////////////////////////////////
//
///////////////////////////////////////////////////////////////
//  Initialization Threads                                   //
///////////////////////////////////////////////////////////////

void setupMachines()
{
	$mover_icecube_trackthing_3.time( 5 );
	$mover_icecube_trackthing_3.accelTime( 1 );
	$mover_icecube_trackthing_3.decelTime( 1 );
	$mover_icecube_trackthing_3.moveTo( $cube_null_6 );
	sys.waitFor( $mover_icecube_trackthing_3 );

	$mover_tube2_mach_2.time( 5 );
	$mover_tube2_mach_2.accelTime( 0.5 );
	$mover_tube2_mach_2.decelTime( 0.5 );
	$mover_tube2_mach_2.rotateOnce( '0 10 0' );
	sys.waitFor( $mover_tube2_mach_2 );
}

///////////////////////////////////////////////////////////////
                                                             //
///////////////////////////////////////////////////////////////
//
///////////////////////////////////////////////////////////////
//  Main                                                     //
///////////////////////////////////////////////////////////////

void main()
{	
	thread setupMachines();
	thread init_steamers();

	//Setup booleans
	ESCAPE_ELEVATOR_CLEAR = false;
	PLAYER_ON_EXIT_ELEVATOR = false;
	EXIT_DOOR_ONE_CLOSED = false;
	EXIT_DOOR_TWO_CLOSED = false;
	EXIT_DOOR_THREE_CLOSED = false;

	sys.trigger( $navajas );
	$navajas.becomePassive( 1 );
	sys.trigger( $valkaryne01 );
	$valkaryne01.becomePassive( 1 );
	aiScriptedAnimLoop( $valkaryne01, "idle", 10 );
	sys.trigger( $monster_gunner_1 );
	sys.trigger( $monster_gunner_2 );
	sys.trigger( $repbot_1 );
	sys.trigger( $repbot_2 );

	thread coldInHere();
	thread repairBotOne();
	thread repairBotTwo();

	sys.wait( 2 );
	m10_giveObjective( 1 );

	thread moveIceCubeDown();
	
	PLAYER_ON_DROPSHIP = false;
	GAME_OVER = false;
}

} // end namespace

