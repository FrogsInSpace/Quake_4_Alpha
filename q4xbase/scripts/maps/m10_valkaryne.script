///////////////////////////////////////////////////////////////
//  Objectives                                               //
///////////////////////////////////////////////////////////////

void m10_giveObjective( float n )
{
	entity p;

	p = sys.getEntity( "item_objective_" + n );
	sys.trigger( p );
}

void m10_completeObjective( float m )
{
	entity q;

	q = sys.getEntity( "item_objectivecomplete_" + m );
	sys.trigger( q );
}

void valk01_moves()
{
	$mvr_valk01.time( 6 );
	$mvr_valk01.accelTime( 0.5 );
	$mvr_valk01.decelTime( 0.5 );
	
	if ( intValk01_moving == 1 )
	{
		sys.println( intValk01_moving );
		$mvr_valk01.startSpline( $spline_valk01 );
		intValk01_moving = intValk01_moving + 1;
		sys.waitFor( $mvr_valk01 );		
	}
	else if ( intValk01_moving == 2 )
	{
		sys.println( intValk01_moving );
		$mvr_valk01.startSpline( $spline_valk02 );
		intValk01_moving = intValk01_moving + 1;
		sys.waitFor( $mvr_valk01 );
	}
	else if ( intValk01_moving == 3 )
	{
		sys.println( intValk01_moving );
		$mvr_valk01.startSpline( $spline_valk03 );
		sys.waitFor( $mvr_valk01 );
	}
	else
	{
		sys.println( "COUNTER NOT WORKING" );
	}
}

///////////////////////////////////////////////////////////////
//  Valkaryne Taunts                                         //
///////////////////////////////////////////////////////////////

//In first large cave after initial descent
void valktauntOne()
{
	float r;
	entity t;

	for(r=0;r<=30;r++) {
		t = sys.getEntity( "vt_light_" + r );
		t.fadeOutLight( 0.05 );
	}

	sys.wait( 1 );
	$func_static_55279.guiEvent( "valkinfluenceOn" );
	$vt_light_red_1.fadeInLight( 0.5 );
	sys.wait( 3.5 );
	$vt_light_red_1.fadeOutLight( 0.5 );
	$func_static_55279.guiEvent( "valkinfluenceOff" );
	sys.wait( 1 );

	for(r=31;r>=1;r--) {
		t = sys.getEntity( "vt_light_" + r );
		t.fadeInLight( 0.25 );
	}
}

//Part way down second tube shaft, following the Valkaryne
void valktauntTwo()
{
	float r;
	entity t;

	for(r=0;r<=14;r++) {
		t = sys.getEntity( "vt2_light_" + r );
		t.fadeOutLight( 0.05 );
	}

	sys.wait( 1 );
	$func_static_54716.guiEvent( "valkinfluenceOn" );
	$vt2_light_red_1.fadeInLight( 0.5 );
	sys.wait( 3.5 );
	$vt2_light_red_1.fadeOutLight( 0.5 );
	$func_static_54716.guiEvent( "valkinfluenceOff" );
	sys.wait( 1 );

	for(r=15;r>=1;r--) {
		t = sys.getEntity( "vt2_light_" + r );
		t.fadeInLight( 0.25 );
	}
}

//In the round blue tube room, on the elevator console
void valktauntThree()
{
	float r;
	entity t;

	for(r=0;r<=10;r++) {
		t = sys.getEntity( "vt3_light_" + r );
		t.fadeOutLight( 0.05 );
	}

	sys.wait( 1 );
	$func_elevator_1_call_1_valk.guiEvent( "valkinfluenceOn" );
	$func_elevator_1_call_1.hide();
	$func_elevator_1_call_1_valk.show();
	$vt3_light_red_1.fadeInLight( 0.5 );
	sys.wait( 3.5 );
	$vt3_light_red_1.fadeOutLight( 0.5 );
	$func_elevator_1_call_1_valk.hide();
	$func_elevator_1_call_1.show();
	sys.wait( 1 );

	for(r=11;r>=1;r--) {
		t = sys.getEntity( "vt3_light_" + r );
		t.fadeInLight( 0.25 );
	}
}

void showElevatorGUI()
{
	$func_elevator_1_call_1_fake.hide();
	$func_elevator_1_call_1.show();
}

///////////////////////////////////////////////////////////////
//  Repair Bots                                              //
///////////////////////////////////////////////////////////////
void repairBotOne()
{
	float t;

	aiScriptedMoveWait( $repbot_1, $repbot_repspot_1, 8, 0 );
	aiScriptedFaceWait( $repbot_1, $repspot_1_target, 0 );
	$repbot_1.bind( $repbot_repspot_1 );
	sys.wait( 1 );

	for(t=0;t++;t<5) {
		aiScriptedActionWait( $repbot_1, $repspot_1_target, 0 );
		sys.wait( 8 );
	}
}

void endRepairBotOne()
{
	$repbot_1.unbind();
	aiScriptedAnimLoop( $repbot_1, "idle", 12 );
}

void repairBotTwo()
{
	float t;

	aiScriptedMoveWait( $repbot_2, $repbot_repspot_2, 8, 0 );
	aiScriptedFaceWait( $repbot_2, $repspot_2_target, 0 );
	$repbot_2.bind( $repbot_repspot_2 );
	sys.wait( 1 );

	for(t=0;t++;t<5) {
		aiScriptedActionWait( $repbot_2, $repspot_2_target, 0 );
		sys.wait( 8 );
	}
}

void endRepairBotTwo()
{
	$repbot_2.unbind();
	aiScriptedAnimLoop( $repbot_2, "idle", 12 );
}

