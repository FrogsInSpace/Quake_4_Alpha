void makSphereDead()
{
	//turn on goo spawning
	$mak_sphere.remove();
	sys.trigger( $baby_goo01 );
	sys.wait( 0.2 );
	sys.trigger( $baby_goo02 );
	sys.wait( 0.7 );
	sys.trigger( $baby_goo03 );
	
	//stop the rotating pieces of armor
	$mak_shield_1.rotate( '0 0 0' );
	$mak_shield.rotate( '0 0 0' );
	
	aiScriptedAnim( $valk, "plugin_pain1", 4, 1 );
	VALK_DOCKED = false;
	sys.wait( 3 );

	valkaryne_undock();
	
	//turn off goo spawning
	sys.trigger( $baby_goo01 );
	sys.wait( 0.2 );
	sys.trigger( $baby_goo02 );
	sys.wait( 0.7 );
	sys.trigger( $baby_goo03 );
}

void animMakronRolling()
{	
	// makron ball rolls into position
	$makShield01.accelTime( 0 );
	$makShield01.decelTime( 1 );
	$makShield01.time( 6 );
	
	$makShield01.rotate( '-180 0 0' );
	
	$makShield01.disableSplineAngles();
	$makShield01.startSpline( $spline_makShield );
	sys.waitFor( $makShield01 );
	$mvr_makShields.rotate( '0 0 0' );	
}

void initValk()
{
	//$mak_sphere_100.setOrigin( '-3808 1224 -4520' );
	//$mak_sphere_200.setOrigin( '-3808 1224 -4520' );
	
	sys.trigger( $target_bossMakronEgg );	

	VALK_DOCKED = true;
	
	thread makronMovers();
	thread makron_shield_battle();
	// valkStageOne();
}

void valkIntro()
{
	VALK_ALIVE = true;

	sys.trigger( $valkcamera );
	//sys.wait( 1 );
	
	animMakronRolling();
	
	$makShield01.remove();
	$makShield02.remove();
	
	$mak_shield_1.show();
	$mak_shield.show();
	$baby_mak.show();
	$baby_mak_light01.On();
	$mak_sphere.show();

	$func_door_119.lock( 1 );
	$func_door_120.lock( 1 );
	$func_static_54386.setShaderParm( 7, 0 );
	sys.trigger( $valkcamera );

	sys.wait( 2 );
	$valk.becomeAggressive();
	thread initValk();
}

void makronMovers()
{
	$side_rotator01.bind( $orig_side_rotator01 );
	$top_rotator01.bind( $orig_top_rotator01 );
	
	$orig_top_rotator01.accelTime( 0.5 );
	$orig_top_rotator01.decelTime( 0.5 );
	$orig_top_rotator01.time( 2 );
	
	$orig_side_rotator01.accelTime( 0.5 );
	$orig_side_rotator01.decelTime( 0.5 );
	$orig_side_rotator01.time( 2 );
	
	// 
	while( 1 )
	{		
		$orig_top_rotator01.rotateUpTo( 1, 90 );
		$orig_side_rotator01.rotateUpTo( 2, 90 );
		
		sys.wait( 3 );
		
		$orig_top_rotator01.rotateDownTo( 1, 0 );
		$orig_side_rotator01.rotateDownTo( 2, 0 );
	}	
}

void valkDead()
{
	VALK_ALIVE = false;

	thread m10_completeObjective( 1 );
	sys.wait( 1 );

	//exit area out of Valk chamber
	sys.trigger( $undervalkdoor );
	$valkseat_static.remove();
	sys.trigger( $undervalk_steamfx_1 );
	sys.trigger( $undervalk_steamfx_2 );
	sys.trigger( $undervalk_steamfx_3 );
	sys.trigger( $undervalk_steamfx_4 );
	sys.trigger( $undervalk_steamfx_5 );
	sys.trigger( $undervalk_steamfx_6 );

	sys.trigger( $valkroom_rumble );
	sys.trigger( $func_fx_50 );
	sys.wait( 2 );
	sys.trigger( $func_fx_53 );
	sys.wait( 1 );
	sys.trigger( $func_fx_52 );
	sys.wait( 1.25 );
	sys.trigger( $func_fx_54 );
	sys.wait( 1.5 );
	sys.trigger( $func_fx_55 );
	sys.wait( 2 );
	sys.trigger( $func_fx_51 );

	//blow some shit up and stuff
	sys.wait( 4 );
	thread m10_giveObjective( 2 );

	//time for player to get out of Valk room
	sys.wait( 10 );
	sys.trigger( $valkroom_bigfx );
	sys.trigger( $valkroom_hurt );
	sys.wait( 1 );
	sys.trigger( $valkroom_bigsmoke );
	sys.trigger( $valkroom_bigsmoke_1 );


	//time for player to get out of Markron room
	sys.wait( 10 );
	if( !EXIT_DOOR_ONE_CLOSED ) {
		sys.trigger( $makronroom_bigfx );
		$monster_makron_6.kill();
		$monster_makron_5.kill();
		$monster_makron_8.kill();
		$monster_makron_10.kill();

		sys.trigger( $makronroom_hurt );
		sys.wait( 1 );
		sys.trigger( $makronroom_bigsmoke );
	}
	if( EXIT_DOOR_ONE_CLOSED ) {
		sys.trigger( $makron_exp_speaker_1 );
		sys.wait( 1 );
		sys.trigger( $makron_exp_speaker_2 );
		//give the player a few extra seconds because he closed the doors
		sys.wait( 2 );
	}


	//time for player to get out of first tunnel section
	sys.wait( 5 );
	if( !EXIT_DOOR_TWO_CLOSED ) {
		sys.trigger( $exit_tun_bigfx );
		sys.trigger( $exit_tun_hurt_1 );
		sys.wait( 1 );
		sys.trigger( $exit_tun_1_bigsmoke );
	}
	if( EXIT_DOOR_TWO_CLOSED ) {
		sys.trigger( $exit_tun_1_exp_speaker_1 );
		sys.wait( 1 );
		sys.trigger( $exit_tun_1_exp_speaker_2 );
		//give the player a few extra seconds because he closed the doors
		sys.wait( 2 );
	}



	//time for player to get out of second tunnel section
	sys.wait( 5 );
	if( !EXIT_DOOR_THREE_CLOSED ) {
		sys.trigger( $exit_tun_bigfx_2 );
		sys.trigger( $exit_tun_hurt_2 );
		sys.wait( 1 );
		sys.trigger( $exit_tun_2_bigsmoke );
	}
	if( EXIT_DOOR_THREE_CLOSED ) {
		sys.trigger( $exit_tun_2_exp_speaker_1 );
		sys.wait( 1 );
		sys.trigger( $exit_tun_2_exp_speaker_2 );
		//give the player a few extra seconds because he closed the doors
		sys.wait( 2 );
	}


	//time for player to get out of third tunnel section
	sys.wait( 5 );
	sys.trigger( $exit_tun_bigfx_3 );
	sys.trigger( $exit_tun_hurt_3 );
	sys.wait( 1 );
	sys.trigger( $exit_tun_3_bigsmoke );

}

