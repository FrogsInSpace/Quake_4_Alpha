void exitDoorOneDisable()
{
	$exitdooronepanel.setGuiParm( "noninteractive", "1" );
	sys.wait( 2 );
	EXIT_DOOR_ONE_CLOSED = true;
}

void exitDoorTwoDisable()
{
	$exitdoortwopanel.setGuiParm( "noninteractive", "1" );
	sys.wait( 2 );
	EXIT_DOOR_TWO_CLOSED = true;
}

void exitDoorThreeDisable()
{
	$exitdoorthreepanel.setGuiParm( "noninteractive", "1" );
	sys.wait( 2 );
	EXIT_DOOR_THREE_CLOSED = true;
}

void animateMakrons()
{
	// DELETE THE MAKRONS
	// MAKE THIS ROOM THE ROOM WHERE YOU SEE ALL THE MANUFACTURING CRAP FOR THE MAKRONS?!
	
	$monster_makron_5.becomePassive( 1 );
	$monster_makron_6.becomePassive( 1 );
	$monster_makron_8.becomePassive( 1 );
	$monster_makron_10.becomePassive( 1 );

	aiScriptedAnim( $monster_makron_8, "death_start", 16, 1 );
	sys.wait( 0.2 );
	aiScriptedAnim( $monster_makron_10, "death_start", 16, 1 );
	sys.wait( 0.5 );
	aiScriptedAnim( $monster_makron_5, "death_start", 16, 1 );
	sys.wait( 0.7 );
	aiScriptedAnim( $monster_makron_6, "death_start", 16, 1 );
	sys.wait( 0.3 );
}

void broken_glass01()
{
	$broken_glass01.show();
	sys.trigger( $broken_glass_steam01 );
}

void rd_spawner( entity rag )
{
	sys.wait( 2.5 );
	rag.kill();
}

void escapeSeqExplosions()
{
	//Series of timed explosion FX and trigger hurts up the exit tunnel

	//Give the elevator time to get to its stopping point
	if( PLAYER_ON_EXIT_ELEVATOR ) {
		sys.wait( 40 );
	}

	//Activate FX and trigger hurt
	sys.trigger( $esc_bot_bigfx_1 );
	sys.trigger( $esc_bot_hurt_1 );
	//Kill the large light for that section of tunnel
	$esc_light_1.Off();
	//Start the secondary smoke
	sys.trigger( $esc_bot_bigfx_1b );

	sys.wait( 8 );
	sys.trigger( $esc_bot_bigfx_2 );
	sys.trigger( $esc_bot_hurt_2 );
	$esc_light_2.Off();
	sys.trigger( $esc_bot_bigfx_2b );

	sys.wait( 8 );
	sys.trigger( $esc_bot_bigfx_3 );
	sys.trigger( $esc_bot_hurt_3 );
	$esc_light_3.Off();
	sys.trigger( $esc_bot_bigfx_3b );

	sys.wait( 8 );
	sys.trigger( $esc_bot_bigfx_4 );
	sys.trigger( $esc_bot_hurt_4 );
	$esc_light_4.Off();
	sys.trigger( $esc_bot_bigfx_4b );

	sys.wait( 8 );
	sys.trigger( $esc_bot_bigfx_5 );
	sys.trigger( $esc_bot_hurt_5 );
	$esc_light_5.Off();
	sys.trigger( $esc_bot_bigfx_5b );
	//Remove the secondary smoke as its very, very far below
	sys.trigger( $esc_bot_bigfx_1b );

	sys.wait( 8 );
	sys.trigger( $esc_bot_bigfx_6 );
	sys.trigger( $esc_bot_hurt_6 );
	sys.trigger( $esc_bot_bigfx_6b );
	//Remove the secondary smoke as its very, very far below
