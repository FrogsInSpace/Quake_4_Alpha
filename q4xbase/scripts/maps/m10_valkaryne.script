void youAreTehWinnar()
{
	aiScriptedAnimLoop( $char_dropship, "relaxed_idle", 10 );
	
	PLAYER_ON_DROPSHIP = true;
	
	$player1.bind( $mover_dropship );
	$player1.disableWeapon();
	$mover_dropship.time( 5 );
	$mover_dropship.accelTime( 1 );
	$mover_dropship.moveTo( $dropship_null_2 );
	sys.waitFor( $mover_dropship );
	$mover_dropship.moveTo( $dropship_null_3 );
	sys.waitFor( $mover_dropship );
	
	thread animBanners(); // animate the banners outside facility
		
	// cut to outside room 
	sys.trigger( $cine_shot01 );	
	
	// make ship fly
	$mover_cine_dropship.enableSplineAngles();
	playAnimWait( $cine_dropship, ANIMCHANNEL_ALL, "idle_all_closed" );
	$mover_cine_dropship.time( 10 );
	$mover_cine_dropship.accelTime( 2 );
	$mover_cine_dropship.decelTime( 0.5 );
	$mover_cine_dropship.startSpline( $spline_dropship );	
	
	// wait a sec or two
	sys.wait( 3.5 );
	
	// trigger explosions
	sys.trigger( $cine_explo01 );
	sys.wait( 0.7 );
	sys.trigger( $cine_explo02 );	
	
	sys.wait( 4 );
	
	//sys.println( "FANTASTIC! Blowjobs for everyone!" );	
	//sys.fadeOut( '0 0 0', 3 );
	
	// rock the camera
	$cine_shot01.bind( $mover_cine_shot01 );
	
	//scriptEvent	void 	bob( float speed, float phase, vector distance );
	$mover_cine_shot01.bob( 10, 1, '0 0 16' );
	
	//scriptEvent	void 	sway( float speed, float phase, vector angles );
	$mover_cine_shot01.sway( 10, 1, '0 10 0' );
	sys.wait( 3 );
	
	$cine_shot01.unbind();
		
	sys.trigger( $cine_shot01 );
	$player1.unbind();
	
	// teleport player to the next cinematic scene which has a trigger_once that executes the "end_cine02" thread below
	$player1.setWorldOrigin( $cine02.getOrigin() );	
}

void end_cine02()
{
	// WARPTO( "$cine02" );
	sys.println( "ENDING IN SPACE" );
	
	// unhide space props
	sys.trigger( $stroggos );
	sys.trigger( $destroyer );
	sys.trigger( $outro_dropship );
	
	// make dropship fly away from stroggos
	thread animDropShipFlyByLanding();
	
	$cine02_shot00.bind( $mover_shot00 );
	// start camera shot00 in space
	sys.trigger( $cine02_shot00 );	
	
	$mover_shot00.accelTime( 1 );
	$mover_shot00.decelTime( 1 );
	$mover_shot00.time( 2 );
	
	//scriptEvent	void 	bob( float speed, float phase, vector distance );	
	$mover_shot00.bob( 10, 1, '0 0 8' );
	$mover_shot00.sway( 10, 1, '0 12 0' );
	
	sys.wait( 8 );
		
	// RHINO SQUAD???
	sys.trigger( $npc_fatigues01 );
	sys.trigger( $npc_fatigues02 );
	sys.trigger( $npc_fatigues03 );
	sys.trigger( $npc_fatigues04 );
	sys.trigger( $npc_fatigues05 );

	// Bay doors open up for dropship	
	sys.trigger( $door_uppper_top_2 );
	
	sys.println( "ENDING IN PATTON BAY" );
		
	// start camera shot01 in patton bay
	sys.trigger( $cine02_shot01 );
	
	sys.wait( 12 );
	
	sys.trigger( $npc_dekard );
	
	$npc_dekard.setAnimRate( 1.2 );
	$npc_dekard.setMoveSpeed( AIMOVESPEED_WALK );
	aiScriptedMoveWait( $npc_dekard, $dekard_spot01, 8, 0 );
	aiScriptedMoveWait( $npc_dekard, $dekard_spot02, 8, 0 );
	
	// show makron/valkaryne emerging
		
	thread theEnd();
}

void theEnd()
{
	sys.println( "GAME OVER!! BLOWJOBS FOR EVERYONE!" );
	sys.fadeOut( '0 0 0', 5);
	sys.wait( 5 );
	sys.trigger( $TEHEND );
}

