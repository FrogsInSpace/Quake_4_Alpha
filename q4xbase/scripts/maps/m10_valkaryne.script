//Large iris doors at bottom of second descent shaft
void operate_4door()  //opens and closes 4 part door
{

	if ( q4doorIsOpen == 1 )
			{
		//close door
		$mover_4door_1.time( 3 );
		$mover_4door_2.time( 3 );
		$mover_4door_3.time( 3 );
		$mover_4door_4.time( 3 );
		$mover_4door_1.accelTime( 0.5 );
		$mover_4door_2.accelTime( 0.5 );
		$mover_4door_3.accelTime( 0.5 );
		$mover_4door_4.accelTime( 0.5 );
		$mover_4door_1.decelTime( 0.5 );
		$mover_4door_2.decelTime( 0.5 );
		$mover_4door_3.decelTime( 0.5 );
		$mover_4door_4.decelTime( 0.5 );
		$mover_4door_1.rotateOnce( '0 45 0' );
		$mover_4door_2.rotateOnce( '0 45 0' );
		$mover_4door_3.rotateOnce( '0 45 0' );
		$mover_4door_4.rotateOnce( '0 45 0' );
		sys.waitFor( $mover_4door_1 );
		q4doorIsOpen	= 0;
	}

	else
	{
		//open door
		$mover_4door_1.time( 3 );
		$mover_4door_2.time( 3 );
		$mover_4door_3.time( 3 );
		$mover_4door_4.time( 3 );
		$mover_4door_1.accelTime( 0.5 );
		$mover_4door_2.accelTime( 0.5 );
		$mover_4door_3.accelTime( 0.5 );
		$mover_4door_4.accelTime( 0.5 );
		$mover_4door_1.decelTime( 0.5 );
		$mover_4door_2.decelTime( 0.5 );
		$mover_4door_3.decelTime( 0.5 );
		$mover_4door_4.decelTime( 0.5 );
		$mover_4door_1.rotateOnce( '0 -45 0' );
		$mover_4door_2.rotateOnce( '0 -45 0' );
		$mover_4door_3.rotateOnce( '0 -45 0' );
		$mover_4door_4.rotateOnce( '0 -45 0' );
		sys.waitFor( $mover_4door_1 );
		q4doorIsOpen	= 1;
	}
}

void moveDropship()
{
	sys.trigger( $char_dropship);
	aiScriptedAnimLoop( $char_dropship, "ad_bidwell_wave", 10 );
	sys.trigger( $dropship );
	//sys.trigger( $dropship_thruster01 ); // effects/cinematics/intro/vtol_5sec
	//sys.trigger( $dropship_thruster02 );
	//sys.trigger( $dropship_thruster03 );
	//sys.trigger( $dropship_thruster04 );	
	playAnimWait( $dropship, ANIMCHANNEL_ALL, "intro_idle" );
	$mover_dropship.time( 3 );
	$mover_dropship.decelTime( 1 );
	$mover_dropship.moveTo( $dropship_null );
	$mover_dropship.rotateOnce( '0 -180 0' );
	sys.waitFor( $mover_dropship );

	$mover_dropship.time( 3 );
	$mover_dropship.accelTime( 1 );
	$mover_dropship.decelTime( 1 );
	$mover_dropship.moveTo( $dropship_null_1 );
	$mover_dropship.rotateOnce( '0 -180 0' );
	sys.wait( 2 );
	
	$busted_beam01.remove();
	sys.trigger( $busted_beam_explo01 );
	$busted_beam02.remove();
	sys.trigger( $busted_beam_explo02 );
	
	sys.waitFor( $mover_dropship );
	
	thread bobbing_dropship();
	thread rolling_dropship();
	thread turning_dropship();
}

void bobbing_dropship()
{	
	//scriptEvent	void 	bob( float speed, float phase, vector distance );	
	
	$mover_dropship.accelTime( 0.3 );
	$mover_dropship.decelTime( 0.3 );
	$mover_dropship.time( 1.5 );
	
	$mover_dropship.bob( 8, 0, '0 0 6' );
}

void rolling_dropship()
{
	//scriptEvent	void 	sway( float speed, float phase, vector angles );
	
	$mover_dropship.accelTime( 0.3 );
	$mover_dropship.decelTime( 0.3 );
	$mover_dropship.time( 1.5 );
	
	$mover_dropship.sway( 8, 4, '10 0 0' );
}

void turning_dropship()
{	
	//scriptEvent	void 	sway( float speed, float phase, vector angles );
	
	$mover_dropship.accelTime( 0.3 );
	$mover_dropship.decelTime( 0.3 );
	$mover_dropship.time( 1.5 );

	$mover_dropship.sway( 4, 1, '0 5 0' );
}

