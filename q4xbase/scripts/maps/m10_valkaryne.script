void sendLiftUp()
{
	$elevator_1.gotoFloor( 2 );
}

// The second tall tunnel
void moveIceCubeDown2()
{
	$navajas.remove();
	$valkaryne01.remove();
	
	// navajas animated on the makron egg
	sys.trigger( $navajas02 );
	aiScriptedAnimLoop( $navajas02, "cine_medic_treating", 10 );
	sys.trigger( $bomb02 );
	$light_bomb02.On();
	
	// open door
	sys.trigger( $tubedoor2_north );

	//move out of tube
	$mover_icecube_2.bind( $mover_icecube_trackthing_2 );

	$mover_icecube_trackthing_2.time( 3 ); // was 5
	$mover_icecube_trackthing_2.moveTo( $cube_null_4 );
	sys.waitFor( $mover_icecube_trackthing_2 );

	sys.trigger( $tubedoor2_north );

	//open the teeth
	$s2_upperarm_teeth_1.time( 1 );
	$s2_upperarm_teeth_1.move( 225, 32 );
	sys.waitFor( $s2_upperarm_teeth_1 );
	$s2_upperarm_teeth_2.time( 1 );
	$s2_upperarm_teeth_2.move( 45, 32 );
	sys.waitFor( $s2_upperarm_teeth_2 );

	//Move out to end of track and move the upper grabber into position
	$mover_icecube_trackthing_2.time( 6 );
	$mover_icecube_trackthing_2.decelTime( 1 );
	$mover_icecube_trackthing_2.moveTo( $cube_null_5 );
	$mover_icecube_trackthing_3.time( 5 );
	$mover_icecube_trackthing_3.accelTime( 1 );
	$mover_icecube_trackthing_3.decelTime( 1 );
	$mover_icecube_trackthing_3.moveTo( $cube_null_7 );
	$mover_upper_icecube_grabber.time( 5 );
	$mover_upper_icecube_grabber.accelTime( 1 );
	$mover_upper_icecube_grabber.decelTime( 1 );
	$mover_upper_icecube_grabber.rotateOnce( '0 -180 0' );
	sys.waitFor( $mover_icecube_trackthing_2 );

	sys.wait( 1 );

	$mover_icecube_2.unbind();
	$mover_icecube_2.bind( $mover_upper_icecube_grabber );

	//close the teeth
	$s2_upperarm_teeth_1.time( 1 );
	$s2_upperarm_teeth_1.move( 225, 32 );
	sys.waitFor( $s2_upperarm_teeth_1 );
	$s2_upperarm_teeth_2.time( 1 );
	$s2_upperarm_teeth_2.move( 45, 32 );
	sys.waitFor( $s2_upperarm_teeth_2 );

	//move the upper grabber out over the middle
	$mover_icecube_trackthing_3.time( 5 );
	$mover_icecube_trackthing_3.accelTime( 1 );
	$mover_icecube_trackthing_3.decelTime( 1 );
	$mover_icecube_trackthing_3.moveTo( $cube_null_6 );
	$mover_upper_icecube_grabber.time( 5 );
	$mover_upper_icecube_grabber.accelTime( 1 );
	$mover_upper_icecube_grabber.decelTime( 1 );
	$mover_upper_icecube_grabber.rotateOnce( '0 180 0' );

	sys.waitFor( $mover_icecube_trackthing_3 );
	
	thread navajasDies();
	
	sys.wait( 1 );

	//move the upper grabber down
	$mover_upper_icecube_grabber.time( 3 );
	$mover_upper_icecube_grabber.accelTime( 0.5 );
	$mover_upper_icecube_grabber.decelTime( 0.5 );
	$mover_upper_icecube_grabber.move( -2, 224 );
	sys.waitFor( $mover_upper_icecube_grabber );

	sys.wait( 1 );

	//open the teeth
	$s2_upperarm_teeth_1.time( 1 );
	$s2_upperarm_teeth_1.move( 225, 32 );
	sys.waitFor( $s2_upperarm_teeth_1 );
	$s2_upperarm_teeth_2.time( 1 );
	$s2_upperarm_teeth_2.move( 45, 32 );
	sys.waitFor( $s2_upperarm_teeth_2 );

	$mover_icecube_2.unbind();

	//move the upper grabber back up
	$mover_upper_icecube_grabber.time( 1.5 );
	$mover_upper_icecube_grabber.accelTime( 0.5 );
	$mover_upper_icecube_grabber.decelTime( 0.5 );
	$mover_upper_icecube_grabber.move( -1, 224 );
	sys.waitFor( $mover_upper_icecube_grabber );


	//---------------------------
	//Begin descent
	//---------------------------
	$mover_icecube_2.bind( $mover_spiralarms );

	$mover_spiralarms.time( 5 );
	$mover_spiralarms.accelTime( 1 );
	$mover_spiralarms.decelTime( 1 );
	$mover_spiralarms.move( -2, 360 );
	$mover_spiralarms.rotateOnce( '0 45 0' );
	sys.waitFor( $mover_spiralarms );

