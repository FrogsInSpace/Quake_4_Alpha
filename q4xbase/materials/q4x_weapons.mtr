models/weapons/goob_gun/w_flamegun

{
	diffusemap 		models/weapons/goob_gun/w_flamegun_d.tga
	bumpmap			models/weapons/goob_gun/w_flamegun_local.tga
	specularmap 	models/weapons/goob_gun/w_flamegun_s.tga
	{
	blend  add
	map 			models/weapons/goob_gun/w_flamegun_add.tga
	red				(.25 * sintable [.5 * time ]) +1
	green			(.1 * sintable [.5 * time ]) +1
	blue			(.1 * sintable [.5 * time ]) +1
	}
	
	{
		maskColor
		map makealpha(models/weapons/goob_gun/w_flamegun_glowmask.tga)
		
	}	
	{
		blend	GL_DST_ALPHA, GL_ONE
	 	maskAlpha
		map models/weapons/goob_gun/w_flamegun_glow.tga
		scroll time * .25, time * .25
		
	}
	{
		blend		GL_DST_ALPHA, gl_one
		maskAlpha
		texgen		reflect
		cubeMap 	gfx/env/marhelmet
		scale       .25, .25
	}	
	

}

