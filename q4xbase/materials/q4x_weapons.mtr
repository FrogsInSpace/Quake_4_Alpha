models/weapons/goob_gun/flame_juice
{

//translucent
//twosided

	{	
		blend blend
		map 					models/weapons/goob_gun/flame_juice.tga
		scale 0.8, 1.0
		scroll time * -0.05, time * -0.05
		green (.5 * sintable [.01 * time ]) +1
		blue  (.5 * cosine [.01 * time ]) +1
	}
	{
		blend add
		map 					models/weapons/goob_gun/flame_juice.tga
		scale 0.5, 0.5
		scroll  time * -.005, time * -.005
	    rotate  time * 0.0005
	    green (.35 * sintable [.03 * time ]) +1 
		blue  (.35 * sintable [.03 * time ]) +1 
	}
	{
		blend add
		map 					models/weapons/goob_gun/flame_juice02.tga
		scale 1.0, 1.0
		scroll  sintable[time * .002], sintable[time * .002]
		rotate  time * -0.0005
		green (1 * cosine [.05 * time ]) +1 
		blue  (1 * cosine [.005 * time ]) +1 
		red   (1 * cosine [.05 * time ]) +1 
	}	

}

models/weapons/goob_gun/flame_glob


{
//deform turbulent sinTable 0.05 (time * .3 ) 1

//deform expand (1* sintable [5 * time ]) +1
//deform move 10*sintable[time*0.5]
deform expand (1* random [.01 * time ]) +1
//translucent
//twosided

	{	
		blend blend
		map 					models/weapons/goob_gun/flame_juice.tga
		scale 0.8, 1.0
		scroll time * -0.5, time * -0.5
		
	}
	
	
	{
		blend add
		map 					models/weapons/goob_gun/flame_juice02.tga
		scale 0.5, 0.5
		scroll  time * .5, time * .5
	    rotate  time * 0.0005
	  
	}
	{
		blend add
		map 					models/weapons/goob_gun/flame_juice02.tga
		scale 1.0, 1.0
		scroll  time * -.2, time * -.2
		rotate  time * -0.075

	}
	
	

}


