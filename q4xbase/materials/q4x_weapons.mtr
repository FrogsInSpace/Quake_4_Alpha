}


textures/marktest/flame_juice
{
qer_editorimage models/weapons/goob_gun/flame_juice.tga
	
//translucent
//twosided
		
	{	
		blend blend
		map 					models/weapons/goob_gun/flame_juice.tga
		scale 5, 5
		scroll time * 0.05, time * 0.05
		green (.5 * sintable [.01 * time ]) +1
		blue  (.5 * cosine [.01 * time ]) +1
		
	}

	{
		blend add
		map 					models/weapons/goob_gun/flame_juice.tga
		scale 5, 5
		scroll  time * .005, time * .005
	    rotate  time * 0.0005
	    green (.35 * sintable [.03 * time ]) +1 
		blue  (.35 * sintable [.03 * time ]) +1 
	}
	{
		blend add
		map 					models/weapons/goob_gun/flame_juice02.tga
		scale 5, 5
		scroll  sintable[time * .002], sintable[time * .002]
		rotate  time * -0.0005
		green (1 * cosine [.05 * time ]) +1 
		blue  (1 * cosine [.005 * time ]) +1 
		red   (1 * cosine [.05 * time ]) +1 
	}	
	
}


