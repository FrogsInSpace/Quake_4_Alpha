models/mapobjects/q4x/cryo_valk_ice/cryo_valk_ice
{
	qer_EditorImage		models/mapobjects/q4x/cryo_valk_ice/cryo_valk_ice_d.tga
	noshadows
	//translucent
	//twosided
	materialType glass
	
	{
		blend diffuseMap
		map models/mapobjects/q4x/cryo_valk_ice/cryo_valk_ice_d.tga
	}

	{
		Program			heatHaze.vfp
		vertexParm		0	time * 0 , time * 0						// texture scrolling
		vertexParm		1	10										// magnitude of the distortion
		fragmentProgram	heatHaze.vfp
		fragmentMap		0	_currentRender
		fragmentMap		1	models/mapobjects/q4x/cryo_valk_ice/cryo_valk_ice_local.tga	// the normal map for distortion
	}
	//{
		//blend blend
		//map models/mapobjects/q4x/cryo_valk_ice/cryo_valk_ice_d.tga
	//}

}

