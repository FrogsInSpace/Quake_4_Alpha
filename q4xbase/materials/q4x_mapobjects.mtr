models/mapobjects/q4x/machines/sf_power_core/sf_core_sphere01
{
	translucent
	{
		blend diffuseMap
		map models/mapobjects/q4x/machines/sf_power_core/sf_core_sphere01_d.tga
		scroll time * 0.6, time * 0.3
	}	

	{
		Program			heatHaze.vfp
		vertexParm		0	time * 0.6 , time * 0.3								// texture scrolling
		vertexParm		1	4													// magnitude of the distortion
		fragmentProgram	heatHaze.vfp
		fragmentMap		0	_currentRender
		fragmentMap		1	models/mapobjects/q4x/machines/sf_power_core/sf_core_sphere01_local.tga	// the normal map for distortion
	}

	//specularMap		models/mapobjects/q4x/machines/sf_power_core/sf_core_sphere01_s.tga

	
	{
		blend GL_DST_COLOR, GL_ONE
		map models/mapobjects/q4x/machines/sf_power_core/sf_core_sphere01_d.tga
		scroll time * -0.6, time * 0.3
	}

	{
		blend add
		map models/mapobjects/q4x/machines/sf_power_core/sf_core_sphere01_d.tga
		scroll time * -0.6, time * 0.3
	}
	
}



