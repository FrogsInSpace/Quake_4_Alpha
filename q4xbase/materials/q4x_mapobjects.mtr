models/mapobjects/q4x/valk_makronball/makronsphere

{
	noShadows
	translucent
	//John S:  this has to be solid so the player can shoot it
	//nonSolid
	twoSided
	deform turbulent sinTable 0.009 (time * .05 ) 1
	
	materialType glass
	
	qer_editorimage 			textures/q4x_cryo/Fluid01.tga

	{
		Program			heatHaze.vfp
		vertexParm		0	time * 0 , time * 0.2			// texture scrolling
		vertexParm		1	7								// magnitude of the distortion
		fragmentProgram	heatHaze.vfp
		fragmentMap		0	_currentRender
		fragmentMap		1	textures/q4x_cryo/fluid01_local.tga	// the normal map for distortion
	}
	
	{
		blend diffuseMap	
		map 					models/mapobjects/q4x/valk_makronball/makronsphere01
		scale 1.3, 0.35
		scroll time * 0.5, time * 0.5
		rgb          (5 * sintable [.3 * time ]) +5 
		
	}

	{
		blend		add
		texgen		reflect
		cubeMap 	gfx/env/valk
		
	}

	{
		blend add
		map 					models/mapobjects/q4x/valk_makronball/makronsphere01
		scale 1.9, 1.2
		scroll time * 0.05, time * 0.051
			
		
	}
	
	{
		blend blend
		map 					textures/q4x_cryo/Fluid04.tga
	}


}

