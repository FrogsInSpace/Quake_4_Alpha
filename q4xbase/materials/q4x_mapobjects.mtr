models/mapobjects/marine/equipment/misc/data_station3
{
      noSelfShadow
      unSmoothedTangents

	renderBump  -size 512 512 -trace 0.05 -aa 2 -mergehigh models/mapobjects/marine/equipment/misc/data_station3_local.tga work/models/mapobjects/marine/equipment/misc/data_station3_high.lwo

	materialType solidmetal

	bumpmap	addnormals	( models/mapobjects/marine/equipment/misc/data_station3_local.tga, heightmap ( models/mapobjects/marine/equipment/misc/data_station3_h.tga,1 ) )
	diffusemap		models/mapobjects/marine/equipment/misc/data_station3_d.tga
	specularmap		models/mapobjects/marine/equipment/misc/data_station3_s.tga


}

models/mapobjects/q4x/doors/cryoframe_d
{
	qer_editorimage mapobjects/q4x_cryo/cryoframe_d.tga

	diffusemap 			models/mapobjects/q4x/doors/cryoframe_d.tga
    bumpmap				models/mapobjects/q4x/doors/cryoframe_local.tga
	specularmap 		models/mapobjects/q4x/doors/cryoframe_s.tga
	
	{
		blend add
		map models/mapobjects/q4x/doors/cryoframe_add.tga
		//rgb (0.5 * sintable [.5 * time ]) +0.5
	}
	
	{
		if ( parm7 == 0 )
		blend 	add
		map		models/mapobjects/q4x/doors/cryoframe_lock.tga
		red		1
		green	0.1
		blue	0.1

	}
	{
		if ( parm7 == 1 )
		blend 	add
		map		models/mapobjects/q4x/doors/cryoframe_lock.tga
		red		0.6
		green	1
		blue	0.23
	}
}


