models/mapobjects/q4x/cryo_queenlight/cryo_queenlight_glass
{
	qer_EditorImage		models/mapobjects/q4x/cryo_queenlight/cryo_queenlight_glass_d.tga
	noshadows
	translucent
	materialType glass
	
	{
		blend diffuseMap
		map models/mapobjects/q4x/cryo_queenlight/cryo_queenlight_glass_d.tga
	}

	{
		Program			heatHaze.vfp
		vertexParm		0	time * 0 , time * 0						// texture scrolling
		vertexParm		1	5										// magnitude of the distortion
		fragmentProgram	heatHaze.vfp
		fragmentMap		0	_currentRender
		fragmentMap		1	models/mapobjects/q4x/cryo_queenlight/cryo_queenlight_glass_local.tga	// the normal map for distortion
	}
	{
		blend blend
		map models/mapobjects/q4x/cryo_queenlight/cryo_queenlight_glass_d.tga
	}

}

