textures/rock/q4x_trian_crystals
{
	noshadows
	//translucent
	twosided
//	materialType glass
	
	{
		blend diffuseMap
		map textures/rock/q4x_trian_crystals_d.tga
		scale 1, 1
	}

	//{
		//Program			heatHaze.vfp
		//vertexParm		0	time * 0 , time * 0						// texture scrolling
		//vertexParm		1	1										// magnitude of the distortion
		//fragmentProgram	heatHaze.vfp
		//fragmentMap		0	_currentRender
		//fragmentMap		1	textures/rock/q4x_trian_crystals_local.tga	// the normal map for distortion
	//}
	{
		blend 		specularmap
		map			textures/rock/q4x_trian_specks_s.tga
		scale 		1, 1
	}

	{
		blend add
		map textures/rock/q4x_trian_crystals_d.tga
		rgb 	0.5	//	(.2 * sinTable [2 * time ]) + 1
		scale 1, 1
	}
}