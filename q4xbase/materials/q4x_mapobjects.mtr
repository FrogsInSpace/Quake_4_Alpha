textures/rock/q4x_sand01_to_q4x_sharprock01_brown
{
        materialType rock  
        noselfshadow
	{
		blend		bumpmap
		map			textures/rock/q4x_sand01_local.tga
		scale 		2, 2
	}
	{
		blend 		diffusemap
		map			textures/rock/q4x_sand01_d.tga
		scale 		3, 3
		vertexColor
	}
	{
		blend 		specularmap
		map			textures/rock/q4x_sand01_s.tga
		scale 		3, 3
		vertexColor
	}
	{
		blend		bumpmap
		map			textures/rock/q4x_sharprock_local.tga
		scale 		1.5, 1.5
	}
	{
		blend		diffusemap
		map			textures/rock/q4x_sharprock01_brown_d.tga
		scale 		2, 2
		inverseVertexColor
	}
	{
		blend		diffusemap
		map			textures/rock/q4x_sharprock01_brown_s.tga
		scale 		1, 1
		inverseVertexColor
	}
}

