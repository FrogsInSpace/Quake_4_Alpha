textures/medlabs/vol_lblue_256

// light blue flare intended to be used over a large area to give the impression of volumetric light
{
	noshadows
	translucent
	nonsolid
	deform	flare 		256
	qer_EditorImage	textures/common_misc/QER_flare.tga
	{
		blend add
		map _quadratic
		red 		.9
		green		.9
		blue		1
		alpha	.1
		vertexcolor
	}
}

/////////////// Shaders added by Steve H    //////////////////////////////////////////////////////////////////////////
textures/q4x_m10/support_2sided
{
	twosided

	qer_editorimage textures/q4x_m10/support_2sided_d.tga 
		
	specularmap 	textures/q4x_m10/support_2sided_s.tga
	bumpmap 	textures/q4x_m10/support_2sided_local.tga
	{       
		blend			diffuseMap 
		map			textures/q4x_m10/support_2sided_d.tga
		alphaTest .5
	}
}

