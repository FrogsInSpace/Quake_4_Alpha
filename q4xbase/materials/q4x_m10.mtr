textures/q4x_m10/damaged_pipes01_add
{
	qer_EditorImage		textures/q4x_m10/damaged_pipes01_d.tga
	bumpMap			textures/q4x_m10/damaged_pipes01_local.tga
	diffuseMap		textures/q4x_m10/damaged_pipes01_d.tga
	specularMap		textures/q4x_m10/damaged_pipes01_s.tga
	{
		blend add
		map textures/q4x_m10/damaged_pipes01_add.tga
		rgb 	firetable2 [time * .3]
	}
}

