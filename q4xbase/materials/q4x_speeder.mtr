guide textures/common_walls/c_support02 generic_materialimageshader("common_walls/c_support02")

textures/Stream/chad_pipe_1_stream
{
	qer_editorimage	textures/medlabs/chad_pipe_1_d.tga
	translucent
	noshadows

	{		//Original diffuse 
	blend		diffusemap
	map 		textures/medlabs/chad_pipe_1_d.tga
	}

	{		//Original specular map
	blend		specularmap
	map		textures/medlabs/chad_pipe_1_s.tga
	}

	{		//Original normalmap with height
	blend		bumpmap
	map		addnormals(textures/medlabs/chad_pipe_1_local.tga, heightmap(textures/medlabs/chad_pipe_1_h.tga,1))
	}
}


