textures/q4x_speeder/terrain01_to_terrain02
{
        materialType rock     
	{
		blend		bumpmap
		map			textures/q4x_speeder/terrain01_local.tga
		scale 2, 2
	}
	{
		blend 		diffusemap
		map			textures/q4x_speeder/terrain01_d.tga
		//scale 2, 2
		vertexColor
	}
	{
		blend		bumpmap
		map			textures/q4x_speeder/terrain02_local.tga
	}
	{
		blend		diffusemap
		map			textures/q4x_speeder/terrain02_d.tga
		inverseVertexColor
	}
}

textures/q4x_speeder/terrain01_to_terrain03
{
        materialType rock     
	{
		blend		bumpmap
		map			textures/q4x_speeder/terrain01_local.tga
		scale 2, 2
	}
	{
		blend 		diffusemap
		map			textures/q4x_speeder/terrain01_d.tga
		scale 2, 2
		vertexColor
	}
	{
		blend		bumpmap
		map			textures/q4x_speeder/terrain03_local.tga
		//map		heightmap (textures/rock/skysand1_bmp.tga, 4)
		scale 2, 2
	}
	{
		blend		diffusemap
		map			textures/q4x_speeder/terrain03_d.tga
		inverseVertexColor
	}
}