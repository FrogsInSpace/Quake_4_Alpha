/// Added by Wyeth /////

textures/q4x_speeder/tubeframe01
{
	qer_editorimage 		textures/q4x_speeder/speed_tube01_d.tga
	twoSided
	noshadows
	translucent

	bumpmap 				textures/q4x_speeder/speed_tube01_local.tga
	
	{       
		blend				diffuseMap 
		map					textures/q4x_speeder/speed_tube01_d.tga
		alphaTest .5
	}
	
	specularmap				textures/q4x_speeder/speed_tube01_s.tga
}





textures/q4x_speeder/tubefluid_red
{
	noShadows
	twoSided
	
	materialType glass
	
	qer_editorimage 			textures/q4x_speeder/Fluid01.tga

	{
		blend diffuseMap	
		map 					textures/q4x_speeder/Fluid01.tga
		scale 1, 0.1
		scroll time * 0.0, time * 0.9
	}

	{
		blend GL_ONE, GL_ONE
		map 					textures/q4x_speeder/Fluid02.tga
		scale 0.6, 0.175
		scroll time * 0., time * 2
	}

	{
		blend GL_DST_COLOR, GL_ONE
		map 					textures/q4x_speeder/Fluid01.tga
		scale 1.75, 1.2
		scroll time * 0, time * 2.2
	}

}


textures/q4x_speeder/tubefluid_green
{
	noShadows
	twoSided
	
	materialType glass
	
	qer_editorimage 			textures/q4x_speeder/Fluid01.tga

	{
		blend diffuseMap	
		map 					textures/q4x_speeder/Fluid01.tga
		scale 1, 0.1
		scroll time * 0.0, time * 0.9
		red 0.1
		green 1
		blue 1
	}

	{
		blend GL_ONE, GL_ONE
		map 					textures/q4x_speeder/Fluid02.tga
		scale 0.6, 0.175
		scroll time * 0., time * 2
		red 0.1
		green 1
		blue 1
	}

	{
		blend GL_DST_COLOR, GL_ONE
		map 					textures/q4x_speeder/Fluid01.tga
		scale 1.75, 1.2
		scroll time * 0, time * 2.2
		red 0.1
		green 1
		blue 1
	}

}


textures/q4x_speeder/tubefluid_sludge
{
	noShadows
	twoSided
	
	materialType glass
	
	qer_editorimage 			textures/q4x_speeder/Fluid01.tga

	{
		blend diffuseMap	
		map 					textures/q4x_speeder/Fluid01.tga
		scale 1, 0.1
		scroll time * 0.0, time * 0.9
		red 0.3
		green 0.6
		blue 1
	}

	{
		blend GL_ONE, GL_ONE
		map 					textures/q4x_speeder/Fluid02.tga
		scale 0.6, 0.175
		scroll time * 0., time * 2
		red 0.3
		green 0.6
		blue 1
	}

	{
		blend GL_DST_COLOR, GL_ONE
		map 					textures/q4x_speeder/Fluid01.tga
		scale 1.75, 1.2
		scroll time * 0, time * 2.2
		red 0.3
		green 0.6
		blue 1
	}

	{
		blend specularMap	
		map 					textures/q4x_speeder/Fluid02.tga
		scale 1, 0.1
		scroll time * 0.0, time * 0.9
		red 0.3
		green 0.3
		blue 0.3
	}

}


textures/q4x_speeder/energytube01_scroll
{
	qer_editorimage 		textures/q4x_speeder/speed_tube02_qer.tga

	bumpmap 				textures/q4x_speeder/speed_tube02_local.tga
	diffuseMap				textures/q4x_speeder/speed_tube02_d.tga
	specularmap				textures/q4x_speeder/speed_tube02_s.tga
	
	{
		blend 				add	
		map 				textures/q4x_speeder/speed_tube02_e.tga
		scale 				1, 1
		scroll 				time * 0.0, time * 1
		rgb 				0.6
	}

	{
		blend 				add	
		map 				textures/q4x_speeder/speed_tube02_e.tga
		scale 				1, 0.85
		scroll 				time * 0.0, time * 1.5
		rgb 				0.6
	}
}


