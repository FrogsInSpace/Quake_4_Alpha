textures/canyon/Can_Rockwall_01
{	//Rock wall for the sides of the canyons

	qer_editorimage	textures/canyon/Can_Rockwall_01_d.tga

	materialType	rock
	
	{
	blend		bumpmap
	map		addnormals (textures/canyon/Can_Rockwall_01_local.tga, heightmap (textures/canyon/Can_Rockwall_01_h.tga, 16) )

	}

	{
	blend		diffusemap
	map		textures/canyon/Can_Rockwall_01_d.tga
	}

	{
	blend		specularmap
	map		textures/canyon/Can_Rockwall_01_s.tga
	}
}