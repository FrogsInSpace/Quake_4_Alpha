textures/q4x_decals/ice_flow01
{
	//DECAL_MACRO
	translucent
	noshadows
	qer_editorimage	textures/q4x_decals/ice_flow01.tga
	
	{
		Program			heatHaze.vfp
		vertexParm		0	time * 0 , time * 0
		vertexParm		1	5
		fragmentProgram	heatHaze.vfp
		fragmentMap		0	_currentRender
		fragmentMap		1	textures/q4x_decals/ice_flow01_local.tga
	}
	{       
		blend		gl_dst_color, gl_src_color
		//blend		diffusemap
		map			textures/q4x_decals/ice_flow01.tga
	}
	
	specularmap 	textures/q4x_decals/ice_flow01_s.tga
	
	{       
		blend		blend
		map			textures/q4x_decals/ice_flow01.tga
		alpha 		0.25
	}
}

