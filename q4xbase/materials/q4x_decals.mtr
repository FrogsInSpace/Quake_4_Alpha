textures/q4x_decals/h9k
{
	qer_editorimage textures/q4x_decals/h9k_d.tga
	DECAL_MACRO
	noShadows
	noimpact

	diffusemap textures/q4x_decals/h9k_d.tga
	{
		blend add
		map textures/q4x_decals/h9k_add.tga
	}
}

textures/q4x_decals/blastmark01_q4x
{
	qer_editorimage textures/q4x_decals/blastmark01_q4x.tga
	DECAL_MACRO
	noShadows
	noimpact
	translucent
	{
       	blend GL_DST_COLOR, GL_SRC_COLOR
