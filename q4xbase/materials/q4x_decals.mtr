textures/q4x_decals/cryo_frost_tile01
{
	qer_editorimage textures/q4x_decals/cryo_frost_tile01.tga
	DECAL_MACRO
	noShadows
	noimpact
	translucent
	{       
		blend				blend 
		map				textures/q4x_decals/cryo_frost_tile01.tga
		red       Parm0
		green     Parm1
		blue      Parm2
		alpha     Parm3
	}
	{
		blend 				specularmap
		map				textures/q4x_decals/cryo_frost_tile01_s.tga
	
		red       Parm0
		green     Parm1
		blue      Parm2
		alpha     Parm3
	}
}

