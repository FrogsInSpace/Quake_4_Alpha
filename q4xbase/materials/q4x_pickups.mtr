models/pick_ups/mp_pickups/mp_q4x_adrenal
{
      noSelfShadow
      //unSmoothedTangents

	bumpmap			models/pick_ups/mp_pickups/mp_q4x_adrenal_local.tga
	diffusemap		models/pick_ups/mp_pickups/mp_q4x_adrenal_d.tga
	specularmap		models/pick_ups/mp_pickups/mp_q4x_adrenal_s.tga
