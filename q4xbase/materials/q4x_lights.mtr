//scrolling trench cloud overlay--------------------------

lights/groundoverlay_trench
{	
	lightFalloffImage	_white
	{
		forceHighQuality
		map		gfx/lights/clouds_1.tga
		translate	(time * 0.5 * parm5), (time * -1 * parm5)
		colored
	}
}