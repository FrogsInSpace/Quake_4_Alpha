textures/prison/prisoner_flare

// large orange flare
{

	noshadows
	translucent
	nonsolid
	deform	flare 		10



	{

		blend add
		map _quadratic
		
		
		red        1 
		green     .67
		blue	    .04
		alpha	    .3


	


	
		vertexcolor
	}

}


textures/prison/prison_flare_combine

// large orange flare
{

	noshadows
	translucent
	nonsolid
	deform	flare 		10



	{

		blend add
		map _quadratic
		
		red        parm0 
		green      parm1 
		blue	     parm2 
		alpha	     parm3 


		colored
		vertexcolor
	}

}






