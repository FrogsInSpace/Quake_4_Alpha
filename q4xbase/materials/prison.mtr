textures/prison/p4_light_snd

{
	qer_editorimage textures/prison/p4_light_d.tga

	bumpmap addnormals ( textures/prison/p4_light_local.tga, heightmap ( textures/prison/p4_light_h.tga, 1 ) )
	diffusemap	textures/prison/p4_light_d.tga
	specularmap	textures/prison/p4_light_s.tga
	
	{
		blend GL_ONE, GL_ONE
		map    textures/prison/p4_light_g.tga
		
		red		Parm0 
		green		Parm1  
		blue		Parm2  
	
	
	}

}

