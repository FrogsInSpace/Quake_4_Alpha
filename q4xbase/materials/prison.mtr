	diffusemap	textures/prison/p4_beam_3_d.tga
	specularmap	textures/prison/p4_beam_3_s.tga
	
}

















textures/prison/pglass
{
	translucent
	twoSided
	noshadows
//	sort close		
	qer_editorimage		textures/prison/pglass_d.tga

	bumpmap heightmap ( textures/prison/pglass_h.tga, 7 )
	specularmap	 textures/prison/pglass_s.tga

	{
	 	uncompressed
		blend blend
		map textures/prison/pglass_d.tga
	}

	{
		blend add
		cubeMap		gfx/env/prisonorange
		texgen		reflect
	}	

}

