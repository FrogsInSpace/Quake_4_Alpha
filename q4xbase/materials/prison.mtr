textures/prison/prison_fencelink1t
{
	qer_editorimage textures/prison/prison_fencelink1t_d.tga
	
	noshadows
	twosided

//	bumpmap addnormals ( textures/prison/prison_fencelink1t_local.tga, heightmap ( textures/prison/prison_fencelink1t_h.tga, 1 ) )
//	specularmap	textures/prison/prison_fencelink1t_s.tga

	{       

     	 blend bumpmap
	 map	textures/prison/prison_fencelink1t_local.tga
	 scale 6, 6 
	}

	{       
     	 blend specularmap
	 map	textures/prison/prison_fencelink1t_s.tga
	 scale 6, 6 
	}
	{       

     	 blend	diffusemap 
	 map	textures/prison/prison_fencelink1t_d.tga
	 alphaTest .5
	 scale 6, 6 
	}
}


