table walkway_pulse    { {.9, .8, .7, .6, .7, .8, .8, 1} }


//prison cellblock sign

textures/prison/strogg_cellblock_sign
{	
	qer_editorimage		gfx/guis/common/strogg/cellblockbg
	noShadows
	translucent
	{
		Map gfx/guis/common/strogg/cellblockbg.tga
		red	guitable_random2  [ time * 1 ]
		green	guitable_random2  [ time * 1 ]
		blue	guitable_random2  [ time * 1 ]
		alpha	parm3
	}

	{
		blend add
		Map gfx/guis/common/monitor_line3.tga
		scroll 0, -.2 * time
		colored
	}

	{
		blend blend
		Map gfx/guis/common/screen_dirt1.tga
		red .5
		green .2
		blue 0
		alpha 1
	}
}

