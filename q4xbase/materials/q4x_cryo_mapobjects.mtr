//	cryoarm----------------------------------------------------------------------------

models/mapobjects/q4x/cryo_cryoarms/cryoarm_arm
{	
	noselfShadow
//	unsmoothedtangents
	
	diffusemap	models/mapobjects/q4x/cryo_cryoarms/cryoarm_arm_d.tga
	specularmap	models/mapobjects/q4x/cryo_cryoarms/cryoarm_arm_s.tga
	bumpmap		models/mapobjects/q4x/cryo_cryoarms/cryoarm_arm_local.tga
	{ 
		blend add
		map models/mapobjects/q4x/cryo_cryoarms/cryoarm_arm_glowpass.tga
		rgb grunttable [ time * 1.3 ]
	}
	}
	
