//added by John, 8-2-05
models/mapobjects/q4x/cryo_cave01/rock2ice
{
           noSelfShadow
           materialType glass
	{
		blend 		bumpmap
		map			textures/rock/sharprock_local.tga
	}
	{
		blend 		diffusemap
		map			textures/rock/sharprock01_brown_d.tga
		inverseVertexColor
	}
	{
		blend 		bumpmap
		map			models/mapobjects/q4x/cryo_cave01/cryo_cave01_local.tga
	}
	{
		blend 		diffusemap
		map			models/mapobjects/q4x/cryo_cave01/cryo_cave01_d.tga
		VertexColor
	}
	{
		blend		gl_dst_color, gl_one
		texgen		reflect
		cubeMap gfx/env/marhelmet
	}

}

//models/mapobjects/strogg/machines/elevators_and_lifts/lift_7_28  (skin variant) -------------------------------------------

models/mapobjects/q4x/cryo_elevator/platform
{
      	noselfShadow
	unsmoothedtangents
	materialImage 		models/mapobjects/q4x/cryo_elevator/platform_hit.tga

	bumpmap		addnormals (models/mapobjects/q4x/cryo_elevator/platform_local.tga, heightmap (models/mapobjects/q4x/cryo_elevator/platform_h.tga, 2))
	diffusemap		models/mapobjects/q4x/cryo_elevator/platform_d.tga
	specularmap		models/mapobjects/q4x/cryo_elevator/platform_s.tga

}

