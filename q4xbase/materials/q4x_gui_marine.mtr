	translucent
	{
		blend GL_SRC_ALPHA, GL_ONE
		Map gfx/guis/q4x_crosshairs/aa_space_OOR_FX.tga
		vertexcolor
		clamp
		alpha 0.0
	}
}

gfx/guis/q4x_crosshairs/aa_space_lock_FX
