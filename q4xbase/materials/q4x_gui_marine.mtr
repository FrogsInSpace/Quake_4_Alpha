//// More main menu madness ////

gfx/guis/mainmenu/q4logoleft
{
	noshadows
	translucent
	{
		nopicmip
		clamp
		blend GL_ZERO, gl_one_minus_src_color
		map gfx/guis/mainmenu/q4logoleft.tga
		colored
	}
}

gfx/guis/mainmenu/q4logoright
{
	noshadows
	translucent
	{
		nopicmip
		clamp
		blend GL_ZERO, gl_one_minus_src_color
		map gfx/guis/mainmenu/q4logoright.tga
		colored
	}
}

gfx/guis/mainmenu/swirl_bg
{
	noshadows
	translucent
	{
		blend GL_DST_COLOR, GL_ONE
		map gfx/guis/mainmenu/swirl_bg.tga
		colored
		scroll time * 0.01, time * 0.08
		scale 2.4, 2.4
	}
	{
		blend GL_DST_COLOR, GL_ONE
		map gfx/guis/mainmenu/swirl_bg.tga
		colored
		scroll time * 0.04, time * 0.04
		scale 2.0, 2.0
	}
	{
		blend GL_DST_COLOR, GL_ONE
		map gfx/guis/mainmenu/swirl_bg.tga
		colored
		scroll time * -0.03, time * 0.1
		scale 2.8, 2.8
	}
}