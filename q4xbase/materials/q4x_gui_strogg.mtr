//Valkaryne face that appears on GUIs as the player makes his way through M09 and M10, added by JohnS
gfx/guis/maps/cryo/valkimage
{	
	noShadows
	translucent
	{
		colored
		Map gfx/guis/maps/cryo/valkimage.tga
	}
}

gfx/guis/maps/cryo/cryo01_bg
{	
	noShadows
	translucent
	{
		blend blend
		colored
		Map gfx/guis/maps/cryo/cryo01_bg.tga
		//scroll 0, .35 * time
	}
}

