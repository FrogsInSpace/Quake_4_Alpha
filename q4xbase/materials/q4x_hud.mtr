gfx/guis/hud/icons/gun_flamegun
{	
	noShadows
	translucent
	
	{
		blend blend
		Map   gfx/guis/hud/icons/gun_flamegun.tga
		colored
	}
}

gfx/guis/hud/icons/item_flamegun_colored
{	
	noShadows
	translucent
	
	{
		blend blend
		Map    gfx/guis/hud/icons/item_fire.tga
		red 1
		green 1
		blue 0
		alpha parm3
	}
}


