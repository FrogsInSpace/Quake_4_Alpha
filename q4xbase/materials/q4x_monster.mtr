models/monsters/valkaryne/valkaryne_plate
{
	
	materialType glass
	noselfshadow
	collision
//	translucent
//	unsmoothedtangents
	
	materialImage models/monsters/valkaryne/valkaryne_plate_d.tga
	
	
	diffuseMap 		models/monsters/valkaryne/valkaryne_plate_d.tga		
	bumpmap			models/monsters/valkaryne/valkaryne_plate_local.tga
	specularmap		models/monsters/valkaryne/valkaryne_plate_s.tga

	
	
	{
		if parm7 < 1
		Program   heatHaze.vfp
		vertexParm 	0 time * 0, time * 0.0
		vertexParm  	1 4
		fragmentProgram heatHaze.vfp
		fragmentMap  0 _currentRender
		fragmentMap  1 models/monsters/valkaryne/valkaryne_plate_local.tga
		}
// COMMENTED THIS OUT BECAUSE THE FRAGMENT SHADER DOES NOT WORTH WITH ALPHATESTING


		{									
		if	parm7		// This is a replacement pass which stands in for the corpse burn effect					
		blend 			blend
		map 			models/monsters/corpseBurnEffect_sm.tga
		alphaTest 		0.1 + 0.3 * (time - parm7)	
		}


inlineGuide corpseBurnEffect(models/monsters/retch/retch_body_tport.tga)
}
