models/monsters/q4x_grunt/q4x_grunt_head
{
	noselfShadow
	unSmoothedTangents
	

	diffusemap	downsize( models/monsters/q4x_grunt/q4x_grunt_head_d.tga, 1 )
	bumpmap	addnormals ( models/monsters/grunt/grunt_head_local.tga, heightmap ( models/monsters/grunt/grunt_head_h.tga, 3 ))
	specularmap	downsize( models/monsters/grunt/grunt_head_s.tga, 1 )
	inlineGuide corpseBurnEffect(models/monsters/grunt/grunt_head_tport.tga)
	
	{ 
		if ( parm6 == 0 )
		blend add
		map models/monsters/q4x_grunt/q4x_grunt_head_g.tga
		rgb grunttable [ time * .6 ]
	}

	{
		if ( parm6 != 0 )
		maskColor
		map makealpha(models/monsters/grunt/grunt_head_glowmask)
	}

	{
		if ( parm6 != 0 )
		blend gl_dst_alpha, gl_one
	 	maskAlpha
		map models/monsters/q4x_grunt/q4x_grunt_glow.tga
		scroll time * .04, time * -.1
		rgb gruntglow [ time * .6 ]
	}

	{ 
		if ( parm6 != 0 )
		blend add
		map models/monsters/q4x_grunt/q4x_grunt_head_g2.tga
		rgb grunttable [ time * 1.3 ]
	}
}



