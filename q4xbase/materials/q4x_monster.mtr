models/vehicles/strogg_flyer/q4x_strogg_flyer_lo
{      
	noSelfShadow
	unSmoothedTangents
	materialImage	models/vehicles/strogg_flyer/strogg_flyer_lo_hit.tga

		diffusemap	models/vehicles/strogg_flyer/q4x_strogg_flyer_lo_d.tga
		bumpmap	addnormals ( models/vehicles/strogg_flyer/strogg_flyer_lo_local.tga, heightmap ( models/vehicles/strogg_flyer/strogg_flyer_lo_h.tga, 1 ))
		specularmap	models/vehicles/strogg_flyer/strogg_flyer_lo_s.tga
		
		{ 
			if (Parm4) == 0
			blend add
			map models/vehicles/strogg_flyer/strogg_flyer_lo_g.tga
			rgb grunttable [ time * 1.3 ]
		}
		{ 
			if (Parm4) == 0 
			blend add
			map models/vehicles/strogg_flyer/strogg_flyer_lo_g2.tga
		}
		{
			if (Parm4) == 1
			blend add
			map _black
		}
}

models/vehicles/strogg_flyer/q4x_strogg_flyer_lo_death
{
	noSelfShadow
	unSmoothedTangents

	diffusemap models/vehicles/strogg_flyer/q4x_strogg_flyer_lo_d.tga
}


//tank--------------------------------------------------------------------------------------------------
table monster_tankTable { { 1, 0 } }
table monster_retchTable { { .4, .3, .5, .7, 1, .6, .3, 1 } }
table monster_retchTable2 { { 1, 0.4, 1, 1, 0.9, 0.9, 0.8, 0.7, 0.6, 0.5 } }



models/monsters/tank/tank
{
	
	noselfshadow
	collision
//	unsmoothedtangents
	
	materialImage models/vehicles/strogg_flyer/strogg_flyer_lo_hit.tga
	
	
	diffuseMap 		models/monsters/tank/tank_d.tga		
	bumpmap			models/monsters/tank/tank_local.tga
	specularmap		models/monsters/tank/tank_s.tga
	
		{ 
		blend add
		map models/monsters/tank/tank_glowpass.tga
		rgb monster_tankTable [ time * 1 ]
		}
		
		{ 
		blend add
		map models/monsters/tank/tank_glowpass1.tga
		rgb monster_tankTable [ time * 1.35 ]
		}
		
		inlineGuide corpseBurnEffect(models/monsters/corpseBurnEffect_sm.tga)

}


