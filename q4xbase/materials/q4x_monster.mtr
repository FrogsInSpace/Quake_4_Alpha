//q4x_strogg_flyer_bomber------------------------------------------------------------------------
models/monsters/q4x_strogg_flyer_bomber/strogg_flyer_bomber
{
		//unsmoothedtangents		
		//twosided
		
			
	
		
		diffusemap 		models/monsters/q4x_strogg_flyer_bomber/strogg_flyer_bomber_d.tga
    	bumpmap			models/monsters/q4x_strogg_flyer_bomber/strogg_flyer_bomber_local.tga
		specularmap 	models/monsters/q4x_strogg_flyer_bomber/strogg_flyer_bomber_s.tga
		{ 
		blend add		
		map				models/monsters/q4x_strogg_flyer_bomber/strogg_flyer_bomber_add.tga
		}  
		{ 
		blend add		
		map				models/monsters/q4x_strogg_flyer_bomber/strogg_flyer_bomber_add2.tga
		rgb 			(.5 * sinTable [.5 * time ]) + 1			
		}            
}

models/monsters/q4x_strogg_flyer_bomber/strogg_flyer_bomber_gizmo


{
		//unsmoothedtangents		
		diffusemap 		models/monsters/q4x_strogg_flyer_bomber/strogg_flyer_bomber_gizmo_d.tga
    	bumpmap			models/monsters/q4x_strogg_flyer_bomber/strogg_flyer_bomber_gizmo_local.tga
		specularmap 	models/monsters/q4x_strogg_flyer_bomber/strogg_flyer_bomber_gizmo_s.tga
}

models/monsters/q4x_strogg_flyer_bomber/strogg_flyer_bomber_glass

 {
	noSelfShadow
	noshadows
	twosided
	translucent
	glass
	forceoverlays
	sort decal
	
	materialType	glass
	
	qer_editorimage textures/glass/outdoorglass1_mask
	{
                Program           heatHaze.vfp
                vertexParm              0       time * 0 , time * 0 // texture scrolling
                vertexParm              1       .4         // magnitude of the distortion
                fragmentProgram			heatHaze.vfp
                fragmentMap             0       _currentRender
                fragmentMap             1       gfx/env/vp1   // the normal map for distortion			
             
    }
	{
		blend		filter
		map 		models/monsters/q4x_strogg_flyer_bomber/strogg_flyer_bomber_glass_d.tga
	}
		
	{
	    blend add
       	cubeMap		gfx/env/outsideglass1
        texgen		reflect
		red Parm0
		green Parm1
		blue  Parm2
	}
	
	{
		blend blend
		map 		models/monsters/q4x_strogg_flyer_bomber/strogg_flyer_bomber_glass_d.tga
	}
	
}

