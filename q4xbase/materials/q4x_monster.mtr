models/monsters/strogg_fighter_formation/strogg_fighter_formation
{
	noSelfShadow
	noimpact
	unSmoothedTangents
	  
	renderbump  -size 512 512 -trace 0.09 -aa 2  models/vehicles/sm_flyer/flyer_local.tga work/models/vehicles/sm_flyer/flyer_hi.lwo

	diffusemap	models/vehicles/sm_flyer/flyer_d.tga
	bumpmap	addnormals ( models/vehicles/sm_flyer/flyer_local.tga, heightmap ( models/vehicles/sm_flyer/flyer_h.tga, 2 ))
	specularmap	models/vehicles/sm_flyer/flyer_s.tga
	{
		blend add
		map models/vehicles/sm_flyer/flyer_g.tga
	}
	{
		blend add
		map models/vehicles/sm_flyer/flyer_g2.tga
		rgb grunttable [ time * 1.3 ]
	}

}
