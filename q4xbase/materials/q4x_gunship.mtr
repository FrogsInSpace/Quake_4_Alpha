textures/q4x_gunship/rivetmetal
{
	qer_editorimage 			textures/q4x_gunship/rivetmetal.tga

	diffusemap	textures/q4x_gunship/rivetmetal_d.tga
	bumpmap		textures/q4x_gunship/rivetmetal_local.tga
	specularmap	textures/q4x_gunship/rivetmetal_s.tga

	
}

textures/q4x_gunship/blasted_edge_d
{
	qer_editorimage 			textures/q4x_gunship/blasted_edge_d.tga

	{
		blend diffusemap
		map textures/q4x_gunship/blasted_edge_d.tga
		alphatest 0.5
	}
	bumpmap		textures/q4x_gunship/blasted_edge_local.tga
	specularmap	textures/q4x_gunship/blasted_edge_s.tga
}

