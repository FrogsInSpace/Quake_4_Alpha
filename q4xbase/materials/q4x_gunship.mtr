models/mapobjects/q4x/air_assault_gunship/gunthingie
{
	noselfshadow
	noShadows

	qer_editorimage 			models/mapobjects/q4x/air_assault_gunship/gunthingie_d.tga

	diffusemap	models/mapobjects/q4x/air_assault_gunship/gunthingie_d.tga
	bumpmap		models/mapobjects/q4x/air_assault_gunship/gunthingie_local.tga
	specularmap	models/mapobjects/q4x/air_assault_gunship/gunthingie_s.tga
{
	    blend GL_DST_ALPHA, gl_one
	    maskalpha
       	cubeMap		gfx/env/marhelmet
        texgen		reflect
		red   Parm0
		green Parm1
		blue  Parm2
	}
	
	}