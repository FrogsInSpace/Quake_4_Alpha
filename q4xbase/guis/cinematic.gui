	}
	windowDef endlogo_black
	{
		rect	0,0,640,480
		visible	0
		backcolor	0,0,0,1
	}
	windowDef endlogo
	{
		rect	0,0,640,480
		visible	0
		background	"gfx/guis/mainmenu/endlogo"
		matcolor	1,1,1,0
		notime	1

		onTime 0 {
			set "endlogo::visible" "1" ;
			transition "endlogo::matcolor_w" "0" "1" "1000" ;
		}
		
		onTime +1000 {
			set "endlogo_black::visible" "1" ;
		}
		
		onTime +5000 {
			transition "endlogo::matcolor_w" "1" "0" "1500" ;
		}

	}
}
