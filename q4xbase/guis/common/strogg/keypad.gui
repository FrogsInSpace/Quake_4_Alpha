	windowDef p_b
	{
		rect	0,0,640,480
		visible	1
		notime	1
		windowDef b_0
		{
			rect	295,114,44,44
			visible	1
			cursor	1

			onMouseEnter {
				transition "number_0::forecolor" "$desktop::white_7" "$desktop::white" "200" ;
				transition "button_0::matcolor" "$desktop::red2_7" "$desktop::red2" "200" ;
			}

			onMouseExit {
				transition "number_0::forecolor" "$desktop::white" "$desktop::white_7" "200" ;
				transition "button_0::matcolor" "$desktop::red2" "$desktop::red2_7" "200" ;
			}

			onAction {
				transition "number_0::forecolor" "$desktop::white" "$desktop::white" "0" ;
				transition "button_0::matcolor" "$desktop::white" "$desktop::red2" "200" ;
				
				if ("desktop::onkey" < 5) {
					if ("desktop::onkey" == 0) {
						set "key_1::text" "0" ;
						set "desktop::key1" "0" ;
						set "desktop::onkey" "1" ;
						set "key_btn_1::matcolor" "$desktop::orange1_7" ;
					}
					if ("desktop::onkey" == 1) {
						set "key_2::text" "0" ;
						set "desktop::key2" "0" ;
						set "desktop::onkey" "2" ;
						set "key_btn_2::matcolor" "$desktop::orange1_7" ;
					}
					if ("desktop::onkey" == 2) {
						set "key_3::text" "0" ;
						set "desktop::key3" "0" ;
						set "desktop::onkey" "3" ;
						set "key_btn_3::matcolor" "$desktop::orange1_7" ;
					}
					if ("desktop::onkey" == 3) {
						set "key_4::text" "0" ;
						set "desktop::key4" "0" ;
						set "desktop::onkey" "4" ;
						set "key_btn_4::matcolor" "$desktop::orange1_7" ;
