					if ("desktop::onkey" == 4) {
						set "key_5::text" "0" ;
						set "desktop::key5" "0" ;
						set "desktop::onkey" "5" ;
						set "key_btn_5::matcolor" "$desktop::orange1_7" ;
						
						EvalRegs;
						if ("gui::gui_parm1" == "desktop::key1" && "gui::gui_parm2" == "desktop::key2" && "gui::gui_parm3" == "desktop::key3" && "gui::gui_parm4" == "desktop::key4" && "gui::gui_parm5" == "desktop::key5") {
