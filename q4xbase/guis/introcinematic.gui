		textscale	0.5
		textalign	1
	}
	windowDef show_text01_anim
	{
		rect	1,32,1,1
		visible	1
		notime	1

		onTime 0 {
			set "text01::visible" "1";	
			transition "text01::forecolor" "0,0,0,0" "1,1,1,1" "2000" ;
		}

		onTime 4000 {
			transition "text01::forecolor" "1,1,1,1" "0,0,0,0" "2000" ;
		}

	}
	windowDef show_text02_anim
	{
		rect	1,32,1,1
