export speederbike
{
	options -prefix HVTK_ -rotate 90 -keep base r_rear l_rear r_front l_front eye turret mgun1 mgun2 mgun3 muzzle gun_pivot Light1 Light2
	mesh	work/models/vehicles/marine_hovertank/Animation/HVTK_Idle.ma	-dest models/vehicles/speeder/speeder_base.md5mesh
	anim	work/models/vehicles/marine_hovertank/Animation/HVTK_Idle.ma	-dest models/vehicles/speeder/idle.md5mesh
	anim	work/models/vehicles/marine_hovertank/Animation/HVTK_Cannon.ma	-dest models/vehicles/speeder/cannon.md5anim
}

