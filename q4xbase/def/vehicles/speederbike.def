//------------------------------------------------------------------------------
//								Model Definition
//------------------------------------------------------------------------------

model vehicle_speederbike
{
	mesh						"models/vehicles/speeder/old/speeder_base.md5mesh"

	channel legs				( *origin )

	anim idle					"models/vehicles/speeder/old/idle.md5anim"
	anim cannon					"models/vehicles/speeder/old/cannon.md5anim"
	{
		frame	3				sound	snd_cannon_kickback
	}
}

