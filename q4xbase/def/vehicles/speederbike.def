//------------------------------------------------------------------------------
// SQUIRREL'S NOTES TO SELF
//
// g_vehicleDebug = 2 (?) for visual debugging of vehicle parts
//
// TEST MAPS
// Game/m08_race
// Game/m08_race2
// Game/m08_race1 (getting cut)
// Prototype/m08_race2x
// Prototype/m08_race2xai
// Prototype/m08_racex
// Prototype/speeder_mtn (really, really old)
// Test/raceterrain
