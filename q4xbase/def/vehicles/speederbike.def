	"offset"					"0 0 8"
	"mins"						"-2 -99 -39"
	"maxs"						"2 99 39"
	"height"					"65" // length of depth trace (used to look up spring force in table at bottom of file)
	
	"force"						"500" // multiply this value by the force lookup table value for total force for this hoverpad
	"forceTable"				"vehicle_speederbike_hover_suspensor_force"
	"dampen"					"100" // units? (was 120)
}


