entityDef vehicle_speederbike_driver
{
//	"def_part_splinetether"		"vehicle_speederbike_splinetether"

	"def_part_boost"			"vehicle_speederbike_boost"				// scott
	"def_part_thruster_forward"	"vehicle_speederbike_thruster_forward"	// makes the vehicle move
	"def_part_thruster_right"	"vehicle_speederbike_thruster_right"	// makes the vehicle move
	"def_part_thruster_right2"	"vehicle_speederbike_thruster_right2"	// makes the vehicle move

// SQUIRREL: These are the old set of hoverpads (four main pads for suspension and torsion)
//	"def_part_hover_fr"			"vehicle_speederbike_hoverpad_fr"		// lifts the vehicle up
//	"def_part_hover_br"			"vehicle_speederbike_hoverpad_br"		// lifts the vehicle up
//	"def_part_hover_fl"			"vehicle_speederbike_hoverpad_fl"		// lifts the vehicle up
//	"def_part_hover_bl"			"vehicle_speederbike_hoverpad_bl"		// lifts the vehicle up

// SQUIRREL: New hoverpads - separated for suspension and torsion
	"def_part_hover_suspensor"			"vehicle_speederbike_hoverpad_suspensor"		// suspension (lifts the vehicle up)
	"def_part_hover_antisuspensor"		"vehicle_speederbike_hoverpad_antisuspensor"	// antisuspension (pushes the vehicle down from the ceiling)
	"def_part_hover_springboard"		"vehicle_speederbike_hoverpad_springboard"		// springboard - gives dynamic jumps
	"def_part_hover_stabilizer_left"	"vehicle_speederbike_hoverpad_stabilizer_left"	// torsion (stabilizes the vehicle)
	"def_part_hover_stabilizer_right"	"vehicle_speederbike_hoverpad_stabilizer_right"	// torsion (stabilizes the vehicle)
	"def_part_hover_stabilizer_front"	"vehicle_speederbike_hoverpad_stabilizer_front"	// torsion (stabilizes the vehicle)
	"def_part_hover_stabilizer_back"	"vehicle_speederbike_hoverpad_stabilizer_back"	// torsion (stabilizes the vehicle)
	"def_part_hover_bumper_leftfront"	"vehicle_speederbike_hoverpad_bumper_leftfront"		// bumper (prevents interpenetration with walls)
	"def_part_hover_bumper_rightfront"	"vehicle_speederbike_hoverpad_bumper_rightfront"	// bumper (prevents interpenetration with walls)
	"def_part_hover_bumper_leftrear"	"vehicle_speederbike_hoverpad_bumper_leftrear"		// bumper (prevents interpenetration with walls)
	"def_part_hover_bumper_rightrear"	"vehicle_speederbike_hoverpad_bumper_rightrear"		// bumper (prevents interpenetration with walls)
	"def_part_hover_bumper_front"		"vehicle_speederbike_hoverpad_bumper_front"		// bumper (prevents interpenetration with walls)
	"def_part_hover_bumper_back"		"vehicle_speederbike_hoverpad_bumper_back"		// bumper (prevents interpenetration with walls)

	"def_part_yaw"				"vehicle_speederbike_turret_yaw"
	"def_part_pitch"			"vehicle_speederbike_turret_pitch"
	
	"def_part_main"				"vehicle_speederbike_weapon_mgun"
	"def_part_mgun"				"vehicle_speederbike_weapon_main"		
//	"def_part_rocket"			"vehicle_speederbike_weapon_rocket"
	
	"def_part_light"			"vehicle_speederbike_light"
		
	"eyeJoint"					"eye"
	"eyeOffset"					"-1 0 0"
	
	"driverJoint"				"origin"
	"driverVisible"				"0"

	// Global sounds when position is enabled
	"snd_loop"					"vehicle_speeder_engine_loop"
	"volume"					"-10 -4"
