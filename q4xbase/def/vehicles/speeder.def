export speeder
 {
	options -game q4xbase -prefix SPEED_ -align ALL -keep Eyes -parent Eyes Body -keep mid_headlight -parent mid_headlight Body -keep SteeringWheel -parent SteeringWheel Body -keep ALL -keep BackEnd Lrearaxlebot Lrearwheelbot Lrearaxletop Lrearwheeltop Lrearwheelin Rrearaxlebot Rrearwheelbot Rrearaxletop Rrearwheeltop Rrearwheelin FrontEnd Lfrontaxlebot Lfrontwheelbot Lfrontaxletop Lfrontwheeltop Lfrontwheelin Rfrontaxlebot Rfrontwheelbot Rfrontaxletop Rfrontwheeltop Rfrontwheelin Lmidaxlebot Lmidwheelbot Lmidaxletop Lmidwheeltop Lmidwheelin Lmidwheelout Rmidaxlebot Rmidwheelbot Rmidaxletop Rmidwheeltop Rmidwheelin Rmidwheelout 
	mesh	models/vehicles/speeder/animations/idle.ma 	-dest models/vehicles/speeder/speeder_base
 	anim	models/vehicles/speeder/animations/idle.ma	-dest models/vehicles/speeder/idle
	anim	models/vehicles/speeder/animations/cannon.ma	-dest models/vehicles/speeder/cannon
}

//------------------------------------------------------------------------------
//							Vehicle Defintion
//------------------------------------------------------------------------------

entityDef vehicle_speeder
{
	"editor_color"				"1 .5 0"
	"editor_mins"				"-8 -8 -8"
	"editor_maxs"				"8 8 8"
	"editor_ragdoll"			"1"
	"editor_rotatable"			"1"
