	"hudid"						"1"
	
	"health"					"1000"
	"mass"						"2500"
	"team"						"0"
	"density"					".0005"
	"friction_linear"			"1"
	"friction_contact"			".1"
	"bouncyness"				".5"
	"nav_active"				"1"
	
	"shieldMins"				"-160 -110 -6"
	"shieldMaxs"				"160 110 64"
	"shieldSides"				"10"
	"shieldHealth"				"10reload0"
	"shieldRegenDelay"			"6"
	"shieldRegenTime"			"3"

	"crashSpeedSmall"			"150"
	"crashSpeedMedium"			"400"
	"crashSpeedLarge"			"500"
	"def_crashDamage"			"damage_speeder_crash"

	"snd_crash_small"			"vehicle_crash_small"
	"snd_crash_medium"			"vehicle_crash_medium"
	"snd_crash_large"			"vehicle_crash_large"
	"snd_cannon_kickback"		"vehicle_speeder_cannon_kickback"	
	"snd_shieldWarning"			"vehicle_speeder_shield_warning"
	"snd_shieldRecharge"		"vehicle_speeder_shield_recharge"
		
	"fx_death"					"effects/vehicles/explosion.fx"
	"fx_shield"					"effects/vehicles/walker/shield.fx"	
	"fx_crash"					"effects/vehicles/crash.fx"

	"focusLength_enter"			"100"
