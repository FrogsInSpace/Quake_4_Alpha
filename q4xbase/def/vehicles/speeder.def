{
	"def_part_hover_fl"			"vehicle_speeder_hoverpad_fl"
	"def_part_hover_bl"			"vehicle_speeder_hoverpad_bl"
	"def_part_hover_fr"			"vehicle_speeder_hoverpad_fr"
	"def_part_hover_br"			"vehicle_speeder_hoverpad_br"
				
	"def_part_yaw"				"vehicle_speeder_turret_yaw"
	"def_part_pitch"			"vehicle_speeder_turret_pitch"
	
	"def_part_main"				"vehicle_speeder_weapon_main"
	"def_part_mgun"				"vehicle_speeder_weapon_mgun"		
//	"def_part_rocket"			"vehicle_speeder_weapon_rocket"
	
	"def_part_light"			"vehicle_speeder_light"
		
	"eyeJoint"					"eye"
	"eyeOffset"					"-1 0 0"
	
	"driverJoint"				"origin"
	"driverVisible"				"0"

	// Global sounds when position is enabled
	"snd_loop"					"vehicle_speeder_engine_loop"
	"volume"					"-8 5.5"
	"freqShift"					"1 1.4"
	"maxSoundSpeed"				"600"	
}

//------------------------------------------------------------------------------
//								Model Defintion
//------------------------------------------------------------------------------

model vehicle_speeder
{
	mesh						models/vehicles/speeder/speeder_base.md5mesh

	channel legs				( *origin )

	anim idle					models/vehicles/speeder/idle.md5anim
	anim af_pose					models/vehicles/speeder/idle.md5anim
	anim cannon					models/vehicles/speeder/cannon.md5anim
	{
		frame	3				sound	snd_cannon_kickback
	}
}

