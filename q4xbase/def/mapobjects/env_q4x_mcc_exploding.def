
/***********************************************************************
MCC Landing Ship
***********************************************************************/


export  MCC_ship
{
	options  -prefix MCCEXP_ -align ALL -keep blast -sourcedir cinematics/air_assault/mcc_exploding/animations -destdir models/mapobjects/airborneassault/mcc_exploding -keep ALL Ship_Base Top_turret_AIM_RShape Top_turret_AIM_R top_turret_AIM_LShape top_turret_AIM_L MCC_Part_3_joint MCC_Part_5_joint MCC_Part_6_joint MCC_Part_7_joint MCC_Part_8_joint F_belly_turret_muzzle_R1 F_belly_turret_muzzle_R2 F_belly_turret_stock_R F_belly_turret_base_R vent_back_R MCC_Part_9_joint MCC_Part_10_joint B_belly_turret_muzzle_R1 B_belly_turret_muzzle_R2 B_belly_turret_stock_R B_belly_turret_base_R MCC_Part_11_joint MCC_Part_12_joint B_belly_turret_muzzle_L1 B_belly_turret_muzzle_L2 B_belly_turret_stock_L B_belly_turret_base_L MCC_Part_14_joint MCC_Part_15_joint MCC_Part_16_joint F_belly_turret_muzzle_L2 F_belly_turret_muzzle_L1 F_belly_turret_stock_L F_belly_turret_base_L vent_back_L MCC_Part_17_joint MCC_Part_18_joint MCC_Part_19_joint MCC_Part_20_joint vent_front_R vent_side_R4 vent_side_R3 vent_side_R2 vent_side_R1 MCC_Part_21_joint vent_front_L vent_side_L4 vent_side_L3 vent_side_L2 vent_side_L1 MCC_Part_22_joint MCC_Part_24_joint MCC_Part_25_joint MCC_Part_26_joint MCC_Part_27_joint MCC_Part_28_joint MCC_Part_29_joint MCC_Part_31_joint engine_top_C2 engine_top_C1 MCC_Part_32_joint MCC_Part_35_joint MCC_Part_36_joint MCC_Part_37_joint MCC_Part_38_joint MCC_Part_39_joint top_turret_muzzle_L2 top_turret_muzzle_L1 top_turret_stock_L_aimConstraint1 top_turret_stock_L top_turret_base_L_aimConstraint1 top_turret_base_L top_turret_muzzle_R1 top_turret_muzzle_R2 top_turret_stock_R_aimConstraint1 top_turret_stock_R top_turret_base_R_aimConstraint1 top_turret_base_R MCC_Part_40_joint engine_bottom_R2 engine_bottom_R1 engine_top_R1 engine_top_R2 engine_bottom_C2 engine_bottom_C1 engine_bottom_L2 engine_bottom_L1 engine_top_L2 engine_top_L1 polySurface163_joint polySurface164_joint breakaway Ship_Body

	mesh	idle.ma					-dest MCC_explode
	anim	space_explosion.ma	-range 1 2	-dest idle
	anim	space_explosion.ma			-dest space_explode
	anim	impact.ma		-range 100 238	-dest impact
	
	
}

entityDef env_q4x_MCC_explode
{
	"editor_color"					"0 .5 .25"
	"editor_mins"					"-32 -32 0"
	"editor_maxs"					"32 32 16"

	"editor_usage"					"MCC exploding"

	"spawnclass"					"idAnimated"

	"model"						"model_q4x_MCC_explode"
	"anim"						"idle"
	
	"fx_burn"					"effects/levels/airassault/q4x_burn_trail.fx"
	"fx_explode"					"effects/monsters/flyer_space/q4x_explode.fx"
	"fx_big_explode"				"effects/levels/airassault/q4x_big_explode.fx"
	"fx_electrical"					"effects/levels/airassault/q4x_electrical_play.fx"

	"fx_bigshotfly"					"effects/levels/airassault/q4x_big_gunfly.fx"
	"fx_impact"					"effects/levels/airassault/q4x_big_gunfly.fx"

}

model model_q4x_MCC_explode
