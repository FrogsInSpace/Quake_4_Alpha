entityDef char_npc_markswell_M07_Race_vo
{
 // CHARACTER: MARKSWELL
 // CONTEXT:Tense
 // DIALOG : No such luck, Tak.  The dropships cleared the Hannibal right before it went critical.  We’re already enroute to Nexus waypoint, but you boys better move, the Strogg are already shutting down the locks.  Good luck,  Falcon Squad.
 "lipsync_marks_nosuch"        "vo_marks_nosuch"


 // CHARACTER: MARKSWELL
 // CONTEXT:Warning
 // DIALOG : Watch out Falcon, you've got heavy Strogg flyers inbound your position!
 "lipsync_marks_watchfalcon"        "vo_marks_watchfalcon"
}

