
entityDef char_npc_darnell_M07_Race_vo
{
 // CHARACTER: DARNELL
 // CONTEXT:Tense
 // DIALOG : If those reactors go critical; it’s gonna blow a crater in this place a half mile wide.
 "lipsync_darn_reactcrit"        "vo_darn_reactcrit"


 // CHARACTER: DARNELL
 // CONTEXT:Tense
 // DIALOG : I hope everybody got out before the ship went up.
 "lipsync_darn_ihopeshipt"        "vo_darn_ihopeshipt"


 // CHARACTER: DARNELL
 // CONTEXT:Tense
 // DIALOG : Haul ass Dekard, the locks are closing!
 "lipsync_darn_haulassdeklk"        "vo_darn_haulassdeklk"


 // CHARACTER: DARNELL
 // CONTEXT:Tense
 // DIALOG : Get to the Cryogenics facility as fast as possible Dekard!
 "lipsync_darn_gettocryo"        "vo_darn_gettocryo"


 // CHARACTER: DARNELL
 // CONTEXT:Tense
 // DIALOG : Sarge, I've got residual EM interference wrecking havoc with my guidance systems.  Me and the rest of Anchor squad are taking the secondary approach vector.
 "lipsync_darn_sargeem"        "vo_darn_sargeem"


 // CHARACTER: DARNELL
 // CONTEXT:Tense
 // DIALOG : Shit, the lock is closed!  Dekard didn't make it!
 "lipsync_darn_shitlock"        "vo_darn_shitlock"


 // CHARACTER: DARNELL
 // CONTEXT:Warning
 // DIALOG : Harvester!
 "lipsync_darn_harvest"        "vo_darn_harvest"


 // CHARACTER: DARNELL
 // CONTEXT:Tense
 // DIALOG : We're almost to the Cryogenics facility, ETA three minutes.
 "lipsync_darn_wealmost"        "vo_darn_wealmost"


 // CHARACTER: DARNELL
 // CONTEXT:Warning
 // DIALOG : Look out!
 "lipsync_darn_lookout2"        "vo_darn_lookout2"
}

