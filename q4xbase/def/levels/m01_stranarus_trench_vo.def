entityDef char_npc_vansen_M01_stranarus_trench_vo
{
 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Calm
 // DIALOG : This is Dropship Falcon en route from the Hannibal heading zero–seven–zero, two minutes to station.  Requesting sit-rep from ground ops.
 "lipsync_vansen_dropflcn"        "vo_vansen_dropflcn"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Calm
 // DIALOG : Roger that, package is prepped and ready for transfer – eat to drop in one-zero-niner.
 "lipsync_vansen_rogerthtp"        "vo_vansen_rogerthtp"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Everybody get to their seats, we have incoming!
 "lipsync_vansen_everseat"        "vo_vansen_everseat"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : GOC, receiving heavy AA fire, re-routing approach to LZ.
 "lipsync_vansen_gochvyaa"        "vo_vansen_gochvyaa"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : We're hit!
 "lipsync_vansen_wehit"        "vo_vansen_wehit"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : GOC, we've been hit hard, trying to stabilize..
 "lipsync_vansen_gochithard"        "vo_vansen_gochithard"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Roger lieutenant, starboard engine is at 20 percent, we've got no rear landing struts, and we are losing altitude fast.
 "lipsync_vansen_rgrltst20"        "vo_vansen_rgrltst20"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Calm
 // DIALOG : Falcon, we are imminent to new LZ, short 1.5 klicks of planned LZ.  You guys need to get out quick, we are still under fire and I can't hold this position for long.
 "lipsync_vansen_falconweimm"        "vo_vansen_falconweimm"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Terse
 // DIALOG : Falcon, we are stable at new LZ, everybody out!
 "lipsync_vansen_stablelz"        "vo_vansen_stablelz"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : I can't hold this position much longer.
 "lipsync_vansen_cntholdpos"        "vo_vansen_cntholdpos"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Starboard engine at 10 percent
 "lipsync_vansen_stbeng10"        "vo_vansen_stbeng10"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Angry
 // DIALOG : We're out of time marines!
 "lipsync_vansen_weouttime"        "vo_vansen_weouttime"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Dropship Falcon clearing hot zone.
 "lipsync_vansen_dropshphot"        "vo_vansen_dropshphot"

}
