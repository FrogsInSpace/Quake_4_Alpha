entityDef char_npc_tak_M01_stranarus_trench_vo
{
 // CHARACTER: TAK
 // CONTEXT:Sarcastic
 // DIALOG : Hey Corporal! The name is Tak. And unlike some grunts, Sci-Tech is always ready to go.
 "lipsync_tak_heycorptak"        "vo_tak_heycorptak"


 // CHARACTER: TAK
 // CONTEXT:Military
 // DIALOG : Yes sir!
 "lipsync_tak_yessir1"        "vo_tak_yessir1"


 // CHARACTER: TAK
 // CONTEXT:Military
 // DIALOG : Line secure!
 "lipsync_tak_linesec"        "vo_tak_linesec"


 // CHARACTER: TAK
 // CONTEXT:Commanding
 // DIALOG : Ok Mitchell, you're out!  Go!
 "lipsync_tak_okmitchout"        "vo_tak_okmitchout"


 // CHARACTER: TAK
 // CONTEXT:Dry
 // DIALOG : I'll have you out in a second sarge.
 "lipsync_tak_outsecsarge"        "vo_tak_outsecsarge"


 // CHARACTER: TAK
 // CONTEXT:Dry
 // DIALOG : Almost there.
 "lipsync_tak_almostth"        "vo_tak_almostth"


 // CHARACTER: TAK
 // CONTEXT:Commanding
 // DIALOG : Got it!  Dekard, let's go!
 "lipsync_tak_gotitdek"        "vo_tak_gotitdek"


 // CHARACTER: TAK
 // CONTEXT:Calling for Attention
 // DIALOG : Dekard!
 "lipsync_tak_dek1"        "vo_tak_dek1"


 // CHARACTER: TAK
 // CONTEXT:Calling for Attention
 // DIALOG : Dekard, This way!
 "lipsync_tak_dekthiswy"        "vo_tak_dekthiswy"


 // CHARACTER: TAK
 // CONTEXT:Yelling
 // DIALOG : Strogg!
 "lipsync_tak_strg1"        "vo_tak_strg1"


 // CHARACTER: TAK
 // CONTEXT:Yelling
 // DIALOG : Open Fire!
 "lipsync_tak_openfr1"        "vo_tak_openfr1"


 // CHARACTER: TAK
 // CONTEXT:Yelling
 // DIALOG : Look out!
 "lipsync_tak_lookout1"        "vo_tak_lookout1"


 // CHARACTER: TAK
 // CONTEXT:Yelling
 // DIALOG : Dekard! Look out!
 "lipsync_tak_deklkout1"        "vo_tak_deklkout1"


 // CHARACTER: TAK
 // CONTEXT:Yelling
 // DIALOG : Keep moving, we're almost there!
 "lipsync_tak_kpmov2"        "vo_tak_kpmov2"


 // CHARACTER: TAK
 // CONTEXT:Yelling
 // DIALOG : Almost there.
 "lipsync_tak_almsthr2"        "vo_tak_almsthr2"


 // CHARACTER: TAK
 // CONTEXT:Yelling
 // DIALOG : Take cover!
 "lipsync_tak_tkcov2"        "vo_tak_tkcov2"


 // CHARACTER: TAK
 // CONTEXT:Yelling
 // DIALOG : The Strogg turrets are on us, get down!
 "lipsync_tak_strgturrs2"        "vo_tak_strgturrs2"


 // CHARACTER: TAK
 // CONTEXT:Calm
 // DIALOG : Always trying to blow something up eh Navajas?  I'll get it open.
 "lipsync_tak_alwaysblow"        "vo_tak_alwaysblow"


 // CHARACTER: TAK
 // CONTEXT:Calm
 // DIALOG : Gimme a second.
 "lipsync_tak_gimmeasec"        "vo_tak_gimmeasec"


 // CHARACTER: TAK
 // CONTEXT:Calm
 // DIALOG : There we go.  See no need for…
 "lipsync_tak_therewego"        "vo_tak_therewego"


 // CHARACTER: TAK
 // CONTEXT:Surprised
 // DIALOG : Whoa!
 "lipsync_tak_whoa"        "vo_tak_whoa"


 // CHARACTER: TAK
 // CONTEXT:Relieved
 // DIALOG : Whew, that was close!
 "lipsync_tak_whewcls"        "vo_tak_whewcls"


 // CHARACTER: TAK
 // CONTEXT:Inquisitive
 // DIALOG : What's that?
 "lipsync_tak_whattht"        "vo_tak_whattht"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : This is a Strogg weapon I've never seen before, some kind of cold fire cannon. Here Sarge, I'm sure you can make better use of this than I can.
 "lipsync_tak_strggweapnseen"        "vo_tak_strggweapnseen"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Not from here.  This terminal is shot.
 "lipsync_tak_notfrmhr"        "vo_tak_notfrmhr"


 // CHARACTER: TAK
 // CONTEXT:Excited
 // DIALOG : Let me get this bridge up.
 "lipsync_tak_letmegetbr"        "vo_tak_letmegetbr"


 // CHARACTER: TAK
 // CONTEXT:Tense
 // DIALOG : Almost got it.  Keep em off me!
 "lipsync_tak_almskeepoff"        "vo_tak_almskeepoff"


 // CHARACTER: TAK
 // CONTEXT:Inquisitive
 // DIALOG : Navajas, can you clear this debris?
 "lipsync_tak_navaclrdeb"        "vo_tak_navaclrdeb"


 // CHARACTER: TAK
 // CONTEXT:Calm
 // DIALOG : Getting there’s going to be difficult. Strogg resistance is intense.
 "lipsync_tak_getttherdiff"        "vo_tak_getttherdiff"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Dekard, that cold fire Strogg weapon should be able to tame this fire.
 "lipsync_tak_thatcoldfire"        "vo_tak_thatcoldfire"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Dekard, you can clear this fire with that Strogg cold fire weapon.
 "lipsync_tak_dekclrfirecld"        "vo_tak_dekclrfirecld"


 // CHARACTER: TAK
 // CONTEXT:Reassuring
 // DIALOG : Good job Dekard!
 "lipsync_tak_goodjbdek"        "vo_tak_goodjbdek"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Lieutenant, we've located the Razor 16 dropship, no survivors.
 "lipsync_tak_ltrazor16"        "vo_tak_ltrazor16"


 // CHARACTER: TAK
 // CONTEXT:Panic
 // DIALOG : What the hell is that thing?!
 "lipsync_tak_whthelltht"        "vo_tak_whthelltht"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : There they are.
 "lipsync_tak_thertheyr"        "vo_tak_thertheyr"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : There it is.
 "lipsync_tak_thereitis"        "vo_tak_thereitis"


 // CHARACTER: TAK
 // CONTEXT:Confident
 // DIALOG : Nah, the weapon and guidance systems are still on line on this one.  The actuators are shot, though, and this thing’s not going anywhere until the drive pistons are getting power.  It’ll shoot, but it won’t walk.  I’ll Take care of that last part; you guys keep the Strogg of me.
 "lipsync_tak_nahweapgonline"        "vo_tak_nahweapgonline"


 // CHARACTER: TAK
 // CONTEXT:Confident
 // DIALOG : Nah, the weapon and guidance systems are still on line.  The actuators are shot, though, and this thing’s not going anywhere until the drive pistons are getting power.  It’ll shoot, but it won’t walk.  I’ll Take care of that last part; you guys keep the Strogg of me.
 "lipsync_tak_nahweapgon2"        "vo_tak_nahweapgon2"


 // CHARACTER: TAK
 // CONTEXT:Calm
 // DIALOG : Got it.
 "lipsync_tak_gotit1"        "vo_tak_gotit1"


 // CHARACTER: TAK
 // CONTEXT:Commanding
 // DIALOG : Dekard!  Get in the walker, the weapons are working!
 "lipsync_tak_dekgetwlk"        "vo_tak_dekgetwlk"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Okay, I got the actuator patched.  I’m routing power to the drive pistons now.
 "lipsync_tak_okactuator"        "vo_tak_okactuator"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Power at twenty-five percent.
 "lipsync_tak_pwr25"        "vo_tak_pwr25"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : We’re at fifty percent.
 "lipsync_tak_pwr50"        "vo_tak_pwr50"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Almost there, seventy-five percent.
 "lipsync_tak_pwr75"        "vo_tak_pwr75"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Drive pistons are active.  I just need to realign the hydraulic governor and –
 "lipsync_tak_drivepist"        "vo_tak_drivepist"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Walker’s nearly functional, Sir.  
 "lipsync_tak_walknrlyfun"        "vo_tak_walknrlyfun"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Walker number one nearly functional, Sir.
 "lipsync_tak_walknumonefun"        "vo_tak_walknumonefun"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Roger that.
 "lipsync_tak_rogerthat"        "vo_tak_rogerthat"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Dekard, you’re good to go.  Navajas and I will meet back with Falcon Squad.  Take the Walker through the supply tunnel and meet us back outside.  Be careful- this thing’s patched up, but it won’t take much of a beating.
 "lipsync_tak_dekgoodtogo"        "vo_tak_dekgoodtogo"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : You’re good to go, Dekard.  Hold on, let me see if I can get this other walker up quickly.
 "lipsync_tak_goodholdwlk"        "vo_tak_goodholdwlk"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : This walker is in much better shape!
 "lipsync_tak_thiswlkbetter"        "vo_tak_thiswlkbetter"


 // CHARACTER: TAK
 // CONTEXT:Tense
 // DIALOG : Keep them off me!
 "lipsync_tak_keepoff2"        "vo_tak_keepoff2"


 // CHARACTER: TAK
 // CONTEXT:Excited
 // DIALOG : This baby is alive again!
 "lipsync_tak_babyalive"        "vo_tak_babyalive"


 // CHARACTER: TAK
 // CONTEXT:Excited
 // DIALOG : Ok Dekard, lets go, you take point!
 "lipsync_tak_okdekpoint"        "vo_tak_okdekpoint"


 // CHARACTER: TAK
 // CONTEXT:Excited
 // DIALOG : Let's go!
 "lipsync_tak_ltsgo2"        "vo_tak_ltsgo2"


 // CHARACTER: TAK
 // CONTEXT:Excited
 // DIALOG : Turret disabled!
 "lipsync_tak_turrdis"        "vo_tak_turrdis"


 // CHARACTER: TAK
 // CONTEXT:Excited
 // DIALOG : I got one!
 "lipsync_tak_igotone2"        "vo_tak_igotone2"


 // CHARACTER: TAK
 // CONTEXT:Excited
 // DIALOG : Turrets are down!
 "lipsync_tak_turrdown"        "vo_tak_turrdown"


 // CHARACTER: TAK +USE
 // CONTEXT:Sarcastic
 // DIALOG : Quite an operation for your first command eh Sarge?
 "lipsync_tak_quiteop"        "vo_tak_quiteop"


 // CHARACTER: TAK +USE
 // CONTEXT:Informative
 // DIALOG : Markswell wants us to regroup. 
 "lipsync_tak_marksregrp"        "vo_tak_marksregrp"


 // CHARACTER: TAK +USE
 // CONTEXT:Sarcastic
 // DIALOG : I don't recall the Sci-Tech job description including anything like this…
 "lipsync_tak_dntrecallsci"        "vo_tak_dntrecallsci"


 // CHARACTER: TAK +USE
 // CONTEXT:Informative
 // DIALOG : Let's get to those walkers.
 "lipsync_tak_letsgetwlk"        "vo_tak_letsgetwlk"


 // CHARACTER: TAK +USE
 // CONTEXT:Informative
 // DIALOG : Let's get to that walker.
 "lipsync_tak_letsget1walk"        "vo_tak_letsget1walk"


 // CHARACTER: TAK +USE
 // CONTEXT:Informative
 // DIALOG : I hope those walkers aren't too beat up
 "lipsync_tak_ihopethosewl"        "vo_tak_ihopethosewl"


 // CHARACTER: TAK +USE
 // CONTEXT:Informative
 // DIALOG : I hope that walker isn't too beat up
 "lipsync_tak_ihopethat"        "vo_tak_ihopethat"


 // CHARACTER: TAK +USE
 // CONTEXT:Informative
 // DIALOG : We need to keep moving Sarge.
 "lipsync_tak_weneedmvsrg"        "vo_tak_weneedmvsrg"

 // CHARACTER: TAK
 // CONTEXT:Combat
 // DIALOG : Moving
 "lipsync_tak_tre_moving"        "vo_tak_tre_moving"


 // CHARACTER: TAK
 // CONTEXT:Combat
 // DIALOG : I'm moving
 "lipsync_tak_tre_moving2"        "vo_tak_tre_moving2"


 // CHARACTER: TAK
 // CONTEXT:Combat
 // DIALOG : Dekards goin for it! 
 "lipsync_tak_tre_dekardgo"        "vo_tak_tre_dekardgo"


 // CHARACTER: TAK
 // CONTEXT:Combat
 // DIALOG : Right behind you Dekard!
 "lipsync_tak_tre_rightbehind"        "vo_tak_tre_rightbehind"


 // CHARACTER: TAK
 // CONTEXT:Combat
 // DIALOG : Go Atlas!
 "lipsync_tak_tre_goatlas"        "vo_tak_tre_goatlas"


 // CHARACTER: TAK
 // CONTEXT:Combat
 // DIALOG : Dekard!  Stop!
 "lipsync_tak_tre_stop"        "vo_tak_tre_stop"


 // CHARACTER: TAK
 // CONTEXT:Informative, Combat
 // DIALOG : Shit!  That walker is blocking our path!
 "lipsync_tak_tre_shitwalker"        "vo_tak_tre_shitwalker"


 // CHARACTER: TAK
 // CONTEXT:Combat
 // DIALOG : Dekard, we need cover!
 "lipsync_tak_tre_needocver"        "vo_tak_tre_needocver"


 // CHARACTER: TAK
 // CONTEXT:Heavy lift struggle
 // DIALOG : URGGHH
 "lipsync_tak_tre_urgmove"        "vo_tak_tre_urgmove"


 // CHARACTER: TAK
 // CONTEXT:Combat
 // DIALOG : Damn, it's stuck in the ground, lift it up!
 "lipsync_tak_tre_legstuck"        "vo_tak_tre_legstuck"


 // CHARACTER: TAK
 // CONTEXT:Heavy lift struggle
 // DIALOG : URGHHH
 "lipsync_dar_tre_urgmove2"        "vo_dar_tre_urgmove2"


 // CHARACTER: TAK
 // CONTEXT:Informative, Combat
 // DIALOG : Leg is moved!  Let's go!
 "lipsync_tak_tre_legmoved"        "vo_tak_tre_legmoved"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : This security door can't be opened from here.
 "lipsync_tak_tre_secdoor"        "vo_tak_tre_secdoor"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Access panel has to be nearby
 "lipsync_tak_tre_accesspanel"        "vo_tak_tre_accesspanel"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : This is the right panel for that door, but it's been locked out from that security room.
 "lipsync_tak_tre_lockedout"        "vo_tak_tre_lockedout"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : I've opened the door leading to the security room, but the hallway is on fire.
 "lipsync_tak_tre_hallwayfire"        "vo_tak_tre_hallwayfire"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : You should be able to get through there with that Strogg freezing weapon.
 "lipsync_tak_tre_stroggweapon"        "vo_tak_tre_stroggweapon"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : You should be able to get through there with your cold cannon.
 "lipsync_tak_tre_stroggweapon2"        "vo_tak_tre_stroggweapon2"


 // CHARACTER: TAK
 // CONTEXT:Tense
 // DIALOG : Dekard, I can't get that door open until you bypass the lockouts.
 "lipsync_tak_tre_bypassremind"        "vo_tak_tre_bypassremind"


 // CHARACTER: TAK
 // CONTEXT:Tense
 // DIALOG : Dekard, what's the hold up!  
 "lipsync_tak_tre_holdup"        "vo_tak_tre_holdup"


 // CHARACTER: TAK
 // CONTEXT:Tense
 // DIALOG : Dekard, come on!  Bypass that security lockout so we can proceed!
 "lipsync_tak_tre_bypassremind2"        "vo_tak_tre_bypassremind2"


 // CHARACTER: TAK
 // CONTEXT:Tense
 // DIALOG : Ok, that did it, I can get this door open now.
 "lipsync_tak_tre_thatdidit"        "vo_tak_tre_thatdidit"


 // CHARACTER: TAK
 // CONTEXT:Tense
 // DIALOG : Dekard, We'll open the door once you get back here.
 "lipsync_tak_tre_getback"        "vo_tak_tre_getback"


 // CHARACTER: TAK
 // CONTEXT:Tense
 // DIALOG : Sarge, we are waiting on you to get back before proceeding!
 "lipsync_tak_tre_waiting"        "vo_tak_tre_waiting"


 // CHARACTER: TAK
 // CONTEXT:Excited
 // DIALOG : Ok, opening the door!
 "lipsync_tak_tre_opening"        "vo_tak_tre_opening"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Let me get this door open.
 "lipsync_tak_pris_door1"        "vo_tak_pris_door1"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Opening this door
 "lipsync_tak_pris_door2"        "vo_tak_pris_door2"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Accessing the door panel
 "lipsync_tak_pris_door3"        "vo_tak_pris_door3"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : One second for this door
 "lipsync_tak_pris_door4"        "vo_tak_pris_door4"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Opening the door
 "lipsync_tak_pris_door5"        "vo_tak_pris_door5"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : I'll open this door
 "lipsync_tak_pris_door6"        "vo_tak_pris_door6"

}

