entityDef char_npc_markswell_M01_stranarus_trench_vo
{
 // CHARACTER: MARKSWELL
 // CONTEXT:Calm
 // DIALOG : At ease. The man standing beside me is Sergeant Dekard Chase.  Shortly before our deployment from the Patton, he was transferred to this squad.  Darnell and I served with him on Earth – best non-com in the outfit as far as I’m concerned.  I’ll be coordinating operations through him from now on.
 "lipsync_marks_ateastman"        "vo_marks_ateastman"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : That's us gentlemen, briefing will continue in the air, let's get this show on the road!
 "lipsync_marks_thatsusgent"        "vo_marks_thatsusgent"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Falcon Squad, saddle up!
 "lipsync_marks_falconsqsd"        "vo_marks_falconsqsd"


 // CHARACTER: MARKSWELL
 // CONTEXT:Calm
 // DIALOG : Ok, listen up!  We've been ordered in with Atlas walker squad and Hades infantry unit to hit one of the Strogg's oldest raw materials processing facilities. Our objective is to gather data from the facility, while Hades and Atlas prep to destroy it.  This facility is heavily guarded.
 "lipsync_marks_oklisten"        "vo_marks_oklisten"


 // CHARACTER: MARKSWELL
 // CONTEXT:Tense
 // DIALOG : Everybody hold on!  Vansen, we lost two marines and the starboard hull is compromised.
 "lipsync_marks_evholdvans"        "vo_marks_evholdvans"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Understood.  Tak, prepare a step-out line, we're taking the hard way out.
 "lipsync_marks_understdt"        "vo_marks_understdt"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Everybody up!  Grab your gear!
 "lipsync_marks_everbdyup"        "vo_marks_everbdyup"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Tak, cut them out of there!
 "lipsync_marks_takcutem"        "vo_marks_takcutem"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : You heard the lady, move!  Go Go Go!  Hit the ground and get moving!
 "lipsync_marks_hrdlady"        "vo_marks_hrdlady"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Darnell, Dekard, Tak, get the hell up here.  We're pinned down!
 "lipsync_marks_darndektakg"        "vo_marks_darndektakg"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Dekard, Darnell, get Tak up here, we need a tech here immediately!
 "lipsync_marks_ddtgetup"        "vo_marks_ddtgetup"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Marines, where are you?! Regroup at my position!
 "lipsync_marks_marineswher"        "vo_marks_marineswher"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : What's the hold up marines!?  
 "lipsync_marks_whatsholdup"        "vo_marks_whatsholdup"


 // CHARACTER: MARKSWELL
 // CONTEXT:Calling for Attention
 // DIALOG : Dekard, over here!
 "lipsync_marks_dekoverhr"        "vo_marks_dekoverhr"


 // CHARACTER: MARKSWELL
 // CONTEXT:Informative
 // DIALOG : Two walkers tried to flank the turrets through the supply tunnels, but they were ambushed.  The walkers are intact, but damaged.  Dekard, Navajas, Tak breach those tunnels and repair those Walkers.  It’s the only way we’re gonna get past these turrets.
 "lipsync_marks_twowalkfl"        "vo_marks_twowalkfl"


 // CHARACTER: MARKSWELL
 // CONTEXT:Informative
 // DIALOG : Walkers tried to flank the turrets through the supply tunnels, but they were ambushed.  One walker is left and intact, but damaged.  Dekard, Navajas, Tak breach those tunnels and repair that Walker.  It’s the only way we’re gonna get past these turrets.
 "lipsync_marks_twowalkfl_alt"        "vo_marks_twowalkfl_alt"


 // CHARACTER: MARKSWELL
 // CONTEXT:Calm; dark
 // DIALOG : Roger that.
 "lipsync_marks_rogertht2"        "vo_marks_rogertht2"


 // CHARACTER: MARKSWELL
 // CONTEXT:Tense
 // DIALOG : We’re under heavy fire.  We need assistance, how close are you?
 "lipsync_marks_underhvyfr"        "vo_marks_underhvyfr"


 // CHARACTER: MARKSWELL
 // CONTEXT:Tense
 // DIALOG : Get it finished and get back here!
 "lipsync_marks_geitfin"        "vo_marks_geitfin"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Roger, double time it Navajas.
 "lipsync_marks_rogdbl"        "vo_marks_rogdbl"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Dekard, take out those turrets!
 "lipsync_marks_dektkoutturr"        "vo_marks_dektkoutturr"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Dekard, Tak, take out those turrets!
 "lipsync_marks_dektaktake"        "vo_marks_dektaktake"


 // CHARACTER: MARKSWELL
 // CONTEXT:Calm
 // DIALOG : Roger that.
 "lipsync_marks_rogthat2"        "vo_marks_rogthat2"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Ok marines, up and over!
 "lipsync_marks_okmarup"        "vo_marks_okmarup"


 // CHARACTER: MARKSWELL
 // CONTEXT:Calm
 // DIALOG : Good job Tak, Dekard.  
 "lipsync_marks_goodjbtakdek"        "vo_marks_goodjbtakdek"


 // CHARACTER: MARKSWELL
 // CONTEXT:Calm
 // DIALOG : Good job Dekard!
 "lipsync_marks_goodjobdek"        "vo_marks_goodjobdek"


 // CHARACTER: MARKSWELL
 // CONTEXT:Calm
 // DIALOG : All able bodied Atlas and Hades squad members have moved into the facility via the tunnels your team cleared.  Dekard, Tak, Navajas, you're with me.  Darnell, stay behind and cover Mitchell until the wounded are stabilized.
 "lipsync_marks_allableatlas"        "vo_marks_allableatlas"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : On me, Move out!
 "lipsync_marks_onmemove"        "vo_marks_onmemove"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Move out!
 "lipsync_marks_moveout2"        "vo_marks_moveout2"


 // CHARACTER: MARKSWELL +USE
 // CONTEXT:Informative
 // DIALOG : The forward entrance to the facility is too heavily defended, we can’t get any closer.  
 "lipsync_marks_forwent"        "vo_marks_forwent"


 // CHARACTER: MARKSWELL +USE
 // CONTEXT:Annoyed
 // DIALOG : Get moving marine!
 "lipsync_marks_getmov"        "vo_marks_getmov"


 // CHARACTER: MARKSWELL +USE
 // CONTEXT:Annoyed
 // DIALOG : Dekard, I'm not going to tell you again.
 "lipsync_marks_deknottell"        "vo_marks_deknottell"

 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Dekard, get out of that walker!
 "lipsync_mark_tre_getout"        "vo_mark_tre_getout"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Dekard, fall in.
 "lipsync_mark_tre_fallin"        "vo_mark_tre_fallin"

}

