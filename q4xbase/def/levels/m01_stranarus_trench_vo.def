entityDef char_npc_navajas_M01_stranarus_trench_vo
{
 // CHARACTER: NAVAJAS
 // CONTEXT:Sarcastic
 // DIALOG : Yeah, one of these days we'll get a nice candy ass assignment like that, instead of all the shit work they keep throwin our way.
 "lipsync_nava_yeahone"        "vo_nava_yeahone"


 // CHARACTER: NAVAJAS
 // CONTEXT:Inquisitive
 // DIALOG : So Darnell, spill it – what’s the scoop on the new sarge?
 "lipsync_nava_sodrnspill"        "vo_nava_sodrnspill"


 // CHARACTER: NAVAJAS
 // CONTEXT:Sarcastic
 // DIALOG : See you on the ground!
 "lipsync_nava_seegrn"        "vo_nava_seegrn"


 // CHARACTER: NAVAJAS
 // CONTEXT:Informative
 // DIALOG : Blast door.  I don’t have enough charges to get through.
 "lipsync_nava_blsenoughchrg"        "vo_nava_blsenoughchrg"


 // CHARACTER: NAVAJAS
 // CONTEXT:Yelling
 // DIALOG : Strogg!
 "lipsync_nava_strgg1"        "vo_nava_strgg1"


 // CHARACTER: NAVAJAS
 // CONTEXT:Inquisitive
 // DIALOG : Damn.  You take care of this one too, Tak?
 "lipsync_nava_damnyoutakec"        "vo_nava_damnyoutakec"


 // CHARACTER: NAVAJAS
 // CONTEXT:Resolute
 // DIALOG : Then we do it my way.  Give me a minute and I’ll make us an entrance.  Watch my back.
 "lipsync_nava_thenwedoitmy"        "vo_nava_thenwedoitmy"


 // CHARACTER: NAVAJAS
 // CONTEXT:Calm
 // DIALOG : Here we go.  Setting the first charge.
 "lipsync_nava_herewegset"        "vo_nava_herewegset"


 // CHARACTER: NAVAJAS
 // CONTEXT:Calm
 // DIALOG : Second charge in place.  One more.
 "lipsync_nava_seconchrg"        "vo_nava_seconchrg"


 // CHARACTER: NAVAJAS
 // CONTEXT:Commanding
 // DIALOG : That’s it.  Everybody back.  Clear.  Clear.
 "lipsync_nava_thatsit"        "vo_nava_thatsit"


 // CHARACTER: NAVAJAS
 // CONTEXT:Commanding
 // DIALOG : Dekard, move away from the charges!
 "lipsync_nava_demvawaychrg"        "vo_nava_demvawaychrg"


 // CHARACTER: NAVAJAS
 // CONTEXT:Commanding
 // DIALOG : Those charges are live, get back!
 "lipsync_nava_thosechrglive"        "vo_nava_thosechrglive"


 // CHARACTER: NAVAJAS
 // CONTEXT:Yelling
 // DIALOG : Detonating!
 "lipsync_nava_detonat"        "vo_nava_detonat"


 // CHARACTER: NAVAJAS
 // CONTEXT:Informative
 // DIALOG : We've got company!
 "lipsync_nava_wegotcom"        "vo_nava_wegotcom"


 // CHARACTER: NAVAJAS
 // CONTEXT:Informative
 // DIALOG : Not unless you want this entire area to cave in.
 "lipsync_nava_nounless"        "vo_nava_nounless"


 // CHARACTER: NAVAJAS
 // CONTEXT:Informative
 // DIALOG : The supply tunnels should be ahead.
 "lipsync_nava_supplyahd"        "vo_nava_supplyahd"


 // CHARACTER: NAVAJAS
 // CONTEXT:Calm
 // DIALOG : Sounds like a Strogg problem, not mine.
 "lipsync_nava_sndslkstrogg"        "vo_nava_sndslkstrogg"


 // CHARACTER: NAVAJAS
 // CONTEXT:Informative
 // DIALOG : This must be Razor 16, no survivors.
 "lipsync_nava_razor16surv"        "vo_nava_razor16surv"


 // CHARACTER: NAVAJAS
 // CONTEXT:Commanding
 // DIALOG : Kill it!
 "lipsync_nava_killit"        "vo_nava_killit"


 // CHARACTER: NAVAJAS
 // CONTEXT:Informative
 // DIALOG : They're both nearly destroyed.
 "lipsync_tak_theybothdest"        "vo_tak_theybothdest"


 // CHARACTER: NAVAJAS
 // CONTEXT:Informative
 // DIALOG : It's nearly destroyed.
 "lipsync_tak_itdest"        "vo_tak_itdest"


 // CHARACTER: NAVAJAS
 // CONTEXT:Informative
 // DIALOG : It looks like Atlas almost breached this door, a couple of charges should finish the job.
 "lipsync_nava_itlooklkatlas"        "vo_nava_itlooklkatlas"


 // CHARACTER: NAVAJAS
 // CONTEXT:Informative
 // DIALOG : Tak, once the walker is repaired, I'll blow the door.
 "lipsync_nava_takoncerep"        "vo_nava_takoncerep"


 // CHARACTER: NAVAJAS
 // CONTEXT:Calm
 // DIALOG : First charge in place.
 "lipsync_nava_firstchrg"        "vo_nava_firstchrg"


 // CHARACTER: NAVAJAS
 // CONTEXT:Calm
 // DIALOG : Second charge up.
 "lipsync_nava_secondchrg"        "vo_nava_secondchrg"


 // CHARACTER: NAVAJAS
 // CONTEXT:Commanding
 // DIALOG : That’s it.  Door is ready!
 "lipsync_nava_thatitdr"        "vo_nava_thatitdr"


 // CHARACTER: NAVAJAS
 // CONTEXT:Commanding
 // DIALOG : Dekard, move away from the charges!
 "lipsync_nava_dekmvawaychrgs"        "vo_nava_dekmvawaychrgs"


 // CHARACTER: NAVAJAS
 // CONTEXT:Commanding
 // DIALOG : Those charges are live, get back!
 "lipsync_nava_thosechrglv"        "vo_nava_thosechrglv"


 // CHARACTER: NAVAJAS
 // CONTEXT:Yelling
 // DIALOG : Detonating!
 "lipsync_nava_detonating"        "vo_nava_detonating"


 // CHARACTER: NAVAJAS
 // CONTEXT:Yelling
 // DIALOG : Strogg incoming!
 "lipsync_nava_strgincom1"        "vo_nava_strgincom1"


 // CHARACTER: NAVAJAS
 // CONTEXT:Yelling
 // DIALOG : Blowing the door!
 "lipsync_nava_blowdoor2"        "vo_nava_blowdoor2"


 // CHARACTER: NAVAJAS
 // CONTEXT:Informative
 // DIALOG : Lieutenant, Dekard and Tak are inbound with walker support, I'm coming back around on foot.
 "lipsync_nava_ltdektak"        "vo_nava_ltdektak"


 // CHARACTER: NAVAJAS +USE
 // CONTEXT:Annoyed
 // DIALOG : Formal introductions can wait Sergeant, needless to say, I'm your demolitions expert.
 "lipsync_nava_formintro"        "vo_nava_formintro"


 // CHARACTER: NAVAJAS +USE
 // CONTEXT:Annoyed
 // DIALOG : Let's chat after we've accomplished our objective.
 "lipsync_nava_letschatob"        "vo_nava_letschatob"


 // CHARACTER: NAVAJAS +USE
 // CONTEXT:Annoyed
 // DIALOG : Time is short Sergeant, you do your job, I'll do mine.
 "lipsync_nava_timeisshort"        "vo_nava_timeisshort"


 // CHARACTER: NAVAJAS +USE
 // CONTEXT:Annoyed
 // DIALOG : Obviously you didn't hear the lieutenant.
 "lipsync_nava_obvioyouhr"        "vo_nava_obvioyouhr"

 // CHARACTER: NAVAJAS
 // CONTEXT:Informative
 // DIALOG : I'll stay here and keep Tak covered.
 "lipsync_nav_tre_stay"        "vo_nav_tre_stay"


}

