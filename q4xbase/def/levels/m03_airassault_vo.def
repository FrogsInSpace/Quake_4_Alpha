 // DIALOG : Shit!  Port engine has a reaction chamber failure.  I can't reset it from here!
 "lipsync_vansen_shitportract"        "vo_vansen_shitportract"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Shit!  Port engine burnout!  I can't reset it from here!
 "lipsync_vansen_shitburnout"        "vo_vansen_shitburnout"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
