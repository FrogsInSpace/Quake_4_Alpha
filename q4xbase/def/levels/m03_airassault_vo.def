entityDef char_npc_markswell_M03_airassault_vo
{

 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Good news, bad news, and worse news gentlemen.  
 "lipsync_marks_goodbadworse"        "vo_marks_goodbadworse"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Good news first, despite our losses, our mission to the Trianthinide facility was a success.  The facility was successfully destroyed and the data that we collected has perked the interests of SMC top brass.  
 "lipsync_marks_goodfirst"        "vo_marks_goodfirst"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Worse news, we just got word from the Hannibal, all four operation advantage EMP convoys were wiped out.  Most of the ground forces are captured or dead, and it would seem that the Strogg have replaced their leader with a new Makron.
 "lipsync_marks_worsenews"        "vo_marks_worsenews"


 // CHARACTER: MARKSWELL
 // CONTEXT:Informative
 // DIALOG : That’s right, after the EMP effort failed, sci-tech turned to the data we collected and discovered fragments pointing to how the Strogg brought a new Makron online so quickly. Unfortunately the rest of the data is heavily encrypted; and since it was our find, we’ve been tasked with locating the only marine that can unlock the rest of this critical data.
 "lipsync_marks_empeffortf"        "vo_marks_empeffortf"


 // CHARACTER: MARKSWELL
 // CONTEXT:Informative
 // DIALOG : Yes, the Hannibal has determined that Strauss is alive and en route to a Strogg bio processing center.
 "lipsync_marks_yeshannib"        "vo_marks_yeshannib"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Now the bad news, we aren’t heading back to the MCC.  We’ve changed course to join up with a multiple unit task force to infiltrate the Strogg medlabs, prisons, and bio processing centers.  
 "lipsync_marks_nowbadnews"        "vo_marks_nowbadnews"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Their goal, to locate pre-stroggified marines. Our goal, to locate and rescue Strauss.
 "lipsync_marks_theirgoal"        "vo_marks_theirgoal"


 // CHARACTER: MARKSWELL
 // CONTEXT:Reassuring
 // DIALOG : Marines, I know we're short-handed, but stay frosty- getting this data decrypted could change the tide of this war in Earth’s favor.  Dekard, Darnell, I don’t have to tell you what’s at stake here, you’ve seen what the Strogg did to Earth firsthand..
 "lipsync_marks_iknowshort"        "vo_marks_iknowshort"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Everybody to stations!  Go!
 "lipsync_marks_everystation"        "vo_marks_everystation"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Dekard, get to the belly turret!
 "lipsync_marks_dekgbelly"        "vo_marks_dekgbelly"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Dekard, man that belly turret now!
 "lipsync_marks_dekmanbell"        "vo_marks_dekmanbell"


 // CHARACTER: MARKSWELL
 // CONTEXT:Angry
 // DIALOG : Move Dekard!
 "lipsync_makrs_movedek1"        "vo_makrs_movedek1"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Ok, stations check.
 "lipsync_marks_okstations"        "vo_marks_okstations"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Mitchell, remain seated at all times, keep an eye on our guest and stay out of harms way.
 "lipsync_marks_mitchremain"        "vo_marks_mitchremain"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Dekard, you're on floating duty - stay on your toes.
 "lipsync_marks_dekfloat"        "vo_marks_dekfloat"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Tak, where are we?
 "lipsync_marks_takwherearewe"        "vo_marks_takwherearewe"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Third wing, this is Falcon 1, status, over.
 "lipsync_marks_thirdwingf1"        "vo_marks_thirdwingf1"


 // CHARACTER: MARKSWELL
 // CONTEXT:Tense
 // DIALOG : Hold on!
 "lipsync_marks_hangon"        "vo_marks_hangon"


 // CHARACTER: MARKSWELL
 // CONTEXT:Tense
 // DIALOG : Dekard, take out that destoryer on our tail!
 "lipsync_marks_dektakedest"        "vo_marks_dektakedest"


 // CHARACTER: MARKSWELL
 // CONTEXT:Tense
 // DIALOG : Dekard, that fighter on our tail is ripping us apart, take it out!
 "lipsync_marks_dekfightt"        "vo_marks_dekfightt"


 // CHARACTER: MARKSWELL
 // CONTEXT:Tense
 // DIALOG : Dekard, take out that target on our 6!
 "lipsync_marks_takeoutt6"        "vo_marks_takeoutt6"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Tak, hit the fire suppression system!
 "lipsync_marks_takhitsupp"        "vo_marks_takhitsupp"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Tak, get back to tactical. Dekard, grab that Strogg cold cannon and put out those fires!
 "lipsync_marks_taktact"        "vo_marks_taktact"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Dekard, I'm shutting down your turret, put out that fire!
 "lipsync_mairs_dekshutturr"        "vo_mairs_dekshutturr"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Gunners, fire at will!
 "lipsync_marks_gunnersfire"        "vo_marks_gunnersfire"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Darnell, Dekard, fire at will!
 "lipsync_marks_darndekfirew"        "vo_marks_darndekfirew"


 // CHARACTER: MARKSWELL
