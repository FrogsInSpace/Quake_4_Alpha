 "lipsync_vansen_pilotrog"        "vo_vansen_pilotrog"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : We've got a destroyer on our tail, Get that thing offa me!
 "lipsync_vansen_desttail"        "vo_vansen_desttail"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : I can't shake this destroyer.
 "lipsync_vansen_cantshkd"        "vo_vansen_cantshkd"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : I can't shake this fighter!
 "lipsync_vansen_cantshkf"        "vo_vansen_cantshkf"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Evasive maneuvers, hold on!
 "lipsync_vansen_evasiveman"        "vo_vansen_evasiveman"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Keep those destroyers offa' me!
 "lipsync_vansen_keepdestsoff"        "vo_vansen_keepdestsoff"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Hang on!
 "lipsync_vansen_hangon"        "vo_vansen_hangon"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Evasive maneuvers.
 "lipsync_vansen_evasiv2"        "vo_vansen_evasiv2"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Evasive action!
 "lipsync_vansen_evasive3"        "vo_vansen_evasive3"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : This is gonna get bumpy!
 "lipsync_vansen_getbumpy"        "vo_vansen_getbumpy"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Hold on to your lunch marines!
 "lipsync_vansen_holdlunch"        "vo_vansen_holdlunch"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Port engine is at 80%, getting bumpy.
 "lipsync_vansen_porteng80"        "vo_vansen_porteng80"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Lateral control is getting sluggish.
 "lipsync_vansen_latercont"        "vo_vansen_latercont"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Both engines are down more than 30%
 "lipsync_vansen_botheng"        "vo_vansen_botheng"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : Ship damage is getting critical
 "lipsync_vansen_shipdamcrit"        "vo_vansen_shipdamcrit"


 // CHARACTER: VANSEN (PILOT)
