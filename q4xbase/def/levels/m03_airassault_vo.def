entityDef char_npc_vansen_M03_airassault_vo
{
 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Calm
 // DIALOG : Lieutenant, we’ve just joined up with wing three of the task force, they’ve spotted Strogg air resistance on our vector.
 "lipsync_vansen_ltwing3"        "vo_vansen_ltwing3"


 // CHARACTER: VANSEN (PILOT)
 // CONTEXT:Tense
 // DIALOG : We’ve got incoming Strogg flyers!  
 "lipsync_vansen_wegotincom1"        "vo_vansen_wegotincom1"


 // CHARACTER: VANSEN (PILOT)
