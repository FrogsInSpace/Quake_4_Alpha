entityDef char_npc_mitchell_M03_airassault_vo
{

 // CHARACTER: MITCHELL
 // CONTEXT:Calm
 // DIALOG : As well as can be expected with three holes in his abdomen.  I’ve got him sedated but we need to keep a close eye on his vitals.
 "lipsync_mitch_aswell"        "vo_mitch_aswell"


 // CHARACTER: MITCHELL
 // CONTEXT:Relieved
 // DIALOG : I’m glad to be back on board the Falcon.  I’ll take a heavy gunship over those dropships any day.
 "lipsync_mitch_gladfalc"        "vo_mitch_gladfalc"


 // CHARACTER: MITCHELL
 // CONTEXT:Shocked
 // DIALOG : Holy shit?!   We committed more than half our ground forces to those objectives.
 "lipsync_mitch_holyshit"        "vo_mitch_holyshit"


 // CHARACTER: MITCHELL
 // CONTEXT:Quiet
 // DIALOG : Roger.
 "lipsync_mitch_roger1"        "vo_mitch_roger1"


 // CHARACTER: MITCHELL
 // CONTEXT:Warning
 // DIALOG : The Trianthinide cargo just ruptured, we've got shrapnel all over the place down here!
 "lipsync_mitch_trianthrupt"        "vo_mitch_trianthrupt"


 // CHARACTER: MITCHELL
 // CONTEXT:Frustrated
 // DIALOG : Damn!  Our guest from Razor squad just took some shrapnel!
 "lipsync_mitch_damnrazor"        "vo_mitch_damnrazor"


 // CHARACTER: MITCHELL
 // CONTEXT:Inquisitive
 // DIALOG : Navajas, you need medical?
 "lipsync_mitch_navayouneedmed"        "vo_mitch_navayouneedmed"


 // CHARACTER: MITCHELL
 // CONTEXT:Panic
 // DIALOG : Whoa, cargo fire!
 "lipsync_mitch_whoacargo"        "vo_mitch_whoacargo"


 // CHARACTER: MITCHELL +USE
 // CONTEXT:Indifferent
 // DIALOG : Sounds like I've been sidelined.
 "lipsync_mitch_soundsside"        "vo_mitch_soundsside"


 // CHARACTER: MITCHELL +USE
 // CONTEXT:Indifferent
 // DIALOG : I guess being shorthanded, we can't afford to lose the only medic.
 "lipsync_mitch_guessshort"        "vo_mitch_guessshort"

}

entityDef char_npc_navajas_M03_airassault_vo
{
 // CHARACTER: NAVAJAS
 // CONTEXT:Inquisitive
 // DIALOG : How’s he doing doc?
 "lipsync_nava_howhedo"        "vo_nava_howhedo"


 // CHARACTER: NAVAJAS
 // CONTEXT:Calm
 // DIALOG : Considering we didn’t actually crash after that impact, we got lucky.
 "lipsync_nava_considwedid"        "vo_nava_considwedid"


 // CHARACTER: NAVAJAS
 // CONTEXT:Dismissive
 // DIALOG : Yeah, well, we accomplished the mission.  Speaking of which- Tak- what’s the verdict on that data we collected?
 "lipsync_nava_yeahwellwe"        "vo_nava_yeahwellwe"


 // CHARACTER: NAVAJAS
 // CONTEXT:Surprised
 // DIALOG : What?!
 "lipsync_nava_what2"        "vo_nava_what2"


 // CHARACTER: NAVAJAS
 // CONTEXT:Despondent
 // DIALOG : Another shit job..
 "lipsync_nava_anothershit"        "vo_nava_anothershit"


 // CHARACTER: NAVAJAS
 // CONTEXT:Military
 // DIALOG : Munitions, online.
 "lipsync_nava_munitonline"        "vo_nava_munitonline"


 // CHARACTER: NAVAJAS
 // CONTEXT:Inquisitive
 // DIALOG : Dekard, you're not using your missiles.  You do know to operate that equipment, yes?
 "lipsync_nava_dekyounotmiss"        "vo_nava_dekyounotmiss"


