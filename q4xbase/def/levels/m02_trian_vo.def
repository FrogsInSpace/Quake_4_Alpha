entityDef char_npc_razor1_M02_trian__vo
{
 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Tense
 // DIALOG : This is Garrett from Razor 16, we're out of ammo and pinned down in a Trianthinide processing chamber.  If anybody can hear this, we need support!
 "lipsync_razor1_garret"        "vo_razor1_garret"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Fighting yell
 // DIALOG : Get offa me!
 "lipsync_razor1_getoff"        "vo_razor1_getoff"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Fighting yell
 // DIALOG : Arrrghhh!
 "lipsync_razor1_pain"        "vo_razor1_pain"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Relieved
 // DIALOG : Damn, are we glad to see you.  I'm Corporal Gray, this is Sergeant Garrett.
 "lipsync_razor1_damnglad"        "vo_razor1_damnglad"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Informative
 // DIALOG : There were 4 survivors of the dropship crash, we're the only two left now.  Our objective is to retrieve Trianthinide samples.  
 "lipsync_razor1_there4surv"        "vo_razor1_there4surv"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Informative
 // DIALOG : This machine processes raw Trianthinide, but we need to shut down its power generators in order to pull our samples.
 "lipsync_razor1_machineproc"        "vo_razor1_machineproc"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Informative
 // DIALOG : We found a Strogg Trianthinide weapon, but couldn't get it functioning in time to help with or assault.  Maybe your tech can get it working.
 "lipsync_razor1_foundstrg"        "vo_razor1_foundstrg"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Informative
 // DIALOG : This is where our team was ambushed.
 "lipsync_razor1_whereteamamb"        "vo_razor1_whereteamamb"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Informative
 // DIALOG : There's the Trianthinide weapon.
 "lipsync_razor1_theretrianth"        "vo_razor1_theretrianth"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Informative
 // DIALOG : The generators are just up that lift.
 "lipsync_razor1_genjustup"        "vo_razor1_genjustup"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Informative
 // DIALOG : There's the generator control, let me see what I can do.
 "lipsync_razor1_genctrl"        "vo_razor1_genctrl"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Informative
 // DIALOG : Ok, I can't shut them down, but I can overload the generators from here.  Cover me.
 "lipsync_razor1_okshutdwn"        "vo_razor1_okshutdwn"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Informative
 // DIALOG : Overload has begun.
 "lipsync_razor1_overload"        "vo_razor1_overload"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Informative
 // DIALOG : Generators are at 125%
 "lipsync_razor1_gen125"        "vo_razor1_gen125"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Informative
 // DIALOG : Generators are at 150%
 "lipsync_razor1_gen150"        "vo_razor1_gen150"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Tense
 // DIALOG : What the hell?  Those repair bots are compensating for the overload.
 "lipsync_razor1_whathellrep"        "vo_razor1_whathellrep"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Angry
 // DIALOG : Damn, the power level is dropping!
 "lipsync_razor1_damnpowdrp"        "vo_razor1_damnpowdrp"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Informative
 // DIALOG : Ok, good, the power level is rising again.
 "lipsync_razor1_gdpwrlv"        "vo_razor1_gdpwrlv"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Surprise
 // DIALOG : What the..?
 "lipsync_razor1_whathte"        "vo_razor1_whathte"


 // CHARACTER: RAZOR MARINE 1
 // CONTEXT:Death scream
 // DIALOG : Arrrghhh!
 "lipsync_razor1_pain2"        "vo_razor1_pain2"


 // CHARACTER: RAZOR MARINE 1 +USE
 // CONTEXT:Military
 // DIALOG : We need to get to those generators.
 "lipsync_razor1_weneedget"        "vo_razor1_weneedget"
}

