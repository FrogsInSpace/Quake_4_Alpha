
entityDef char_npc_darnell_M02_trian__vo
{
 // CHARACTER: DARNELL
 // CONTEXT:Calm
 // DIALOG : Lieutenant, Mitchell has stabilized the wounded, we are pushing into the facility
 "lipsync_darn_ltmitchwnd"        "vo_darn_ltmitchwnd"


 // CHARACTER: DARNELL
 // CONTEXT:Calm
 // DIALOG : Yes sir.
 "lipsync_darn_yessir"        "vo_darn_yessir"


 // CHARACTER: DARNELL
 // CONTEXT:Informative
 // DIALOG : Darnell here, Mitchell and I have located a terminal that Tak needs to ID for data mining, could be paydirt.
 "lipsync_darn_mitchlocterm"        "vo_darn_mitchlocterm"


 // CHARACTER: DARNELL
 // CONTEXT:Tense
 // DIALOG : Copy Lieutenant, tell that pair to double time it, we've got some company down here.
 "lipsync_darn_copylttell"        "vo_darn_copylttell"


 // CHARACTER: DARNELL
 // CONTEXT:Sarcastic
 // DIALOG : Glad you two could join us!
 "lipsync_darn_gladjoin"        "vo_darn_gladjoin"


 // CHARACTER: DARNELL
 // CONTEXT:Calm
 // DIALOG : Calm down Mitch.
 "lipsync_darn_calmmitch"        "vo_darn_calmmitch"


 // CHARACTER: DARNELL
 // CONTEXT:Yelling
 // DIALOG : Strogg!  
 "lipsync_darn_strogg3"        "vo_darn_strogg3"


 // CHARACTER: DARNELL
 // CONTEXT:Sarcastic
 // DIALOG : Great, make sure and tell that to the Strogg.
 "lipsync_darn_greatmake"        "vo_darn_greatmake"


 // CHARACTER: DARNELL
 // CONTEXT:Informative
 // DIALOG : Hmm, this is the only way - Mitchell, help me with the door.
 "lipsync_darn_hmmonlyway"        "vo_darn_hmmonlyway"


 // CHARACTER: DARNELL
 // CONTEXT:Commanding
 // DIALOG : Tak, get under this door and see if there is an access panel on the other side.
 "lipsync_darn_takgetunderths"        "vo_darn_takgetunderths"


 // CHARACTER: DARNELL
 // CONTEXT:Commanding
 // DIALOG : Tak, get through this door and see if there is an access panel on the other side
 "lipsync_darn_takgetdoor"        "vo_darn_takgetdoor"


 // CHARACTER: DARNELL
 // CONTEXT:Lifting heavy object
 // DIALOG : Urrggh!
 "lipsync_darn_pain"        "vo_darn_pain"


 // CHARACTER: DARNELL
 // CONTEXT:Strained
 // DIALOG : Dekard, see if you can find something to shove under this door.
 "lipsync_darn_dekseefind"        "vo_darn_dekseefind"


 // CHARACTER: DARNELL
 // CONTEXT:Strained
 // DIALOG : Tak, you find anything?!
 "lipsync_darn_takfindany"        "vo_darn_takfindany"


 // CHARACTER: DARNELL
 // CONTEXT:Strained
 // DIALOG : Dekard, forget it, get under the door.
 "lipsync_darn_dekforget"        "vo_darn_dekforget"


 // CHARACTER: DARNELL
 // CONTEXT:Strained
 // DIALOG : Dekard, go through the door!
 "lipsync_darn_dekgothru"        "vo_darn_dekgothru"


 // CHARACTER: DARNELL
 // CONTEXT:Strained
 // DIALOG : Dekard, hurry up!
 "lipsync_darn_dekhrry"        "vo_darn_dekhrry"


 // CHARACTER: DARNELL
 // CONTEXT:Strained
 // DIALOG : Come on Dekard, we can't hold this any longer!
 "lipsync_darn_comondek"        "vo_darn_comondek"


 // CHARACTER: DARNELL
 // CONTEXT:Relief from heavy lift
 // DIALOG : Ugh!
 "lipsync_darn_pain2"        "vo_darn_pain2"


 // CHARACTER: DARNELL
 // CONTEXT:Informative
 // DIALOG : Tak, Dekard, we're meeting back up with Markswell and Navajas, you should keep moving
 "lipsync_darn_takmeetmarks"        "vo_darn_takmeetmarks"


 // CHARACTER: DARNELL
 // CONTEXT:Sarcastic
 // DIALOG : It's not that big, the REAL big ones take more than just Dekard here to take down!
 "lipsync_darn_itnotthatbg"        "vo_darn_itnotthatbg"


 // CHARACTER: DARNELL
 // CONTEXT:Excited
 // DIALOG : Allright!  Vansen's back, this time with some heavier air support firepower!
 "lipsync_darn_alrightvans"        "vo_darn_alrightvans"


 // CHARACTER: DARNELL +USE
 // CONTEXT:Joking
 // DIALOG : Darnell and Dekard, raising hell once again!
 "lipsync_darn_darndekrais"        "vo_darn_darndekrais"


 // CHARACTER: DARNELL +USE
 // CONTEXT:Joking
 // DIALOG : The Squibs don't stand a chance!
 "lipsync_darn_squibsdont"        "vo_darn_squibsdont"

