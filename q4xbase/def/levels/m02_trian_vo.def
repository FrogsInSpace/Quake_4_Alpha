entityDef char_npc_markswell_M02_trian__vo
{

 // CHARACTER: MARKSWELL
 // CONTEXT:Calm
 // DIALOG : Hades and Atlas are prepping this facility for some fireworks, let's get in, get our data, and get out.
 "lipsync_marks_hadesatlas"        "vo_marks_hadesatlas"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Let's move.
 "lipsync_marks_letsmove2"        "vo_marks_letsmove2"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Keep it tight people.
 "lipsync_marks_keepittight"        "vo_marks_keepittight"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Apparently not, let's double time it, they're directly ahead.
 "lipsync_marks_apparentnot"        "vo_marks_apparentnot"


 // CHARACTER: MARKSWELL
 // CONTEXT:Resolute
 // DIALOG : We read you Razor 16, Falcon is on the way.
 "lipsync_marks_wereadrazor"        "vo_marks_wereadrazor"


 // CHARACTER: MARKSWELL
 // CONTEXT:Inquisitive
 // DIALOG : How many Razor survivors are there?
 "lipsync_marks_howmaysurv"        "vo_marks_howmaysurv"


 // CHARACTER: MARKSWELL
 // CONTEXT:Calm
 // DIALOG : No word, nothing yet.
 "lipsync_marks_nowordnoth"        "vo_marks_nowordnoth"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Here's the plan: Navajas, stay here and hold this position with Garrett.  The rest of us will push ahead to the generators and shut them down.
 "lipsync_marks_hereplannav"        "vo_marks_hereplannav"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Let's go.
 "lipsync_marks_letsgo3"        "vo_marks_letsgo3"


 // CHARACTER: MARKSWELL
 // CONTEXT:Calm
 // DIALOG : Roger that Darnell, try to locate a terminal that Tak can use to data mine.
 "lipsync_marks_rogerthtterm"        "vo_marks_rogerthtterm"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Shoot the repair bots marines!
 "lipsync_marks_shootrepbot"        "vo_marks_shootrepbot"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Take out those repair bots!
 "lipsync_marks_tkoutrep"        "vo_marks_tkoutrep"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Take that thing out!
 "lipsync_marks_takeout2"        "vo_marks_takeout2"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Tak, get on this control station and keep that overload going.
 "lipsync_marks_takctrlstat"        "vo_marks_takctrlstat"


 // CHARACTER: MARKSWELL
 // CONTEXT:Tense
 // DIALOG : Standby Darnell.
 "lipsync_marks_standdarn"        "vo_marks_standdarn"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Allright, we're splitting up, Dekard, Tak, locate Darnell and Mitchell, see if the terminal they located will work for data mining.  I'm going back with Navajas to help Razor complete their objective.
 "lipsync_marks_alsplitting"        "vo_marks_alsplitting"


 // CHARACTER: MARKSWELL
 // CONTEXT:Informative
 // DIALOG : Darnell, Tak and Dekard are coming your way.
 "lipsync_marks_darnloctermd"        "vo_marks_darnloctermd"


 // CHARACTER: MARKSWELL
 // CONTEXT:Informative
 // DIALOG : I'm heading back.  Get moving you two.
 "lipsync_marks_headback"        "vo_marks_headback"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Roger that Tak, standby.
 "lipsync_marks_rogetakst"        "vo_marks_rogetakst"


 // CHARACTER: MARKSWELL
 // CONTEXT:Informative
 // DIALOG : Ok Falcon, GOC has changed our primary objective.  We are to locate that unsecured Nexus access point at all costs, download any critical data we can, and get it back to the brass pronto.
 "lipsync_marks_okfalcgoc"        "vo_marks_okfalcgoc"


 // CHARACTER: MARKSWELL
 // CONTEXT:Informative
 // DIALOG : Dekard, you and your team follow Tak to that access point, we'll catch up ASAP.
 "lipsync_makrs_dekyouandyour"        "vo_makrs_dekyouandyour"


 // CHARACTER: MARKSWELL
 // CONTEXT:Calm
 // DIALOG : Roger that, make it fast, we have a gunship heading our way for evac. Atlas and Hades squads are ready to scrub this facility, you're on a timeline marines
 "lipsync_marks_rogmakeitfast"        "vo_marks_rogmakeitfast"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Ok gentlemen, lets get moving to the LZ. Atlas and Hades squads are about to nuke this facility off the map, we don't want to be around for it.
 "lipsync_marks_okgents"        "vo_marks_okgents"


 // CHARACTER: MARKSWELL
 // CONTEXT:Military
 // DIALOG : Roger Falcon 1, we are inbound to LZ
 "lipsync_marks_rogfalc1"        "vo_marks_rogfalc1"


 // CHARACTER: MARKSWELL
 // CONTEXT:Inquisitive
 // DIALOG : Did you get the data Tak?
 "lipsync_marks_didyouget"        "vo_marks_didyouget"


 // CHARACTER: MARKSWELL
 // CONTEXT:Commanding
 // DIALOG : Everybody onboard!
 "lipsync_marks_everybodyonb"        "vo_marks_everybodyonb"


 // CHARACTER: MARKSWELL +USE
 // CONTEXT:Military
 // DIALOG : I'd sure like to know how the EMP convoys are proceeding.
 "lipsync_marks_idlikeemp"        "vo_marks_idlikeemp"


 // CHARACTER: MARKSWELL +USE
 // CONTEXT:Military
 // DIALOG : I know it’s your first command, Dekard.  Don’t worry, you’re the right man for the job.
 "lipsync_marks_iknowfirstdek"        "vo_marks_iknowfirstdek"


 // CHARACTER: MARKSWELL +USE
 // CONTEXT:Military
 // DIALOG : Dekard, stay focused.  We've got a job to do.
 "lipsync_marks_dekstayfoc"        "vo_marks_dekstayfoc"


 // CHARACTER: MARKSWELL +USE
 // CONTEXT:Military
 // DIALOG : You heard the man, get moving!
 "lipsync_marks_youheardm"        "vo_marks_youheardm"


 // CHARACTER: MARKSWELL +USE
 // CONTEXT:Annoyed
 // DIALOG : Dekard, now is not the time.
 "lipsync_marks_deknownot"        "vo_marks_deknownot"


 // CHARACTER: MARKSWELL +USE
 // CONTEXT:Annoyed
 // DIALOG : You have your orders marine!
 "lipsync_marks_youhaveords"        "vo_marks_youhaveords"
}

