entityDef char_npc_tak_M02_trian__vo
{

 // CHARACTER: TAK
 // CONTEXT:Calm
 // DIALOG : Hold up Dekard, the boys in Atlas squad showed me how to increase effective yield on their grenade launchers, give me yours and I'll do the same.
 "lipsync_tak_holdupdek"        "vo_tak_holdupdek"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Ok, done - now your grenades will have a larger concussive blast.
 "lipsync_tak_okdngren"        "vo_tak_okdngren"


 // CHARACTER: TAK
 // CONTEXT:Surprise
 // DIALOG : Holy shit, I thought everybody on that Razor dropship was dead?
 "lipsync_tak_holshitdead"        "vo_tak_holshitdead"


 // CHARACTER: TAK
 // CONTEXT:
 // DIALOG : Let me get this door open.
 "lipsync_tak_letmegetdr"        "vo_tak_letmegetdr"


 // CHARACTER: TAK
 // CONTEXT:
 // DIALOG : Done
 "lipsync_tak_done3"        "vo_tak_done3"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Hmm, let me see, getting this to fire should be easy enough.  [beat] Done.
 "lipsync_tak_hmmletmesee"        "vo_tak_hmmletmesee"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Here Dekard, this looks like it shoots Trianthinide bolts, should do quite a bit of damage.
 "lipsync_tak_herekedshoots"        "vo_tak_herekedshoots"


 // CHARACTER: TAK
 // CONTEXT:Military
 // DIALOG : Yes sir.
 "lipsync_tak_yessir2"        "vo_tak_yessir2"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Generators are at 175%
 "lipsync_tak_genat175"        "vo_tak_genat175"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Generators reaching critical level.
 "lipsync_tak_genreachcrit"        "vo_tak_genreachcrit"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : That's it, the generators are failing.
 "lipsync_tak_thatgenfall"        "vo_tak_thatgenfall"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Generator 1 has failed.
 "lipsync_tak_gen1failred"        "vo_tak_gen1failred"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : …and…Generator 2 has failed.  Razor should be able to finish their objective.
 "lipsync_tak_andgen2fail"        "vo_tak_andgen2fail"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Wow, this terminal is older than anything I've seen before.  Keep me covered guys, while I try to access this antique
 "lipsync_tak_wowtermseen"        "vo_tak_wowtermseen"


 // CHARACTER: TAK
 // CONTEXT:Yelling
 // DIALOG : Keep em' off me!
 "lipsync_tak_keepemoff"        "vo_tak_keepemoff"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Lieutenant, according to the data I'm seeing here, there is a Nexus access point in this facility that doesn't contain any data lockouts of any kind.  If we can locate that access terminal, we will have found a serious hole in the Strogg network.  We could get our hands on info about the Strogg that nobody has seen before.
 "lipsync_tak_ltaccord"        "vo_tak_ltaccord"


 // CHARACTER: TAK
 // CONTEXT:Warning
 // DIALOG : Whoa, these walls contain raw exposed Trianthinide veins.  We need to watch our fire in here- hitting any of these veins could light up this entire facility.
 "lipsync_tak_whoawallsraw"        "vo_tak_whoawallsraw"


 // CHARACTER: TAK
 // CONTEXT:Warning
 // DIALOG : Watch your fire!
 "lipsync_tak_watchfire"        "vo_tak_watchfire"


 // CHARACTER: TAK
 // CONTEXT:Angry
 // DIALOG : Trianthinide is very unstable, check your targets!
 "lipsync_tak_trianthuns"        "vo_tak_trianthuns"


 // CHARACTER: TAK
 // CONTEXT:Calm
 // DIALOG : Ok…
 "lipsync_tak_ok3"        "vo_tak_ok3"


 // CHARACTER: TAK
 // CONTEXT:Calm
 // DIALOG : No, I don't see an access panel, this door is controlled remotely.
 "lipsync_tak_noidntsee"        "vo_tak_noidntsee"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Come on Dekard, the Nexus access point should be close.
 "lipsync_tak_comnexus"        "vo_tak_comnexus"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Hmm, the Nexus access point is in the adjacent room, but the door is momentary.  Shit, Dekard, I can get the door open from here, but you’re going to have to get in there and access the terminal. I can't get to it from here.
 "lipsync_tak_hmmnexacc"        "vo_tak_hmmnexacc"


 // CHARACTER: TAK
 // CONTEXT:Informative
 // DIALOG : Look around Dekard, the Nexus access point should be easy to find.
 "lipsync_tak_lkarounddek"        "vo_tak_lkarounddek"


 // CHARACTER: TAK
 // CONTEXT:Calm
 // DIALOG : Lieutenant, Dekard and I are about to download the data from the Nexus access point
 "lipsync_tak_ltdeki"        "vo_tak_ltdeki"


 // CHARACTER: TAK
 // CONTEXT:Calm
 // DIALOG : Roger that, Dekard.  
 "lipsync_tak_rogdek3"        "vo_tak_rogdek3"


 // CHARACTER: TAK
 // CONTEXT:Calm
 // DIALOG : Ok, good, I can see the data you are accessing now, keep navigating.
 "lipsync_tak_gooddataacc"        "vo_tak_gooddataacc"


 // CHARACTER: TAK
 // CONTEXT:Excited
 // DIALOG : Sweet Mother!  What did you do Dekard?
 "lipsync_tak_swtmoth"        "vo_tak_swtmoth"


 // CHARACTER: TAK
 // CONTEXT:Excited
 // DIALOG : Keep it up.. You've opened up something..  I'm getting a data stream that's like nothing I've ever seen before.  This is amazing!
 "lipsync_tak_keepopensome"        "vo_tak_keepopensome"


 // CHARACTER: TAK
 // CONTEXT:Panicked
 // DIALOG : I'm almost done with this download, oh shi(static)..ekard!  Something huge is coming your way!
 "lipsync_tak_almostdown"        "vo_tak_almostdown"


 // CHARACTER: TAK
 // CONTEXT:Panicked
 // DIALOG : That data has set off a serious alarm (static)..coming your way!  Move out!  Move ou(static)
 "lipsync_tak_thatdatserious"        "vo_tak_thatdatserious"


 // CHARACTER: TAK
 // CONTEXT:Surprised
 // DIALOG : Holy shit!  Look at the size of that thing?!
 "lipsync_tak_holysht"        "vo_tak_holysht"


 // CHARACTER: TAK
 // CONTEXT:Excited
 // DIALOG : Yes sir, once we're on the Falcon, I'll start pushing this data to the MCC. I need to spend a little time with the data, but this stuff is gold.
 "lipsync_tak_yessfalc"        "vo_tak_yessfalc"


 // CHARACTER: TAK +USE
 // CONTEXT:Informative
 // DIALOG : The Strogg mine and process pure Trianthinide at this facility.
 "lipsync_tak_strgmine"        "vo_tak_strgmine"


 // CHARACTER: TAK +USE
 // CONTEXT:Informative
 // DIALOG : Trianthinide is a damn unstable element, like plutonium, they use it as a volatile power source.
 "lipsync_tak_triandamn"        "vo_tak_triandamn"


 // CHARACTER: TAK +USE
 // CONTEXT:Informative
 // DIALOG : When this place goes up, it's going to leave a giant crater.
 "lipsync_tak_whenplcgo"        "vo_tak_whenplcgo"


 // CHARACTER: TAK +USE
 // CONTEXT:Informative
 // DIALOG : Let's move, Darnell and Mitchell need our help
 "lipsync_tak_letsmvdrn"        "vo_tak_letsmvdrn"


 // CHARACTER: TAK +USE
 // CONTEXT:Inquisitive
 // DIALOG : So this is your first command?
 "lipsync_tak_sothisfirst"        "vo_tak_sothisfirst"


 // CHARACTER: TAK +USE
 // CONTEXT:Informative
 // DIALOG : Darnell told me about what you guys did back on Earth.  Pretty impressive.
 "lipsync_tak_darnearth"        "vo_tak_darnearth"


 // CHARACTER: TAK +USE
 // CONTEXT:Excited
 // DIALOG : We need to find that access point.
 "lipsync_tak_weneedfing"        "vo_tak_weneedfing"


 // CHARACTER: TAK +USE
 // CONTEXT:Excited
 // DIALOG : If I can get open access to the Nexus, it could change the tide of this war!
 "lipsync_tak_ificanget"        "vo_tak_ificanget"


 // CHARACTER: TAK +USE
 // CONTEXT:Informative
 // DIALOG : If Navajas was here, we could breach this door.
 "lipsync_tak_ifnavabr"        "vo_tak_ifnavabr"


 // CHARACTER: TAK +USE
 // CONTEXT:Reassuring
 // DIALOG : Speaking of Navajas, don't mind him, he lost a lot of friends back on Earth.
 "lipsync_tak_speaknava"        "vo_tak_speaknava"


 // CHARACTER: TAK +USE
 // CONTEXT:Reassuring
 // DIALOG : Navajas takes a while to warm up to anybody that was part of the Earth defensive.
 "lipsync_tak_anyboderth"        "vo_tak_anyboderth"
}

