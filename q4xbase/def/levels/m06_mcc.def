	"lipsync_yoshi_swearmust"        "vo_yoshi_swearmust"
	
	
	// CHARACTER: YOSHIDA +USE
	// CONTEXT:Angry
	// DIALOG : They better not let him wander the ship without his bodyguard.
	"lipsync_yoshi_bettrnot"        "vo_yoshi_bettrnot"


	
	// CHARACTER: DOCTOR 0
	// CONTEXT:Monotone
	// DIALOG : This Strogg gunner was found dead without any apparent contact wounds
	"lipsync_doc_0_1"        "vo_doc_0_1"
	
	
	// CHARACTER: DOCTOR 0
	// CONTEXT:Monotone
	// DIALOG : Further investigation revealed a severe deterioration  between the biomechanical implants and fused tissue, leading to a severe infection
	"lipsync_doc_0_2"        "vo_doc_0_2"
	
	
	// CHARACTER: DOCTOR 0
	// CONTEXT:Monotone
	// DIALOG : Impossible to tell actual COD without removing the Strogg implants
	"lipsync_doc_0_3"        "vo_doc_0_3"
	
	
	
	// CHARACTER: DOCTOR 1
	// CONTEXT:Calm
	// DIALOG : There seems to be some concern from command that Kain might turn
	"lipsync_doc_1"        "vo_doc_1"
	
	
	// CHARACTER: DOCTOR 1
	// CONTEXT:Prodding
	// DIALOG : You also said it was impossible for another Markon to lead the Strogg
	"lipsync_doc_3"        "vo_doc_3"
	
	
	
	// CHARACTER: DOCTOR 2
	// CONTEXT:Frustrated
	// DIALOG : That's totally irrelevant, nobody predicted that, I'm speaking from hard medical evidence
	"lipsync_doc_4"        "vo_doc_4"
	
	// CHARACTER: DOCTOR 2
	// CONTEXT:Frustrated
	// DIALOG : That's impossible, the neurocyte isn't active.
	"lipsync_doc_2"        "vo_doc_2"
	
	
	
	// CHARACTER: GUARD 1
	// CONTEXT:Commanding
	// DIALOG : Hold on sir.
	"lipsync_guard1_holdon"        "vo_guard1_holdon"
	
	
	// CHARACTER: GUARD 1
	// CONTEXT:Commanding
	// DIALOG : Ok, move along.
	"lipsync_guard1_okmove"        "vo_guard1_okmove"
	
	
	
	// CHARACTER: GENERAL CLOUD
	// CONTEXT:Whispered
	// DIALOG : The assault on the Nexus cannot fail again.
	"lipsync_cloud_assault"        "vo_cloud_assault"
	
	
	// CHARACTER: GENERAL CLOUD
	// CONTEXT:Whispered
	// DIALOG : Our ground presence on Stroggos is extremely limited.
	"lipsync_cloud_ground"        "vo_cloud_ground"
	
	
	
	// CHARACTER: MCNUTT
	// CONTEXT:Calm
	// DIALOG : Did you update their positioning systems to account for the latest SMC update?
	"lipsync_mcnutt_angry2"        "vo_mcnutt_angry2"
	
	
	// CHARACTER: MCNUTT
	// CONTEXT:Informative
	// DIALOG : Process an update through the analog router, it will take some time, but it should reset their location beacons.
	"lipsync_mcnutt_angry4"        "vo_mcnutt_angry4"
	
	
	
	// CHARACTER: FRANKLIN
	// CONTEXT:Questioning
	// DIALOG : Who the hell was that?
	"lipsync_frank_conv1"        "vo_frank_conv1"
	
	// CHARACTER: FRANKLIN
	// CONTEXT:Surprised
	// DIALOG : Why the hell does he have an armed escort?  There are no squibs on this ship!
	"lipsync_frank_conv3"        "vo_frank_conv3"
	
	// CHARACTER: FRANKLIN
	// CONTEXT:Realization
	// DIALOG : Oh yeah, I forgot about that mess.
	"lipsync_frank_conv5"        "vo_frank_conv5"
	
	// CHARACTER: FRANKLIN +USE
	// CONTEXT:Calm
	// DIALOG : I'm surprised to see armed guards escorting a general
	"lipsync_frank_use1"        "vo_frank_use1"
	
	// CHARACTER: FRANKLIN +USE
	// CONTEXT:Calm
	// DIALOG : Maybe their worried about that freak from Rhino squad.
	"lipsync_frank_use2"        "vo_frank_use2"
	
	// CHARACTER: FRANKLIN +USE
	// CONTEXT:Calm
	// DIALOG : I don't know if anybody is excited about having THAT former marine on board.
	"lipsync_frank_use3"        "vo_frank_use3"
	
	
	
	// CHARACTER: MUNRO
	// CONTEXT:Calm
	// DIALOG : The medical centers on this deck keep the brass jumpy, not all Strogg those docs work on have proven to be dead, remember?
	"lipsync_munro_conv4"        "vo_munro_conv4"
	
	// CHARACTER: MUNRO
	// CONTEXT:Calm
	// DIALOG : That was general Cloud, he hasn't been down to this deck since we left Earth.
	"lipsync_munro_conv2"        "vo_munro_conv2"
	
	// CHARACTER: MUNRO +USE
	// CONTEXT:Calm
	// DIALOG : It is strange seeing general Cloud down on this deck
	"lipsync_munro_use1"        "vo_munro_use1"
	
	
	// CHARACTER: MUNRO +USE
	// CONTEXT:Calm
	// DIALOG : The upcoming assault has everybody on edge
	"lipsync_munro_use2"        "vo_munro_use2"
	
	
	// CHARACTER: MUNRO +USE
	// CONTEXT:Annoyed
	// DIALOG : I need to get back to work.
	"lipsync_munro_use3"        "vo_munro_use3"
	
	
	
	// CHARACTER: FOWLER
	// CONTEXT:Working
	// DIALOG : Hang on… I got the same.  Full power, full operations.  Looks like it's ready
	"lipsync_fowler_hangon"        "vo_fowler_hangon"
	
	// CHARACTER: FOWLER
	// CONTEXT:Calm
	// DIALOG : Yes.
	"lipsync_fowler_yes"        "vo_fowler_yes"
	
	// CHARACTER: FOWLER
	// CONTEXT:Calm
	// DIALOG : Yes.
	"lipsync_fowler_yes2"        "vo_fowler_yes2"
	
	
	
	// CHARACTER: EISERLOH
	// CONTEXT:Working
	// DIALOG : System is reading on-line.  What do you have on your end?
	"lipsync_brian_system"        "vo_brian_system"
	
	// CHARACTER: EISERLOH
	// CONTEXT:Frustrated
	// DIALOG : You check redundant coil switch?  (beat)  well?
	"lipsync_brian_coil"        "vo_brian_coil"
	
	// CHARACTER: EISERLOH
	// CONTEXT:Frustrated
	// DIALOG : Are you lying to me?
	"lipsync_brian_lying"        "vo_brian_lying"
	
	// CHARACTER: EISERLOH
	// CONTEXT:Frustrated
	// DIALOG : Look, just check it over, and we'll get you out of there.  The system should be fine.
	"lipsync_brian_look"        "vo_brian_look"
	
	// CHARACTER: EISERLOH +USE
	// CONTEXT:Frustrated
	// DIALOG : Feel like we've been working on this defense system for days.
	"lipsync_brian_use1"        "vo_brian_use1"
	
	// CHARACTER: EISERLOH +USE
	// CONTEXT:Frustrated
	// DIALOG : Fowler's been in that hatch without a break since shift change
	"lipsync_brian_use2"        "vo_brian_use2"
	
	// CHARACTER: EISERLOH +USE
	// CONTEXT:Frustrated
	// DIALOG : Hopefully we won't need these guns anytime soon.
	"lipsync_brian_use3"        "vo_brian_use3"
	
	
	
	// CHARACTER: GARRETT 
	// CONTEXT:Informative
	// DIALOG : Sir, this door is malfunctioning, you'll need to go around.  Sorry.
	"lipsync_garrett_door"        "vo_garrett_door"
	
	
	// CHARACTER: GARRETT +USE
	// CONTEXT:Informative
	// DIALOG : This ship is falling apart around us.
	"lipsync_garrett_use1"        "vo_garrett_use1"
	
	
	// CHARACTER: GARRETT +USE
	// CONTEXT:Informative
	// DIALOG : Can't even keep the messhall open, you should see what the munitions bay looks like
	"lipsync_garrett_use2"        "vo_garrett_use2"
	
	
	// CHARACTER: GARRETT +USE
	// CONTEXT:Informative
	// DIALOG : The landing really jarred a lot of systems, I'll be happy once we are back in space.
	"lipsync_garrett_use3"        "vo_garrett_use3"
	
	
	
	// CHARACTER: SLEEPER
	// CONTEXT:Sleepy, annoyed
	// DIALOG : ...urgh, leave me alone...
	"lipsync_sleeper_use1"        "vo_sleeper_use1"
	
	
	// CHARACTER: SLEEPER
	// CONTEXT:Sleepy, annoyed
	// DIALOG : ..ugh, damnit, I've been up for 20 hours, let me get some shut eye...
	"lipsync_sleeper_use2"        "vo_sleeper_use2"
	
	
	// CHARACTER: SLEEPER
	// CONTEXT:Sleepy, annoyed
	// DIALOG : ..the presentations for the nexus assault were changed last minute, no sleep trying to fix it in time...
	"lipsync_sleeper_use3"        "vo_sleeper_use3"
	
	
	// CHARACTER: SLEEPER
	// CONTEXT:Sleepy, annoyed
	// DIALOG : ..please, just let me sleep..
	"lipsync_sleeper_use4"        "vo_sleeper_use4"
	
	
	
	// CHARACTER: TV
	// CONTEXT:Newscaster
	// DIALOG : Earth cleanup efforts in New Berlin have been hindered by unexpected high levels of a previously undiscovered Strogg radiation at all Strogg landing sites.
	"lipsync_news_earth"        "vo_news_earth"
	
	
	// CHARACTER: TV
	// CONTEXT:Newscaster
	// DIALOG : 15 workers have been hospitalized due to radiation related sickness.  Labor groups are confused and angry since each site was proclaimed safe by SMC engineers over 2 months ago
	"lipsync_news_workers"        "vo_news_workers"
	
	
	// CHARACTER: TV
	// CONTEXT:Newscaster
	// DIALOG : SMC engineers on site have reported that the radiation source was Strogg in nature, and had not been a type of Radiation known to SMC engineers before the hospitalizations took place.
	"lipsync_news_engineers"        "vo_news_engineers"
	
	
	
	// CHARACTER: TV GUY +USE
	// CONTEXT:Annoyed
	// DIALOG : Hey, I'm watching this.
	"lipsync_tvguy_annoyed1"        "vo_tvguy_annoyed1"
	
	
	// CHARACTER: TV GUY +USE
	// CONTEXT:Annoyed
	// DIALOG : Shh...
	"lipsync_tvguy_annoyed2"        "vo_tvguy_annoyed2"
	
	
	// CHARACTER: TV GUY +USE
	// CONTEXT:Annoyed
	// DIALOG : Sir, please.
	"lipsync_tvguy_annoyed3"        "vo_tvguy_annoyed3"
	
	
	
	// CHARACTER: RUNNING MARINE
	// CONTEXT:Military
	// DIALOG : Go Go Go!
	"lipsync_runmarine_1"        "vo_runmarine_1"
	
	
	// CHARACTER: RUNNING MARINE
	// CONTEXT:Military
	// DIALOG : Move it ladies!
	"lipsync_runmarine_2"        "vo_runmarine_2"
	
	
	// CHARACTER: RUNNING MARINE
	// CONTEXT:Military
	// DIALOG : The Nexus assault won't wait for you!
	"lipsync_runmarine_3"        "vo_runmarine_3"
	
	
	
	// CHARACTER: FLANNAGAN
	// CONTEXT:Tense
	// DIALOG : If we setup the decryption algorithm on every workstation on the ship, we can process the data in parallel
	"lipsync_flan_data1"        "vo_flan_data1"
	
	
	// CHARACTER: FLANNAGAN
	// CONTEXT:Tense
	// DIALOG : No, too many systems on the ship are locked out from each other, we could get root access to each subsystem and install it from there.
	"lipsync_flan_data3"        "vo_flan_data3"
	
	// CHARACTER: FLANNAGAN +USE
	// CONTEXT:Informative
	// DIALOG : There are over four thousand workstations on this ship, all of which could assist in processing this data
	"lipsync_flan_use1"        "vo_flan_use1"
	
	
	// CHARACTER: FLANNAGAN +USE
	// CONTEXT:Informative
	// DIALOG : We have to manually install the decryption algorithm on each workstation, we don't have time for that
	"lipsync_flan_use2"        "vo_flan_use2"
	
	// CHARACTER: FLANNAGAN +USE
	// CONTEXT:Informative
	// DIALOG : This wasn't something we anticipated having to deal with, this is an enormous amount of data
	"lipsync_flan_use3"        "vo_flan_use3"
	
	
	
	// CHARACTER: KETCHERSIDE
	// CONTEXT:Tense
	// DIALOG : Is it possible to do that without modifying every workstation manually?
	"lipsync_ketch_data2"        "vo_ketch_data2"
	
	// CHARACTER: KETCHERSIDE
	// CONTEXT:Tense
	// DIALOG : We can't do that while there are any active operations, it would require a total shutdown and restart for all systems
	"lipsync_ketch_data4"        "vo_ketch_data4"
	
	// CHARACTER: KETCHERSIDE +USE
	// CONTEXT:Informative
	// DIALOG : Parallel processing would have this data decrypted in just under a day
	"lipsync_ketch_use1"        "vo_ketch_use1"
	
	
	// CHARACTER: KETCHERSIDE +USE
	// CONTEXT:Informative
	// DIALOG : We have every CPU in sci-tech already dedicated to this task
	"lipsync_ketch_use2"        "vo_ketch_use2"
	
	
	// CHARACTER: KETCHERSIDE +USE
	// CONTEXT:Informative
	// DIALOG : The data is processing much faster, but still not quickly enough.
	"lipsync_ketch_use3"        "vo_ketch_use3"
	
}



//--------------------------------------------------------------------------------------------------------------------
// copy-paste required for medics, techs, and doctors
//--------------------------------------------------------------------------------------------------------------------
model model_q4x_mcc_marine_medic
{
	inherit					model_q4x_mcc_marine
	
	mesh					models/characters/marine_medic/marine_medic.md5mesh
	channel torso	( *waist )
	channel legs	( *origin *hips -*waist )
	
	anim	medic_treating_player_start		models/characters/marine/medic_treating_player_start.md5anim
	{
		frame	13							attachment_show	medic_vaccinegun
		rate 1.3
	}
	anim	medic_treating_player			models/characters/marine/medic_treating_player.md5anim
	{
		frame	1							sound	snd_med_gun_heal
		rate .5
	}
	anim	medic_treating_player_end		models/characters/marine/medic_treating_player_end.md5anim
	{
		frame	17							attachment_hide	medic_vaccinegun
		rate 1.3
	}
}


model model_q4x_mcc_marine_tech
{
	inherit					model_q4x_mcc_marine
	
	mesh					models/characters/marine_tech/marine_tech.md5mesh
	channel torso	( *waist )
	channel legs	( *origin *hips -*waist )
	
	anim	medic_treating_player_start		models/characters/marine/medic_treating_player_start.md5anim
	{
		frame	13							attachment_show	tech_tool
		rate 1.3
	}
	anim	medic_treating_player			models/characters/marine/medic_treating_player.md5anim
	{
		frame	1							sound	snd_tech_tool_repair
		rate .5
	}
	anim	medic_treating_player_end		models/characters/marine/medic_treating_player_end.md5anim
	{
		frame	17							attachment_hide	tech_tool
		rate 1.3
	}
}


model model_q4x_mcc_doctor
{
	inherit							model_q4x_mcc_marine
	//inherit							mcc1_model_char_marine // BAD
	
	mesh							models/characters/doctor/doctor.md5mesh
	channel torso	( *waist )
	channel legs	( *origin *hips -*waist )
}


//--------------------------------------------------------------------------------------------------------------------
// copy-paste for officer model
//--------------------------------------------------------------------------------------------------------------------
model model_q4x_mcc_marine_officer
{
	inherit							model_q4x_mcc_marine_fatigues
	
	mesh							models/characters/marine_fatigues_mocap/officer_mesh.md5mesh

	channel torso	( *waist )
	channel legs	( *origin *hips -*waist )
}


