//--------------------------------------------------------------------------------------------------------------------
// LOTS AND LOTS OF DIALOGUE YAY
//--------------------------------------------------------------------------------------------------------------------
entityDef char_q4x_mcc_marine_dialog
{
	// CHARACTER: BANKS +USE
	// CONTEXT:Informative
	// DIALOG : The Perimeter Defense System is ready.  We’re just doing the last few checks.
	"lipsync_banks_peridef"        "vo_banks_peridef"
	
	
	// CHARACTER: BANKS +USE
	// CONTEXT:Informative
	// DIALOG : If the Nexus Assault is successful, the war will be over before we'll ever need these defense systems.
	"lipsync_banks_nexass"        "vo_banks_nexass"
	
	
	// CHARACTER: BANKS +USE
	// CONTEXT:Informative
	// DIALOG : We only have a couple more tests.  The system should be good to go.
	"lipsync_banks_coupltarg"        "vo_banks_coupltarg"
	
	
	
	// CHARACTER: BELICA
	// CONTEXT:Informative
	// DIALOG : Here sir, your guns, I also was able to modify your Cold Fire cannon with an extended clip!  Good luck!
	"lipsync_belica_sirgun"        "vo_belica_sirgun"
	
	
	// CHARACTER: BELICA
	// CONTEXT:Death Scream
	// DIALOG : Arrrghhh!
	"lipsync_belica_die"        "vo_belica_die"
	
	
	
	// CHARACTER: BENNETTE +USE
	// CONTEXT:Dismissive
	// DIALOG : Sergeant?
	"lipsync_benn_serg"        "vo_benn_serg"
	
	
	// CHARACTER: BENNETTE +USE
	// CONTEXT:Dismissive
	// DIALOG : Yes sir?
	"lipsync_benn_yess"        "vo_benn_yess"
	
	
	// CHARACTER: BENNETTE +USE
	// CONTEXT:Dismissive
	// DIALOG : Do you need something sir?
	"lipsync_benn_youneed"        "vo_benn_youneed"

	
	
	// CHARACTER: BERGER +USE
	// CONTEXT:Informative
	// DIALOG : I'm sure you've already heard, but without the data your team collected, there would be no Nexus assault
	"lipsync_bergr_datateam"        "vo_bergr_datateam"
	
	
	// CHARACTER: BERGER +USE
	// CONTEXT:Informative
	// DIALOG : It's too much data for us to process by hand, so we have search algorythims looking for key tactical information
	"lipsync_bergr_prochand"        "vo_bergr_prochand"
	
	
	// CHARACTER: BERGER +USE
	// CONTEXT:Informative
	// DIALOG : We will be strudying this find for years to come, even after the war is over.
	"lipsync_bergr_study"        "vo_bergr_study"

	
	
	// CHARACTER: DARNELL
	// CONTEXT:Yelling
	// DIALOG : Dekard, over here, this defense turret is ready for you!
	"lipsync_darn_overdef"        "vo_darn_overdef"
	
	
	// CHARACTER: DARNELL
	// CONTEXT:Relieved
	// DIALOG : Holy shit, Dekard, I almost wasted you.  Let's get to the speeder hanger!
	"lipsync_darn_wasted"        "vo_darn_wasted"
	
	
	// CHARACTER: DARNELL +USE
	// CONTEXT:Hurried
	// DIALOG : No time to chat now!
	"lipsync_darn_notime"        "vo_darn_notime"
	
	
	// CHARACTER: DARNELL +USE
	// CONTEXT:Hurried
	// DIALOG : Let's get moving!
	"lipsync_darn_getmv"        "vo_darn_getmv"
	
	
	// CHARACTER: DARNELL +USE
	// CONTEXT:Hurried
	// DIALOG : Come on!
	"lipsync_darn_comeon5"        "vo_darn_comeon5"

	
		
	// CHARACTER: DR COREMAN
	// CONTEXT:Informative
	// DIALOG : It would seem the Strogg have perfected their process.
	"lipsync_core_strggperf"        "vo_core_strggperf"
	
	
	// CHARACTER: DR COREMAN
	// CONTEXT:Informative
	// DIALOG : Agreed, I would expect that early Stroggification proved quite unsuccessful.
	"lipsync_core_earlystrgg"        "vo_core_earlystrgg"
	
	
	// CHARACTER: DR COREMAN
	// CONTEXT:Questioning
	// DIALOG : I wonder if they will let us look into that by studying Corporal Kain?
	"lipsync_core_wonderwill"        "vo_core_wonderwill"
	

	
	// CHARACTER: DR LUDWIG
	// CONTEXT:Amazed
	// DIALOG : It's really quite amazing that anbody survives the Stroggification procedure
	"lipsync_luwg_quiteamaz"        "vo_luwg_quiteamaz"
	
	
	// CHARACTER: DR LUDWIG
	// CONTEXT:Informative
	// DIALOG : Most likely through rigirious testing on live subjects
	"lipsync_luwg_rigtest"        "vo_luwg_rigtest"
	
	
	// CHARACTER: DR LUDWIG
	// CONTEXT:Amazed
	// DIALOG : How they overcame the body rejecting all the foreign hardware is baffling 
	"lipsync_luwg_howover"        "vo_luwg_howover"

	
		
	// CHARACTER: GRAVES +USE
	// CONTEXT:Informative
	// DIALOG : Rhino squad's next up for this briefing room.
	"lipsync_graves_rhinsq"        "vo_graves_rhinsq"
	
	
	// CHARACTER: GRAVES +USE
	// CONTEXT:Dismissive
	// DIALOG : Do you need anything else sir?
	"lipsync_graves_doyouneed"        "vo_graves_doyouneed"
	
	
	// CHARACTER: GRAVES +USE
	// CONTEXT:Dismissive
	// DIALOG : Can I help you?
	"lipsync_graves_canihelp"        "vo_graves_canihelp"
	
	
	
	// CHARACTER: HARPER/DAVENPORT
	// CONTEXT:Military
	// DIALOG : Falcon squad, I'm here to compliment you on your efforts today, your team has pulled off the impossible by getting Strauss back in one piece, and the Strogg data you collected has become essential to the entire war effort, Strauss...
	"lipsync_harp_falcsqcom"        "vo_harp_falcsqcom"
	
	
	// CHARACTER: HARPER/DAVENPORT
	// CONTEXT:Military
	// DIALOG : Within the hour, we will be launching a major strike against the source of the Strogg communication network, the Core.
	"lipsync_harp_withinhr"        "vo_harp_withinhr"
	
	
	// CHARACTER: HARPER/DAVENPORT
	// CONTEXT:Military
	// DIALOG : Another Rhino squad member, Corporal Kain was pulled from the medlabs just before he was fully converted into a Strogg soldier.  
	"lipsync_harp_anothrhin"        "vo_harp_anothrhin"
	
	
	// CHARACTER: HARPER/DAVENPORT
	// CONTEXT:Informative
	// DIALOG : According to the data you collected, Kain's newly acquired Strogg physiology will allow us to get inside the Core to destroy the Nexus, and possibly the Makron.  Lieutenant...
	"lipsync_harp_accorddata"        "vo_harp_accorddata"
	
	
	
	// CHARACTER: HOLDORF +USE
	// CONTEXT:Inquisitive
	// DIALOG : I wonder what kind of hardware Corporal Kain's got in his head right now.
	"lipsync_holdorf_iwondkain"        "vo_holdorf_iwondkain"
	
	
	// CHARACTER: HOLDORF +USE
	// CONTEXT:Inquisitive
	// DIALOG : I really wonder how many instructions per second he can perform.
	"lipsync_holdorf_iwondinst"        "vo_holdorf_iwondinst"
	
	
	// CHARACTER: HOLDORF +USE
	// CONTEXT:Inquisitive
	// DIALOG : You think the Strogg are using nanotechnology to enhance the celluar membranes?
	"lipsync_holdorf_youthinkstrgg"        "vo_holdorf_youthinkstrgg"
	
	// CHARACTER: HOLDORF
	// CONTEXT:Calm
	// DIALOG : Don't worry, I told Trabbold he would be coming from Rhino Quarters.
	"lipsync_hold_conv4"        "vo_hold_conv4"
	
	// CHARACTER: HOLDORF
	// CONTEXT:Calm
	// DIALOG : Yeah, he'll come right past here before the Rhino brief.
	"lipsync_hold_conv2"        "vo_hold_conv2"
	
		
	// CHARACTER: HUGHES
	// CONTEXT:Informative
	// DIALOG : It's possible, we don't have any recon data for that area at all
	"lipsync_hughes_isposs"        "vo_hughes_isposs"
	
	
	// CHARACTER: HUGHES +USE
	// CONTEXT:Calm
	// DIALOG : I'm sorry Sargeant, not right now.
	"lipsync_hughes_imsorrtn"        "vo_hughes_imsorrtn"
	
	
	// CHARACTER: HUGHES +USE
	// CONTEXT:Annoyed
	// DIALOG : Maybe we can chat another time.
	"lipsync_hughes_maybewec"        "vo_hughes_maybewec"
	
	
	// CHARACTER: HUGHES +USE
	// CONTEXT:Annoyed
	// DIALOG : I'm not going to say it again.
	"lipsync_hughes_notsay"        "vo_hughes_notsay"

	
		
	// CHARACTER: INGLIS (RESPONSE)
	// CONTEXT:Apologetic
	// DIALOG : Really?  Oh shit..
	"lipsync_inglis_reallysht"        "vo_inglis_reallysht"
	
	
	// CHARACTER: INGLIS (RESPONSE)
	// CONTEXT:Questioning
	// DIALOG : Who's Falcon squad again?
	"lipsync_inglis_whofalc"        "vo_inglis_whofalc"
	
	
	// CHARACTER: INGLIS +USE
	// CONTEXT:Arrogant
	// DIALOG : Hey, why aren't you part of the Nexus assault like the rest of us?
	"lipsync_inglis_heywhy"        "vo_inglis_heywhy"

	
			
	// CHARACTER: LUCH +USE
	// CONTEXT:Informative
	// DIALOG : You hear about Corporal Kain?  He's been (beat) Stroggified
	"lipsync_luch_youhrkain"        "vo_luch_youhrkain"
	
	
	// CHARACTER: LUCH +USE
	// CONTEXT:Distant
	// DIALOG : I can't even imagine what that's like
	"lipsync_luch_canteven"        "vo_luch_canteven"
	
	
	// CHARACTER: LUCH +USE
	// CONTEXT:Inquisitive
	// DIALOG : I wonder if they rerouted the neural pathways to account for the icreased neural activity?
