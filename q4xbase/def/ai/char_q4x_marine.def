/*
===============================================================================

	Marine Model Definition

===============================================================================
*/

model model_char_q4x_marine
{
	mesh										models/characters/marine/newmarine_mesh2.md5mesh

	channel torso	( *waist )
	channel legs	( *origin *hips -*waist )

	// ------------------------------------------------------------------------------------------
	//
	//									Idle Animations
	//
	// ------------------------------------------------------------------------------------------

	anim idle									models/characters/marine/idle.md5anim
	anim cover_idle								models/characters/marine/idle.md5anim
	anim af_pose								models/characters/marine/af_pose.md5anim	

	anim talk_idle								models/characters/marine/relax_idle.md5anim
		
	anim relax_idle_start						models/characters/marine/relax_idle_start.md5anim
	anim relax_idle								models/characters/marine/relax_idle.md5anim
	anim relax_idle_end							models/characters/marine/relax_idle_end.md5anim
	{
		rate	1.5
	}

	anim pain_fire								models/characters/marine/pain_fire.md5anim
	{
		rate 0.8
		frame 1									speak_random	lipsync_pain
	}



	// ------------------------------------------------------------------------------------------
	//
	//									Movement Animations
	//
	// ------------------------------------------------------------------------------------------

//	anim sprint_backwards						models/characters/marine/sprint_backwards.md5anim
//	{
//	}

	anim run									models/characters/marine/run_forward.md5anim
	{
		sync_cycle
		frame	4,11							sound		snd_gear
		frame	1,9								footstep
	}
	
	anim nearcover_run							models/characters/marine/nearcover_run.md5anim
	{
		sync_cycle
		frame	4,11							sound		snd_gear
		frame	1,9								footstep
	}
		
	anim run_backwards							models/characters/marine/run_backwards.md5anim
	{
		sync_cycle
		frame	7,14,23,29						footstep
		frame	3,10,16,24						sound	snd_gear
	}
	anim nearcover_run_backwards			models/characters/marine/nearcover_run_backwards.md5anim
	{
		sync_cycle
		frame	5,13							footstep
		frame	3,10							sound	snd_gear
	}
	anim run_right								models/characters/marine/walk_strafe_fast_right.md5anim
	{
		sync_cycle
		frame	5,14							footstep
		frame	8,16							sound	snd_gear
	}
	anim nearcover_run_right								models/characters/marine/nearcover_run_right.md5anim
	{
		sync_cycle
		frame	5,14							footstep
		frame	8,16							sound	snd_gear
	}
	anim run_left								models/characters/marine/walk_strafe_fast_left.md5anim
	{
		sync_cycle
		frame	6,13							footstep
		frame	3,10							sound	snd_gear
	}
	anim nearcover_run_left								models/characters/marine/nearcover_run_left.md5anim
	{
		sync_cycle
		frame	6,13							footstep
		frame	3,10							sound	snd_gear
	}

	anim walk									models/characters/marine/walk_gun_aimed.md5anim // walk_gun_relax.md5anim
	{
		sync_cycle
		frame	5,20							footstep
	}
	
	anim nearcover_walk							models/characters/marine/walk_gun_up.md5anim // walk_gun_relax.md5anim
	{
		sync_cycle
		frame	5,20							footstep
	}
		
	anim walk_alert								models/characters/marine/walk_gun_alert.md5anim
	{
		sync_cycle
