export char_marine_landing
{
	options -game /q4xbase -scale .3937 -prefix PLAYER_ -align ALL   -keep HB_base HB_front_rotate HB_battery HB_muzzle_flash MG_stock_joint MG_clip_joint MG_muzzle_flash SG_stock SG_clip SG_muzzle_flash SG_pump_joint l_elbo_tweak r_elbo_tweak body shoulders neckcontrol legs_channel head_channel SG_muzzle_flash MG_muzzle_flash HB_muzzle_flash -parent MG_stock_joint r_wrist -parent HB_base r_wrist -parent hips body -parent waist SPINNER -parent SPINNER body  -sourcedir cinematics/air_assault/landing/marine_01/animations -destdir models/characters/marine 

