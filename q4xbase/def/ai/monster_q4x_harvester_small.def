/*
===============================================================================
	Harvester
===============================================================================
*/
export monster_harvester
 {
	options -prefix HARV_ -scale 0.75 -align ALL -sourcedir work/models/monsters/Harvester/animations -destdir models/monsters/q4x_harvester_small
	addoptions -keep lft_muzzle_flash
	addoptions -keep rt_muzzle_flash 
	addoptions -keep l_hopper_muzzle_flash
	addoptions -keep r_hopper_muzzle_flash 
	addoptions -keep l_toe_front
	addoptions -keep r_toe_front
	addoptions -keep l_toe_back
	addoptions -keep r_toe_back
	addoptions -keep l_side_can_tip
	addoptions -keep back_can_tip
	

	mesh	HARV_mesh.ma 	 					-dest mesh
	anim	HARV_idle.ma				-range 1 100	-dest idle
	anim	HARV_walk_cycle_C.ma			-range 1 57	-dest walk_01

	anim	HARV_whip_attack_all.ma				-dest whip_attack_all
	anim	HARV_whip_attack_front_whip.ma		-dest whip_attack_front
	anim	HARV_whip_attack_left_whip.ma		-dest whip_attack_left
	anim	HARV_whip_attack_right_whip.ma		-dest whip_attack_right

	anim	HARV_turn_90_lt.ma			-range 1 28  -dest turn_90_lt
	anim	HARV_turn_90_rt.ma			-range 1 28  -dest turn_90_rt
	anim	HARV_fire_forward.ma			-range 2 9  -dest fire_forward
	anim	HARV_fire_forward_left.ma		-range 2 9  -dest fire_forward_left
	anim	HARV_fire_forward_right.ma		-range 2 9  -dest fire_forward_right
	anim	HARV_fire_spray.ma			-range 1 14  -dest fire_spray_start
	anim	HARV_fire_spray.ma			-range 14 94  -dest fire_spray_loop
	anim	HARV_fire_spray.ma			-range 94 108  -dest fire_spray_end
	anim	HARV_attack_rleg_fw.ma			-range 1 38  -dest attack_rleg_fw
	anim	HARV_attack_rleg_fw_rt.ma		-range 1 38  -dest attack_rleg_fw_rt
	anim	HARV_attack_lleg_fw.ma			-range 1 38  -dest attack_lleg_fw
	anim	HARV_attack_lleg_fw_lt.ma		-range 1 38  -dest attack_lleg_fw_lt
	anim	HARV_pain_light.ma			-range 2 12  -dest pain_light
	anim	HARV_pain_light2.ma			-range 2 12  -dest pain_light2
	anim	HARV_death.ma				-range 1 60  -dest death
	anim	HARV_death2.ma				-range 1 130  -dest death2
	anim	HARV_death.ma				-range 36 60 -dest dmg_death
	anim	HARV_missile_fire.ma			-range 1 18  -dest missile_fire_start
	anim	HARV_missile_fire.ma			-range 18 60  -dest missile_fire
	anim 	HARV_leg_pains.ma			-range 1 12 -dest leg_pain_fr
	anim 	HARV_leg_pains.ma			-range 12 24 -dest leg_pain_fl
	anim 	HARV_leg_pains.ma			-range 24 36 -dest leg_pain_br
	anim 	HARV_leg_pains.ma			-range 36 48 -dest leg_pain_bl
	anim 	HARV_attack_rleg_fw_stab.ma		-range 1 42 -dest attack_rleg_fw_stab
	anim 	HARV_attack_lleg_fw_stab.ma		-range 1 42 -dest attack_lleg_fw_stab
	
	anim	HARV_dmg_frt_walk.ma			-range 1 57	-dest dmg_frt_walk
	anim	HARV_dmg_frt_idle.ma			-range 1 100  -dest dmg_frt_idle
	anim	HARV_dmg_frt_pain.ma			-range 1 36  -dest dmg_frt_pain
	anim	HARV_dmg_frt_turn90_lt.ma		-range 1 28  -dest dmg_frt_turn_90_lt
	anim	HARV_dmg_frt_turn90_rt.ma		-range 1 28  -dest dmg_frt_turn_90_rt
	anim	HARV_dmg_frt_fire_forward.ma		-range 2 9  -dest dmg_frt_fire_forward
	anim	HARV_dmg_frt_fire_right.ma		-range 2 9  -dest dmg_frt_fire_right
	anim	HARV_dmg_frt_fire_left.ma		-range 2 9  -dest dmg_frt_fire_left
	anim	HARV_dmg_frt_pain_light.ma		-range 2 12  -dest dmg_frt_pain_light
	
	anim	HARV_dmg_flt_walk.ma			-range 1 57	-dest dmg_flt_walk
	anim	HARV_dmg_flt_idle.ma			-range 1 100  -dest dmg_flt_idle
	anim	HARV_dmg_flt_pain.ma			-range 1 36  -dest dmg_flt_pain
	anim	HARV_dmg_flt_fire_forward.ma		-range 2 9  -dest dmg_flt_fire_forward
	anim	HARV_dmg_flt_fire_right.ma		-range 2 9  -dest dmg_flt_fire_right
	anim	HARV_dmg_flt_fire_left.ma		-range 2 9  -dest dmg_flt_fire_left
	anim	HARV_dmg_flt_pain_light.ma		-range 2 12  -dest dmg_flt_pain_light
	anim	HARV_dmg_flt_turn90_lt.ma		-range 1 28  -dest dmg_flt_turn_90_lt
	anim	HARV_dmg_flt_turn90_rt.ma		-range 1 28  -dest dmg_flt_turn_90_rt
	
	anim	HARV_dmg_brt_walk.ma			-range 1 57	-dest dmg_brt_walk
	anim	HARV_dmg_brt_idle.ma			-range 1 100  -dest dmg_brt_idle
	anim	HARV_dmg_brt_pain.ma			-range 1 36  -dest dmg_brt_pain
	anim	HARV_dmg_brt_fire_forward.ma		-range 2 9  -dest dmg_brt_fire_forward
	anim	HARV_dmg_brt_fire_left.ma		-range 2 9  -dest dmg_brt_fire_left
	anim	HARV_dmg_brt_fire_right.ma		-range 2 9  -dest dmg_brt_fire_right
	anim	HARV_dmg_brt_pain_light.ma		-range 2 12  -dest dmg_brt_pain_light
	anim	HARV_dmg_brt_turn90_lt.ma		-range 1 28  -dest dmg_brt_turn_90_lt
	anim	HARV_dmg_brt_turn90_rt.ma		-range 1 28  -dest dmg_brt_turn_90_rt
	
	anim	HARV_dmg_blt_walk.ma			-range 1 57	-dest dmg_blt_walk
	anim	HARV_dmg_blt_idle.ma			-range 1 100  -dest dmg_blt_idle
	anim	HARV_dmg_blt_pain.ma			-range 1 36  -dest dmg_blt_pain
	anim	HARV_dmg_blt_fire_forward.ma		-range 2 9  -dest dmg_blt_fire_forward
	anim	HARV_dmg_blt_fire_left.ma		-range 2 9  -dest dmg_blt_fire_left
	anim	HARV_dmg_blt_fire_right.ma		-range 2 9  -dest dmg_blt_fire_right
	anim	HARV_dmg_blt_pain_light.ma		-range 2 12  -dest dmg_blt_pain_light
	anim	HARV_dmg_blt_turn90_lt.ma		-range 1 28  -dest dmg_blt_turn_90_lt
	anim	HARV_dmg_blt_turn90_rt.ma		-range 1 28  -dest dmg_blt_turn_90_rt
	
	
}

