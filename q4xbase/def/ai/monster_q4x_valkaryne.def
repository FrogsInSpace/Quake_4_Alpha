/*
===============================================================================

	Q4X valkaryne

===============================================================================
*/

export valkaryne
{
	options -game q4xbase/ -prefix VALK_ -align ALL -parent body origin -scale .3 -keep r_melee_tip l_melee_tip r_ranged_barrell_top l_ranged_barrell_top l_ranged_barrell_middle l_ranged_barrell_bottom r_ranged_barrell_middle r_ranged_barrell_bottom -sourcedir models/monsters/valkaryne/animations -destdir models/monsters/valkaryne

	mesh	idle.ma 							-dest valkaryne

	anim	plugin.ma 							-dest idle_plugin
	anim	idle.ma 					-range 1 31	-dest idle
	anim	idle.ma 					-range 32 161	-dest idle_ambient
	anim	idle.ma								-dest af_pose
		
	anim	run.ma 								-dest run
	anim	evade_left.ma							-dest evade_left
	anim	evade_right.ma							-dest evade_right
	anim	run_left.ma							-dest run_left
	anim	run_right.ma							-dest run_right
	anim	turn_left.ma						 	-dest turn_left
	anim	turn_right.ma							-dest turn_right
	anim	run_backward.ma							-dest run_backward
	
	anim	ranged01.ma 				 			-dest ranged01
	anim	ranged02.ma							-dest ranged02
	anim	ranged03.ma							-dest ranged03
	anim	ranged_wave_attack.ma						-dest ranged_wave_attack
	anim	plugin_wave_attack.ma						-dest plugin_wave_attack
	
	anim	run_to_plugin.ma 				 		-dest run_to_plugin	
	anim	plugin_ranged01.ma 				 		-dest plugin_ranged01
	anim	plugin_ranged02.ma						-dest plugin_ranged02
	anim	plugin_ranged03.ma						-dest plugin_ranged03
	anim	plugin_to_idle.ma 				 		-dest plugin_to_idle
		
	anim	leanleft.ma							-dest leanleft
	anim	leanright.ma							-dest leanright
	anim	melee01.ma 							-dest melee01
	anim	melee02.ma 							-dest melee02
	anim	melee03.ma 							-dest melee03
	
	anim	pain01.ma 							-dest pain01
	anim	pain02.ma 							-dest pain02
	anim	pain03.ma 							-dest pain03
	anim    pain04.ma 							-dest pain04
	anim    pain05.ma 							-dest pain05
	anim	pain06.ma							-dest pain06
	
	
	anim	plugin_pain01.ma 						-dest plugin_pain01
	anim	plugin_pain02.ma 						-dest plugin_pain02

	anim	va_najavas_dies.ma 						-dest va_najavas_dies
	anim	cr_idle.ma 							-dest cr_idle
	anim	cr_idle_upside_down.ma 						-dest cr_idle_upside_down
	anim	cr_idle_land_attack.ma 			-range 0 193		-dest cr_idle_land_attack
	anim	cr_idle_land_attack.ma 			-range 194 260		-dest cr_ceiling_idle
	anim	cr_kill_tak.ma 							-dest cr_kill_tak





}

/*
===============================================================================

	valkaryne Model

===============================================================================
*/

model model_monster_q4x_valkaryne
{	
	mesh										models/monsters/valkaryne/valkaryne.md5mesh	
	
	channel torso									( *body -*waist)
	channel legs									( *waist origin )
	
	anim af_pose									models/monsters/valkaryne/af_pose.md5anim
	
	anim idle									models/monsters/valkaryne/idle.md5anim 
	{	
	frame 1 											sound_body		snd_idle
	}	

	anim walk									models/monsters/valkaryne/run.md5anim 
	{
	rate 1.5
	frame 22, 29, 50, 57 								footstep
	frame 22, 29, 50, 57 								sound		snd_step
	frame 1 											sound_body		snd_walk
	
	}

	anim walk_backwards								models/monsters/valkaryne/run_backward.md5anim
	{
	rate 2.0
	frame 24, 30, 50, 52								footstep
	frame 24, 30, 50, 52								sound		snd_step
	frame 1 											sound_body		snd_walk_backwards
	}
	
	anim walk_right									models/monsters/valkaryne/run_right.md5anim
	{
	rate 1.5
	frame 23, 34, 40, 48								footstep
	frame 23, 34, 40, 48								sound		snd_step
	frame 1 											sound_body		snd_walk_side	
	}
	
	anim walk_left									models/monsters/valkaryne/run_left.md5anim
	{
	rate 1.5
	frame 23, 39, 46, 57 								footstep
	frame 23, 39, 46, 57 								sound		snd_step
	frame 1 											sound_body		snd_walk_side	
	}

	anim turn_right_90								models/monsters/valkaryne/turn_right.md5anim, models/monsters/valkaryne/turn_right.md5anim
	{
	rate 2.5
	anim_turn
	frame 22, 29, 50, 57 								footstep
	frame 22, 29, 50, 57 								sound		snd_step
	frame 1 											sound_body		snd_turn	
	}
	
	anim turn_left_90								models/monsters/valkaryne/turn_left.md5anim, models/monsters/valkaryne/turn_left.md5anim
	{
	rate 2.5
	anim_turn
	frame 22, 23, 46, 53  								footstep
	frame 22, 23, 46, 53  								sound		snd_step
	frame 1 											sound_body		snd_turn
	}
	
