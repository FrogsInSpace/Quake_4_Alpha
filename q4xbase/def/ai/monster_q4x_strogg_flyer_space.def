/*
===============================================================================

	QFX Strogg Flyer Space

===============================================================================
*/

export strogg_flyer
{
	options -game q4xbase/ -prefix FLY_ -rotate -90 -scale .5906 -keep tail_thrusters -keep left_gun -keep right_gun -keep l_fx -keep r_fx -sourcedir models/vehicles/strogg_flyer/animations/ -destdir models/vehicles/q4x_strogg_flyer/
	mesh	lift_off_a_work_refix.ma	-dest	mesh.md5mesh
	anim	lift_off_a_work_refix.ma	-dest liftoff_a.md5anim
	anim	idle_a.ma		-dest idle_a.md5anim
	anim	crash_a.ma		-dest crash_a.md5anim
	anim	crash_b.ma		-dest crash_b.md5anim
	anim	crash_c_work_refix.ma	-dest crash_c.md5anim
	anim	Air_defense_strafe_2.ma	-dest Air_defense_strafe.md5anim
	anim	med_labs_flyby.ma	-dest med_labs_flyby.md5anim
}

export strogg_flyer
{
	options -game q4xbase/ -prefix FLY_ -rotate -90 -scale 1.2 -keep tail_thrusters -keep left_gun -keep right_gun -keep l_fx -keep r_fx -sourcedir models/vehicles/strogg_flyer/animations/ -destdir models/monsters/q4x_strogg_flyer/
	mesh	lift_off_a_work_refix.ma	-dest	mesh.md5mesh
	anim	idle_a.ma	-dest	idle_a.md5anim
	
}

/*
===============================================================================

	Strogg Flyer Model

===============================================================================
*/

model model_monster_q4x_strogg_flyer_space
{
	mesh										models/monsters/q4x_strogg_flyer/mesh.md5mesh	
	anim idle									models/monsters/q4x_strogg_flyer/idle_a.md5anim
	anim pain									models/monsters/q4x_strogg_flyer/idle_a.md5anim
	{
		frame 1									fx	fx_damaged	tail_thrusters
	}
	anim range_attack								models/monsters/q4x_strogg_flyer/idle_a.md5anim
}

/*
===============================================================================

	Strogg Flyer Attacks

===============================================================================
*/

entityDef damage_strogg_flyer_space_blaster
{
	"inherit"									"damage_bullet_base"
	"damage"									"25"
}

entityDef projectile_strogg_flyer_space_blaster
{
	"inherit"									"projectile_blaster_base"
	"velocity"									"10000 0 0"
	"fx_impact"									"effects/monsters/strogg_flyer/q4x_blaster_collide.fx"
	"fx_fly"									"effects/monsters/flyer_space/rocket_fly.fx"
	"def_damage"									"damage_strogg_flyer_space_blaster"
}

/*
===============================================================================

	Strogg Flyer Entity Definition

===============================================================================
*/

entityDef monster_q4x_strogg_flyer_space
{
	"inherit"									"actor_default"
	"spawnclass"									"rvMonsterStroggFlyer"
	
	"targetAsEnemy"									"1"

	// --------------------------------- Actions ------------------------------------
	"action_blasterAttack"								"1"
	"action_blasterAttack_rate"							"4"
	"action_blasterAttack_maxRange"							"12000"
	"action_blasterAttack_minRange2d"						"0"
	"action_blasterAttack_maxRange2d"						"12000"
	"action_blasterAttack_noturn"							"0"
	"action_blasterAttack_overrideLegs"						"0"

	// --------------------------------- General ------------------------------------
	"size"										"240 240 128"
	"model"										"model_monster_q4x_strogg_flyer_space"
	"mass"										"100000"
	"use_aas"									"aas250"	//This seems to not complain, although no aas file is created.

	"static" "1"

	"joint_gun_right"								"right_gun"
	"joint_gun_left"								"left_gun"
	"joint_thruster"								"tail_thrusters"
	
	"blasterAttackDuration"								"2"
	"blasterAttackRate"								".15"

	"remove_on_death"								"1"
	"canturn"									"0"
	"noFaceEnemy"									"1"

	// --------------------------------- Combat ----------------------------------
	"health"									"325"	//325
	"missile_suppress_range"							"0"
	"fov"										"90"
	"attack_cone"									"90"
	"turn_rate"									"180"
	"painThreshold"									"10"
	"bleed"										"0"
	"startdamaged"									"0"
	"flee_not_die"									"0"
	"reload_count"									"18"
	"reload_delay"									"0.05"
	"suppress_rate"									"0"
	"attackRange"									"2000 12000"
	
	"iff"										"1"

	"def_attack_blaster"								"projectile_strogg_flyer_space_blaster"
	"attack_blaster_accuracy"							"1"

	//added straight up attack for strafing anim
	"def_attack_fromJoint"								"projectile_strogg_flyer_space_blaster"
	"attack_fromJoint_lockToJoint"							"1"
	
	"useMasterPitch"						"1"
	"useMasterRoll"							"1"


	// --------------------------------- Effects ---------------------------------
	"fx_muzzleflash"								"effects/monsters/flyer_space/q4x_blaster_burst.fx"
	"fx_exhaust"									"effects/monsters/strogg_flyer/smoke_trail2.fx"
	"fx_base_attack_flash"								"effects/monsters/turret/f_flash.fx"						// FX_REPLACE
	"fx_damage_transition"								"effects/monsters/flyer_space/q4x_explode.fx"					// FX_REPLACE
	"fx_death"									"effects/monsters/flyer_space/q4x_explode.fx"						// FX_REPLACE
	"fx_damaged"									"effects/monsters/strogg_flyer/q4x_smoke_trail_damaged.fx"

	// --------------------------------- Sounds ----------------------------------
	"snd_flyloop"									"q4x_strogg_flyer_loop"

	// --------------------------------- Playbacks -------------------------------
	"playcount_pain"								"4"
	"playback_pain_1"								"playbacks/effects/painshake_1.playback"
	"playback_pain_2"								"playbacks/effects/painshake_2.playback"
	"playback_pain_3"								"playbacks/effects/painshake_3.playback"
	"playback_pain_4"								"playbacks/effects/painshake_4.playback"
	
	// --------------------------------- DB Info   -------------------------------
	"dbTitle"									"QFX Strogg Flyer (Space)"
	"dbText"									"This is the expansion pack version of the flyer"
}
