	"action_meleeAttack_maxRange"			"250"
	"action_meleeAttack_chance"				"1"
	//"action_meleeAttack_rate"				"0.1"
	"action_meleeAttack_rate"				"1"
	"action_meleeAttack_failrate"			"0"
	
