/*
===============================================================================

	pain_lord Entity Definition

===============================================================================
*/

entityDef monster_q4x_pain_lord
{
	"inherit"								"actor_default"
	"spawnclass"							"riMonsterPainLord"
	
	"editor_usage"							"In the script call .requestProcessing() when the Pain Lord is to move to the processing station and .atProcessingStation() when the pain lord has reached the processing station."
	
	"editor_var MoveToProcessingStationFunc"	"Script executed when .requestProcessing() is unblocked."
	"editor_var EnragedFunc"					"Script executed when enraged."
	"editor_var ProcessingBrokenFunc"			"Script executed when pulled out of his .atProcessingStation() behavior."
	"editor_var ProcessingDoneFunc"				"Script executed when finished with his .atProcessingStation() behavior."
	"editor_var StunnedFunc"					"Script executed when put into the stunned state."	
	"editor_var UnstunnedFunc"					"Script executed when breaks out of his stunned state."

	// ------------------------------- Actions ------------------------------------
	//"actionTimer_rangedAttack_rate"		"3"				
	"actionTimer_meleeAttack_rate"			"2"

	"action_meleeAttack"					"1"
