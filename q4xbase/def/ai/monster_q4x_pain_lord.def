	"health"								"8000"
	"damageRegionHealth"					"1500"

	"size"									"94 94 96"
	"use_aas"								"aas96"
	//"chatter_idle_rate"					"8"
	//"chatter_combat_rate"					"8"	
	
	"joint_eyeOffset"						"head"
	"joint_chestOffset"						"spine2"
	
	"turn_rate"								"120"

