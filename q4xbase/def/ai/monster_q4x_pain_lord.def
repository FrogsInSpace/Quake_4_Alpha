	"action_evadeRight"						"0"
	"action_evadeRight_minrange"			"150"
	"action_evadeRight_anim"				"walk"
	
	"action_strafe"							"0"
	"action_strafe_anim"					"walk"
	"action_strafe_anim2"					"walk"
	"action_strafe_minRange"				"50"
	"action_strafe_maxRange"				"100"
