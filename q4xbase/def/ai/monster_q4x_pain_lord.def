/*
===============================================================================

	pain_lord

===============================================================================
*/

export pain_lord
{	
	options -game q4xbase/ -prefix PAIN_ -align ALL -scale .8 -parent root origin -keep root hook_attach -sourcedir /models/monsters/pain_lord/animations -destdir models/monsters/pain_lord
	
	mesh	idle.ma					-dest mesh
	anim	idle.ma					-dest idle
	anim	idle.ma					-dest af_pose
	anim	melee01.ma				-dest melee01	
	anim	melee02.ma				-dest melee02	
	//anim	melee03.ma				-dest melee03	
	//anim	ranged01.ma				-dest ranged01
	anim	turn_left.ma				-dest turn_left
	anim	turn_right.ma				-dest turn_right
	anim	walk.ma					-dest walk
	anim	walk_left.ma				-dest walk_left
	anim	walk_right.ma				-dest walk_right
	anim	walk_backwards.ma			-dest walk_backward
	anim	walk.ma					-dest walk
	//anim	evade_left.ma				-dest evade_left
	//anim	evade_right.ma				-dest evade_right
	//anim	evade_left_hop.ma			-dest evade_left_hop
	//anim	evade_right_hop.ma			-dest evade_right_hop
	anim	pain01.ma				-dest pain01
	anim	pain02.ma				-dest pain02
	//anim	onfire03.ma				-dest pain_fire
	anim 	stunned.ma		-range 0 43	-dest stunned_intro
	anim 	stunned.ma		-range 44 166	-dest stunned_loop
	anim 	stunned_end.ma		-range 167 220	-dest stunned_end
	anim 	stunned_pain.ma				-dest stunned_pain
	anim 	stunned_pain_left.ma			-dest stunned_pain_left
	anim 	stunned_pain_right.ma			-dest stunned_pain_right
	anim 	stunned_end_rage.ma	-range 167 270 	-dest stunned_end_rage
	anim 	death.ma		-range 0 99 	-dest death
	anim 	death.ma		-range 100 300 	-dest death_idle
	anim 	console_idle.ma			 	-dest console_idle
	
}

/*
===============================================================================

	pain_lord Model

===============================================================================
*/

model model_monster_q4x_pain_lord
{
	mesh									models/monsters/pain_lord/mesh.md5mesh
	
	channel torso								( *hips )
	channel legs								( *root origin -*hips )
	
	//channel torso								( *hips )
	//channel legs								( *root origin -*hips -*dl_base -*dr_base)
	//channel head								( *dl_base )
	//channel eyelids								( *dr_base )
	
	
	anim ik_pose								models/monsters/pain_lord/af_pose.md5anim
	anim af_pose								models/monsters/pain_lord/af_pose.md5anim

	// -------------------------------- Standard Anims ------------------------
	anim idle								models/monsters/pain_lord/idle.md5anim
	{
		//ai_no_turn
		frame 	1								sound		snd_idle	
	}
	
	anim walk								models/monsters/pain_lord/walk.md5anim	
	{
		sync_cycle
		frame 	1,21								sound		snd_walk
		frame 	20,53								sound		snd_step
	}
	
	anim walk_backwards							models/monsters/pain_lord/walk_backward.md5anim	
	{
		sync_cycle
		frame 	1,21								sound		snd_walk
		frame 	20,53								sound		snd_step		
	}
		
	anim run								models/monsters/pain_lord/walk.md5anim	
	{
		sync_cycle
		frame 	1								sound		snd_run	
		frame 	20,53								sound		snd_step
	}	
	
	anim run_backwards							models/monsters/pain_lord/walk_backward.md5anim	
	{
		sync_cycle
		frame 	1								sound		snd_run	
		frame 	20,53								sound		snd_step
	}
	
	anim evade_left								models/monsters/pain_lord/walk_left.md5anim	
	{
		sync_cycle
		frame 	1								sound		snd_evade
		frame 	17,38								sound		snd_step	
	}
	
	anim evade_right							models/monsters/pain_lord/walk_right.md5anim	
	{
		sync_cycle
		frame 	1								sound		snd_evade
		frame 	17,38								sound		snd_step	
	}
		
	anim walk_left								models/monsters/pain_lord/walk_left.md5anim	
	{
		sync_cycle
		frame 	1								sound		snd_walk
		frame 	17,38								sound		snd_step	
	}
	
	anim walk_right								models/monsters/pain_lord/walk_right.md5anim	
	{
		sync_cycle
		frame 	1								sound		snd_walk
		frame 	17,38								sound		snd_step	
	}

	anim run_left								models/monsters/pain_lord/walk_left.md5anim	
	{
		sync_cycle
		frame 	1								sound		snd_run	
		frame 	17,38								sound		snd_step
	}
	
	anim run_right								models/monsters/pain_lord/walk_right.md5anim	
	{
		sync_cycle
		frame 	1								sound		snd_run
		frame 	17,38								sound		snd_step	
	}

	anim turn_right_90							models/monsters/pain_lord/turn_left.md5anim, models/monsters/pain_lord/turn_left.md5anim
	{
		//anim_turn
		frame 	1								sound		snd_turn	
	}
	
	anim turn_left_90							models/monsters/pain_lord/turn_right.md5anim, models/monsters/pain_lord/turn_right.md5anim
	{
		//anim_turn
		frame 	1								sound		snd_turn	
	}
	
	anim pain1								models/monsters/pain_lord/pain01.md5anim
	{
		ai_no_turn
		frame 	1								sound_body		snd_pain	
	}
		
	anim pain2								models/monsters/pain_lord/pain02.md5anim
	{
		ai_no_turn
		frame 	1								sound_body		snd_pain	
	}

	anim stunned_intro							models/monsters/pain_lord/stunned_intro.md5anim
	{
		ai_no_turn
		ai_no_look
		frame 	1								sound_body		snd_pain	
	}

	anim stunned_loop							models/monsters/pain_lord/stunned_loop.md5anim
	{
		ai_no_turn
		ai_no_look
		frame 	1								sound_body		snd_pain	
	}

	anim stunned_end							models/monsters/pain_lord/stunned_end.md5anim
	{
		//ai_no_turn
		frame 	1								sound_body		snd_pain	
		/*
		frame 	22								ai_attack	ranged				blade
		frame 	1								sound_weapon		snd_buildup_ranged
		frame 	22								sound_weapon		snd_ranged
		frame 	10,13,19						sound		snd_step
		*/
	}
	
	anim stunned_end_rage							models/monsters/pain_lord/stunned_end_rage.md5anim
	{
		rate 0.6
		frame 	80								sound_body		snd_pain
		frame 	10,14,20,33,40							sound		snd_step
	}

	anim stunned_pain							models/monsters/pain_lord/stunned_pain.md5anim
	{
		ai_no_look
		ai_no_turn
		frame 	1								sound_body		snd_pain	
	}
	
	anim stunned_pain_left							models/monsters/pain_lord/stunned_pain_left.md5anim
	{
		ai_no_look
		ai_no_turn
		frame 	1								sound_body		snd_pain	
	}

	anim stunned_pain_right							models/monsters/pain_lord/stunned_pain_right.md5anim
	{
		ai_no_look
		ai_no_turn
		frame 	1								sound_body		snd_pain	
	}

	anim melee_attack1							models/monsters/pain_lord/melee01.md5anim
	{
		frame 12								fx			fx_swipe		r_wrist
		frame 16								ai_attack_melee		melee
		frame 	1								sound_weapon		snd_melee_one	
	}

	anim melee_attack2							models/monsters/pain_lord/melee02.md5anim
	{
		frame 12								fx			fx_swipe		l_wrist
		frame 16								ai_attack_melee		melee
		frame 	1								sound_weapon		snd_melee_two	
	}
	
	/*
	anim range_attack1							models/monsters/pain_lord/ranged01.md5anim
	{
		frame 	24								ai_attack	ranged				blade
		frame 	1								sound_weapon		snd_buildup_ranged
		frame 	24								sound_weapon		snd_ranged
	}
	*/

	anim death							models/monsters/pain_lord/death.md5anim
	{
		rate 0.6
		ai_no_look
		ai_no_turn
		frame 	1							sound_body		snd_pain	
		frame 	14,22							sound			snd_step
	}
	
	anim death_idle							models/monsters/pain_lord/death_idle.md5anim
	{
		ai_no_look
		ai_no_turn
	}

	anim console_idle							models/monsters/pain_lord/console_idle.md5anim
	{
	}
}


