	"ik_ankle2"								"lft_ankle"
	"ik_foot1"								"rt_mid_foot"
	"ik_foot2"								"lft_mid_foot"
*/

	// --------------------------------- Sounds ----------------------------------
	"lipsync_sight"							"retch_sight"
	"lipsync_rush"							"grunt_rush"
	
	"snd_rush"								"retch_rush"
	
	"lipsync_chatter_idle"					"retch_chatter_idle"
