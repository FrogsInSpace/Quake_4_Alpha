	"damage_scale legs"						".75"	

	// -------------------------------- Look Joints -----------------------------
	"look_joint waist"					"0.2 0.2 0"
	 // "look_joint spine"					"0.2 0.2 0"
	    //"look_joint chest"					"0.3 0.3 0"
		//  "look_joint muzzle_flash"			"0.4 0.4 0"
	      "look_joint neck"					"0 0.6 0"
	       "look_joint head"				"0 0.5 0"

	// --------------------------------- IK --------------------------------------
