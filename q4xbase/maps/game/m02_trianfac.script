void gruntBlasted()		
{
	$fx_death_gib.setWorldOrigin( $mon_grunt_wrestle.getJointPos( $mon_grunt_wrestle.getJointHandle( "chest")));
	$fx_death_gib.setAngles( $mon_grunt_wrestle.getAngles());
	sys.trigger( $fx_death_gib);

	//let's see what we can do. We want him to topple ass-over-teakettle, y positive
	$mon_grunt_wrestle.kill();
	sys.waitFrame();
	vector vHead = $mon_grunt_wrestle.getWorldOrigin();
	vHead_z += 48;

	$mon_grunt_wrestle.applyImpulse( $mon_grunt_wrestle, vHead, '0 20000 2000');	
	$mon_grunt_wrestle.applyImpulse( $mon_grunt_wrestle, $mon_grunt_wrestle.getWorldOrigin(), '-1000 30000 2000');
}










void ReleaseGruntWrestler()
{
	sys.trigger( $razor2 );
	sys.trigger( $razor3 );

	sys.trigger( $processor_subroom_2_lock );
	$processor_subroom_2_frame.setShaderParm( 7, 1 );

	sys.trigger( $processor_subroom_2_doora );

	aiSpeak( $razor1, "lipsync_razor1_getoff" );

	aiScriptedAnim( $mon_grunt_wrestle, "ad_jump", 1, 0 );
	aiScriptedAnimWait( $razor1, "ad_fights_grunt_1", 1, 0 );

	aiSpeak( $razor1, "lipsync_razor1_pain" );

	$razor1.setAnimRate( 1.2 );
	aiScriptedAnim( $razor1, "ad_fights_grunt_2", 1, 1 );
	$razor1.setAnimRate( 1 );

	aiSpeak( $razor2, "lipsync_razor2_ivegotem" );

	thread gruntBlasted();

	$razor1.setTalkState( TALK_OK ); // , "idle");
	sys.wait( 1.0 );

	aiSpeak( $razor2, "lipsync_razor2_pain" );

//	sys.trigger( $ai_tether_radius_razor1_1 );
	aiScriptedMoveWait( $razor1, $razor1_pos_8, 16, 0 );
}












