void BossKilled()
{
	thread LandDropShip();

	sys.trigger( $music_tank_defeated );

	sys.wait( 5.0 );

	sys.setCamera( $core_boss_cam_4 );
	sys.fadeIn( '0 0 0', 1 );

	$dekard.setOrigin( $dekard_ending_pos_1.getOrigin() );

	$darnell.setMoveSpeed( AIMOVESPEED_RUN );

//	thread OpenCoreBossDoor( 2 );
	thread OpenCoreBossDoor( 1 );

	aiScriptedMoveWait( $dekard, $dekard_ending_pos_2, 5, 0 );

	sys.setCamera( $core_boss_cam_5 );
	sys.fadeIn( '0 0 0', 1 );

	thread TakNavajasCarryingTrian();

	aiScriptedMove( $dekard, $dekard_ending_pos_3, 5, 0 );

	radioChatterPlayWait( $razor1_radiochatter_1, "vo_vansen_gunfalc1" );

	radioChatterPlayWait( $razor1_radiochatter_1, "vo_marks_rogfalc1" );

	sys.setCamera( $core_boss_cam_6 );
	sys.fadeIn( '0 0 0', 1 );

	aiScriptedMove( $darnell, $darnell_ending_pos_2, 5, 0 );

	aiScriptedMoveWait( $dekard, $dekard_ending_pos_4, 5, 0 );

	sys.fadeOut( '0 0 0', 3 );

	sys.wait( 5.0 );

	sys.trigger( $target_endlevel );
}





