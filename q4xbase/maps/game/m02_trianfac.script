	sys.trigger( $core_explosion_trigger_2 );
	sys.wait( 0.5 );
	sys.trigger( $core_explosion_trigger_3 );
	sys.wait( 3.0 );
	sys.trigger( $core_explosion_trigger_4 );
	sys.wait( 1.0 );

	sys.trigger( $music_core_explode );

	sys.trigger( $core_explosion_trigger_5 );
	sys.wait( 0.5 );
	sys.trigger( $core_explosion_trigger_6 );

	sys.wait( 2.0 );

	sys.trigger( $item_objective_4 );

