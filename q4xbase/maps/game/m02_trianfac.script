#include "scripts/doom_defs.script"


float room1_cleared_counter		= 0;
float uplink_room_cleared		= 0;
float processor_room_reached		= 0;
float player_beyond_momentary_doors	= 0;









void PlayerBeyondMomentaryDoors()
{
	sys.trigger( $momentary_door_a );

	sys.wait( 0.5 );

	sys.trigger( $momentary_door_lock );
	$momentary_door_frame.setShaderParm( 7, 0 );
}





void MomentaryDoorOpen()
{
	aiScriptedMoveWait( $tak, $tak_pos_51, 8, 0 );
	aiScriptedFaceWait( $tak, $momentart_doors_console, 0 );

	aiSpeakWait( $tak, "lipsync_tak_hmmnexacc" );

	aiScriptedAnimWait( $tak, "console_stand_start", 0, 0 );
	aiScriptedAnim( $tak, "console_stand_end", 0, 0 );

	sys.trigger( $momentary_door_lock );
	$momentary_door_frame.setShaderParm( 7, 1 );

	sys.wait( 0.5 );

	sys.trigger( $momentary_door_a );
}












void oldPlayerBeyondMomentaryDoors()
{
	player_beyond_momentary_doors = 1;
}



void oldMomentaryDoorOpen()
{
	aiScriptedMoveWait( $tak, $tak_pos_51, 8, 0 );
	aiScriptedFaceWait( $tak, $momentart_doors_console, 0 );

	while ( player_beyond_momentary_doors == 0 )
		{
		aiSpeakWait( $tak, "lipsync_tak_hmmnexacc" );

//		sys.wait( 3.0 );

		aiScriptedAnimWait( $tak, "console_stand_start", 0, 0 );
		aiScriptedAnim( $tak, "console_stand_end", 0, 0 );

		sys.trigger( $momentary_door_lock );
		$momentary_door_frame.setShaderParm( 7, 1 );

		sys.wait( 0.5 );

		sys.trigger( $momentary_door_a );

		sys.wait( 1.0 );

		sys.trigger( $momentary_door_a );

		sys.wait( 0.5 );

		sys.trigger( $momentary_door_lock );
		$momentary_door_frame.setShaderParm( 7, 0 );

		sys.wait( 5.0 );
		}
}










void Leaper1Start()
{
	$leaper_clip_1.becomeNonSolid();
	sys.wait( 0.5 );
	sys.trigger( $leaper_strogg_marine_1 );
	sys.wait( 1.0 );
	sys.trigger( $leaper_strogg_marine_2 );
	sys.wait( 2.0 );
	$leaper_clip_1.becomeSolid();
}





