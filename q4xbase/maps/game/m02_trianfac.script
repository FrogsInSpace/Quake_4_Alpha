	sys.wait( 1.0 );

	aiScriptedFaceWait( $tak, $player1, 1 );

//	sys.wait( 1.0 );

	aiScriptedAnim( $markswell, "idle_look_back_lt", 0, 0 );
//	aiScriptedAnim( $markswell, "reload", 0, 0 );
//	aiScriptedAnim( $markswell, "idle_stretching_3", 0, 0 );

	aiScriptedFace( $navajas, $player1, 1 );

