	aiScriptedMoveWait( $markswell, $markswell_pos_27, 32, 1 );
	aiScriptedMoveWait( $razor1, $razor1_pos_27, 32, 0 );
}











void ReleaseRepairBot( float bot_count )
{
	entity proc_bot;
	entity proc_bot_target;
	entity proc_bot_spot;

	proc_bot        = sys.getEntity( "proc_bot_" + bot_count );
	proc_bot_target = sys.getEntity( "proc_bot_target_" + bot_count );
	proc_bot_spot   = sys.getEntity( "proc_bot_spot_" + bot_count );

//	sys.println("proc_bot_spot_" + bot_count );

//	if ( bot_count == 2 )
//		{
//		sys.trigger( $proc_bot_sentry_1 );
//		aiScriptedMoveWait( $proc_bot_sentry_1, $proc_bot_sentry_1_pos_1, 32, 1 );
//		$proc_bot_sentry_1.becomeAggressive();
//		}
//	if ( bot_count == 4 )
//		{
//		sys.trigger( $proc_bot_sentry_2 );
//		aiScriptedMoveWait( $proc_bot_sentry_2, $proc_bot_sentry_2_pos_1, 32, 1 );
//		$proc_bot_sentry_2.becomeAggressive();
//		}
	
	aiScriptedMoveWait( proc_bot, proc_bot_spot, 8, 0 );
	aiScriptedFaceWait( proc_bot, proc_bot_target, 0 );
	$repbot_1.bind( proc_bot_spot );

	sys.wait( 1.0 );

	while ( isLivingEntity( proc_bot ) )
		{
		aiScriptedActionWait( proc_bot, proc_bot_target, 0 );
		sys.wait( 8.0 );
		}
}










void ProcRepairBot()
{
	float  i;

	for ( i = 1; i <= 6; i++ )
		{
		thread ReleaseRepairBot( i );
		sys.wait( 3.0 );
		}
}









void TeamToGeneratorRoom()
{
	aiScriptedMove( $markswell, $markswell_pos_28, 32, 1 );
	aiScriptedMove( $tak, $tak_pos_28, 32, 1 );
	aiScriptedMoveWait( $razor1, $razor1_pos_28, 32, 0 );

	aiScriptedMoveWait( $razor1, $razor1_pos_29, 32, 0 );

	sys.wait( 1.0 );

	aiScriptedMoveWait( $tak, $tak_pos_29, 32, 1 );

	sys.wait( 1.0 );

	aiScriptedMoveWait( $markswell, $markswell_pos_29, 32, 1 );

	aiScriptedFaceWait( $razor1, $gen_screen_1, 0 );

	aiSpeakWait( $razor1, "lipsync_razor1_genctrl" );
	aiSpeakWait( $razor1, "lipsync_razor1_okshutdwn" );

	thread ProcRepairBot();

	aiSpeak( $razor1, "lipsync_razor1_overload" );
	aiScriptedAnimWait( $razor1, "console_stand_start", 0, 0 );
	aiSpeak( $razor1, "lipsync_razor1_gen125" );
	aiScriptedAnimWait( $razor1, "console_stand_loop", 0, 0 );
	aiSpeak( $razor1, "lipsync_razor1_gen150" );
	aiScriptedAnimWait( $razor1, "console_stand_end", 0, 0 );

	aiScriptedAnim( $razor1, "point_left", 0, 0 );

	aiSpeakWait( $razor1, "lipsync_razor1_whathellrep" );
	sys.wait( 1.0 );
	aiSpeakWait( $razor1, "lipsync_razor1_damnpowdrp" );

	aiSpeakWait( $markswell, "lipsync_marks_shootrepbot" );

	aiScriptedMove( $markswell, $markswell_pos_28, 32, 1 );
	aiScriptedMoveWait( $tak, $tak_pos_28, 32, 1 );

	aiSpeakWait( $markswell, "lipsync_marks_tkoutrep" );

	sys.wait( 2.0 );

	aiSpeakWait( $razor1, "lipsync_razor1_gdpwrlv" );
	aiSpeakWait( $razor1, "lipsync_razor1_whathte" );
	aiSpeakWait( $razor1, "lipsync_razor1_pain2" );

	$gen_retch_holder_1.remove();
	sys.trigger( $gen_retch_1 );

	sys.wait( 1.0 );

	$razor1.kill();

	aiSpeakWait( $markswell, "lipsync_marks_takeout2" );
}






