void CoreCannonSite()
{
	aiSpeak( $razor1, "lipsync_razor1_whereteamamb" );
	aiScriptedAnimWait( $razor1, "idle_look_back_lt", 0, 0 );

	aiSpeak( $razor1, "lipsync_razor1_theretrianth" );
	aiScriptedAnimWait( $razor1, "point_down", 0, 0 );

	aiScriptedFaceWait( $tak, $weapon_spikegun_1, 0 );

	aiSpeakWait( $tak, "lipsync_tak_hmmletmesee" );

	aiSpeak( $tak, "lipsync_tak_herekedshoots" );

	aiScriptedAnimWait( $tak, "player_gift2_start", 0, 0 );
	aiScriptedAnimWait( $tak, "player_gift2_loop", 0, 0 );
	aiScriptedAnimWait( $tak, "player_gift2_end", 0, 0 );

	$weapon_spikegun_1.remove();
	sys.trigger( $target_give_3 );

	aiScriptedMove( $markswell, $markswell_pos_25, 32, 1 );
	aiScriptedMove( $razor1, $razor1_pos_25, 32, 0 );
	aiScriptedMoveWait( $tak, $tak_pos_25, 32, 0 );

	aiSpeakWait( $razor1, "lipsync_razor1_genjustup" );

	aiScriptedFaceWait( $tak, $tak_elevA_panel, 1 );
	aiScriptedAnimWait( $tak, "console_stand_start", 0, 0 );
	aiScriptedAnimWait( $tak, "console_stand_loop", 0, 0 );
	aiScriptedAnimWait( $tak, "console_stand_end", 0, 0 );

	// Open the gate
	setNewTimes( $elevGateA_1 , 1 , .5 , .2 );
	$elevGateA_1.rotateOnce( '-90 0 0' );
	sys.waitFor( $elevGateA_1 );

	thread ElevatorChatter();

	aiScriptedMoveWait( $markswell, $markswell_pos_26, 32, 0 );
	aiScriptedMoveWait( $razor1, $razor1_pos_26, 32, 0 );
	aiScriptedMoveWait( $tak, $tak_pos_26, 32, 0 );

	sys.trigger( $trigger_playerOnElevator );
}






