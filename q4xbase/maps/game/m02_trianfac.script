	sys.trigger( $mitchell );
	$tak.setOrigin( $tak_pos_44.getOrigin() );
	$darnell.setOrigin( $darnell_pos_44.getOrigin() );
	$mitchell.setOrigin( $mitchell_pos_44.getOrigin() );
	$markswell.setOrigin( $markswell_pos_31.getOrigin() );
//	$razor1.setOrigin( $razor1_pos_31.getOrigin() );
}



void PlaytestStartBeforeTank()
{
	sys.wait( 1.0 );
	$tak.setOrigin( $tak_pos_50.getOrigin() );
}










void main()
{
	thread InitCharacters();

	thread TakEntrance();
//	thread PlaytestStartAtProc();
//	thread PlaytestStartAtGen();
//	thread PlaytestStartAfterGen();
//	thread PlaytestStartAfterPanel();
//	thread PlaytestStartBeforeTank();

	playAnimWait( $uplink_power_pump, ANIMCHANNEL_ALL, "stop");
}

