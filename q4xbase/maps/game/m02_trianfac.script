void AmbientAABlastSound( float blast_no )
{
	entity blast_sound;
	float  random_wait;

	blast_sound = sys.getEntity( "AA_blastsound_" + blast_no );

	sys.wait( blast_no * 6 );
	sys.trigger( blast_sound );
	sys.trigger( $AA_blastsound_dust_relay );

	while ( 1 )
		{
		random_wait = sys.random( 30 ) + 10;
		sys.wait( random_wait );
		sys.trigger( $AA_blastsound_dust_relay );
		sys.wait( 1.0 );
//		sys.println("BlastSound = " + blast_no );
		sys.trigger( blast_sound );
		}
}





void AmbientAABlastSounds()
{
	thread AmbientAABlastSound( 1 );
	thread AmbientAABlastSound( 2 );
	thread AmbientAABlastSound( 3 );
}














