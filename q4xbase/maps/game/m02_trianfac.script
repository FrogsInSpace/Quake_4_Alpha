void TeammateLiftDoor( entity teammate, entity look_target )
{
	aiScriptedFaceWait( teammate, look_target, 0 );
	aiScriptedAnimWait( teammate, "tr_doorlift_start", 0, 0 );
	aiScriptedAnimWait( teammate, "tr_doorlift_loop_1", 0, 0 );
}


void TeammateLiftDoorHigher( entity teammate )
{
	aiScriptedAnimWait( teammate, "tr_doorlift_higher", 0, 0 );
	aiScriptedAnimWait( teammate, "tr_doorlift_loop_2", 0, 0 );
}


void DarnellMitchellDropDoor()
{
	aiScriptedAnim( $darnell, "tr_doorlift_end", 0, 0 );
	aiScriptedAnim( $mitchell, "tr_doorlift_end", 0, 0 );

	setNewTimes( $stuck_door, 0.5, 0.0, 0.1 );
	$stuck_door.move( DOWN, 48 );
	sys.waitFor( $stuck_door );
}



void DarnellMitchellOpenDoor()
{
	aiScriptedMoveWait( $darnell, $darnell_door_pos, 8, 0 );
	aiScriptedMoveWait( $mitchell, $mitchell_door_pos, 8, 0 );
	aiScriptedMoveWait( $tak, $tak_door_pos_before, 8, 0 );

	sys.println( "got here #1" );

	aiSpeak( $darnell, "lipsync_darn_hmmonlyway" );

	thread TeammateLiftDoor( $darnell, $darnell_stuck_door_look_target );
	thread TeammateLiftDoor( $mitchell, $mitchell_stuck_door_look_target );

	sys.wait( 1.0 );

	setNewTimes( $stuck_door, 0.8, 0.0, 0.2 );
	$stuck_door.move( UP, 32 );
	sys.waitFor( $stuck_door );

	aiSpeak( $darnell, "lipsync_darn_takgetunderths" );

	aiScriptedMoveWait( $tak, $tak_door_pos_before, 8, 0 );
	aiScriptedAnimWait( $tak, "tr_tak_duck", 0, 0 );
	aiScriptedMoveWait( $tak, $tak_door_pos_console, 8, 0 );

	thread TakOnOthersideOfUpDoor();

	aiSpeakWait( $darnell, "lipsync_darn_pain" );
	aiSpeakWait( $darnell, "lipsync_darn_dekforget" );

	thread TeammateLiftDoorHigher( $darnell );
	thread TeammateLiftDoorHigher( $mitchell );

	$stuck_door.move( UP, 16 );
	sys.waitFor( $stuck_door );

	aiSpeakWait( $mitchell, "lipsync_mitch_pain" );
	aiSpeakWait( $darnell, "lipsync_darn_dekhrry" );
	aiSpeakWait( $mitchell, "lipsync_mitch_cntholdlng" );

	aiSpeakWait( $darnell, "lipsync_darn_comondek" );
	aiSpeakWait( $darnell, "lipsync_darn_pain2" );
	aiSpeakWait( $mitchell, "lipsync_mitch_pain2" );

	radioChatterPlay( $razor1_radiochatter_1, "vo_darn_takmeetmarks" );
}









