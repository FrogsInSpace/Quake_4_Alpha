void OpenCoreBossDoor( float door_no )
{
	entity core_boss_door;
	entity core_boss_door_lock;

	core_boss_door      = sys.getEntity( "tank_door_" + door_no + "_east" );
	core_boss_door_lock = sys.getEntity( "tank_door_team_" + door_no + "_lock" );

	sys.trigger( core_boss_door_lock );
	sys.wait( 1.5 );
	sys.trigger( core_boss_door );
}





void CloseCoreBossDoor( float door_no )
{
	entity core_boss_door;
	entity core_boss_door_lock;

	core_boss_door      = sys.getEntity( "tank_door_" + door_no + "_east" );
	core_boss_door_lock = sys.getEntity( "tank_door_team_" + door_no + "_lock" );

	sys.trigger( core_boss_door );
	sys.wait( 1.5 );
	sys.trigger( core_boss_door_lock );
}












void BringOnTheTank()
{
	sys.trigger( $dekard );

	sys.wait( 1.0 );

	$dekard.setOrigin( $dekard_console_pos_1.getOrigin() );
	aiScriptedFace( $dekard, $boss_screen_4_off, 0 );

	sys.setCamera( $core_boss_cam_1 );
	sys.fadeIn( '0 0 0', 1 );

	aiScriptedAnimWait( $dekard, "console_stand_start", 0, 0 );
	aiScriptedAnim( $dekard, "console_stand_loop", 1, 0 );

	thread BringOnTheTankScreens();

	radioChatterPlayWait( $razor1_radiochatter_1, "vo_tak_ltdeki" );
	radioChatterPlayWait( $razor1_radiochatter_1, "vo_marks_rogmakeitfast" );

	aiScriptedAnimWait( $dekard, "console_stand_end", 0, 0 );

	aiScriptedAnim( $dekard, "idle_wrist_gui_start", 0, 0 );
	radioChatterPlayWait( $razor1_radiochatter_1, "vo_dek_takinpos" );
//	aiScriptedAnimWait( $dekard, "idle_wrist_gui_loop", 0, 0 );
	aiScriptedAnimWait( $dekard, "idle_wrist_gui_end", 0, 0 );

	aiScriptedAnimWait( $dekard, "console_stand_start", 0, 0 );
	aiScriptedAnim( $dekard, "console_stand_loop", 1, 0 );

	radioChatterPlayWait( $razor1_radiochatter_1, "vo_tak_rogdek3" );

	radioChatterPlayWait( $razor1_radiochatter_1, "vo_tak_gooddataacc" );

	sys.trigger( $music_tank_intro );

	aiScriptedAnim( $dekard, "console_stand_loop", 1, 0 );

	radioChatterPlayWait( $razor1_radiochatter_1, "vo_tak_swtmoth" );

	aiScriptedAnimWait( $dekard, "console_stand_end", 0, 0 );

	aiScriptedAnimWait( $dekard, "idle_wrist_gui_start", 0, 0 );
	radioChatterPlay( $razor1_radiochatter_1, "vo_dek_yrguess" );
	aiScriptedAnimWait( $dekard, "idle_wrist_gui_loop", 0, 0 );
	aiScriptedAnimWait( $dekard, "idle_wrist_gui_end", 0, 0 );

	aiScriptedAnimWait( $dekard, "console_stand_start", 0, 0 );
	aiScriptedAnim( $dekard, "console_stand_loop", 1, 0 );

	radioChatterPlayWait( $razor1_radiochatter_1, "vo_tak_keepopensome" );

	aiScriptedAnim( $dekard, "console_stand_loop", 1, 0 );

	radioChatterPlayWait( $razor1_radiochatter_1, "vo_tak_almostdown" );

	aiScriptedAnimWait( $dekard, "console_stand_end", 0, 0 );

	aiScriptedAnimWait( $dekard, "idle_wrist_gui_start", 0, 0 );
	radioChatterPlay( $razor1_radiochatter_1, "vo_dek_rptlattrans" );
	aiScriptedAnimWait( $dekard, "idle_wrist_gui_loop", 0, 0 );
	aiScriptedAnimWait( $dekard, "idle_wrist_gui_end", 0, 0 );

	radioChatterPlayWait( $razor1_radiochatter_1, "vo_tak_thatdatserious" );

	aiScriptedAnimWait( $dekard, "console_stand_start", 0, 0 );
	aiScriptedAnim( $dekard, "console_stand_end", 0, 0 );

	$core_boss.setMoveSpeed( AIMOVESPEED_RUN );

//	sys.wait( 10.0 );

	thread OpenCoreBossDoor( 2 );
//	sys.wait( 3.0 );

	thread OpenCoreBossDoor( 1 );

	sys.trigger( $core_boss );

	sys.setCamera( $core_boss_cam_2 );
	sys.fadeIn( '0 0 0', 1 );

//	thread CloseCoreBossDoor( 2 );

	aiScriptedMove( $core_boss, $core_boss_pos_1, 32, 1 );

	sys.wait( 3.0 );

	sys.setCamera( $core_boss_cam_3 );
	sys.fadeIn( '0 0 0', 1 );

	sys.wait( 3.0 );

	thread CloseCoreBossDoor( 1 );

	$core_boss.becomePassive( 0 );
	sys.trigger( $core_boss_healthbar );

	$dekard.setOrigin( $dekard_ending_pos_4.getOrigin() );

	sys.firstPerson();
}





