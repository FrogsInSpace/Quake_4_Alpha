void FinalTank()
{
	aiScriptedMove( $tak, $tak_pos_43, 16, 1 );
	aiScriptedMoveWait( $navajas, $navajas_pos_43, 16, 0 );

	aiScriptedAnimWait( $navajas, "stand_to_crouch", 0, 0 );
	aiScriptedAnimWait( $navajas, "crouch_cover_idle", 1, 0 );

	sys.wait( 5.0 );

	aiScriptedAnimWait( $navajas, "crouch_to_stand", 0, 0 );

	aiScriptedMove( $tak, $tak_pos_43a, 16, 0 );
	aiScriptedMoveWait( $navajas, $navajas_pos_43a, 16, 0 );

	aiScriptedFaceWait( $tak, $Valkaryne_door1, 1 );
	aiScriptedFaceWait( $navajas, $Valkaryne_door1, 1 );

	sys.trigger( $door_ice_explosion_4 );

	aiScriptedAnim( $navajas, "pain_concussive2", 0, 0 );
	aiScriptedAnim( $tak, "pain_concussive5", 0, 0 );

	aiSpeak( $tak, "lipsync_tak_readingsorts" );

	aiScriptedMoveWait( $tak, $tak_pos_42, 16, 1 );
	aiScriptedMoveWait( $navajas, $navajas_pos_42, 16, 1 );

//	$valkaryne.setOrigin( $valkaryne_pos_1.getOrigin() );

	$door_ice_4a.remove();
	$door_ice_4b.remove();

	sys.trigger( $final_tank );
	sys.trigger( $final_tank_healthbar );

	sys.trigger( $Valkaryne_door1 );
}









void FinalValkaryne()
{
	aiScriptedMoveWait( $tak, $tak_pos_44, 16, 0 );
	aiScriptedMoveWait( $navajas, $navajas_pos_44, 16, 0 );

	radioChatterPlay( $valkaryne_voice, "vo_marks_falconsqkn" );

//	setNewTimes( $mover_icecube, 5.0, 1.0 , 1.0 );
