void TeamToElevator()
{
	aiScriptedMoveWait( $tak, $tak_pos_22, 16, 1 );
	aiScriptedMove( $navajas, $navajas_pos_22, 16, 1 );

	aiScriptedFaceWait( $tak, $tak_elevA_panel, 1 );
	aiScriptedAnimWait( $tak, "console_stand_start", 0, 0 );
	aiScriptedAnimWait( $tak, "console_stand_loop", 0, 0 );
	aiScriptedAnimWait( $tak, "console_stand_end", 0, 0 );

	// Open the gate
	setNewTimes( $elevGateA_1 , 1 , .5 , .2 );
	$elevGateA_1.rotateOnce( '-90 0 0' );
	sys.waitFor( $elevGateA_1 );

	sys.wait( 1.0 );

	aiScriptedMoveWait( $tak, $tak_pos_23, 16, 1 );
	aiScriptedMoveWait( $navajas, $navajas_pos_23, 16, 1 );
	sys.wait( 1.0 );

	sys.trigger( $trigger_playerOnElevator );
	}






void TeamOnElevator()
{
	// Close the gate
	setNewTimes( $elevGateA_1 , 1 , .5 , .2 );
	$elevGateA_1.rotateOnce( '90 0 0' );
	sys.waitFor( $elevGateA_1 );

	sys.trigger( $team_elevator_block );

	$elevAControls.guiEvent( "anim_up" );
	$elevA.move( DOWN, 1280 );
	sys.waitFor( $elevA );
	$elevAControls.guiEvent( "anim_up_reset" );
	
	// Open the gate
	setNewTimes( $elevGateA_1 , 1 , .5 , .2 );
	$elevGateA_1.rotateOnce( '-90 0 0' );
	sys.waitFor( $elevGateA_1 );

	sys.trigger( $monster_gunner_3 );
	sys.trigger( $lab1_grun_01 );

	aiScriptedMove( $tak, $tak_pos_24, 32, 1 );
	aiScriptedMove( $navajas, $navajas_pos_24, 32, 1 );
}










