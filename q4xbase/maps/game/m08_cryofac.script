	$valkaryne_window_fixed.remove();
	$valkaryne_window_broken.show();

//	$tak.kill();
	$tak.becomeRagdoll();
	sys.waitFrame();
	$tak.bindToJoint( $valkaryne_1, "r_melee_tip", 1 );

	radioChatterPlay( $valkaryne_voice, "vo_valk_racedies" );

	sys.trigger( $music_cryo_exit );

	$valkaryne_1.remove();

	aiScriptedAnimWait( $navajas, "turn_180", 0, 0 );
	aiScriptedAnimWait( $navajas, "cr_ladder_descend", 0, 0 );

	$navajas.remove();

