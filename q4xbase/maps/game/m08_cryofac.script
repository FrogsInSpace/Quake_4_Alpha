void FrostBlaster( float blaster_no )
	{
	entity blaster_west_a;
	entity blaster_west_b;
	entity blaster_west_c;
	entity mover_west_a;
	entity mover_west_b;
	entity mover_west_c;

	blaster_west_a = sys.getEntity( "frostblaster_" + blaster_no + "west_a" );
	blaster_west_b = sys.getEntity( "frostblaster_" + blaster_no + "west_b" );
	blaster_west_c = sys.getEntity( "frostblaster_" + blaster_no + "west_c" );

	mover_west_a = sys.getEntity( "frostblaster_" + blaster_no + "west_a_mover" );
	mover_west_b = sys.getEntity( "frostblaster_" + blaster_no + "west_b_mover" );
	mover_west_c = sys.getEntity( "frostblaster_" + blaster_no + "west_c_mover" );

	while ( frostblasters_on == 1 )
		{
		mover_west_b.move( NORTH, 64 );
		sys.trigger( blaster_west_b );

		sys.wait( 0.5 );

		mover_west_a.move( NORTH, 64 );
		mover_west_c.move( NORTH, 64 );
		sys.trigger( blaster_west_a );
		sys.trigger( blaster_west_c );
		sys.waitFor( mover_west_c );

		mover_west_b.move( SOUTH, 64 );
		mover_west_a.move( SOUTH, 64 );
		mover_west_c.move( SOUTH, 64 );
		sys.waitFor( mover_west_c );

		sys.wait( 3.0 );
		}
	}


void FrostBlasters( )
	{
	thread FrostBlaster( 1 );
	sys.wait( 1.0 );
	thread FrostBlaster( 2 );
	sys.wait( 1.0 );
	thread FrostBlaster( 3 );
	}









void OpenStartDoor()
{
	$func_static_54504.setShaderParm( 7, 1 );
	$func_door_158.lock( 0 );

	sys.wait( 1.0 );

	sys.trigger( $entrance_strogg_marine_1 );
	sys.trigger( $entrance_strogg_marine_2 );
	sys.trigger( $entrance_strogg_grunt_1 );
}



void LockCryoDoor( entity locking_trigger )
{	
	entity door_locked = sys.getEntity( locking_trigger.getKey("door1_name") );
	entity frame_locked = sys.getEntity( locking_trigger.getKey("frame_name") );

	sys.wait( 0.1 );

	frame_locked.setShaderParm( 7, 0 );
	door_locked.lock( 1 );

//	$func_static_54504.setShaderParm( 7, 0 );
//	$func_door_158.lock( 1 );
}


void UnlockCryoDoor( entity unlocking_trigger )
{	
	entity door_unlocked = sys.getEntity( unlocking_trigger.getKey( "door1_name" ) );
	entity frame_unlocked = sys.getEntity( unlocking_trigger.getKey( "frame_name" ) );

	sys.wait( 0.1 );

	frame_unlocked.setShaderParm( 7, 0 );
	door_unlocked.lock( 0 );

//	$func_static_54504.setShaderParm( 7, 0 );
//	$func_door_158.lock( 0 );
}




















void CoreMonitor()
{
	aiScriptedMoveWait( $tak, $tak_pos_28, 8, 0 );

	aiScriptedFaceWait( $tak, $valkaryne_console_1, 0 );

	aiScriptedMove( $navajas, $navajas_pos_3, 8, 0 );

	aiScriptedAnimWait( $tak, "console_stand_start", 0, 0 );
	aiScriptedAnimWait( $tak, "console_stand_loop", 0, 0 );
	aiScriptedAnimWait( $tak, "console_stand_end", 0, 0 );

	$core_monitor_static.hide();
	$core_monitor_screen.show();

	radioChatterPlay( $valkaryne_voice, "vo_valk_iseeyou" );

	sys.trigger( $valkaryne_monitor_fadeout );

	sys.wait( 4.0 );

	sys.trigger( $valkaryne_monitor_fadein );

	sys.wait( 5.0 );

	TakOpenDoor( $cryodoor_5 );
	aiScriptedMove( $tak, $cryodoor_5_tak_pos_2, 16, 0 );
}




void CoreMonitor2()
{
	if ( core_monitor2_on == 0 )
		{
		$core_monitor_static2.hide();
		$core_monitor_screen2.show();
		core_monitor2_on = 1;
		sys.wait( 0.1 );
		}
	else
		{
		$core_monitor_static2.show();
		$core_monitor_screen2.hide();
		core_monitor2_on = 0;
		sys.wait( 0.1 );
		}
}









void FirstFreeze()
{
	float i;

	sys.trigger( $darnell );
	sys.trigger( $redshirt );

	$darnell.setOrigin( $darnell_pos_1.getOrigin() );
	$redshirt.setOrigin( $redshirt_pos_1.getOrigin() );

	sys.wait( 3.0 );

	sys.trigger( $fog_stream_trigger_1 );

	aiSpeak( $navajas, "lipsync_nava_whathll" );

	sys.wait( 3.0 );

	aiScriptedMoveWait( $tak, $tak_firstfreeze_pos_1, 8, 0 );
	aiScriptedMoveWait( $navajas, $navajas_firstfreeze_pos_1, 8, 0 );

	aiScriptedFace( $tak, $player1, 0 );
	aiScriptedFace( $navajas, $player1, 0 );

	sys.trigger( $fog_light_fade_in_1 );

	$fog_lifter_1.move( UP, 128 );
	sys.waitFor( $fog_lifter_1 );

	for ( i = 0.2; i <= 1.0; i += 0.02 )
		{
		$freezer_window_3.setShaderParms( i, i, i, i );
		sys.wait(0.02);
		}

	sys.trigger( $firstfreeze_FX );

	aiSpeakWait( $tak, "lipsync_tak_itcryocfrz" );

	sys.trigger( $little_freeze_hurt );

	aiScriptedAnimWait( $tak, "idle_wrist_gui_start", 0, 0 );
	aiSpeakWait( $tak, "lipsync_tak_ddcc" );
	aiScriptedAnimWait( $tak, "idle_wrist_gui_loop", 0, 0 );
	aiScriptedAnimWait( $tak, "idle_wrist_gui_end", 0, 0 );

	aiScriptedMoveWait( $darnell, $darnell_pos_2, 16, 0 );
	aiScriptedMoveWait( $redshirt, $redshirt_pos_2, 16, 0 );

	aiScriptedFace( $darnell, $player1, 0 );
	aiScriptedFaceWait( $redshirt, $player1, 0 );

	aiScriptedFace( $tak, $darnell, 0 );
	aiScriptedFaceWait( $navajas, $darnell, 0 );

	radioChatterPlayWait( $func_radiochatter_1, "vo_darn_whatmattb" );

	aiSpeakWait( $navajas, "lipsync_nava_shoveit" );

	aiScriptedMoveWait( $darnell, $darnell_pos_3, 16, 0 );
	aiScriptedMoveWait( $redshirt, $redshirt_pos_3, 16, 0 );

	aiScriptedFaceWait( $darnell, $func_static_55887, 1 );
	aiScriptedFaceWait( $redshirt, $player1, 1 );

	radioChatterPlay( $func_radiochatter_1, "vo_darn_solaterthn" );

	aiScriptedAnimWait( $darnell, "console_stand_start", 0, 0 );
	aiScriptedAnimWait( $darnell, "console_stand_loop", 0, 0 );
	aiScriptedAnimWait( $darnell, "console_stand_end", 0, 0 );

	aiScriptedFaceWait( $darnell, $player1, 1 );

	radioChatterPlayWait( $func_radiochatter_1, "vo_darn_therecryoc" );

	sys.trigger( $little_freeze_hurt );

	sys.trigger( $fog_stream_trigger_1 );

	$fog_lifter_1.move( DOWN, 256 );
	sys.waitFor( $fog_lifter_1 );

	sys.trigger( $firstfreeze_FX );

	for ( i = 1.0; i >= 0.2; i -= 0.02 )
		{
		$freezer_window_3.setShaderParms( i, i, i, i );
		sys.wait(0.02);
		}

	aiSpeakWait( $navajas, "lipsync_nava_thanksdarn" );
	radioChatterPlayWait( $func_radiochatter_1, "vo_darn_noprobfiretm" );

	aiScriptedMove( $darnell, $darnell_pos_1, 16, 0 );
	aiScriptedMoveWait( $redshirt, $redshirt_pos_1, 16, 0 );

	sys.wait( 3.0 );

	aiScriptedMove( $navahas, $cryodoor_6_navajas_pos_1, 16, 0 );

	TakOpenDoor( $cryodoor_6 );
	aiScriptedMove( $tak, $cryodoor_6_tak_pos_2, 16, 0 );
	sys.wait( 1.0 );
	aiScriptedMove( $navahas, $cryodoor_6_navajas_pos_1, 16, 0 );


//	sys.trigger( $lab2_trigger_hurt1 );
}

















void TurnOnFreeze()
{
	float i;

	sys.trigger( $fog_stream_trigger );

	sys.wait( 1.0 );

	sys.trigger( $fog_light_fade_in );

	sys.trigger( $freezer_sound_1 );
	sys.trigger( $freezer_sound_2 );

	$fog_lifter.move( UP, 192 );
	sys.waitFor( $fog_lifter );

	sys.wait( 3.0 );

	for ( i = 0.2; i <= 1.0; i += 0.02 )
		{
		$freezer_window_1.setShaderParms( i, i, i, i );
		$freezer_window_2.setShaderParms( i, i, i, i );
		sys.wait(0.02);
		}

	sys.wait( 1.0 );

	sys.trigger( $lab2_trigger_hurt1 );

	sys.trigger( $freezer_sound_3 );
}












void TurnOffFreeze()
{
	float i;

	sys.trigger( $little_freeze_hurt );

	sys.trigger( $fog_stream_trigger );

	sys.wait( 1.0 );

	sys.trigger( $fog_light_fade_in );

	sys.trigger( $freezer_sound_1 );
	sys.trigger( $freezer_sound_2 );

	for ( i = 1.0; i > 0.2; i -= 0.02 )
		{
		$freezer_window_1.setShaderParms( i, i, i, i );
		sys.wait(0.02);
		}

	sys.wait( 3.0 );

	$fog_lifter.move( DOWN, 192 );
	sys.waitFor( $fog_lifter );

	sys.trigger( $lab2_trigger_hurt1 );

	sys.trigger( $freezer_sound_3 );

	aiScriptedFace( $tak, $player1, 0 );
	aiScriptedFaceWait( $navajas, $player1, 0 );

	aiSpeakWait( $tak, "lipsync_tak_wowcls" );

	aiSpeakWait( $navajas, "lipsync_nava_sorryserg" );

	sys.trigger( $freezer_doors2_lock );
	$freezer_doors2_frame.setShaderParm( 7, 1 );

	aiScriptedMoveWait( $tak, $tak_pos_33, 8, 1 );
	aiScriptedMoveWait( $navajas, $navajas_pos_33, 8, 1 );
}













void StartFreezerMaidens()
{
	$darnell.setOrigin( $darnell_pos_4.getOrigin() );
	$redshirt.setOrigin( $redshirt_pos_4.getOrigin() );

	aiScriptedMove( $tak, $tak_pos_32, 8, 0 );
	aiScriptedMove( $navajas, $navajas_pos_32, 8, 0 );

	aiScriptedMove( $darnell, $darnell_pos_5, 16, 0 );
	aiScriptedMoveWait( $redshirt, $redshirt_pos_5, 16, 0 );

	aiScriptedMove( $darnell, $darnell_pos_6, 16, 0 );
	aiScriptedMoveWait( $redshirt, $redshirt_pos_6, 16, 0 );

	aiScriptedFaceWait( $darnell, $player1, 1 );

	aiScriptedMoveWait( $redshirt, $redshirt_pos_7, 16, 1 );
	sys.trigger( $redshirt_pos_7_tether );
	aiScriptedMoveWait( $darnell, $darnell_pos_7, 16, 1 );
	sys.trigger( $darnell_pos_7_tether );

	sys.trigger( $freezeroom_maiden_casket_1 );
	sys.trigger( $freezeroom_maiden_1 );

	$darnell_door_frame.setShaderParm( 7, 0 );
	sys.trigger( $darnell_door_lock );	

	sys.wait( 1.0 );

	aiScriptedFaceWait( $darnell, $freezeroom_maiden_1, 1 );

	sys.trigger( $freezeroom_maiden_casket_2 );
	sys.trigger( $freezeroom_maiden_2 );

	sys.wait( 1.0 );

	aiScriptedFaceWait( $redshirt, $freezeroom_maiden_1, 1 );
}













void StartValkaryne()
{
	sys.wait( 3.0 );

	TurnOnFreeze();

	radioChatterPlayWait( $func_radiochatter_1, "vo_darn_holyshitcold" );
	radioChatterPlay( $func_radiochatter_1, "vo_marine1_die" );

	aiScriptedAnimWait( $redshirt, "pain2", 0, 1 );
	aiScriptedAnimWait( $redshirt, "pain1", 0, 1 );
	$redshirt.kill();

	sys.trigger( $valkaryne );
	sys.waitFrame();
	aiScriptedAnim( $valkaryne, "cr_idle_upside_down", 0, 0 );

	aiScriptedFaceWait( $darnell, $valkaryne, 1 );

	aiSpeak( $tak, "lipsync_tak_itmakguard" );

//	aiScriptedAnim( $valkaryne, "plugin_to_idle", 0, 0 );

	aiSpeak( $tak, "lipsync_tak_darngethell" );

	sys.trigger( $darnell_pos_7_breaktether );
	aiScriptedMoveWait( $darnell, $darnell_pos_6, 16, 1 );

//	aiSpeakWait( $tak, "lipsync_tak_darnman" );

//	aiScriptedAnimWait( $valkaryne, "run", 0, 0 );

	radioChatterPlayWait( $func_radiochatter_1, "vo_darn_dir" );
	aiSpeak( $tak, "lipsync_tak_sheflood" );



	sys.trigger( $music_cryo_cue );

	aiScriptedAnimWait( $darnell, "pain1", 0, 1 );
	aiScriptedAnimWait( $darnell, "pain3", 0, 1 );
	$darnell.kill();

//	aiScriptedAnimWait( $valkaryne, "run_right", 0, 0 );
//	aiScriptedAnimWait( $valkaryne, "run_right", 0, 0 );
//	aiScriptedAnimWait( $valkaryne, "run", 0, 0 );

//	aiScriptedAnim( $valkaryne, "leap_attack", 0, 0 );

	sys.wait( 2.0 );

	$freezer_window_2.remove();
	$frost_window_fixed_1.remove();
	$frost_window_broken_1.show();

//	sys.wait( 3.0 );

	sys.trigger( $little_freeze_hurt );

	aiSpeak( $navajas, "lipsync_nava_weneedloccryo" );

//	aiScriptedAnimWait( $valkaryne, "run_backwards", 0, 0 );
//	aiScriptedAnimWait( $valkaryne, "run_backwards", 0, 0 );

//	$valkaryne.setOrigin( $valkaryne_pos_1.getOrigin() );

	$func_static_53709.setShaderParm( 7, 1 );
	sys.trigger( $target_lock_11 );

	aiSpeakWait( $tak, "lipsync_tak_wecantlast" );

	aiSpeakWait( $tak, "lipsync_tak_cantfeelhand" );

	$valkaryne.remove();
}








