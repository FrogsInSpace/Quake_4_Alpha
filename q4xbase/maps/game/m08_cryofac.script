//	sys.waitFor( $mover_icecube );
}











void InitCharacters()
{
	$tak.setUndying( 1 );
	$navajas.setUndying( 1 );
//	$darnell.setUndying( 1 );
//	$redshirt.setUndying( 1 );

	$redshirt.setHealth( 300 );
	$darnell.setHealth( 300 );

	setNewTimes( $elevGateA_1 , 1 , .5 , .2 );
	$elevGateA_1.rotateOnce( '90 0 0' );
	sys.waitFor( $elevGateA_1 );
}






void Intro()
{
	sys.trigger( $music_intro );

	aiScriptedMove( $tak, $tak_intropos_1, 8, 0 );
	aiScriptedMoveWait( $navajas, $navajas_intropos_1, 8, 0 );

	aiScriptedMove( $tak, $tak_intropos_2, 8, 0 );
	aiScriptedMoveWait( $navajas, $navajas_intropos_2, 8, 0 );

	aiScriptedFace( $tak, $door_ice_1, 1 );
	aiScriptedFace( $navajas, $door_ice_1, 1 );

	aiSpeakWait( $tak, "lipsync_tak_wedefrt" );

	sys.wait( 1.0 );

	aiSpeakWait( $navajas, "lipsync_nava_dontlot" );

	sys.wait( 1.0 );

	aiSpeak( $tak, "lipsync_tak_heysrg" );

	aiScriptedAnimWait( $tak, "console_stand_start", 0, 0 );
//	aiScriptedAnimWait( $tak, "console_stand_loop", 0, 0 );
	aiScriptedAnimWait( $tak, "console_stand_end", 0, 0 );

	sys.wait( 1.0 );

	aiSpeak( $tak, "lipsync_tak_hmmsrgna" );

	aiScriptedMove( $tak, $tak_intropos_3, 8, 0 );
	aiScriptedMoveWait( $navajas, $navajas_intropos_3, 8, 0 );

	aiScriptedFace( $navajas, $door_ice_1, 1 );
	aiScriptedFace( $tak, $door_ice_1, 1 );
}






void GenWheels()
{
	$gen_wheel_1.time( 1.0 );
	$gen_wheel_1.rotate( '0 0 90' );

	sys.wait( 0.5 );

	$gen_wheel_2.time( 1.0 );
	$gen_wheel_2.rotate( '0 0 90' );
}












