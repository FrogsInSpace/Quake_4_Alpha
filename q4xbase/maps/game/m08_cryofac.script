void TakOpenDoor( entity cryodoor )
{
	string cryodoor_name;
	entity cryodoor_lock;
	entity cryodoor_frame;
	entity cryodoor_FX;
	entity cryodoor_tak_pos_1;
	entity cryodoor_panel;

	cryodoor_name      = cryodoor.getName();
	cryodoor_lock      = sys.getEntity( cryodoor_name + "_lock" );
	cryodoor_frame     = sys.getEntity( cryodoor_name + "_frame" );
	cryodoor_FX        = sys.getEntity( cryodoor_name + "_FX" );
	cryodoor_tak_pos_1 = sys.getEntity( cryodoor_name + "_tak_pos_1" );
	cryodoor_panel     = sys.getEntity( cryodoor_name + "_panel" );

	sys.println( "cryodoor = " + cryodoor_name );

	aiScriptedMoveWait( $tak, cryodoor_tak_pos_1, 8, 0 );
	aiScriptedFaceWait( $tak, cryodoor_panel, 0 );

	aiScriptedAnimWait( $tak, "console_stand_start", 0, 0 );
	aiScriptedAnimWait( $tak, "console_stand_loop", 0, 0 );
	aiScriptedAnimWait( $tak, "console_stand_end", 0, 0 );

	sys.trigger( cryodoor_FX );
	sys.trigger( cryodoor_lock );
	cryodoor_frame.setShaderParm( 7, 1 );
	sys.trigger( cryodoor );
}








