	//******************************************intro cinematic********************************************************
	
	void raceIntroCinematic()
	{
		sys.fadeOut( '0 0 0', 0);
		thread mccStrafeRun1();
		sys.wait( .1 );
		thread harvesterVSMcc();
		sys.wait( .2 );
		sys.trigger( $harvester_mcc_1 );
		sys.trigger( $harvester_mcc_3 );
		aiScriptedAnimLoop( $harvester_mcc_1, "taunt", 0 );	
		aiScriptedAnimLoop( $cine_tak_speeder, "speeder_idle", 0 );
		aiScriptedAnimLoop( $cine_darnell_speeder, "speeder_idle", 0 );
		aiScriptedAnimLoop( $cine_dekard_speeder, "speeder_idle", 0 );
		aiScriptedAnimLoop( $RS_rider_1, "speeder_idle", 0 );
		aiScriptedAnimLoop( $RS_rider_2, "speeder_idle", 0 );
		aiScriptedAnimLoop( $RS_rider_3, "speeder_idle", 0 );
		aiScriptedAnimLoop( $RS_rider_4, "speeder_idle", 0 );
		aiScriptedAnimLoop( $RS_rider_5, "speeder_idle", 0 );
		sys.trigger( $cine_overheadCam1 );
		sys.fadeIn( '0 0 0', .5);
		radioChatterPlay( $func_radiochatter_1, "vo_marine2_harvinbound" );
		$cine_overheadCam1_mover.time( 13 );
		$cine_overheadCam1_mover.accelTime( 1 );
		$cine_overheadCam1_mover.decelTime( 1 );
		$cine_overheadCam1_mover.rotateOnce( '30 10 0' );
		$cine_overheadCam1_mover.moveTo( $cine_overheadCam1_pos1 );
		
		sys.wait( 1 );
		aiScriptedAnimLoop( $harvester_mcc_3, "taunt", 0 );
		sys.wait( 2.5 );
		sys.trigger( $mcc_small_splosion_1 );
		sys.wait( 1.5 );
		radioChatterPlay( $func_radiochatter_1, "vo_marine3_shilddown" );
		sys.wait( 2 );
		radioChatterPlay( $func_radiochatter_1, "vo_marine3_keepoff" );
		thread RSSpeeder3Go();
		thread RSSpeeder4Go();
		thread RSSpeeder5Go();
		sys.wait( 1. );
		radioChatterPlay($func_radiochatter_1, "vo_marine5_dropprep");
		sys.wait( 1. );
		thread npcSpeederGo_01();
		thread npcSpeederGo_02();
		thread cineDekardSpeederGo();
		sys.wait( 0.7 );
		thread RSSpeeder1Go();
		thread RSSpeeder2Go();
		sys.wait( 3. );
		sys.trigger( $cine_overheadCam1 );
		sys.trigger( $cine_overheadCam2 );

		sys.wait( 1.0 );
		radioChatterPlayWait( $func_radiochatter_1, "vo_marine6_whathell" );
		//sys.wait( 1.0 );

		sys.trigger( $dropTurret_cinematic_1 );
		sys.wait ( 0.6 );
		thread mccStrafeRun2();
		radioChatterPlay( $func_radiochatter_1, "vo_marine6" );
		sys.wait( 3. );
		radioChatterPlay( $func_radiochatter_1, "vo_marine6_waveunder" );
		sys.wait( .5 );
		thread bomberRun_mcc();
		sys.wait( .5 );
		sys.trigger( $cine_overheadCam2 );
		sys.trigger( $cine_overheadCam3 );
		sys.wait( 1 );
		sys.trigger( $mcc_small_splosion_2 );
		sys.wait( 1 );
		sys.fadeOut( '0 0 0', 1 );
		sys.wait( 1.5 );
		$cine_dekard_speeder.remove();
		$cine_speeder_dekard.remove();
		$dropTurret_cinematic_1.remove();
		sys.trigger( $cine_overheadCam3 );

		thread start_your_engines();
		sys.wait( 1 );
	
	}
		
