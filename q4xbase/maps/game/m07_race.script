	void girderCollapse()
	{
		
		
		$girder_collapse_3.bind( $girder_collapse_4 );
		$girder_collapse_2.bind( $girder_collapse_3 );
		$girder_collapse_1.bind( $girder_collapse_2 );
		
		$girder_collapse_5.time( 1 );
		$girder_collapse_5.accelTime( 1 );
		$girder_collapse_4.time( 1 );
		$girder_collapse_4.accelTime( 1 );
		$girder_collapse_5.rotateOnce( '0 0 20' );
		$girder_collapse_4.rotateOnce( '0 0 -20' );
		
		sys.waitFor( $girder_collapse_4 );
		
		$girder_collapse_3.unbind();
		
		$girder_collapse_3.time( 1 );
		//$girder_collapse_3.accelTime( 1 );
		$girder_collapse_3.rotateOnce( '0 0 -17' );
		
		sys.waitFor( $girder_collapse_3 );
		
		$girder_collapse_fx_1.bind( $girder_collapse_1 );
		$target_null_41.bind( $girder_collapse_1 );
		sys.trigger( $girder_collapse_fx_1 );
		
		
		$girder_collapse_3.time( 2 );
		$girder_collapse_3.decelTime( 1 );
		$girder_collapse_2.time( 2 );
		$girder_collapse_2.decelTime( 1 );
		$girder_collapse_1.time( 2 );
		$girder_collapse_1.decelTime( 1 );
		$girder_collapse_3.rotateOnce( '0 0 -35' );
		$girder_collapse_2.rotateOnce( '0 0 19' );
		$girder_collapse_1.rotateOnce( '0 0 45' );
		sys.waitFor( $girder_collapse_1 );
		sys.wait( 2 );
		sys.trigger( $girder_collapse_fx_1 );
		
		
	}
	
