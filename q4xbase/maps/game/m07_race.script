	void mccGoesBoom()
	{
		radioChatterPlay($func_radiochatter_1, "vo_marine1_crit");
		sys.wait( 5 );
		radioChatterPlay($func_radiochatter_1, "vo_marine2_hullint");
		sys.trigger( $mcc_death_splosion_1 );
		sys.wait( 2 );
		sys.trigger( $mcc_death_splosion_2 );
		$mcc_01.playAnim(ANIMCHANNEL_ALL, "impact");
		sys.wait( 1 );
		sys.trigger( $mcc_death_splosion_2 );
		radioChatterPlay($func_radiochatter_1, "vo_marine3_aband");
		sys.wait( 2 );
		sys.trigger( $mcc_death_splosion_3 );
		sys.wait( .5 );
		sys.trigger( $mcc_death_splosion_4 );
		sys.wait( 1.5 );
		sys.trigger( $mcc_death_splosion_5 );
		sys.wait( .75 );
		sys.trigger( $mcc_death_splosion_6 );
		$harvester_mcc_1.remove();
		$harvester_mcc_3.remove();
		$mcc_01.playAnim(ANIMCHANNEL_ALL, "space_explode");
		$MCC_blast_mover.show();
		sys.trigger( $MCC_blast_pain );
		$MCC_blast_mover.time( 8 );
		$MCC_blast_mover.accelTime( 3 );
		$MCC_blast_mover.moveTo( $MCC_blast_target );
		sys.waitFor( $MCC_blast_mover );
		$MCC_blast_mover.remove();
		$MCC_blast_pain.remove();
		$mcc_01.remove();
		
	}
	
	void start_your_engines()  // force player into vehicle at start of level; start spline
	{
		sys.wait( 1. );
		$player1.enterVehicle( $vehicle_speeder_1 );
		$vehicle_speeder_1.setOrigin( '4540. -8040. 1164.11' );
		$vehicle_speeder_1.setAngles( '0 165 0' );
		//$vehicle_speeder_1.setSpeederBikeBoostEnabled( 0 );
		//$vehicle_speeder_1.setSpeederBikeMaxGravityDistance( 32, 0 );
		sys.wait( 0.1 );
		$vehicle_speeder_1.lock( 1 );
		$vehicle_speeder_1.guiEvent( "hidespeedertimer2" );
		thread raceProgress0();
		sys.music( "m8_chase" );
		sys.fadeIn( '0 0 0', .5);
		thread flyThrough06();
		thread flyThrough05();
		radioChatterPlay($func_radiochatter_1, "vo_tak_srggetmv");
		thread RSSpeeder3MoveOut();
		sys.wait( .2 );
		thread RSSpeeder4MoveOut();
		sys.wait( .2 );
		thread RSSpeeder5MoveOut();
		sys.wait( 1 );
		thread darnellRoadRage();
		radioChatterPlay($func_radiochatter_1, "vo_darn_reactcrit");
		sys.trigger( $mcc_turretSpawner );
		thread RSSpeeder1MoveOut();
		thread RSSpeeder2MoveOut();		
		sys.wait( 3 );

		sys.wait( 3 );
		thread mccGoesBoom();
		
	}

