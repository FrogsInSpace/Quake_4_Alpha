	void liftOperative()
	{
		$func_static_53762.setGuiParm( "noninteractive", "1" );
		$exitLedgeFrame.setShaderParm( 7, 0 );
		$exitLedgeDoor1.lock( 2 );
		$exitLedgeDoor2.lock( 2 );
		sys.trigger( $monster_q4x_tank_1 );
		sys.wait( .5 );
		radioChatterPlay ($prison1_radiochatter, "vo_tak_actlift");
		$exit_lift.gotoFloor( 2 );
		thread extendLiftBridge();
		sys.trigger( $item_objectivecomplete_4 );
		$mitchell_RS.disableHeal();
		sys.wait( 2 );
		aiScriptedMoveWait( $mitchell_RS, $mitchell_exitPos_2, 8, 0 );
		aiSpeak( $mitchell, "lipsync_mitch_theresome" );
		aiScriptedAnimWait( $mitchell_RS, "point_down", 4, 0 );
		sys.wait( 1 );
		aiScriptedMove( $mitchell_RS, $mitchell_exitPos_1, 16, 0 );
		sys.wait( 6 );
		aiSpeak( $tolson_RS, "lipsync_fox5_takecover" );
		aiScriptedMove( $mitchell_RS, $mitchell_exitPos_1, 16, 0 );
		aiScriptedMove( $tolson_RS, $tolson_exitPos_1, 16, 0 );
		sys.wait( 6 );
		aiScriptedMove( $mitchell_RS, $mitchell_exitPos_1, 16, 1 );
		aiScriptedMove( $tolson_RS, $tolson_exitPos_1, 16, 1 );

	}
	
	void enableExitLift()
	{
		sys.wait( 3 );
		aiScriptedMove( $mitchell_RS, $mitchell_exitPos_3, 8, 0 );
		sys.wait( 1.0 );
		aiScriptedMove( $tolson_RS, $tolson_exitPos_3, 8, 0 );
		$exit_lift.setGuiParm( "noninteractive", "0" );
	}
	
	void cinematicEndLevel()  
		{
		//sys.trigger( $exitAcessBlock_2 );
		sys.fadeOut( '0 0 0', 1);
		sys.wait( 1.0 );
		if( isValidEntity( $monster_q4x_tank_1 ))
			{
				$monster_q4x_tank_1.remove();
			}
		sys.trigger( $camera_cine_levelEnd_1 );
		$mitchell_RS.remove();
		$tolson_RS.remove();
		sys.wait( .1 );
		$cinematic_endLevel_dekard.show();
		sys.trigger( $cinematic_endLevel_mitchell );
		sys.trigger( $cinematic_endLevel_tolson );
		sys.wait( .5 );
		aiScriptedMove( $cinematic_endLevel_dekard, $deckard_cine_endLevel_pos_1, 4, 0 );
		sys.fadeIn( '0 0 0', 1);
		sys.wait( 2.0 );
		aiScriptedMove( $cinematic_endLevel_mitchell, $mitchell_cine_endLevel_pos_1, 8, 0 );
		sys.wait( 1.0 );
		aiScriptedMove( $cinematic_endLevel_tolson, $tolson_cine_endLevel_pos_1, 8, 0 );
		sys.wait( 1.0 );
		aiScriptedWait( $cinematic_endLevel_tolson );
		aiScriptedFaceWait( $cinematic_endLevel_tolson, $tolson_cine_endLevel_face, 0 );
		sys.wait( 1.0 );
		aiScriptedFaceWait( $cinematic_endLevel_dekard, $exit_lift, 0 );
		aiScriptedAnimWait( $cinematic_endLevel_dekard, "point_down", 4, 0);
		sys.wait( .5 );
		thread retractLiftBridge();
		sys.wait( 3 );	
		$exit_lift.gotoFloor( 1 );
		sys.wait( 8 );
		sys.trigger( $target_endlevel_1 );
	}
	
	void main()
	{
		$func_mover_20.hide();
		
		sys.wait( 0.1 );
		thread theLevelBegins();
		
		sys.wait( 0.1 );
		thread setSecWindowShields();
		
				
		sys.wait( 0.1 );
		thread tubeTransportSystem();
		
		sys.wait( 0.1 );
		thread tubeTransportSystem2();
		
		sys.wait( 0.1 );
