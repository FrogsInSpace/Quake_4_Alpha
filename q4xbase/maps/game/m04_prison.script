		$center_walkway_east.decelTime( .5 );
		$center_walkway_east.rotateOnce( '90 0 0' );
		sys.wait( 1 );
		$bridge_plat_rt_d_east.time( .5 );
		$bridge_plat_lf_d_east.time( .5 );
		$bridge_plat_lf_d_east.move( NORTH, 24 );
		$bridge_plat_rt_d_east.move( NORTH, 24 );
	}
	
	
	
