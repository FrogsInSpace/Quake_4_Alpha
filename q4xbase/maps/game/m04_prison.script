	void squadTopLoop7Pos() //team arrives at locked security door, tak overrides while player mans the turret
	{
		sys.wait( 4 );
		aiScriptedMove( $tak, $tak_toploop_7, 8, 0 );
		sys.wait( 1 );
		aiScriptedMove( $darnell, $darnell_toploop_7, 8, 0 );
		aiScriptedWait( $tak );
		aiScriptedFaceWait( $tak, $turret_seq_monitor, 0 );
		aiSpeak( $tak, "lipsync_tak_weneedtoget" );
		aiScriptedAnimWait( $tak, "console_stand_start", 4, 0 );
		aiScriptedAnimWait( $tak, "console_stand_loop", 4, 0 );
		aiScriptedAnimWait( $tak, "console_stand_end", 4, 0 );
		aiScriptedWait( $darnell );
		sys.wait( .5 );
		aiSpeakWait( $tak, "lipsync_tak_coverhack" );
		aiSpeakWait( $darnell, "lipsync_darn_dekifyouman" );
		
		sys.wait( 4 );
		sys.trigger( $spkr_breach_explosion );
		sys.trigger( $breach_quake );
		sys.trigger( $breach_quake_1 );
		thread manTheTurret();
		aiSpeak( $darnell, "lipsync_darn_incom3" );
		aiScriptedMoveWait( $darnell, $darnell_hygpos_1, 8, 1 );
		sys.trigger( $darnell_turret_tether );
	}
	
	
