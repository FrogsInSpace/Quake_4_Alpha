	void darnellNagHatch()
	{
		while(1)
		{
			sys.wait( 10 );
			aiSpeak( $darnell, "lipsync_darn_overhere3" );
		}
			
	}
	
	void darnellAtHatch()
	{
		sys.killthread( "darnellNagHatch" );
		aiScriptedFaceWait( $darnell, $player1, 0);
		aiSpeakWait( $darnell, "lipsync_darn_thistunn" );
		aiScriptedMoveWait( $darnell, $darnell_doorhackpos_1, 8, 1);
	}
	
	void darnellLooksAround()
	{
		aiScriptedMoveWait( $darnell, $darnell_accessGratePos_4, 8, 0);
		sys.wait( 5 );
		aiScriptedMoveWait( $darnell, $darnell_accessGratePos_1, 4, 0);
		aiScriptedFaceWait( $darnell, $sec_grate_clip, 1);
		aiScriptedAnim( $darnell, "pr_darnell_grate", 8, 0 );
		aiSpeak( $darnell, "lipsync_darn_ifoundh" );
		sys.wait( $env_q4x_pr_darnell_grate_1.playAnim(ANIMCHANNEL_ALL, "pr_darnell_grate"));
			//sys.waitFor( $env_q4x_pr_darnell_grate_1 );
		$env_q4x_pr_darnell_grate_1.playCycle(ANIMCHANNEL_ALL, "end_idle");
		$sec_grate_clip.remove();
		sys.trigger( $darnell_hatch_trig );
		thread darnellNagHatch();
	}
	
	void secRoomLastOne()
	{
		float k;
		sys.wait( 3 );
		aiScriptedMoveWait( $tak, $tak_doorhackpos_1, 8, 0 );
		aiSpeak( $tak, "lipsync_tak_pris_door1" );
		aiScriptedFaceWait( $tak, $doorhack_monitor_1, 0 );
		
		aiScriptedAnimWait( $tak, "console_stand_start", 4, 0 );
		aiScriptedAnimWait( $tak, "console_stand_loop", 4, 0 );
		aiScriptedAnimWait( $tak, "console_stand_end", 4, 0 );
		aiSpeak( $tak, "lipsync_tak_weneedsecproc" );
		aiScriptedMoveWait( $tak, $tak_doorhackpos_2, 8, 1);
		aiScriptedFaceWait( $tak, $func_static_53381, 1);
		aiScriptedAnim( $tak, "conversation_1", 16, 1 );
		k = thread darnellLooksAround();
		sys.wait( 5 );
		aiSpeakWait( $tak, "lipsync_tak_accordacc" );
		sys.wait( 2 );

		sys.trigger( $item_objective_sec_room );
		sys.waitForThread( k );
		thread takDoorHack_1();
	}
	
	
	void tunnelReparBotWorking()
	{
		float t;
		
		while( isValidEntity( $tunnel_bot ))
		{
		aiScriptedAnimLoop( $tunnel_bot, "idle", 12 );
		sys.waitFrame();
			
		aiScriptedMoveWait( $tunnel_bot, $tunBot_spot_1, 8, 0 );
		aiScriptedFaceWait( $tunnel_bot, $func_static_54312, 0 );
		$repbot_1.bind( $tunBot_spot_1 );
		sys.wait( 1 );

		aiScriptedActionWait( $tunnel_bot, $func_static_54312, 0 );
		sys.wait( .5 );

		$tunnel_bot.unbind();
		aiScriptedAnimLoop( $tunnel_bot, "idle", 12 );
		
		sys.wait( 1 );
		
		aiScriptedMoveWait( $tunnel_bot, $tunBot_spot_2, 8, 0 );
		aiScriptedFaceWait( $tunnel_bot, $func_static_54314, 0 );
		$repbot_1.bind( $tunBot_spot_1 );
		sys.wait( 1 );

		aiScriptedActionWait( $tunnel_bot, $func_static_54314, 0 );
		sys.wait( .5 );

		$tunnel_bot.unbind();
		aiScriptedAnimLoop( $tunnel_bot, "idle", 12 );
		
		sys.wait( 1 );
		
		//aiScriptedMoveWait( $tunnel_bot, $tunBot_spot_3, 8, 0 );
		//aiScriptedFaceWait( $tunnel_bot, $func_static_54678, 0 );
		//$repbot_1.bind( $tunBot_spot_1 );
		//sys.wait( 1 );

		//aiScriptedActionWait( $tunnel_bot, $func_static_54678, 0 );
		//sys.wait( .5 );

		//$tunnel_bot.unbind();
		//aiScriptedAnimLoop( $tunnel_bot, "idle", 12 );
		
		//sys.wait( 1 );
			
			
		}
	}

	
