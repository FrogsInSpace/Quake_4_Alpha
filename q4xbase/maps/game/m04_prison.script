	void darnellUnlocksDoor1()
	{
		float db;
		float pbo;
		
		aiScriptedMoveWait( $tak, $tak_BridgePos_1, 8, 0 );
		aiScriptedFaceWait( $tak, $bridge_controller, 0 );
		aiScriptedAnimWait( $tak, "console_stand_start", 4, 0 );
		aiScriptedAnimWait( $tak, "console_stand_loop", 4, 0 );
		aiScriptedAnimWait( $tak, "console_stand_end", 4, 1 );
		aiSpeakWait( $tak, "lipsync_tak_damncutoff" );
		aiSpeakWait( $darnell, "lipsync_darn_imonit" );
		aiSpeakWait( $tak, "lipsync_tak_rogethat3" );
		thread takGuardBridge();
		aiScriptedMove( $tak, $tak_BridgePos_2, 8, 1 );
		sys.wait( 1 );
		aiScriptedMoveWait( $darnell, $darnell_unlockBridgeDoorPos_1, 2, 0 );
		aiScriptedFaceWait( $darnell, $center_walkway_east, 0 );
		sys.trigger( $objective_bridge );
		$darnell.setUndying( 0 );
		$darnell.setHealth( 200 );
		db = thread darnellBridgeAnims();
		sys.wait( 2 );
		sys.trigger( $bridgeSpawner_1 );
		radioChatterPlay($prison1_radiochatter, "vo_darn_iseeit");
		sys.wait( 4 );
		sys.trigger( $bridgeSpawner_2 );
		radioChatterPlay($prison1_radiochatter, "vo_darn_gettclose");
		sys.wait( 4 );
		radioChatterPlay($prison1_radiochatter, "vo_darn_almostthr");
		sys.wait( 6 );
		radioChatterPlay($prison1_radiochatter, "vo_darn_gotitkeep");
		sys.wait( 34 );
		sys.trigger( $bridgeSpawner_1 );
		sys.trigger( $bridgeSpawner_2 );
		sys.wait( 6 );
		pbo = thread prison_bridge_out();
		sys.waitForThread( db );
		sys.wait( .5 );
		sys.waitForThread( pbo );
		sys.trigger( $bridge_teamblock );

		thread letsTakeTheBridge();
		
	}
	
