	void tacticalTakesALook()
	{
		sys.trigger( $monster_tactical_mgun_1 );
		aiScriptedMoveWait( $monster_tactical_mgun_1, $sec_room_tact_check_pos2, 16, 1 );
		//sys.trigger( $aas_obs_trapdoor );
		aiScriptedMove( $monster_tactical_mgun_1, $t_mgun_1_pos, 32, 1 );
	}
	
	void squadMoveUp_0() //move team mates forward
	{
		sys.wait(.5 );
		aiScriptedMove( $darnell, $darnell_tactpos_start, 8, 1 );
		aiSpeakWait( $tak, "lipsync_tak_dekletmstrg" );
		aiScriptedMoveWait( $tak, $player1, 64, 0 );
		aiScriptedAnimWait( $tak, "player_gift_start", 4, 0 );
		aiScriptedAnimWait( $tak, "player_gift_end", 4, 0 );
		//sys.wait( 3 );
		aiSpeakWait( $tak, "lipsync_tak_therethatscp" );
		sys.trigger( $core_mod_give );
		sys.wait( .5 );
		sys.music( "m4_enter_prison" );
		thread tacticalTakesALook();
		$player_start_block.hide();
		sys.trigger( $item_objective_2 );
		aiScriptedMove( $darnell, $darnell_tactpos_0, 8, 0 );
		aiScriptedMove( $tak, $tak_tactpos_0, 8, 0 );
	}

