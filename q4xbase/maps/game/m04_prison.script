	void run_for_alarm()  //force ai to run & turn on alarm
	{
		thread squadMoveUp_1();
		aiScriptedMoveWait( $tactical_secRoom, $alarm_location_3, 4, 0 );	//move to window
		aiScriptedFaceWait( $tactical_secRoom, $func_static_1740, 0 );
		//aiScriptedAnimWait( $tactical_secRoom, "point_left", 4, 0 ); //gesture
		aiScriptedMoveWait( $tactical_secRoom, $alarm_location_1, 4, 0 ); //move to console
		aiScriptedFaceWait( $tactical_secRoom, $func_static_54011, 0 );
		//aiScriptedAnimWait( $tactical_secRoom, "point_forward", 4, 0 ); //turn on alarm
		sys.trigger( $security_alarm_1 );
		sys.trigger( $alarm_light01 );
		sys.trigger( $func_rotating_1 );
		$secRoomDoorFrame01.setShaderParm( 7, 0 );
		$secRoomDoora.lock( 2 );
		$secRoomDoorb.lock( 2 );
		$sec_windowShield_01.time( 4 );
		$sec_windowShield_01.accelTime( 1 );
		$sec_windowShield_01.decelTime( .5 );
		$sec_windowShield_02.time( 4 );
		$sec_windowShield_02.accelTime( 1 );
		$sec_windowShield_02.decelTime( .5 );
		$sec_windowShield_01.move( DOWN, 120 );
		$sec_windowShield_02.move( DOWN, 120 );

		sys.wait( .3 );
		sys.trigger( $alarm_light02 );
		sys.trigger( $func_rotating_2 );
		aiScriptedMove( $tactical_secRoom, $alarm_location_2, 4, 0 ); //move to console
		sys.wait( .5 );
		aiSpeakWait( $darnell, "lipsync_darn_shittrig" );
		sys.wait( 1 );
		aiSpeakWait( $tak, "lipsync_tak_thatalarmb" );
		//aiScriptedFaceWait( $tactical_secRoom, $func_static_54013, 0 );
		$tactical_secRoom.remove();

	}

	void securityRoomReinforcements()
	{
		sys.trigger( $secRoom_berserker );
		sys.trigger( $monster_tactical_mgun_33 );
		sys.trigger( $monster_tactical_mgun_34 );
		sys.waitFrame();
		sys.trigger( $secRoomAAS_block );
		$secRoomDoora.lock( 0 );
		$secRoomDoorb.lock( 0 );
		aiScriptedMove( $secRoom_berserker, $secRoom_berkserk_pos_1, 4, 1 );
		sys.wait( .5 );
		aiScriptedMove( $monster_tactical_mgun_33, $secRoom_mgun33_pos_1, 32, 1 );
		sys.wait( .5 );
		aiScriptedMove( $monster_tactical_mgun_34, $secRoom_mgun34_pos_1, 32, 1 );
		sys.wait( 3 );
		sys.trigger( $secRoomAAS_block );
		$secRoomDoora.lock( 2 );
		$secRoomDoorb.lock( 2 );

	}
	
	void takDoorHack_1()
	{
		aiScriptedMoveWait( $tak, $tak_doorhackpos_1, 4, 1);
		aiScriptedFaceWait( $tak, $doorhack_monitor_1, 1);
		aiScriptedAnimWait( $tak, "plant_tnt_low_start", 16, 1 );
