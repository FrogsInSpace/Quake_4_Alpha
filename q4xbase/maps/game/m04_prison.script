	void gruntAndGunnerAttack()
	{
		thread cellblock3_prisoners();
		
		if( isValidEntity( $prison_camera_8 ))
			{
				sys.wait( 2 );
				sys.trigger( $monster_grunt_2 );
				sys.waitFrame();
				aiScriptedMoveWait( $monster_grunt_2, $Tbalcony_jumpdown_pos_3, 8, 0 );
				aiScriptedAnimWait( $monster_grunt_2, "jump128", 8, 1 );
				sys.wait( 2 );
				sys.trigger( $monster_gunner_1 );
			}
		if( !isValidEntity( $prison_camera_8 ))
			{
				thread squadTopLoop7Pos();
			}
					
	}
	
	void takDies()
	{
		sys.trigger( $item_objectivefailed_3 );
	}
	
	void gunnerDropsIn()
	{	
		float jumptime;
		jumptime = randomRoundFloat( 1, 20 ) + 20;
		
		sys.wait( jumptime );
		
		sys.trigger( $gunner_turret_jumpdown );
		sys.waitFrame();
		aiScriptedAnim( $gunner_turret_jumpdown, "pr_gunner_jump_down", 8, 1 );
		sys.wait( .4 );
		sys.trigger( $turret_glass_ceilingfx );
		sys.trigger( $gunner_glass_ceilingbreak );
		$turret_glass_ceiling.remove();
	}	
	
	void manTheTurret()  //turret wave seq while teammate opens door
	{
		aiScriptedAnimWait( $tak, "console_stand_start", 4, 0 );
		aiScriptedAnimLoop( $tak, "console_stand_loop", 8 );

		sys.trigger( $hyg_obstacle );

		sys.wait( 5 );
		sys.trigger( $turretWaveSpawner ); //start wave of enemies
		$tak.setUndying( 0 );
		$tak.setHealth( 200 );
		sys.wait( 8 );
		thread gunnerDropsIn();
		aiSpeak( $darnell, "vo_darn_aboveus" );
		sys.trigger( $turretWaveSpawnerBig );
		radioChatterPlay($prison1_radiochatter, "vo_tak_isobridge");
		sys.wait( 15 );
		radioChatterPlay($prison1_radiochatter, "vo_tak_firstbr");
		sys.wait( 15 );
		radioChatterPlay($prison1_radiochatter, "vo_tak_secondact");
		sys.wait( 15 );
		radioChatterPlay($prison1_radiochatter, "vo_tak_therethird");
		sys.wait( 10 );
		sys.trigger( $turretWaveSpawner ); 
		sys.trigger( $turretWaveSpawnerBig );
		sys.wait( 15 );	//allow for spawned monsters to move through
		radioChatterPlay($prison1_radiochatter, "vo_tak_thatwein");
		$tak.setUndying( 1 );
		//$tak.setHealth( 2000 );
		$turret_exit_frame.setShaderParm( 7, 1 ); //door is unlocked
		$turret_exit_door_1.lock( 0 );
		$turret_exit_door_2.lock( 0 );
		aiScriptedAnimWait( $tak, "console_stand_end", 4, 1 );
		sys.wait( 5.5 );
		sys.trigger( $darnell_remove_tether );
		sys.trigger( $turretWaveOverTrig ); //enables trigger for monsters, removes aas ob, moves teammates
		sys.wait( 0.5 );
		sys.trigger( $func_savegame_1 );
	}
		
	void turretBalconyJumper(entity TJumperName)
	{
		//sys.println("jumperName =" + TJumperName.getName());
		float x;

		x = randomRoundFloat( 1, 4 );
		
		if( x == 1 )
			{
				//sys.println( "jumping" );
				aiScriptedMoveWait(TJumperName, $Tbalcony_jumpdown_pos_1, 16, 1);
				TJumperName.scriptedJumpDown( 90 ); // this is the jump angle
				aiScriptedWait( TJumperName );
			}
			
		if( x == 2 )
			{
				//sys.println( "jumping" );
				aiScriptedMoveWait(TJumperName, $Tbalcony_jumpdown_pos_2, 16, 1);
				TJumperName.scriptedJumpDown( 90 ); // this is the jump angle
				aiScriptedWait( TJumperName );
			}
			
		if( x > 2 )
			{
				aiScriptedMoveWait(TJumperName, $Tbalcony_moveTo_pos_2, 16, 1);
			}
	}
	
	void turretBalconyJumper2(entity TJumperName2)
	{
		//sys.println("jumperName =" + TJumperName2.getName());
		float x;

		x = randomRoundFloat( 1, 4 );
		
		if( x == 1 )
			{
				//sys.println( "jumping" );
				aiScriptedMoveWait(TJumperName2, $Tbalcony_jumpdown_pos_3, 16, 1);
				TJumperName2.scriptedJumpDown( 0 ); // this is the jump angle
				aiScriptedWait( TJumperName2 );
			}
			
		if( x == 2 )
			{
				//sys.println( "jumping" );
				aiScriptedMoveWait(TJumperName2, $Tbalcony_jumpdown_pos_2, 16, 1);
				TJumperName2.scriptedJumpDown( 90 ); // this is the jump angle
				aiScriptedWait( TJumperName2 );
			}
			
		if( x > 2 )
			{
				aiScriptedMoveWait(TJumperName2, $Tbalcony_moveTo_pos_2, 32, 1);
			}
			
	}

	void turretBalconyBerserk(entity TJumperBerserk)
	{
		//sys.println("jumperName =" + TJumperBerserk.getName());
		float x;

		x = randomRoundFloat( 1, 4 );
		
		if( x <= 2 )
			{
				//sys.println( "jumping" );
				aiScriptedMoveWait(TJumperBerserk, $Tbalcony_jumpdown_pos_1, 16, 1);
				TJumperBerserk.scriptedJumpDown( 90 ); // this is the jump angle
				aiScriptedWait( TJumperBerserk );
			}
			
		if( x > 2 )
			{
				//sys.println( "jumping" );
				aiScriptedMoveWait(TJumperBerserk, $Tbalcony_jumpdown_pos_2, 16, 1);
				TJumperBerserk.scriptedJumpDown( 90 ); // this is the jump angle
				aiScriptedWait( TJumperBerserk );
			}

	}
	
