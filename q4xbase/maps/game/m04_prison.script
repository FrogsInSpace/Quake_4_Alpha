	void bridge_unfold()
	{
		$center_walkway_east.time( 3 );
		$center_walkway_east.rotateOnce( '-90 0 0' );
		sys.wait( 1 );
		$bridge_plat_rt_d_east.time( .5 );
		$bridge_plat_lf_d_east.time( .5 );
		$bridge_plat_lf_d_east.move( SOUTH, 24 );
		$bridge_plat_rt_d_east.move( SOUTH, 24 );
	}
	
	void catwalk_c_east()
	{
		$bridge_arm_lf_c_east.time(1.5);
		$bridge_arm_rt_c_east.time(1.5);
		$bridge_plat_rt_c_east.time(1.5);
		$bridge_plat_lf_c_east.time(1.5);
		
		$bridge_plat_lf_c_east.rotateOnce('0 0 -195');
		$bridge_plat_rt_c_east.rotateOnce('0 0 195');
		
		sys.waitFor( $bridge_plat_rt_c_east );
		
		$bridge_arm_lf_c_east.rotateOnce('-203 0 0');
		$bridge_arm_rt_c_east.rotateOnce('-203 0 0');
		
		sys.wait( .75 );
		$bridge_plat_lf_c_east.time(.75);
		$bridge_plat_rt_c_east.time(.75);
		$bridge_plat_lf_c_east.rotateOnce('0 0 128');
		$bridge_plat_rt_c_east.rotateOnce('0 0 -128');
			
		sys.waitFor($bridge_arm_lf_c_east);
		//sys.waitFor( $bridge_plat_rt_c_east );
		
		$bridge_arm_lf_c_east.time(.5);
		$bridge_arm_rt_c_east.time(.5);
		
		$bridge_arm_lf_c_east.move(SOUTH, 232);
		$bridge_arm_rt_c_east.move(SOUTH, 232);
		
	}
	
	void catwalk_b_east()
	{
		$bridge_arm_lf_b_east.time(1.5);
		$bridge_arm_rt_b_east.time(1.5);
		$bridge_plat_rt_b_east.time(1.5);
		$bridge_plat_lf_b_east.time(1.5);
	
		$bridge_plat_lf_b_east.rotateOnce('0 0 -195');
		$bridge_plat_rt_b_east.rotateOnce('0 0 195');
		
		sys.waitFor( $bridge_plat_rt_b_east );
		
		$bridge_arm_lf_b_east.rotateOnce('-203 0 0');
		$bridge_arm_rt_b_east.rotateOnce('-203 0 0');
		
		sys.wait( .75 );
		$bridge_plat_lf_b_east.time(.75);
		$bridge_plat_rt_b_east.time(.75);
		$bridge_plat_lf_b_east.rotateOnce('0 0 128');
		$bridge_plat_rt_b_east.rotateOnce('0 0 -128');
			
		sys.waitFor($bridge_arm_lf_b_east);
		//sys.waitFor( $bridge_plat_rt_b_east );
		
		sys.wait( .5 );
		
		$bridge_arm_lf_b_east.time(1.);
		$bridge_arm_rt_b_east.time(1.);
		
		$bridge_arm_lf_b_east.move(SOUTH, 320);
		$bridge_arm_rt_b_east.move(SOUTH, 320);
	}
	
	void catwalk_a_east()
	{
		$bridge_arm_lf_a_east.time(1.5);
		$bridge_arm_rt_a_east.time(1.5);
		$bridge_plat_rt_a_east.time(1.5);
		$bridge_plat_lf_a_east.time(1.5);
	
		$bridge_plat_lf_a_east.rotateOnce('0 0 -195');
		$bridge_plat_rt_a_east.rotateOnce('0 0 195');
		
		sys.waitFor( $bridge_plat_rt_a_east );
		
		$bridge_arm_lf_a_east.rotateOnce('-203 0 0');
		$bridge_arm_rt_a_east.rotateOnce('-203 0 0');
		
		sys.wait( .75 );
		$bridge_plat_lf_a_east.time(.75);
		$bridge_plat_rt_a_east.time(.75);
		$bridge_plat_lf_a_east.rotateOnce('0 0 128');
		$bridge_plat_rt_a_east.rotateOnce('0 0 -128');
			
		sys.waitFor($bridge_arm_lf_a_east);
		//sys.waitFor( $bridge_plat_rt_a_east );
		
		sys.wait( 1 );
		
		$bridge_arm_lf_a_east.time(1.5);
		$bridge_arm_rt_a_east.time(1.5);
		
		$bridge_arm_lf_a_east.move(SOUTH, 420);
		$bridge_arm_rt_a_east.move(SOUTH, 420);
	}
	
	void bridge_retract()
	{
		$bridge_east_supports.accelTime(.5);
		$bridge_east_supports.decelTime(.5);
		$bridge_east_supports.time(1.5);
		$bridge_east_supports.move(SOUTH, 424);
		sys.waitFor($bridge_east_supports);
	}
	
	void catwalks()
	{
		thread catwalk_c_east();
		sys.wait(.5);
		thread catwalk_b_east();
		sys.wait(.5);
		thread catwalk_a_east();
	}
	
	void prison_bridge()
	{
		thread bridge_unfold();
		sys.wait(.5 );
		thread catwalks();
		sys.wait( 5 );
		thread bridge_retract();
		sys.wait( 2 );
		
		sys.trigger( $alarm_light03 );
		sys.trigger( $func_rotating_5 );
	}
	
	
