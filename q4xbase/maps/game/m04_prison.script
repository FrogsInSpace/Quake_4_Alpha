	void noMoreMrNiceGuy()
	{
		sys.killthread( "overSecRoom" );
	}
	
	void secRoomNag()
	{
		while( !SECROOMSPECS )
		{
			sys.wait( 30 );
			radioChatterPlayWait($prison1_radiochatter, "vo_tak_wegottogetg");
			sys.wait( 30 );
			radioChatterPlayWait($prison1_radiochatter, "vo_tak_thatalarmb");

		}
	}

	void gotSpecs()
	{
		SECROOMSPECS = true;
		sys.killthread( "secRoomNag" );
		sys.wait ( 1 );
		radioChatterPlayWait($prison1_radiochatter, "vo_tak_thatsitdek");

	}
	
	void unlockSecRoomDoors()  //unlocks security room doors
	{
		$secRoomDoorFrame01.setShaderParm( 7, 1 );
		$secRoomDoora.lock( 0 );
		$secRoomDoorb.lock( 0 );
		$secRoomDoorFrame02.setShaderParm( 7, 1 );
		$secRoomDoor02R.lock( 0 );
		$secRoomDoor02L.lock( 0 );
		$sec_windowShield_01.time( 4 );
		$sec_windowShield_01.accelTime( .5 );
		$sec_windowShield_01.decelTime( .5 );
		$sec_windowShield_02.time( 4 );
		$sec_windowShield_02.accelTime( .5 );
		$sec_windowShield_02.decelTime( .5 );

		$sec_windowShield_01.move( UP, 120 );
		$sec_windowShield_02.move( UP, 120 );
		sys.trigger( $security_alarm_1 );
		sys.trigger( $secRoomAAS_block );
		sys.trigger( $item_objectivecomplete_sec_room );
		sys.trigger( $alarm_light03 );
		sys.trigger( $func_rotating_5 );
		sys.trigger( $alarm_light01 );
		sys.trigger( $func_rotating_1 );
		sys.trigger( $alarm_light02 );
		sys.trigger( $func_rotating_2 );
		$func_mover_18.hide();
		$func_mover_19.hide();
		thread gotSpecs();
	}
	
