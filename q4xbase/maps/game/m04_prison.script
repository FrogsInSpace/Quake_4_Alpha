	void prison_bridge_out()
	{
		aiScriptedMoveWait( $tak, $tak_BridgePos_1, 8, 0 );
		$bridge_controls.show();
		aiSpeakWait( $tak, "lipsync_tak_bridgereeng" );
		aiScriptedFaceWait( $tak, $bridge_controller, 0 );
		sys.wait( 2 );
		aiScriptedAnimWait( $tak, "console_stand_start", 4, 0 );
		aiScriptedAnimWait( $tak, "console_stand_loop", 4, 0 );
		aiScriptedAnimWait( $tak, "console_stand_end", 4, 0 );
		thread bridge_extend();
		sys.wait( 2 );
		thread catwalks_out();
		sys.wait( 4 );
		thread bridge_up();
		aiScriptedMove( $tak, $tak_toploop_13, 8, 1 );
		sys.wait( 3 );

	}
	
