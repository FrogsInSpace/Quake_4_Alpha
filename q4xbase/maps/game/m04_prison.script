	void chaingunDriverFire( entity gunner )
	{
		float a;
		float b;
		float c;
	
		if( DRIVER_FIRING ) {
			return;
		}
	
		DRIVER_FIRING = true;
	
		a = starget.getHealth();
	
		while( a > 0 ) {
			sys.wait( 2 );
			gunner.lookAt( starget );
			sys.wait( 0.5 );		
			gunner.fireWeapon( 0, 1.5 );

			sys.wait( .6 );
			a = starget.getHealth();
			if( DRIVER_STOP_FIRING ) {
				break;
			}
		}
	
		DRIVER_FIRING = false;
	}

	
	
