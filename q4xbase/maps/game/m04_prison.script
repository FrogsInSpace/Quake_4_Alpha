	void theLevelBegins()
	{
		
		sys.fadeOut( '0 0 0', 0);
		sys.wait( .2 );
		sys.fadeIn( '0 0 0', .3);
		$tak.setUndying( 1 );
		$darnell.setUndying( 1 );
		
	}

	void tubeTransportSystem() //scripted tube mover
	{
		sys.trigger( $char_marine_naked_1 );
		//aiScriptedAnimLoop( $char_marine_naked_1, "med_tube_float", 0 );
		sys.trigger( $char_marine_naked_2 );
		//aiScriptedAnimLoop( $char_marine_naked_2, "med_tube_float", 0 );
		sys.trigger( $char_marine_naked_3 );
		//aiScriptedAnimLoop( $char_marine_naked_3, "med_tube_float", 0 );
				
		while( !TUBESAREOFF )
		{
			
			$transport_topclamp_3.time( 5.0 );
			$transport_topclamp_4.time( 5.0 );
			$transport_topclamp_5.time( 5.0 );
			$transport_topclamp_6.time( 5.0 );
			$transport_topclamp_3.moveTo( $transport_target_2 );
			$transport_topclamp_4.moveTo( $transport_target_3 );
			$transport_topclamp_5.moveTo( $transport_target_4 );
			$transport_topclamp_6.moveTo( $transport_target_1 );
			sys.wait( 1.35 );
			sys.trigger( $func_door_1569 );
			sys.wait( 1.0 );
			sys.trigger( $func_door_1572 );
			sys.waitFor( $transport_topclamp_6 );
			
			$transport_topclamp_3.time( 5.0 );
			$transport_topclamp_4.time( 5.0 );
			$transport_topclamp_5.time( 5.0 );
			$transport_topclamp_6.time( 5.0 );
			$transport_topclamp_3.moveTo( $transport_target_3 );
			$transport_topclamp_4.moveTo( $transport_target_4 );
			$transport_topclamp_5.moveTo( $transport_target_1 );
			$transport_topclamp_6.moveTo( $transport_target_2 );
			sys.wait( 1.35 );
			sys.trigger( $func_door_1569 );
			sys.wait( 1.0 );
			sys.trigger( $func_door_1572 );
			sys.waitFor( $transport_topclamp_6 );
			
			$transport_topclamp_3.time( 5.0 );
			$transport_topclamp_4.time( 5.0 );
			$transport_topclamp_5.time( 5.0 );
			$transport_topclamp_6.time( 5.0 );
			$transport_topclamp_3.moveTo( $transport_target_4 );
			$transport_topclamp_4.moveTo( $transport_target_1 );
			$transport_topclamp_5.moveTo( $transport_target_2 );
			$transport_topclamp_6.moveTo( $transport_target_3 );
			sys.wait( 1.35 );
			sys.trigger( $func_door_1569 );
			sys.wait( 1.0 );
			sys.trigger( $func_door_1572 );
			sys.waitFor( $transport_topclamp_6 );
			
			$transport_topclamp_3.time( 5.0 );
			$transport_topclamp_4.time( 5.0 );
			$transport_topclamp_5.time( 5.0 );
			$transport_topclamp_6.time( 5.0 );
			$transport_topclamp_3.moveTo( $transport_target_1 );
			$transport_topclamp_4.moveTo( $transport_target_2 );
			$transport_topclamp_5.moveTo( $transport_target_3 );
			$transport_topclamp_6.moveTo( $transport_target_4 );
			sys.wait( 1.35 );
			sys.trigger( $func_door_1569 );
			sys.wait( 1.0 );
			sys.trigger( $func_door_1572 );
			sys.waitFor( $transport_topclamp_6 );
		}
	}

	void tubeTransportSystem2()
	{
		while( !TUBESAREOFF )
		{
			$transport2_topclamp_1.show();
			$transport2_pod_1.show();
			$transport2_topclamp_1.time( 5.0 );
			$transport2_topclamp_2.time( 5.0 );
			$transport2_topclamp_3.hide();
			$transport2_pod_3.hide();
			$transport2_topclamp_3.time( 5.0 );
			$transport2_topclamp_1.moveTo( $transport2_target_2 );
			$transport2_topclamp_2.moveTo( $transport2_target_3 );
			$transport2_topclamp_3.moveTo( $transport2_target_1 );
			sys.waitFor( $transport2_topclamp_3 );
			
			$transport2_topclamp_1.time( 5.0 );
			$transport2_topclamp_2.hide();
			$transport2_pod_2.hide();
			$transport2_topclamp_2.time( 5.0 );
			$transport2_topclamp_3.show();
			$transport2_pod_3.show();
			$transport2_topclamp_3.time( 5.0 );
			$transport2_topclamp_1.moveTo( $transport2_target_3 );
			$transport2_topclamp_2.moveTo( $transport2_target_1 );
			$transport2_topclamp_3.moveTo( $transport2_target_2 );
			sys.waitFor( $transport2_topclamp_3 );
			
			$transport2_topclamp_1.hide();
			$transport2_pod_1.hide();
			$transport2_topclamp_1.time( 5.0 );
			$transport2_topclamp_2.show();
			$transport2_pod_2.show();
			$transport2_topclamp_2.time( 5.0 );
			$transport2_topclamp_3.time( 5.0 );
			$transport2_topclamp_1.moveTo( $transport2_target_1 );
			$transport2_topclamp_2.moveTo( $transport2_target_2 );
			$transport2_topclamp_3.moveTo( $transport2_target_3 );
			sys.waitFor( $transport2_topclamp_3 );
			
		}
	}
	
