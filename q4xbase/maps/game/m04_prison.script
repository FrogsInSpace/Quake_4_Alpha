	void transferRoomTransport()
	{
		while( !STRAUSSCINEMATIC )
		{
			$transfer_transport_pod1.show();
			$transfer_transport_1.show();
			
			$transfer_transport_1.time( 5 );
			$transfer_transport_1.decelTime( 1 );
			$transfer_transport_1.moveTo( $transfer_transport_target_2 );
	
			sys.waitFor( $transfer_transport_1 );
			
			$scan_arm_lower_1.time( 1 );
			$scan_arm_1.time( 1 );
			$scan_arm_lower_2.time( 1 );
			$scan_arm_2.time( 1 );
			$scan_arm_lower_1.rotateOnce( '0 0 40' );
			$scan_arm_1.moveTo( $scan_arm_1_up );
			$scan_arm_lower_2.rotateOnce( '0 0 -40' );
			$scan_arm_2.moveTo( $scan_arm_2_up );
			
			sys.waitFor( $scan_arm_1 );
			
			$scan_arm_1.bind( $scan_arm_lower_1 );
			$scan_arm_2.bind( $scan_arm_lower_2 );
			
			sys.wait( 0.1 );
			
			$scan_arm_lower_1.bind( $scan_arm_base_1 );
			$scan_arm_lower_2.bind( $scan_arm_base_2 );
			$func_mover_20.show();
			$func_mover_20.bind( $scan_arm_base_1 );
			
			sys.wait( 0.1 );
			
			$scan_arm_base_1.accelTime( 1.0 );
			$scan_arm_base_2.accelTime( 1.0 );
			$scan_arm_base_1.decelTime( 1.0 );
			$scan_arm_base_2.decelTime( 1.0 );
			$scan_arm_base_1.time( 5.0 );
			$scan_arm_base_2.time( 5.0 );
			$scan_arm_base_1.rotateOnce( '0 360 0' );
			$scan_arm_base_2.rotateOnce( '0 360 0' );
	
			sys.waitFor( $scan_arm_base_2 );
			
			$func_mover_20.hide();
			$scan_arm_lower_1.unbind();
			$scan_arm_lower_2.unbind();
			$scan_arm_1.unbind();
			$scan_arm_2.unbind();
			$func_mover_20.unbind();
			$scan_arm_lower_1.time( 1 );
			$scan_arm_1.time( 1 );
			$scan_arm_lower_2.time( 1 );
			$scan_arm_2.time( 1 );
			$scan_arm_lower_1.rotateOnce( '0 0 -40' );
			$scan_arm_1.moveTo( $scan_arm_1_down );
			$scan_arm_lower_2.rotateOnce( '0 0 40' );
			$scan_arm_2.moveTo( $scan_arm_2_down );
			
			sys.waitFor( $scan_arm_2 );
			
			$transfer_transport_1.time( 5 );
			$transfer_transport_1.accelTime( 1 );
			$transfer_transport_1.moveTo( $transfer_transport_target_3 );
			
			sys.waitFor( $transfer_transport_1 );
			
			$transfer_transport_pod1.hide();
			$transfer_transport_1.hide();
			setNewTimes($transfer_transport_1, .1, 0, 0);
			$transfer_transport_1.moveTo( $transfer_transport_target_1 );
			
			sys.waitFor( $transfer_transport_1 );
			
			if ( STRAUSSCINEMATIC )
					break;
		}
		
		sys.fadeOut( '0 0 0', 1);
		sys.wait( 1.0 );
		//STRAUSSCINEMATIC = true;
		$player1.hide();
		$player1.setOrigin( '2264 -1080 504' );
		sys.trigger( $camera_cine_strauss_2 );
		sys.wait( .1 );
		$cinematic_strauss_dekard.show();
		//aiScriptedAnimLoop( $strauss, "med_tube_float", 0 );
		sys.wait( .1 );
		aiScriptedMove( $cinematic_strauss_dekard, $deckard_cine_strauss_pos_1, 4, 0 );
		sys.fadeIn( '0 0 0', 1);
		sys.music( "m6_strauss_is_taken" );
		aiScriptedWait( $cinematic_strauss_dekard );
		aiScriptedFaceWait( $cinematic_strauss_dekard, $scan_arm_1, 0 );
		sys.wait( 2.0 );
		sys.fadeOut( '0 0 0', 1);
		sys.wait( 1.0 );
		sys.trigger( $camera_cine_strauss_1 );
		sys.wait( .1 );
		sys.fadeIn( '0 0 0', 1);
		sys.wait( 1.0 );
		sys.trigger( $strauss );
		$strauss_pod.bind( $transport_topclamp_2 );
		//$transport_topclamp_2.accelTime( 1 );
		$transport_topclamp_2.time( 5 );
		$transport_topclamp_2.decelTime( 1 );
		$transport_topclamp_2.move( EAST, 432 );
		sys.wait( 2.5 );
		$strauss.lookAt( $cinematic_strauss_dekard );
		aiScriptedAnimLoop( $cinematic_strauss_dekard, "pr_dekard_glass", 8 );
		sys.waitFor( $transport_topclamp_2 );
		$scan_arm_lower_1.time( 1 );
		$scan_arm_1.time( 1 );
		$scan_arm_lower_2.time( 1 );
		$scan_arm_2.time( 1 );
		$scan_arm_lower_1.rotateOnce( '0 0 40' );
		$scan_arm_1.moveTo( $scan_arm_1_up );
		$scan_arm_lower_2.rotateOnce( '0 0 -40' );
		$scan_arm_2.moveTo( $scan_arm_2_up );
		sys.waitFor( $scan_arm_1 );
		$scan_arm_1.bind( $scan_arm_lower_1 );
		$scan_arm_2.bind( $scan_arm_lower_2 );
		sys.wait( 0.1 );
		$scan_arm_lower_1.bind( $scan_arm_base_1 );
		$scan_arm_lower_2.bind( $scan_arm_base_2 );
		$func_mover_20.show();
		$func_mover_20.bind( $scan_arm_base_1 );
		sys.wait( 0.1 );
		$scan_arm_base_1.accelTime( 1.0 );
		$scan_arm_base_2.accelTime( 1.0 );
		$scan_arm_base_1.decelTime( 1.0 );
		$scan_arm_base_2.decelTime( 1.0 );
		$scan_arm_base_1.time( 5.0 );
		$scan_arm_base_2.time( 5.0 );
		$scan_arm_base_1.rotateOnce( '0 360 0' );
		$scan_arm_base_2.rotateOnce( '0 360 0' );
		sys.wait( 3.0 );
		$strauss.lookAt( $pod_grasper );
		sys.waitFor( $scan_arm_base_2 );
		aiScriptedAnimLoop( $cinematic_strauss_dekard, "relax_idle", 8 );
		$func_mover_20.hide();
		$scan_arm_lower_1.unbind();
		$scan_arm_lower_2.unbind();
		$scan_arm_1.unbind();
		$scan_arm_2.unbind();
		$func_mover_20.unbind();
		$scan_arm_lower_1.time( 1 );
		$scan_arm_1.time( 1 );
		$scan_arm_lower_2.time( 1 );
		$scan_arm_2.time( 1 );
		$scan_arm_lower_1.rotateOnce( '0 0 -40' );
		$scan_arm_1.moveTo( $scan_arm_1_down );
		$scan_arm_lower_2.rotateOnce( '0 0 40' );
		$scan_arm_2.moveTo( $scan_arm_2_down );
		sys.waitFor( $scan_arm_2 );
		$pod_grasper.time( 2 );
		$pod_grasper.accelTime( .7 );
		$pod_grasper.decelTime( .7 );
		$pod_grasper.moveTo( $pod_grasper_up );
		sys.waitFor( $pod_grasper );
		sys.wait( 0.1 );
		$strauss_pod.unbind();
		$strauss_pod.bind( $pod_grasper );
		sys.wait( 0.1 );
		$pod_grasper.time( 7 );
		$pod_grasper.accelTime( 1 );
		$pod_grasper.decelTime( 1 );
		$pod_grasper.moveTo( $pod_grasper_down );
		sys.wait( 1.0 );
		$strauss.lookAt( $cinematic_strauss_dekard );
		sys.wait( 5.0 );
		aiSpeakComlinkWait( $cinematic_strauss_dekard, "lipsync_dek_taktube" );
		radioChatterPlayWait ($prison1_radiochatter, "vo_tak_hangmom");
		//sys.wait( 1 );
		sys.trigger( $camera_cine_strauss_2 );
		sys.wait( .5 );
		aiSpeakComlinkWait( $cinematic_strauss_dekard, "lipsync_dek_rogthat" );
		sys.fadeOut( '0 0 0', 1);
		sys.wait( 1.0 );
		sys.trigger( $camera_cine_strauss_2 );
		$cinematic_strauss_dekard.hide();
		$player1.setOrigin( '-784 -256 144' );
		$player1.show();
		$makron_prison_monitor.remove();
		$transferRoomMakronMonitorOn.hide();
		STRAUSSCINEMATIC = false;
		thread straussCinematicOver();
		sys.fadeIn( '0 0 0', 1);
		sys.wait( 2.0 );
		
	}
	

	
