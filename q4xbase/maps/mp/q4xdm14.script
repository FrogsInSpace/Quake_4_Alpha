	$mover_gear_hook2.decelTime( 0 );
	$mover_gear_hook2.rotateOnce( '-3 0 0' );
	sys.waitFor( $mover_gear_hook2 );
	$mover_gear_hook2.time( 0.1 );
	$mover_gear_hook2.accelTime( 0 );
	$mover_gear_hook2.decelTime( 0 );
	$mover_gear_hook2.rotateOnce( '3 0 0' );
	sys.waitFor( $mover_gear_hook2 );
	$mover_gear_hook2.time( 0.1 );
	$mover_gear_hook2.accelTime( 0 );
	$mover_gear_hook2.decelTime( 0 );
	$mover_gear_hook2.rotateOnce( '-2 0 0' );
	sys.waitFor( $mover_gear_hook2 );
	$mover_gear_hook2.time( 0.1 );
	$mover_gear_hook2.accelTime( 0 );
	$mover_gear_hook2.decelTime( 0 );
	$mover_gear_hook2.rotateOnce( '2 0 0' );
	sys.waitFor( $mover_gear_hook2 );

	}
}

//*********************************************************************************
//** Double gears in window by water
//** 
//*********************************************************************************

void loop_windowgears()
{
	while( 1 ) {

	//speed up slowly, then stop abruptly
	$mover_windowgear_upper.time( 10 );
	$mover_windowgear_upper.accelTime( 7 );
	$mover_windowgear_upper.decelTime( 0 );
	$mover_windowgear_lower.time( 10 );
	$mover_windowgear_lower.accelTime( 7 );
	$mover_windowgear_lower.decelTime( 0 );
	$mover_windowgear_upper.rotateOnce( '2880 0 0' );
	$mover_windowgear_lower.rotateOnce( '-2880 0 0' );
	sys.waitFor( $mover_windowgear_upper );

	//rattle them a bit
	$mover_windowgear_upper.time( 0.1 );
	$mover_windowgear_upper.accelTime( 0 );
	$mover_windowgear_upper.decelTime( 0 );
	$mover_windowgear_lower.time( 0.1 );
	$mover_windowgear_lower.accelTime( 0 );
	$mover_windowgear_lower.decelTime( 0 );
	$mover_windowgear_upper.rotateOnce( '-2 0 0' );
	$mover_windowgear_lower.rotateOnce( '2 0 0' );
	sys.waitFor( $mover_windowgear_upper );
	$mover_windowgear_upper.time( 0.1 );
	$mover_windowgear_upper.accelTime( 0 );
	$mover_windowgear_upper.decelTime( 0 );
	$mover_windowgear_lower.time( 0.1 );
	$mover_windowgear_lower.accelTime( 0 );
	$mover_windowgear_lower.decelTime( 0 );
	$mover_windowgear_upper.rotateOnce( '3 0 0' );
	$mover_windowgear_lower.rotateOnce( '-3 0 0' );
	sys.waitFor( $mover_windowgear_upper );
	$mover_windowgear_upper.time( 0.1 );
	$mover_windowgear_upper.accelTime( 0 );
	$mover_windowgear_upper.decelTime( 0 );
	$mover_windowgear_lower.time( 0.1 );
	$mover_windowgear_lower.accelTime( 0 );
	$mover_windowgear_lower.decelTime( 0 );
	$mover_windowgear_upper.rotateOnce( '-1 0 0' );
	$mover_windowgear_lower.rotateOnce( '1 0 0' );
	sys.waitFor( $mover_windowgear_upper );

	sys.wait( 2 );

	//speed up moderately, run for a bit, then slow back down, going backwards this time
	$mover_windowgear_upper.time( 10 );
	$mover_windowgear_upper.accelTime( 2 );
	$mover_windowgear_upper.decelTime( 2 );
	$mover_windowgear_lower.time( 10 );
	$mover_windowgear_lower.accelTime( 2 );
	$mover_windowgear_lower.decelTime( 2 );
	$mover_windowgear_upper.rotateOnce( '-2160 0 0' );
	$mover_windowgear_lower.rotateOnce( '2160 0 0' );
	sys.waitFor( $mover_windowgear_upper );

	sys.wait( 1.5 );

	//act as though they're resetting or something clever
	$mover_windowgear_upper.time( 3 );
	$mover_windowgear_upper.accelTime( 1 );
	$mover_windowgear_upper.decelTime( 1 );
	$mover_windowgear_lower.time( 3 );
	$mover_windowgear_lower.accelTime( 1 );
	$mover_windowgear_lower.decelTime( 1 );
	$mover_windowgear_upper.rotateOnce( '720 0 0' );
	$mover_windowgear_lower.rotateOnce( '-720 0 0' );
	sys.waitFor( $mover_windowgear_upper );

	sys.wait( 0.1 );

	//one final movement so the first is in the opposite direction
	$mover_windowgear_upper.time( 5 );
	$mover_windowgear_upper.accelTime( 0.5 );
	$mover_windowgear_upper.decelTime( 3 );
	$mover_windowgear_lower.time( 5 );
	$mover_windowgear_lower.accelTime( 0.5 );
	$mover_windowgear_lower.decelTime( 3 );
	$mover_windowgear_upper.rotateOnce( '-360 0 0' );
	$mover_windowgear_lower.rotateOnce( '360 0 0' );
	sys.waitFor( $mover_windowgear_upper );

	sys.wait( 5 );
	}
}

//*********************************************************************************
//** Bars to high platform teleporter
//** 
//*********************************************************************************

void open_hightele_bars()
{
	//move button in
	$mover_hightele_button.time( 0.5 );
	$mover_hightele_button.accelTime( 0.15 );
	$mover_hightele_button.decelTime( 0.15 );
	$mover_hightele_button.move( SOUTH, 3 );
	sys.waitFor( $mover_hightele_button );


	//Gears and shafts
	$mover_gategear_s.time( 2 );
	$mover_gategear_s.accelTime( 0.25 );
	$mover_gategear_s.decelTime( 0.25 );
	$mover_gategear_s3.time( 2 );
	$mover_gategear_s3.accelTime( 0.25 );
	$mover_gategear_s3.decelTime( 0.25 );
	$mover_gategear_s.rotateOnce( '0 0 435' );
	$mover_gategear_s3.rotateOnce( '0 435 0' );

	$mover_gategear_n.time( 2 );
	$mover_gategear_n.accelTime( 0.25 );
	$mover_gategear_n.decelTime( 0.25 );
	$mover_gategear_n3.time( 2 );
	$mover_gategear_n3.accelTime( 0.25 );
	$mover_gategear_n3.decelTime( 0.25 );
	$mover_gategear_n.rotateOnce( '0 0 -435' );
	$mover_gategear_n3.rotateOnce( '0 -435 0' );

	//Gate
	$mover_hightele_bars.time( 2 );
	$mover_hightele_bars.accelTime( 0.25 );
	$mover_hightele_bars.decelTime( 0.25 );
	$mover_hightele_bars.move( UP, 76 );
	sys.waitFor( $mover_hightele_bars );

	sys.wait( 4.0 );

	//Gears and shafts
	$mover_gategear_s.time( 2 );
	$mover_gategear_s.accelTime( 0.25 );
	$mover_gategear_s.decelTime( 0.25 );
	$mover_gategear_s3.time( 2 );
	$mover_gategear_s3.accelTime( 0.25 );
	$mover_gategear_s3.decelTime( 0.25 );
	$mover_gategear_s.rotateOnce( '0 0 -435' );
	$mover_gategear_s3.rotateOnce( '0 -435 0' );

	$mover_gategear_n.time( 2 );
	$mover_gategear_n.accelTime( 0.25 );
	$mover_gategear_n.decelTime( 0.25 );
	$mover_gategear_n3.time( 2 );
	$mover_gategear_n3.accelTime( 0.25 );
	$mover_gategear_n3.decelTime( 0.25 );
	$mover_gategear_n.rotateOnce( '0 0 435' );
	$mover_gategear_n3.rotateOnce( '0 435 0' );

	//Gate
	$mover_hightele_bars.time( 2 );
	$mover_hightele_bars.accelTime( 0.25 );
	$mover_hightele_bars.decelTime( 0.25 );
	$mover_hightele_bars.move( DOWN, 76 );
	sys.waitFor( $mover_hightele_bars );


	//move button out
	$mover_hightele_button.time( 0.5 );
	$mover_hightele_button.accelTime( 0.15 );
	$mover_hightele_button.decelTime( 0.15 );
	$mover_hightele_button.move( NORTH, 3 );
	sys.waitFor( $mover_hightele_button );
}
