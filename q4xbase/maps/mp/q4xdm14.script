void extend_redarmor_plat()
{
	//move button in
	$mover_redarmor_button.time( 0.5 );
	$mover_redarmor_button.accelTime( 0.15 );
	$mover_redarmor_button.decelTime( 0.15 );
	$mover_redarmor_button.move( SOUTH, 3 );
	sys.waitFor( $mover_redarmor_button );

	//extend it
	$mover_redarmor_plat.time( 3 );
	$mover_redarmor_plat.accelTime( 0.2 );
	$mover_redarmor_plat.decelTime( 0.2 );
	$mover_redarmor_plat.move( NORTH, 200 );


	//Gears and shafts
	$mover_smgear_left.time( 3 );
	$mover_smgear_left.accelTime( 0.2 );
	$mover_smgear_left.decelTime( 0.2 );
	$mover_smgear_left.rotateOnce( '0 1145 0' );
	$mover_smgearshaft_left.time( 3 );
	$mover_smgearshaft_left.accelTime( 0.2 );
	$mover_smgearshaft_left.decelTime( 0.2 );
	$mover_smgearshaft_left.rotateOnce( '0 1145 0' );
	$mover_smgearshaft_h_left.time( 3 );
	$mover_smgearshaft_h_left.accelTime( 0.2 );
	$mover_smgearshaft_h_left.decelTime( 0.2 );
	$mover_smgearshaft_h_left.rotateOnce( '1145 0 0' );

	$mover_smgear_right.time( 3 );
	$mover_smgear_right.accelTime( 0.2 );
	$mover_smgear_right.decelTime( 0.2 );
	$mover_smgear_right.rotateOnce( '0 -1145 0' );
	$mover_smgearshaft_right.time( 3 );
	$mover_smgearshaft_right.accelTime( 0.2 );
	$mover_smgearshaft_right.decelTime( 0.2 );
	$mover_smgearshaft_right.rotateOnce( '0 -1145 0' );
	$mover_smgearshaft_h_right.time( 3 );
	$mover_smgearshaft_h_right.accelTime( 0.2 );
	$mover_smgearshaft_h_right.decelTime( 0.2 );
	$mover_smgearshaft_h_right.rotateOnce( '-1145 0 0' );


	sys.waitFor( $mover_redarmor_plat );	
	redarmorplatform = 1;

	//move button back out
	$mover_redarmor_button.time( 0.5 );
	$mover_redarmor_button.accelTime( 0.15 );
	$mover_redarmor_button.decelTime( 0.15 );
	$mover_redarmor_button.move( NORTH, 3 );
	sys.waitFor( $mover_redarmor_button );
}

void retract_redarmor_plat()
{
	//move button in
	$mover_redarmor_button.time( 0.5 );
	$mover_redarmor_button.accelTime( 0.15 );
	$mover_redarmor_button.decelTime( 0.15 );
	$mover_redarmor_button.move( SOUTH, 3 );
