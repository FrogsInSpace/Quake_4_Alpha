//*********************************************************************************
//** Cache in sounds
//** 
//*********************************************************************************
void cache_sounds()
{
	sys.cacheSoundShader ("machine_armswing_01");
	sys.cacheSoundShader ("lavatrap2start");
	sys.cacheSoundShader ("lavatrap2gear");
	sys.cacheSoundShader ("lavatrap2stop");
	sys.cacheSoundShader ("windowgear_small1");
	sys.cacheSoundShader ("giant_lava_pit");
	sys.cacheSoundShader ("lavaloop_muted");
	sys.cacheSoundShader ("lavaloop_01L");
	sys.cacheSoundShader ("machine_grind_02");
	sys.cacheSoundShader ("machine_teleport_01");
}

//*********************************************************************************

//*********************************************************************************
//** Lava buckets
//** 
//*********************************************************************************

void cycle_lavabucket_doors()
{
	//open
	$org_lavabucketdoor_s.time( 1.0 );
	$org_lavabucketdoor_s.accelTime( 0.2 );
	$org_lavabucketdoor_s.decelTime( 0.2 );
	$org_lavabucketdoor_s.rotateOnce( '0 0 90' );
	$org_lavabucketdoor_n.time( 1.0 );
	$org_lavabucketdoor_n.accelTime( 0.2 );
	$org_lavabucketdoor_n.decelTime( 0.2 );
	$org_lavabucketdoor_n.rotateOnce( '0 0 -90' );

	sys.waitFor( $org_lavabucketdoor_s );

	sys.wait( 3.25 );

	//close
	$org_lavabucketdoor_s.time( 1.0 );
	$org_lavabucketdoor_s.accelTime( 0.2 );
	$org_lavabucketdoor_s.decelTime( 0 );
	$org_lavabucketdoor_s.rotateOnce( '0 0 -90' );
	$org_lavabucketdoor_n.time( 1.0 );
	$org_lavabucketdoor_n.accelTime( 0.2 );
	$org_lavabucketdoor_n.decelTime( 0 );
	$org_lavabucketdoor_n.rotateOnce( '0 0 90' );

	sys.waitFor( $org_lavabucketdoor_s );
}

void cycle_lavabucket_door_vert()
{
	//open
	$mover_lavabucketdoor_v.time( 0.35 );
	$mover_lavabucketdoor_v.accelTime( 0.2 );
	$mover_lavabucketdoor_v.move( DOWN, 78 );
	sys.waitFor( $mover_lavabucketdoor_v );

	sys.wait( 0.75 );

	//close
	$mover_lavabucketdoor_v.time( 0.35 );
	$mover_lavabucketdoor_v.accelTime( 0.2 );
	$mover_lavabucketdoor_v.move( UP, 78 );
	sys.waitFor( $mover_lavabucketdoor_v );
}

void loopbucket1()
{
	while( 1 ) {

	$org_bucket1.time( 0.1 );
	$org_bucket1.moveTo( $bucket_pos1 );
	sys.waitFor( $org_bucket1 );

	$org_bucket1.time( 2 );
	$org_bucket1.moveTo( $bucket_pos1b );
	sys.waitFor( $org_bucket1 );

	thread cycle_lavabucket_doors();

	sys.wait( 0.75 );

	$org_bucket1.time( 2 );
	$org_bucket1.moveTo( $bucket_pos2 );
	sys.waitFor( $org_bucket1 );

	$org_bucket1.time( 0.2 );
	$org_bucket1.moveTo( $bucket_pos3 );
	sys.waitFor( $org_bucket1 );

	$org_bucket1.time( 0.2 );
	$org_bucket1.moveTo( $bucket_pos4 );
	sys.waitFor( $org_bucket1 );

	$org_bucket1.time( 0.2 );
	$org_bucket1.moveTo( $bucket_pos4 );
	sys.waitFor( $org_bucket1 );

	$org_bucket1.time( 0.2 );
	$org_bucket1.moveTo( $bucket_pos5 );
	sys.waitFor( $org_bucket1 );

	$org_bucket1.time( 0.2 );
	$org_bucket1.moveTo( $bucket_pos6 );
	sys.waitFor( $org_bucket1 );

	$org_bucket1.time( 1 );
	$org_bucket1.moveTo( $bucket_pos7 );
	$org_bucket1.rotateOnce( '-15 0 0' );
	sys.waitFor( $org_bucket1 );

	$org_bucket1.time( 1.5 );
	$org_bucket1.moveTo( $bucket_pos8 );
	$org_bucket1.rotateOnce( '15 0 0' );
	sys.waitFor( $org_bucket1 );

	thread cycle_lavabucket_door_vert();

	$org_bucket1.time( 2 );
	$org_bucket1.moveTo( $bucket_pos9 );
	sys.waitFor( $org_bucket1 );

	$org_bucket1.time( 2 );
	$org_bucket1.moveTo( $bucket_pos10 );
	sys.waitFor( $org_bucket1 );

	}
}

void loopbucket2()
{
	while( 1 ) {

	$org_bucket2.time( 0.1 );
