void loop_lavabuckets()
{
	thread loopbucket1();
	sys.wait( 6 );
	thread loopbucket2();
}

//*********************************************************************************
//** Clockwork gears
//** 
//*********************************************************************************

void loop_clockwork1()
{
	while( 1 ) {

	sys.wait( 2.25 );

	$org_hook1.time( 0.1 );
	$org_hook1.rotateOnce( '0 0 12' );
	sys.waitFor( $org_hook1 );

	$mover_gear_hook1.time( 5 );
	$mover_gear_hook1.accelTime( 1 );
	$mover_gear_hook1.decelTime( 0 );
	$mover_gear_hook1.rotateOnce( '1440 0 0' );
	sys.waitFor( $mover_gear_hook1 );

	$org_hook1.time( 0.01 );
	$org_hook1.rotateOnce( '0 0 -12' );
	sys.waitFor( $org_hook1 );

	$mover_gear_hook1.time( 0.1 );
	$mover_gear_hook1.accelTime( 0 );
	$mover_gear_hook1.decelTime( 0 );
	$mover_gear_hook1.rotateOnce( '-2 0 0' );
	sys.waitFor( $mover_gear_hook1 );
	$mover_gear_hook1.time( 0.1 );
	$mover_gear_hook1.accelTime( 0 );
	$mover_gear_hook1.decelTime( 0 );
	$mover_gear_hook1.rotateOnce( '2 0 0' );
	sys.waitFor( $mover_gear_hook1 );

	}
}

