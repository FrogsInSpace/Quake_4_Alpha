	$org_bucket2.moveTo( $bucket_pos3 );
	sys.waitFor( $org_bucket2 );

	$org_bucket2.time( 0.2 );
	$org_bucket2.moveTo( $bucket_pos4 );
	sys.waitFor( $org_bucket2 );

	$org_bucket2.time( 0.2 );
	$org_bucket2.moveTo( $bucket_pos4 );
	sys.waitFor( $org_bucket2 );

	$org_bucket2.time( 0.2 );
	$org_bucket2.moveTo( $bucket_pos5 );
	sys.waitFor( $org_bucket2 );

	$org_bucket2.time( 0.2 );
	$org_bucket2.moveTo( $bucket_pos6 );
	sys.waitFor( $org_bucket2 );

	$org_bucket2.time( 1 );
	$org_bucket2.moveTo( $bucket_pos7 );
	$org_bucket2.rotateOnce( '-15 0 0' );
	sys.waitFor( $org_bucket2 );

	$org_bucket2.time( 1.5 );
	$org_bucket2.moveTo( $bucket_pos8 );
	$org_bucket2.rotateOnce( '15 0 0' );
	sys.waitFor( $org_bucket2 );

	thread cycle_lavabucket_door_vert();

	$org_bucket2.time( 2 );
	$org_bucket2.moveTo( $bucket_pos9 );
