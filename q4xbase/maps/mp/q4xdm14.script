//*********************************************************************************

//*********************************************************************************
//** Lava trap #1
//** This is the two-piece moving floor near the red armor room
//*********************************************************************************

void retract_lavatrap_1()
{
	//turn on light
	$lavatrap1_light.On();

	//show heat
	$lavatrap1_heat.show();

	//open trap to reveal lava
	$mover_lavatrap_1n.time( 1 );
	$mover_lavatrap_1n.accelTime( 0.1 );
	$mover_lavatrap_1n.decelTime( 0.1 );
	$mover_lavatrap_1s.time( 1 );
	$mover_lavatrap_1s.accelTime( 0.1 );
	$mover_lavatrap_1s.decelTime( 0.1 );

	$mover_lavatrap_1n.move( NORTH, 136 );
	$mover_lavatrap_1s.move( SOUTH, 136 );

	$tn_lavatrap1_snd.startSoundShader ("windowgear_small1", SND_CHANNEL_ANY );
	sys.waitFor( $mover_lavatrap_1s );

	//turn off lavatrap1 overhead lights
	$lavatrap1_overhead1.fadeOutLight( 0.1 );
	$lavatrap1_overhead2.fadeOutLight( 0.1 );
	$lavatrap1_overhead3.fadeOutLight( 0.1 );
	$lavatrap1_overhead4.fadeOutLight( 0.1 );
	$lavatrap1_overhead5.fadeOutLight( 0.1 );


}

void lavatrap_1_button()
{
	//move button in
	$mover_lavatrap_1_button.time( 0.5 );
	$mover_lavatrap_1_button.accelTime( 0.15 );
	$mover_lavatrap_1_button.decelTime( 0.15 );
	$mover_lavatrap_1_button.move( SOUTH, 3 );
	sys.waitFor( $mover_lavatrap_1_button );

	//fade in overhead lights
	$lavatrap1_overhead1.fadeInLight( 0.5 );
	$lavatrap1_overhead2.fadeInLight( 0.5 );
	$lavatrap1_overhead3.fadeInLight( 0.5 );
	$lavatrap1_overhead4.fadeInLight( 0.5 );
	$lavatrap1_overhead5.fadeInLight( 0.5 );

	//open the light covers
	$mover_lavatrap_lightcover_n.time( 0.5 );
	$mover_lavatrap_lightcover_s.time( 0.5 );
	$mover_lavatrap_lightcover_n.move( NORTH, 63 );
	$mover_lavatrap_lightcover_s.move( SOUTH, 63 );

	//close trap over lava
	//Floor pieces
	$mover_lavatrap_1n.time( 1 );
	$mover_lavatrap_1n.accelTime( 0.1 );
	$mover_lavatrap_1n.decelTime( 0.1 );
	$mover_lavatrap_1s.time( 1 );
	$mover_lavatrap_1s.accelTime( 0.1 );
	$mover_lavatrap_1s.decelTime( 0.1 );

	$mover_lavatrap_1n.move( SOUTH, 144 );
	$mover_lavatrap_1s.move( NORTH, 144 );

	//Gears
	$mover_gear2_cw.time( 1 );
	$mover_gear2_ccw.time( 1 );
	$mover_gear2_cw2.time( 1 );
	$mover_gear2_ccw2.time( 1 );
	$mover_gear2_cw.rotateOnce( '135 0 0' );
	$mover_gear2_ccw.rotateOnce( '-135 0 0' );
	$mover_gear2_cw2.rotateOnce( '-135 0 0' );
	$mover_gear2_ccw2.rotateOnce( '135 0 0' );

	$tn_lavatrap1_snd.startSoundShader ("windowgear_small1", SND_CHANNEL_ANY );
	sys.waitFor( $mover_lavatrap_1s );

	//hide heat
	$lavatrap1_heat.hide();

	//turn off light
	$lavatrap1_light.Off();
	
	sys.wait( 2 );

	//show heat
	$lavatrap1_heat.show();

	//turn on light
	$lavatrap1_light.On();

	//fade out overhead lights
	$lavatrap1_overhead1.fadeOutLight( 0.5 );
	$lavatrap1_overhead2.fadeOutLight( 0.5 );
	$lavatrap1_overhead3.fadeOutLight( 0.5 );
	$lavatrap1_overhead4.fadeOutLight( 0.5 );
	$lavatrap1_overhead5.fadeOutLight( 0.5 );

	//close the light covers
	$mover_lavatrap_lightcover_n.time( 0.5 );
	$mover_lavatrap_lightcover_s.time( 0.5 );
	$mover_lavatrap_lightcover_n.move( SOUTH, 63 );
	$mover_lavatrap_lightcover_s.move( NORTH, 63 );

	//open trap to reveal lava
	//Floor pieces
	$mover_lavatrap_1n.time( 1 );
	$mover_lavatrap_1n.accelTime( 0.1 );
	$mover_lavatrap_1n.decelTime( 0.1 );
	$mover_lavatrap_1s.time( 1 );
	$mover_lavatrap_1s.accelTime( 0.1 );
	$mover_lavatrap_1s.decelTime( 0.1 );

	$mover_lavatrap_1n.move( NORTH, 144 );
	$mover_lavatrap_1s.move( SOUTH, 144 );

	//Gears
	$mover_gear2_cw.time( 1 );
	$mover_gear2_ccw.time( 1 );
	$mover_gear2_cw2.time( 1 );
	$mover_gear2_ccw2.time( 1 );
	$mover_gear2_cw.rotateOnce( '-135 0 0' );
	$mover_gear2_ccw.rotateOnce( '135 0 0' );
	$mover_gear2_cw2.rotateOnce( '135 0 0' );
	$mover_gear2_ccw2.rotateOnce( '-135 0 0' );

	$tn_lavatrap1_snd.startSoundShader ("windowgear_small1", SND_CHANNEL_ANY );
	sys.waitFor( $mover_lavatrap_1s );

	//move button out
	$mover_lavatrap_1_button.time( 0.5 );
	$mover_lavatrap_1_button.accelTime( 0.15 );
	$mover_lavatrap_1_button.decelTime( 0.15 );
	$mover_lavatrap_1_button.move( NORTH, 3 );
	sys.waitFor( $mover_lavatrap_1_button );

}
