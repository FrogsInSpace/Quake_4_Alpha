	$mover_lavatrap_2w.time( 1 );
	$mover_lavatrap_2w.accelTime( 0.1 );
	$mover_lavatrap_2w.decelTime( 0.1 );
	$mover_lavatrap_2e.time( 1 );
	$mover_lavatrap_2e.accelTime( 0.1 );
	$mover_lavatrap_2e.decelTime( 0.1 );

	$mover_lavatrap_2w.move( WEST, 64 );
	$mover_lavatrap_2e.move( EAST, 64 );

	//Gears
	$mover_gear_cw.time( 1 );
	$mover_gear_ccw.time( 1 );
	$mover_gear_cw2.time( 1 );
	$mover_gear_ccw2.time( 1 );
	$mover_gear_cw.rotateOnce( '-135 0 0' );
	$mover_gear_ccw.rotateOnce( '135 0 0' );
	$mover_gear_cw2.rotateOnce( '135 0 0' );
	$mover_gear_ccw2.rotateOnce( '-135 0 0' );

	$tn_lavatrap2snd.startSoundShader ("windowgear_small1", SND_CHANNEL_ANY );
	sys.waitFor( $mover_lavatrap_2e );

	sys.wait( 1 );

	}
}
