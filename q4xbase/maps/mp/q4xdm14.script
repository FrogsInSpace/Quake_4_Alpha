//*********************************************************************************
//** Big moving floor over main lava pit
//** 
//*********************************************************************************

void bigpit_light_control()
{
	//turn on the lava lamp
	$bigpit_light.fadeInLight( 3 );

	//wait for floor to start closing
	sys.wait( 14 );

	//turn off the lava lamp
	$bigpit_light.fadeOutLight( 3 );
}

void open_bigpit()
{
	//mark the floor as being opened / fully open so no one can abuse the buttons
	bigpitfloor = 1;

	$bigpit_heat.show();

	//move buttons in
	$mover_bigpit_button2.time( 0.5 );
	$mover_bigpit_button2.accelTime( 0.15 );
	$mover_bigpit_button2.decelTime( 0.15 );
	$mover_bigpit_button2.move( NORTH, 3 );
	$mover_bigpit_button.time( 0.5 );
	$mover_bigpit_button.accelTime( 0.15 );
	$mover_bigpit_button.decelTime( 0.15 );
	$mover_bigpit_button.move( NORTH, 3 );
	sys.waitFor( $mover_bigpit_button );

	thread bigpit_light_control();

	//open
	$mover_biglava_w.time( 6.5 );
	$mover_biglava_w.accelTime( 0.2 );
	$mover_biglava_w.decelTime( 0.2 );
	$mover_biglava_w.move( WEST, 282 );

	$mover_biglava_e.time( 6.5 );
	$mover_biglava_e.accelTime( 0.2 );
	$mover_biglava_e.decelTime( 0.2 );
	$mover_biglava_e.move( EAST, 250 );

	$mover_biglava_w2.time( 6.5 );
	$mover_biglava_w2.accelTime( 0.2 );
	$mover_biglava_w2.decelTime( 0.2 );
	$mover_biglava_w2.move( WEST, 58 );

	$mover_biglava_e2.time( 6.5 );
	$mover_biglava_e2.accelTime( 0.2 );
	$mover_biglava_e2.decelTime( 0.2 );
	$mover_biglava_e2.move( EAST, 58 );


	//gears
	$mover_bigfloor_upper_r.time( 6.5 );
	$mover_bigfloor_upper_r.accelTime( 0.2 );
	$mover_bigfloor_upper_r.decelTime( 0.2 );
	$mover_bigfloor_upper_r.rotateOnce( '320 0 0' );
	$mover_bigfloor_lower_r.time( 6.5 );
	$mover_bigfloor_lower_r.accelTime( 0.2 );
	$mover_bigfloor_lower_r.decelTime( 0.2 );
	$mover_bigfloor_lower_r.rotateOnce( '-320 0 0' );

	$mover_bigfloor_upper_l.time( 6.5 );
	$mover_bigfloor_upper_l.accelTime( 0.2 );
	$mover_bigfloor_upper_l.decelTime( 0.2 );
	$mover_bigfloor_upper_l.rotateOnce( '-320 0 0' );
	$mover_bigfloor_lower_l.time( 6.5 );
	$mover_bigfloor_lower_l.accelTime( 0.2 );
	$mover_bigfloor_lower_l.decelTime( 0.2 );
	$mover_bigfloor_lower_l.rotateOnce( '320 0 0' );

	$tn_bigpitsnd.startSoundShader ("giant_lava_pit", SND_CHANNEL_ANY );
	$tn_bigpitlavasnd.stopSound ( SND_CHANNEL_ANY, false );
	$tn_bigpitlavasnd.startSoundShader ("lavaloop_01L", SND_CHANNEL_ANY );
	sys.waitFor( $mover_biglava_e2 );
	sys.wait( 3 );

	//close
	$mover_biglava_w.time( 6.5 );
	$mover_biglava_w.accelTime( 0.2 );
	$mover_biglava_w.decelTime( 0.2 );
	$mover_biglava_w.move( EAST, 282 );

	$mover_biglava_e.time( 6.5 );
	$mover_biglava_e.accelTime( 0.2 );
	$mover_biglava_e.decelTime( 0.2 );
	$mover_biglava_e.move( WEST, 250 );

	$mover_biglava_w2.time( 6.5 );
	$mover_biglava_w2.accelTime( 0.2 );
	$mover_biglava_w2.decelTime( 0.2 );
	$mover_biglava_w2.move( EAST, 58 );

	$mover_biglava_e2.time( 6.5 );
	$mover_biglava_e2.accelTime( 0.2 );
	$mover_biglava_e2.decelTime( 0.2 );
	$mover_biglava_e2.move( WEST, 58 );


	//gears
	$mover_bigfloor_upper_r.time( 6.5 );
	$mover_bigfloor_upper_r.accelTime( 0.2 );
	$mover_bigfloor_upper_r.decelTime( 0.2 );
	$mover_bigfloor_upper_r.rotateOnce( '-320 0 0' );
	$mover_bigfloor_lower_r.time( 6.5 );
	$mover_bigfloor_lower_r.accelTime( 0.2 );
	$mover_bigfloor_lower_r.decelTime( 0.2 );
	$mover_bigfloor_lower_r.rotateOnce( '320 0 0' );

	$mover_bigfloor_upper_l.time( 6.5 );
	$mover_bigfloor_upper_l.accelTime( 0.2 );
	$mover_bigfloor_upper_l.decelTime( 0.2 );
	$mover_bigfloor_upper_l.rotateOnce( '320 0 0' );
	$mover_bigfloor_lower_l.time( 6.5 );
	$mover_bigfloor_lower_l.accelTime( 0.2 );
	$mover_bigfloor_lower_l.decelTime( 0.2 );
	$mover_bigfloor_lower_l.rotateOnce( '-320 0 0' );

	$tn_bigpitsnd.startSoundShader ("giant_lava_pit", SND_CHANNEL_ANY );
	$tn_bigpitlavasnd.stopSound ( SND_CHANNEL_ANY, false );
	$tn_bigpitlavasnd.startSoundShader ("lavaloop_muted", SND_CHANNEL_ANY );
	sys.waitFor( $mover_biglava_e2 );

	//move buttons back out
	$mover_bigpit_button2.time( 0.5 );
	$mover_bigpit_button2.accelTime( 0.15 );
	$mover_bigpit_button2.decelTime( 0.15 );
	$mover_bigpit_button2.move( SOUTH, 3 );
	$mover_bigpit_button.time( 0.5 );
	$mover_bigpit_button.accelTime( 0.15 );
	$mover_bigpit_button.decelTime( 0.15 );
	$mover_bigpit_button.move( SOUTH, 3 );
	sys.waitFor( $mover_bigpit_button );

	$bigpit_heat.hide();
	bigpitfloor = 0;
}

void biglavapit_button()
{
	if( bigpitfloor == 0 ) {
		open_bigpit();
	}
}
//*********************************************************************************

//*********************************************************************************
//** Moving platform high above big lava pit
//** 
//*********************************************************************************

void loop_arm()
{
	while( 1 ) {

	sys.wait( 1 );

	//Go east!

	//arm arc movement
	$mover_swingarm_origin.time( 3 );
	$mover_swingarm_origin.accelTime( 0.5 );
	$mover_swingarm_origin.decelTime( 0.5 );
	$mover_swingarm_origin.rotateOnce( '0 76 0' );

	//platform rotation
	$mover_high_w.time( 3 );
	$mover_high_w.accelTime( 0.5 );
	$mover_high_w.decelTime( 0.5 );
	$mover_high_w.rotateOnce( '0 -76 0' );

	//gear
	$mover_swingarm_gear.time( 3 );
	$mover_swingarm_gear.accelTime( 0.5 );
	$mover_swingarm_gear.decelTime( 0.5 );
	$mover_swingarm_gear.rotateOnce( '90 0 0' );

	$mover_swingarm_origin.startSoundShader ("machine_armswing_01", SND_CHANNEL_ANY );
	sys.waitFor( $mover_swingarm_origin );

	sys.wait( 1 );

	//Go west!

	//arm arc movement
	$mover_swingarm_origin.time( 3 );
	$mover_swingarm_origin.accelTime( 0.5 );
	$mover_swingarm_origin.decelTime( 0.5 );
	$mover_swingarm_origin.rotateOnce( '0 -76 0' );

	$mover_high_w.time( 3 );
	$mover_high_w.accelTime( 0.5 );
	$mover_high_w.decelTime( 0.5 );
	$mover_high_w.rotateOnce( '0 76 0' );

	//gear
	$mover_swingarm_gear.time( 3 );
	$mover_swingarm_gear.accelTime( 0.5 );
	$mover_swingarm_gear.decelTime( 0.5 );
	$mover_swingarm_gear.rotateOnce( '-90 0 0' );

	$mover_swingarm_origin.startSoundShader ("machine_armswing_01", SND_CHANNEL_ANY );
	sys.waitFor( $mover_swingarm_origin );

	}
}

void setup_swingarm()
{
	//bind all the arm parts together
	$mover_swingarm_telescope_end.bind( $mover_swingarm_telescope_mid );
	$mover_swingarm_telescope_mid.bind( $mover_swingarm );
	$mover_swingarm.bind( $mover_swingarm_origin );
	$mover_swingarm_gear.bind( $mover_swingarm_origin );
	$org_armplat.bind( $mover_swingarm_origin );
	$mover_swingarm_gear_shaft.bind( $mover_swingarm_gear );

	//move the entire arm into start position (West)
	$mover_swingarm_origin.time( 0.1 );
	$mover_swingarm_origin.rotateOnce( '0 -38 0' );
	sys.waitFor( $mover_swingarm_origin );

	//bind the platform to the arm
	$mover_high_w.bind( $org_armplat );

	loop_arm();
}
//*********************************************************************************

//*********************************************************************************
//** Setup initial states
//** Bind all origins and movers and whatnot
//*********************************************************************************

void setup_initial_states()
{
	//retract the red armor platform
	thread retract_redarmor_plat();

	//put lavatrap 1 in initial open position
	thread retract_lavatrap_1();

	//turn off the big lava pit light for performance
	$bigpit_light.fadeOutLight( 0.1 );

	//hide the bigpit heat VP
	$bigpit_heat.hide();

	//bind clockwork hooks to origins
	$mover_hook1.bind( $org_hook1 );
	$mover_hook2.bind( $org_hook2 );

	//bind all of the gate gear bits
	$mover_gategear_s2.bind( $mover_gategear_s );
	$mover_gategearshaft_s.bind( $mover_gategear_s );
	$mover_gategearshaft_s2.bind( $mover_gategear_s3 );
	$mover_gategear_n2.bind( $mover_gategear_n );
	$mover_gategearshaft_n.bind( $mover_gategear_n );
	$mover_gategearshaft_n2.bind( $mover_gategear_n3 );

	//bind the lava bucket lights to their buckets
	$bucket1_light.bind( $mover_bucket1 );
	$bucket2_light.bind( $mover_bucket2 );
	//bind the lava buckets to their origins
	$mover_bucket1.bind( $org_bucket1 );
	$mover_bucket2.bind( $org_bucket2 );
	//bind the horizontal doors to their origins
	$mover_lavabucketdoor_s.bind( $org_lavabucketdoor_s );
	$mover_lavabucketdoor_n.bind( $org_lavabucketdoor_n );

	//turn on the big lava pit ambient lava sound
	$tn_bigpitlavasnd.startSoundShader ("lavaloop_muted", SND_CHANNEL_ANY );

}
//*********************************************************************************

//*********************************************************************************
//** Startup Sounds
//** These are entities that don't have specific functions, i.e. func_rotating
//*********************************************************************************

void startup_sounds()
{
	//nothing here yet ...

}

//*********************************************************************************

void main()
{
	float moverthread;

	sys.wait( 0.1 );
	thread cache_sounds();

	sys.wait( 0.1 );
	thread setup_initial_states();

	sys.wait( 0.1 );
	thread startup_sounds();

	//hold here to make sure everything is done being setup
	moverthread = thread setup_initial_states();
	sys.waitForThread ( moverthread );

	sys.wait( 0.1 );
	thread loop_lavatrap_2();

	sys.wait( 0.1 );
	thread setup_swingarm();

	sys.wait( 0.1 );
	thread loop_windowgears();

	sys.wait( 0.1 );
	thread loop_clockwork1();
	thread loop_clockwork2();

	sys.wait( 0.1 );
	thread loop_lavabuckets();
}
